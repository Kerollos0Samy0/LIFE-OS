    end_line: 277
    content: "export type Language = \'ar\' | \'en\';\n\nexport type NavDestination =\n  | \'home\'\n  | \'finance\'\n  | \'time\'\n  | \'health\'\n  | \'ai\'\n  | \'wellbeing\'\n  | \'goals\'\n  | \'reports\'\n  | \'connections\'\n  | \'settings\';\n\nexport type PeakConcentration = \'morning\' | \'afternoon\' | \'evening\';\nexport type AiModelId = \'gemini-3.1-flash-lite\' | \'gemini-4-hydrogen\';\n\nexport interface UserProfile {\n  userId: string;\n  displayName: string;\n  email: string;\n  language: Language;\n  currency: \'EGP\';\n  dailyWorkHours: number;\n  workStartHour: number;\n  workEndHour: number;\n  targetSleepHours: number;\n  peakConcentration: PeakConcentration;\n  financialGoal: string;\n  smartphone: string;\n  smartwatch: string;\n  dailyStepTarget: number;\n  aiDefaultModel: AiModelId;\n  aiDailyLimit: number;\n  liabilitiesPiasters: number;\n  customCategories?: string[];\n}\n\nexport type IncomeSource = \'fixed_salary\' | \'freelance\' | \'additional\';\nexport type IncomeStatus = \'expected\' | \'invoiced\' | \'partially_paid\' | \'fully_paid\' | \'overdue\';\n\nexport interface IncomeRecord {\n  id: string;\n  userId: string;\n  title: string;\n  amountPiasters: number;\n  paidAmountPiasters: number;\n  currency: \'EGP\';\n  source: IncomeSource;\n  status: IncomeStatus;\n  dateReceived?: string;\n  expectedPaymentDate: string;\n  projectName?: string;\n  notes?: string;\n}\n\nexport type DefaultExpenseCategory =\n  | \'food\'\n  | \'transportation\'\n  | \'housing\'\n  | \'utilities\'\n  | \'internet_mobile\'\n  | \'shopping\'\n  | \'health\'\n  | \'entertainment\'\n  | \'education\'\n  | \'family\'\n  | \'church_activities\'\n  | \'work_expenses\'\n  | \'subscriptions\'\n  | \'other\';\n\nexport type PaymentMethod = \'cash\' | \'card\' | \'instapay\' | \'wallet\' | \'bank_transfer\';\nexport type EntrySource = \'manual\' | \'voice\' | \'receipt\' | \'notification\' | \'email_import\';\n\nexport interface ExpenseRecord {\n  id: string;\n  userId: string;\n  description: string;\n  amountPiasters: number;\n  currency: \'EGP\';\n  category: string;\n  date: string; // YYYY-MM-DD\n  paymentMethod: PaymentMethod;\n  entrySource: EntrySource;\n  recurring: boolean;\n  notes?: string;\n}\n\nexport interface Budget {\n  id: string;\n  userId: string;\n  category: string; // \'overall\' or category key\n  monthKey: string; // YYYY-MM\n  limitPiasters: number;\n}\n\nexport type SavingsCategory = \'emergency\' | \'purchases\' | \'education\' | \'travel\' | \'investments\' | \'custom\';\n\nexport interface SavingsGoal {\n  id: string;\n  userId: string;\n  title: string;\n  category: SavingsCategory;\n  targetPiasters: number;\n  currentPiasters: number;\n  targetDate: string; // YYYY-MM-DD\n}\n\nexport type InvestmentCategory = \'gold\' | \'stocks\' | \'mutual_funds\' | \'etfs\' | \'other\';\nexport type ValuationSource = \'manual\' | \'verified_market\';\n\nexport interface InvestmentAsset {\n  id: string;\n  userId: string;\n  name: string;\n  category: InvestmentCategory;\n  quantity: number;\n  purchasePricePiasters: number;\n  currentValuationPiasters: number;\n  feesPiasters: number;\n  realizedPnlPiasters: number;\n  purchaseDate: string;\n  valuationSource: ValuationSource;\n}\n\nexport type TaskPriority = \'critical\' | \'high\' | \'medium\' | \'low\';\nexport type TaskCategory = \'deep_work\' | \'admin\' | \'meetings\' | \'personal\' | \'rest\' | \'commute\';\nexport type TaskStatus = \'todo\' | \'in_progress\' | \'completed\';\n\nexport interface TaskItem {\n  id: string;\n  userId: string;\n  title: string;\n  description?: string;\n  priority: TaskPriority;\n  category: TaskCategory;\n  status: TaskStatus;\n  deadline: string;\n  scheduledStart?: string; // HH:mm\n  estimatedMinutes: number;\n  actualMinutes: number;\n  project?: string;\n}\n\nexport interface CalendarEvent {\n  id: string;\n  userId: string;\n  title: string;\n  calendarType: \'work\' | \'personal\';\n  date: string;\n  startTime: string; // HH:mm\n  endTime: string; // HH:mm\n  notes?: string;\n}\n\nexport interface FocusSession {\n  id: string;\n  userId: string;\n  label: string;\n  durationMinutes: number;\n  distractions: number;\n  date: string;\n}\n\nexport type HealthSource = \'manual\' | \'health_connect\' | \'xiaomi_band\';\n\nexport interface HealthLog {\n  id: string;\n  userId: string;\n  date: string;\n  sleepHours?: number;\n  sleepBedtime?: string;\n  steps?: number;\n  activeCalories?: number;\n  restingHeartRate?: number;\n  source: HealthSource;\n}\n\nexport interface AppUsageLog {\n  id: string;\n  userId: string;\n  date: string;\n  productivityMinutes: number;\n  communicationMinutes: number;\n  socialMediaMinutes: number;\n  entertainmentMinutes: number;\n  educationMinutes: number;\n  otherMinutes: number;\n  nighttimeMinutes: number;\n  interruptions: number;\n  source: \'manual\' | \'usage_stats\';\n}\n\nexport interface EnergyLog {\n  id: string;\n  userId: string;\n  date: string;\n  energyLevel: number; // 1-10\n  moodLevel: number; // 1-10\n  focusLevel: number; // 1-10\n  stressLevel: number; // 1-10\n  notes?: string;\n}\n\nexport type GoalCategory = \'financial\' | \'professional\' | \'educational\' | \'health\' | \'personal\' | \'social\';\n\nexport interface GoalMilestone {\n  id: string;\n  title: string;\n  completed: boolean;\n}\n\nexport interface PersonalGoal {\n  id: string;\n  userId: string;\n  title: string;\n  description?: string;\n  category: GoalCategory;\n  targetLabel: string;\n  startDate: string;\n  deadline: string;\n  progress: number; // 0-100\n  milestones: GoalMilestone[];\n}\n\nexport interface ParsedExpenseProposal {\n  description: string;\n  amountEgp: number;\n  category: string;\n  date: string;\n  paymentMethod: PaymentMethod;\n  confidence: number;\n  notes?: string;\n}\n\nexport interface AiChatActionProposal {\n  type: \'add_expense\' | \'add_task\';\n  summary: string;\n  payload: Record<string, unknown>;\n}\n\nexport interface AiChatMessage {\n  id: string;\n  role: \'user\' | \'assistant\';\n  content: string;\n  model?: AiModelId;\n  timestamp: string;\n  tokensUsed?: number;\n  proposal?: AiChatActionProposal;\n  proposalApplied?: boolean;\n}\n\nexport interface AiUsageStats {\n  dateKey: string;\n  requestsToday: number;\n  tokensThisMonth: number;\n  flashLiteCalls: number;\n  flashCalls: number;\n}\n\nexport interface LifeOsDataset {\n  profile: UserProfile;\n  incomeRecords: IncomeRecord[];\n  expenseRecords: ExpenseRecord[];\n  budgets: Budget[];\n  savingsGoals: SavingsGoal[];\n  investments: InvestmentAsset[];\n  tasks: TaskItem[];\n  calendarEvents: CalendarEvent[];\n  focusSessions: FocusSession[];\n  healthLogs: HealthLog[];\n  appUsageLogs: AppUsageLog[];\n  energyLogs: EnergyLog[];\n  goals: PersonalGoal[];\n  aiUsage: AiUsageStats;\n}\n"
    num_lines: 278
