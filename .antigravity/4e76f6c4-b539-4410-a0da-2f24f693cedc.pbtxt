      thinking_signature: "\022\376\025\n\373\025\001i\024}\023d\v\004\'t\025\340\265\277\314n\311$vI\004\304\376\300\270jUH\376\225^7R\311\352\355\235,e\205\034\002\336`\236\365\350\\\315\263iw\254\271\273LR\354\223_\334\374*\216\273\336_\030\234}\213\3008\370\323q&9L1\023~\264\325\247\0278i\301\305\233\312\363|\257\350\367\311\353L. jX-:Pe\302\347\336}\221\343\346\210\317E@`\002\312aP@\262#\207\337\004\036\304\373\251\nO\346\325h\312\000\236\024\300\375\330Vt[\027\033\317qfrh|\2554\"\307\006\204\356\017\346g(@\371)iS;\314R\335p\217G\bq\275\2438\357k\2520>\250\020\354G\224\221\227\275\302\264g\240\306\303q\200d \351\3134-\207\321\235W\0352\203K\245\304\354\036\350\035\226b\277\305\216\201\024j\270\177jG\004,\246 8\3209\244c\337\362bWZ\266\261\241\345\201\177\302\346B\276\032\332]\304aR\267\020(5\232Hc\303#\244\205\351\341u:PC\022\210\210o\263J<H\342F~&\362\256}\257C#\213D\t\243\3204\307\277\031\215\2553\024\346E\2749\322\036\207Q=\333P\210\256\315\334\313##\211\005\0214\022\321\361m\002\232 \276n?\370\210\364\r\256\020\231{\177\211^\343]\244\215\034b\354.\005\304P)9\265#\320Y\357\251\271\201\302\343\224\201\021Rj\365\360\005\r\326b\272\310\323W\200\222\030\320\v\241\376)\273\266\315\3221\\s\273\265/9\fGv\235\b!\372.\035\215$\300\037\331\320\211?\244\366\201\001\272\374g\200e\341\250X9\264\244\334|\265\347f\372*I\273\366>f\303B\322y\223\242\223Y\023\277\245\311\036S\353c\214\260\3719\273?\341\v2}\360\242:\334y\306\317\340|V\203\252\351>,\316[\270\277\270>\336od\260\327\317o\340\367\2408\367\\K\030\325\002\316D6u\237w\256{v\360~\001b\"\'\b<\300bo\225\221\240\304\320\204sm\367\032\224\354\226/\257h\27192\336I6\265\376i\256\347v\350\022h\321\177\331H\246\027&`\203O\216\342\343\030\377!\320\033\361\234\336\377\232\274O\255\016u\240.\3653\211\201|i:\243[G;I\374]4\376\317\243\fR\236\341\213\304\373_`HX\020&0$\367\307\341\366\253\226\256\002\a\0320\223\355\365S1d\330>\323\304P\361\332m\336\337\340\213\266\036\025\352\337E$\"\351\vAc\026\'\033\365)\262\315!\a54\311\205\253k