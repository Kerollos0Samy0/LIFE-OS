    tool_calls {
      id: "call_6024804069680066485"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { Check, Loader2, Mic, MicOff, X } from \'lucide-react\';\\nimport { useLifeOs } from \'../context/LifeOsContext\';\\nimport {\\n  DEFAULT_EXPENSE_CATEGORIES,\\n  getCategoryLabel,\\n  PAYMENT_METHOD_LABELS,\\n} from \'../i18n/translations\';\\nimport { TODAY_ISO } from \'../data/seedData\';\\nimport { egpToPiasters } from \'../utils/finance\';\\nimport type { ParsedExpenseProposal, PaymentMethod } from \'../types/lifeos\';\\n\\ninterface VoiceExpenseModalProps {\\n  open: boolean;\\n  onClose: () => void;\\n}\\n\\ninterface SpeechRecognitionInstance {\\n  lang: string;\\n  interimResults: boolean;\\n  maxAlternatives: number;\\n  start: () => void;\\n  stop: () => void;\\n  onresult: ((ev: { results: ArrayLike<ArrayLike<{ transcript: string }>> }) => void) | null;\\n  onerror: ((ev: { error: string }) => void) | null;\\n  onend: (() => void) | null;\\n}\\n\\nexport const VoiceExpenseModal: React.FC<VoiceExpenseModalProps> = ({ open, onClose }) => {\\n  const { lang, addExpense, recordAiUsage, data } = useLifeOs();\\n  const [inputText, setInputText] = useState(\'\');\\n  const [isListening, setIsListening] = useState(false);\\n  const [isParsing, setIsParsing] = useState(false);\\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\\n  const [proposal, setProposal] = useState<ParsedExpenseProposal | null>(null);\\n  const [savedSuccess, setSavedSuccess] = useState(false);\\n\\n  if (!open) return null;\\n\\n  const isAr = lang === \'ar\';\\n  const allCategories = [...DEFAULT_EXPENSE_CATEGORIES, ...(data.profile.customCategories || [])];\\n\\n  const handleVoiceCapture = () => {\\n    setErrorMsg(null);\\n    const w = window as unknown as {\\n      SpeechRecognition?: new () => SpeechRecognitionInstance;\\n      webkitSpeechRecognition?: new () => SpeechRecognitionInstance;\\n    };\\n    const SpeechRec = w.SpeechRecognition || w.webkitSpeechRecognition;\\n    if (!SpeechRec) {\\n      setErrorMsg(\\n        isAr\\n          ? \'\330\247\331\204\330\252\330\271\330\261\331\201 \330\247\331\204\330\265\331\210\330\252\331\212 \330\247\331\204\331\205\330\250\330\247\330\264\330\261 \330\272\331\212\330\261 \331\205\330\257\330\271\331\210\331\205 \331\201\331\212 \331\207\330\260\330\247 \330\247\331\204\331\205\330\252\330\265\331\201\330\255 \342\200\224 \331\212\331\205\331\203\331\206\331\203 \331\203\330\252\330\247\330\250\330\251 \330\247\331\204\330\254\331\205\331\204\330\251 \330\250\330\247\331\204\330\271\330\247\331\205\331\212\330\251 \330\247\331\204\331\205\330\265\330\261\331\212\330\251 \331\205\330\250\330\247\330\264\330\261\330\251 \330\243\330\257\331\206\330\247\331\207.\'\\n          : \'Browser Speech Recognition is unavailable here \342\200\224 type your expense sentence directly below.\',\\n      );\\n      return;\\n    }\\n\\n    const recognition = new SpeechRec();\\n    recognition.lang = isAr ? \'ar-EG\' : \'en-US\';\\n    recognition.interimResults = false;\\n    recognition.maxAlternatives = 1;\\n    setIsListening(true);\\n\\n    recognition.onresult = (event) => {\\n      const transcript = event.results[0]?.[0]?.transcript || \'\';\\n      setInputText(transcript);\\n      setIsListening(false);\\n    };\\n    recognition.onerror = () => {\\n      setIsListening(false);\\n      setErrorMsg(isAr ? \'\330\252\330\271\330\260\331\221\330\261 \330\247\331\204\330\252\331\202\330\247\330\267 \330\247\331\204\330\265\331\210\330\252\330\214 \330\254\330\261\331\221\330\250 \330\247\331\204\331\203\330\252\330\247\330\250\330\251 \330\243\331\210 \330\245\330\271\330\247\330\257\330\251 \330\247\331\204\331\205\330\255\330\247\331\210\331\204\330\251.\' : \'Could not capture audio. Please type or retry.\');\\n    };\\n    recognition.onend = () => setIsListening(false);\\n    recognition.start();\\n  };\\n\\n  const handleParse = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!inputText.trim()) return;\\n    setErrorMsg(null);\\n    setProposal(null);\\n    setSavedSuccess(false);\\n    setIsParsing(true);\\n\\n    try {\\n      const res = await fetch(\'/api/ai/parse-expense\', {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({\\n          text: inputText.trim(),\\n          sourceType: \'voice\',\\n          todayIso: TODAY_ISO,\\n        }),\\n      });\\n      const json = await res.json();\\n      if (!res.ok) {\\n        throw new Error(json.error || \'Parsing failed\');\\n      }\\n      if (json.tokensUsed) {\\n        recordAiUsage(\'gemini-3.1-flash-lite\', json.tokensUsed);\\n      }\\n      setProposal(json.proposal as ParsedExpenseProposal);\\n    } catch (err) {\\n      setErrorMsg(err instanceof Error ? err.message : \'Failed to parse expense\');\\n    } finally {\\n      setIsParsing(false);\\n    }\\n  };\\n\\n  const handleConfirmSave = async () => {\\n    if (!proposal || proposal.amountEgp <= 0 || !proposal.description.trim()) {\\n      setErrorMsg(isAr ? \'\331\212\330\261\330\254\331\211 \330\247\331\204\330\252\330\243\331\203\330\257 \331\205\331\206 \330\247\331\204\331\205\330\250\331\204\330\272 \331\210\330\247\331\204\331\210\330\265\331\201 \331\202\330\250\331\204 \330\247\331\204\330\255\331\201\330\270.\' : \'Please verify amount and description before saving.\');\\n      return;\\n    }\\n    await addExpense({\\n      description: proposal.description,\\n      amountPiasters: egpToPiasters(proposal.amountEgp),\\n      currency: \'EGP\',\\n      category: proposal.category || \'other\',\\n      date: proposal.date || TODAY_ISO,\\n      paymentMethod: proposal.paymentMethod || \'cash\',\\n      entrySource: \'voice\',\\n      recurring: false,\\n      notes: proposal.notes,\\n    });\\n    setSavedSuccess(true);\\n    setTimeout(() => {\\n      setSavedSuccess(false);\\n      setProposal(null);\\n      setInputText(\'\');\\n      onClose();\\n    }, 600);\\n  };\\n\\n  return (\\n    <div\\n      className=\\\"fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-black/75 backdrop-blur-sm p-4\\\"\\n      role=\\\"dialog\\\"\\n      aria-modal=\\\"true\\\"\\n      aria-labelledby=\\\"voice-expense-title\\\"\\n    >\\n      <div className=\\\"w-full max-w-lg bg-[#13171C] border border-[#232A33] rounded-2xl p-6 space-y-5 max-h-[90vh] overflow-y-auto\\\">\\n        <div className=\\\"flex items-center justify-between gap-4\\\">\\n          <div>\\n            <h2 id=\\\"voice-expense-title\\\" className=\\\"text-base font-semibold text-[#F4F6F8]\\\">\\n              {isAr ? \'\330\252\330\263\330\254\331\212\331\204 \331\205\330\265\330\261\331\210\331\201 \330\250\330\247\331\204\330\265\331\210\330\252 \330\243\331\210 \330\247\331\204\331\206\330\265 \330\247\331\204\330\267\330\250\331\212\330\271\331\212\' : \'Voice & Natural-Language Expense Entry\'}\\n            </h2>\\n            <p className=\\\"text-xs text-[#8E99A8] mt-1\\\">\\n              {isAr\\n                ? \'\330\252\330\255\331\204\331\212\331\204 \330\260\331\203\331\212 \330\271\330\250\330\261 Gemini Flash-Lite \331\205\330\271 \330\264\330\247\330\264\330\251 \330\252\330\243\331\203\331\212\330\257 \330\245\331\204\330\262\330\247\331\205\331\212\330\251 \331\202\330\250\331\204 \330\247\331\204\330\255\331\201\330\270.\'\\n                : \'Parsed via Gemini Flash-Lite with mandatory confirmation before saving.\'}\\n            </p>\\n          </div>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onClose}\\n            aria-label={isAr ? \'\330\245\330\272\331\204\330\247\331\202\' : \'Close\'}\\n            className=\\\"min-h-[40px] min-w-[40px] flex items-center justify-center rounded-xl text-[#8E99A8] hover:text-[#F4F6F8] hover:bg-[#1C222B]\\\"\\n          >\\n            <X className=\\\"w-5 h-5\\\" />\\n          </button>\\n        </div>\\n\\n        <form onSubmit={handleParse} className=\\\"space-y-3\\\">\\n          <label htmlFor=\\\"voice-expense-input\\\" className=\\\"block text-xs font-medium text-[#A9B3C1]\\\">\\n            {isAr ? \'\330\247\330\252\331\203\331\204\331\205 \330\243\331\210 \330\247\331\203\330\252\330\250 \330\247\331\204\331\205\330\265\330\261\331\210\331\201 \330\250\330\247\331\204\330\271\330\247\331\205\331\212\330\251 \330\247\331\204\331\205\330\265\330\261\331\212\330\251\' : \'Speak or type your expense naturally\'}\\n          </label>\\n          <div className=\\\"flex gap-2\\\">\\n            <input\\n              id=\\\"voice-expense-input\\\"\\n              type=\\\"text\\\"\\n              value={inputText}\\n              onChange={(e) => setInputText(e.target.value)}\\n              placeholder={isAr ? \'\331\205\330\253\330\247\331\204: \330\257\331\201\330\271\330\252 150 \330\254\331\206\331\212\331\207 \331\205\331\210\330\247\330\265\331\204\330\247\330\252 \330\247\331\204\331\206\331\207\330\247\330\261\330\257\331\207\' : \'e.g., Paid 150 EGP for Uber today\'}\\n              className=\\\"flex-1 min-h-[44px] px-3.5 py-2.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8] placeholder:text-[#5E6877] focus:outline-none focus:border-emerald-500\\\"\\n            />\\n            <button\\n              type=\\\"button\\\"\\n              onClick={handleVoiceCapture}\\n              aria-label={isAr ? \'\330\252\330\263\330\254\331\212\331\204 \330\265\331\210\330\252\331\212\' : \'Start voice input\'}\\n              className={`min-h-[44px] min-w-[44px] px-3 rounded-xl border transition-colors flex items-center justify-center ${\\n                isListening\\n                  ? \'bg-red-500/20 border-red-500 text-red-400\'\\n                  : \'bg-[#191F27] border-[#232A33] text-[#C8D0DC] hover:border-emerald-500/60\'\\n              }`}\\n            >\\n              {isListening ? <MicOff className=\\\"w-4 h-4\\\" /> : <Mic className=\\\"w-4 h-4\\\" />}\\n            </button>\\n          </div>\\n\\n          <div className=\\\"flex flex-wrap gap-2 text-xs\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setInputText(\'\330\257\331\201\330\271\330\252 150 \330\254\331\206\331\212\331\207 \331\205\331\210\330\247\330\265\331\204\330\247\330\252 \330\247\331\204\331\206\331\207\330\247\330\261\330\257\331\207\')}\\n              className=\\\"text-[#8E99A8] hover:text-emerald-400 underline underline-offset-4 transition-colors\\\"\\n            >\\n              \\\"\330\257\331\201\330\271\330\252 150 \330\254\331\206\331\212\331\207 \331\205\331\210\330\247\330\265\331\204\330\247\330\252 \330\247\331\204\331\206\331\207\330\247\330\261\330\257\331\207\\\"\\n            </button>\\n            <span className=\\\"text-[#404A58]\\\">\302\267</span>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setInputText(\'\330\247\330\264\330\252\330\261\331\212\330\252 \331\202\331\207\331\210\330\251 \331\210\330\272\330\257\330\247 \330\250 220 \330\254\331\206\331\212\331\207 \331\203\330\247\330\264\')}\\n              className=\\\"text-[#8E99A8] hover:text-emerald-400 underline underline-offset-4 transition-colors\\\"\\n            >\\n              \\\"\330\247\330\264\330\252\330\261\331\212\330\252 \331\202\331\207\331\210\330\251 \331\210\330\272\330\257\330\247 \330\250 220 \330\254\331\206\331\212\331\207 \331\203\330\247\330\264\\\"\\n            </button>\\n          </div>\\n\\n          <button\\n            type=\\\"submit\\\"\\n            disabled={isParsing || !inputText.trim()}\\n            className=\\\"w-full min-h-[44px] rounded-xl bg-emerald-500 text-[#07110C] font-semibold text-sm hover:bg-emerald-400 disabled:opacity-50 transition-colors flex items-center justify-center gap-2\\\"\\n          >\\n            {isParsing ? <Loader2 className=\\\"w-4 h-4 animate-spin\\\" /> : null}\\n            {isParsing\\n              ? isAr ? \'\330\254\330\247\330\261\331\212 \330\247\331\204\330\252\330\255\331\204\331\212\331\204...\' : \'Parsing...\'\\n              : isAr ? \'\330\252\330\255\331\204\331\212\331\204 \330\247\331\204\331\205\330\265\330\261\331\210\331\201 \331\202\330\250\331\204 \330\247\331\204\330\255\331\201\330\270\' : \'Extract & Review Expense\'}\\n          </button>\\n        </form>\\n\\n        {errorMsg ? (\\n          <div className=\\\"p-3.5 rounded-xl bg-red-500/10 border border-red-500/30 text-xs text-red-300\\\">\\n            {errorMsg}\\n          </div>\\n        ) : null}\\n\\n        {proposal ? (\\n          <div className=\\\"pt-4 border-t border-[#232A33] space-y-4\\\">\\n            <div className=\\\"flex items-center justify-between text-xs text-[#8E99A8]\\\">\\n              <span className=\\\"font-semibold text-emerald-400\\\">\\n                {isAr ? \'\331\205\330\261\330\247\330\254\330\271\330\251 \331\210\330\252\330\243\331\203\331\212\330\257 \330\247\331\204\331\205\330\271\330\247\331\205\331\204\330\251 (\330\245\331\204\330\262\330\247\331\205\331\212)\' : \'Confirm Extracted Transaction (Required)\'}\\n              </span>\\n              <span className=\\\"font-mono-nums\\\">\\n                {isAr ? \'\330\257\331\202\330\251 \330\247\331\204\330\252\330\255\331\204\331\212\331\204:\' : \'Confidence:\'} {Math.round((proposal.confidence || 0) * 100)}%\\n              </span>\\n            </div>\\n\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3\\\">\\n              <div>\\n                <label htmlFor=\\\"prop-amount\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">\\n                  {isAr ? \'\330\247\331\204\331\205\330\250\331\204\330\272 (\330\254.\331\205)\' : \'Amount (EGP)\'}\\n                </label>\\n                <input\\n                  id=\\\"prop-amount\\\"\\n                  type=\\\"number\\\"\\n                  step=\\\"0.01\\\"\\n                  value={proposal.amountEgp}\\n                  onChange={(e) => setProposal({ ...proposal, amountEgp: Number(e.target.value) })}\\n                  className=\\\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <label htmlFor=\\\"prop-cat\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">\\n                  {isAr ? \'\330\247\331\204\330\252\330\265\331\206\331\212\331\201\' : \'Category\'}\\n                </label>\\n                <select\\n                  id=\\\"prop-cat\\\"\\n                  value={proposal.category}\\n                  onChange={(e) => setProposal({ ...proposal, category: e.target.value })}\\n                  className=\\\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\\\"\\n                >\\n                  {allCategories.map((cat) => (\\n                    <option key={cat} value={cat}>\\n                      {getCategoryLabel(cat, lang)}\\n                    </option>\\n                  ))}\\n                </select>\\n              </div>\\n\\n              <div className=\\\"sm:col-span-2\\\">\\n                <label htmlFor=\\\"prop-desc\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">\\n                  {isAr ? \'\330\247\331\204\331\210\330\265\331\201\' : \'Description\'}\\n                </label>\\n                <input\\n                  id=\\\"prop-desc\\\"\\n                  type=\\\"text\\\"\\n                  value={proposal.description}\\n                  onChange={(e) => setProposal({ ...proposal, description: e.target.value })}\\n                  className=\\\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <label htmlFor=\\\"prop-date\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">\\n                  {isAr ? \'\330\247\331\204\330\252\330\247\330\261\331\212\330\256\' : \'Date\'}\\n                </label>\\n                <input\\n                  id=\\\"prop-date\\\"\\n                  type=\\\"date\\\"\\n                  value={proposal.date}\\n                  onChange={(e) => setProposal({ ...proposal, date: e.target.value })}\\n                  className=\\\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <label htmlFor=\\\"prop-method\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">\\n                  {isAr ? \'\330\267\330\261\331\212\331\202\330\251 \330\247\331\204\330\257\331\201\330\271\' : \'Payment Method\'}\\n                </label>\\n                <select\\n                  id=\\\"prop-method\\\"\\n                  value={proposal.paymentMethod}\\n                  onChange={(e) => setProposal({ ...proposal, paymentMethod: e.target.value as PaymentMethod })}\\n                  className=\\\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\\\"\\n                >\\n                  {(Object.keys(PAYMENT_METHOD_LABELS) as PaymentMethod[]).map((m) => (\\n                    <option key={m} value={m}>\\n                      {PAYMENT_METHOD_LABELS[m][lang]}\\n                    </option>\\n                  ))}\\n                </select>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"flex items-center justify-end gap-3 pt-1\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setProposal(null)}\\n                className=\\\"min-h-[44px] px-4 rounded-xl border border-[#232A33] text-sm text-[#C8D0DC] hover:bg-[#1B212A]\\\"\\n              >\\n                {isAr ? \'\330\245\331\204\330\272\330\247\330\241\' : \'Discard\'}\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={handleConfirmSave}\\n                className=\\\"min-h-[44px] px-5 rounded-xl bg-emerald-500 text-[#07110C] font-semibold text-sm hover:bg-emerald-400 flex items-center gap-2\\\"\\n              >\\n                <Check className=\\\"w-4 h-4\\\" />\\n                {savedSuccess\\n                  ? isAr ? \'\330\252\331\205 \330\247\331\204\330\255\331\201\330\270\' : \'Saved\'\\n                  : isAr ? \'\330\252\330\243\331\203\331\212\330\257 \331\210\330\255\331\201\330\270 \330\247\331\204\331\205\330\265\330\261\331\210\331\201\' : \'Confirm & Save Expense\'}\\n              </button>\\n            </div>\\n          </div>\\n        ) : null}\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create Voice & Natural-Language Egyptian Arabic Expense Entry modal with Web Speech API, Gemini Flash-Lite extraction, and mandatory confirmation screen\", \"Overwrite\":true, \"TargetFile\":\"/src/components/VoiceExpenseModal.tsx\", \"toolAction\":\"Creating VoiceExpenseModal component\", \"toolSummary\":\"Create VoiceExpenseModal\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_6024804069680065786"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useMemo, useState } from \'react\';\\nimport {\\n  Activity,\\n  ArrowUpLeft,\\n  ArrowUpRight,\\n  CalendarClock,\\n  CheckCircle2,\\n  Loader2,\\n  Mic,\\n  RefreshCw,\\n  Sparkles,\\n  Wallet,\\n  Zap,\\n} from \'lucide-react\';\\nimport { useLifeOs } from \'../context/LifeOsContext\';\\nimport { CURRENT_MONTH, TODAY_ISO } from \'../data/seedData\';\\nimport {\\n  calculateAvailableCashPiasters,\\n  calculatePendingReceivablesPiasters,\\n  calculateSavingsRatePercent,\\n  calculateTotalExpensesPiasters,\\n  calculateTotalPaidIncomePiasters,\\n  formatEgp,\\n} from \'../utils/finance\';\\nimport { calculateEnergyEstimate } from \'../utils/energy\';\\nimport { UI_TEXT } from \'../i18n/translations\';\\nimport type { NavDestination } from \'../types/lifeos\';\\n\\ninterface DailyBriefingResponse {\\n  financialObservation: string;\\n  productivityObservation: string;\\n  healthObservation: string;\\n  importantReminder: string;\\n  recommendations: string[];\\n}\\n\\ninterface HomeDashboardProps {\\n  onNavigate: (dest: NavDestination) => void;\\n  onOpenVoiceExpense: () => void;\\n}\\n\\nexport const HomeDashboard: React.FC<HomeDashboardProps> = ({ onNavigate, onOpenVoiceExpense }) => {\\n  const { data, lang, recordAiUsage, isCloudMode, signInWithGoogle, seedCloudFromSample } = useLifeOs();\\n  const isAr = lang === \'ar\';\\n\\n  const [briefing, setBriefing] = useState<DailyBriefingResponse | null>(null);\\n  const [briefingLoading, setBriefingLoading] = useState(false);\\n  const [briefingError, setBriefingError] = useState<string | null>(null);\\n\\n  const metrics = useMemo(() => {\\n    const availableCash = calculateAvailableCashPiasters(data.incomeRecords, data.expenseRecords);\\n    const monthlyPaidIncome = calculateTotalPaidIncomePiasters(data.incomeRecords, CURRENT_MONTH);\\n    const monthlyExpenses = calculateTotalExpensesPiasters(data.expenseRecords, CURRENT_MONTH);\\n    const pendingReceivables = calculatePendingReceivablesPiasters(data.incomeRecords);\\n    const savingsRate = calculateSavingsRatePercent(monthlyPaidIncome, monthlyExpenses);\\n\\n    const totalSavingsCurrent = data.savingsGoals.reduce((s, g) => s + g.currentPiasters, 0);\\n    const totalSavingsTarget = data.savingsGoals.reduce((s, g) => s + g.targetPiasters, 0);\\n    const savingsProgressPct = totalSavingsTarget > 0 ? Math.round((totalSavingsCurrent / totalSavingsTarget) * 100) : 0;\\n\\n    const todayTasks = data.tasks.filter((t) => t.deadline === TODAY_ISO);\\n    const completedToday = todayTasks.filter((t) => t.status === \'completed\').length;\\n    const remainingToday = todayTasks.length - completedToday;\\n    const todayEvents = data.calendarEvents.filter((e) => e.date === TODAY_ISO);\\n    const focusMinutesToday = data.focusSessions\\n      .filter((f) => f.date === TODAY_ISO)\\n      .reduce((s, f) => s + f.durationMinutes, 0);\\n\\n    const latestHealth = [...data.healthLogs].sort((a, b) => b.date.localeCompare(a.date))[0] || null;\\n    const latestUsage = [...data.appUsageLogs].sort((a, b) => b.date.localeCompare(a.date))[0] || null;\\n\\n    const energy = calculateEnergyEstimate({\\n      healthLogs: data.healthLogs,\\n      appUsageLogs: data.appUsageLogs,\\n      energyLogs: data.energyLogs,\\n      dailyStepTarget: data.profile.dailyStepTarget,\\n      targetSleepHours: data.profile.targetSleepHours,\\n      peakConcentration: data.profile.peakConcentration,\\n    });\\n\\n    const overdueInvoices = data.incomeRecords.filter((i) => i.status === \'overdue\');\\n\\n    return {\\n      availableCash,\\n      monthlyPaidIncome,\\n      monthlyExpenses,\\n      pendingReceivables,\\n      savingsRate,\\n      savingsProgressPct,\\n      totalSavingsCurrent,\\n      todayTasks,\\n      completedToday,\\n      remainingToday,\\n      todayEvents,\\n      focusMinutesToday,\\n      latestHealth,\\n      latestUsage,\\n      energy,\\n      overdueInvoices,\\n    };\\n  }, [data]);\\n\\n  const handleGenerateBriefing = async () => {\\n    setBriefingLoading(true);\\n    setBriefingError(null);\\n    try {\\n      const payload = {\\n        date: TODAY_ISO,\\n        availableCashEgp: metrics.availableCash / 100,\\n        monthlyPaidIncomeEgp: metrics.monthlyPaidIncome / 100,\\n        monthlyExpensesEgp: metrics.monthlyExpenses / 100,\\n        pendingFreelanceReceivablesEgp: metrics.pendingReceivables / 100,\\n        overdueInvoicesCount: metrics.overdueInvoices.length,\\n        savingsProgressPercent: metrics.savingsProgressPct,\\n        tasksCompletedToday: metrics.completedToday,\\n        tasksRemainingToday: metrics.remainingToday,\\n        focusMinutesToday: metrics.focusMinutesToday,\\n        sleepHours: metrics.latestHealth?.sleepHours ?? \'unavailable\',\\n        steps: metrics.latestHealth?.steps ?? \'unavailable\',\\n        restingHeartRate: metrics.latestHealth?.restingHeartRate ?? \'unavailable\',\\n        nighttimeScreenMinutes: metrics.latestUsage?.nighttimeMinutes ?? \'unavailable\',\\n        estimatedEnergyScore: metrics.energy.estimatedScore ?? \'unavailable\',\\n        peakConcentration: data.profile.peakConcentration,\\n      };\\n\\n      const res = await fetch(\'/api/ai/briefing\', {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({ language: lang, summary: payload }),\\n      });\\n      const json = await res.json();\\n      if (!res.ok) {\\n        throw new Error(json.error || \'Could not generate daily briefing\');\\n      }\\n      if (json.tokensUsed) {\\n        recordAiUsage(\'gemini-3.1-flash-lite\', json.tokensUsed);\\n      }\\n      setBriefing(json.briefing as DailyBriefingResponse);\\n    } catch (err) {\\n      setBriefingError(err instanceof Error ? err.message : \'Failed to load AI briefing\');\\n    } finally {\\n      setBriefingLoading(false);\\n    }\\n  };\\n\\n  const ArrowIcon = isAr ? ArrowUpLeft : ArrowUpRight;\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      {/* Greeting & Quick Actions Row */}\\n      <section className=\\\"flex flex-col md:flex-row md:items-end justify-between gap-4\\\">\\n        <div>\\n          <p className=\\\"text-xs text-[#8E99A8] font-mono-nums\\\">\\n            {TODAY_ISO} \302\267 {isCloudMode ? UI_TEXT[lang].auth.cloudSynced : UI_TEXT[lang].auth.localSampleMode}\\n          </p>\\n          <h1 className=\\\"text-2xl sm:text-3xl font-bold text-[#F4F6F8] mt-1\\\">\\n            {isAr ? `\330\243\331\207\331\204\330\247\331\213 \331\212\330\247 ${data.profile.displayName}` : `Welcome back, ${data.profile.displayName}`}\\n          </h1>\\n          <p className=\\\"text-sm text-[#8E99A8] mt-1\\\">\\n            {isAr\\n              ? \'\331\205\331\204\330\256\330\265 \330\255\331\212 \331\204\330\255\330\247\331\204\330\252\331\203 \330\247\331\204\331\205\330\247\331\204\331\212\330\251\330\214 \331\210\331\202\330\252\331\203\330\214 \330\265\330\255\330\252\331\203\330\214 \331\210\331\205\330\244\330\264\330\261 \330\267\330\247\331\202\330\252\331\203 \330\247\331\204\331\212\331\210\331\205.\'\\n              : \'Live snapshot of your finances, time, health, and daily energy.\'}\\n          </p>\\n        </div>\\n\\n        <div className=\\\"flex flex-wrap items-center gap-2.5\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onOpenVoiceExpense}\\n            className=\\\"min-h-[44px] px-4 py-2 rounded-xl bg-emerald-500 text-[#07110C] font-semibold text-sm hover:bg-emerald-400 transition-colors flex items-center gap-2 whitespace-nowrap\\\"\\n          >\\n            <Mic className=\\\"w-4 h-4\\\" />\\n            {isAr ? \'\330\263\330\254\331\221\331\204 \331\205\330\265\330\261\331\210\331\201 \330\250\330\247\331\204\330\265\331\210\330\252\' : \'Voice Expense\'}\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => onNavigate(\'ai\')}\\n            className=\\\"min-h-[44px] px-4 py-2 rounded-xl bg-[#13171C] border border-[#232A33] text-sm font-medium text-[#E2E8F0] hover:border-emerald-500/50 transition-colors flex items-center gap-2 whitespace-nowrap\\\"\\n          >\\n            <Sparkles className=\\\"w-4 h-4 text-emerald-400\\\" />\\n            {isAr ? \'\330\247\330\263\330\243\331\204 LIFE AI\' : \'Ask LIFE AI\'}\\n          </button>\\n        </div>\\n      </section>\\n\\n      {/* Honest Cloud Sync / Empty Cloud Notice */}\\n      {!isCloudMode ? (\\n        <div className=\\\"bg-[#13171C] border border-[#232A33] rounded-2xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3\\\">\\n          <p className=\\\"text-xs sm:text-sm text-[#A9B3C1] leading-relaxed\\\">\\n            {UI_TEXT[lang].auth.syncNotice}\\n          </p>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => void signInWithGoogle()}\\n            className=\\\"min-h-[40px] px-4 py-2 rounded-xl border border-emerald-500/40 text-emerald-300 hover:bg-emerald-500/10 text-xs font-semibold transition-colors whitespace-nowrap shrink-0\\\"\\n          >\\n            {UI_TEXT[lang].auth.signInGoogle}\\n          </button>\\n        </div>\\n      ) : data.expenseRecords.length === 0 && data.incomeRecords.length === 0 ? (\\n        <div className=\\\"bg-[#13171C] border border-[#232A33] rounded-2xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3\\\">\\n          <p className=\\\"text-xs sm:text-sm text-[#A9B3C1]\\\">\\n            {isAr\\n              ? \'\330\255\330\263\330\247\330\250\331\203 \330\247\331\204\330\263\330\255\330\247\330\250\331\212 \330\254\330\247\331\207\330\262 \331\210\331\201\330\247\330\261\330\272 \330\255\330\247\331\204\331\212\330\247\331\213. \331\212\331\205\331\203\331\206\331\203 \330\247\331\204\330\250\330\257\330\241 \330\250\330\245\330\266\330\247\331\201\330\251 \330\263\330\254\331\204\330\247\330\252\331\203 \330\243\331\210 \330\247\330\263\330\252\331\212\330\261\330\247\330\257 \330\250\331\212\330\247\331\206\330\247\330\252 \330\250\330\257\330\247\331\212\330\251 \331\206\331\205\331\210\330\260\330\254\331\212\330\251 \331\204\330\252\330\254\330\261\330\250\330\251 \330\247\331\204\331\205\331\206\330\265\330\251.\'\\n              : \'Your cloud workspace is empty. Start adding records or load starter sample data to explore.\'}\\n          </p>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => void seedCloudFromSample()}\\n            className=\\\"min-h-[40px] px-4 py-2 rounded-xl bg-emerald-500 text-[#07110C] text-xs font-semibold hover:bg-emerald-400 transition-colors whitespace-nowrap shrink-0\\\"\\n          >\\n            {isAr ? \'\330\247\330\263\330\252\331\212\330\261\330\247\330\257 \330\250\331\212\330\247\331\206\330\247\330\252 \330\247\331\204\330\250\330\257\330\247\331\212\330\251\' : \'Load Starter Data\'}\\n          </button>\\n        </div>\\n      ) : null}\\n\\n      {/* Focal Anchor: Financial Summary Hero Grid */}\\n      <section className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-5\\\">\\n        <div className=\\\"lg:col-span-7 bg-[#13171C] border border-[#232A33] rounded-2xl p-6 flex flex-col justify-between gap-6\\\">\\n          <div className=\\\"flex items-start justify-between gap-4\\\">\\n            <div>\\n              <p className=\\\"text-xs text-[#8E99A8] flex items-center gap-1.5\\\">\\n                <Wallet className=\\\"w-3.5 h-3.5 text-emerald-400\\\" />\\n                {isAr ? \'\330\247\331\204\330\261\330\265\331\212\330\257 \330\247\331\204\331\206\331\202\330\257\331\212 \330\247\331\204\331\205\330\252\330\247\330\255 \331\201\330\271\331\204\331\212\330\247\331\213\' : \'Available Cash Balance\'}\\n              </p>\\n              <p className=\\\"text-3xl sm:text-4xl font-bold font-mono-nums text-[#F4F6F8] mt-2\\\" data-testid=\\\"home-available-cash\\\">\\n                {formatEgp(metrics.availableCash, lang)}\\n              </p>\\n              <p className=\\\"text-xs text-[#8E99A8] mt-1.5\\\">\\n                {isAr\\n                  ? \'\331\204\330\247 \331\212\330\264\331\205\331\204 \331\201\331\210\330\247\330\252\331\212\330\261 \330\247\331\204\331\201\330\261\331\212\331\204\330\247\331\206\330\263 \330\272\331\212\330\261 \330\247\331\204\331\205\330\255\330\265\331\221\331\204\330\251\'\\n                  : \'Strictly excludes unpaid freelance invoices\'}\\n                {\' \302\267 \'}\\n                <span className=\\\"text-amber-400 font-mono-nums\\\">\\n                  {isAr ? \'\331\205\330\263\330\252\330\255\331\202\330\247\330\252 \331\205\330\271\331\204\331\202\330\251:\' : \'Pending:\'} {formatEgp(metrics.pendingReceivables, lang)}\\n                </span>\\n              </p>\\n            </div>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => onNavigate(\'finance\')}\\n              className=\\\"min-h-[38px] px-3 rounded-xl text-xs font-medium text-emerald-400 hover:bg-[#1B222A] transition-colors flex items-center gap-1 whitespace-nowrap shrink-0\\\"\\n            >\\n              {isAr ? \'\330\247\331\204\330\252\331\201\330\247\330\265\331\212\331\204\' : \'Details\'}\\n              <ArrowIcon className=\\\"w-3.5 h-3.5\\\" />\\n            </button>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-3 gap-4 pt-5 border-t border-[#232A33]\\\">\\n            <div>\\n              <p className=\\\"text-xs text-[#8E99A8]\\\">{isAr ? \'\330\257\330\256\331\204 \330\247\331\204\330\264\331\207\330\261 \330\247\331\204\331\205\330\255\330\265\331\221\331\204\' : \'Monthly Paid Income\'}</p>\\n              <p className=\\\"text-base sm:text-lg font-semibold font-mono-nums text-emerald-400 mt-1\\\">\\n                {formatEgp(metrics.monthlyPaidIncome, lang)}\\n              </p>\\n            </div>\\n            <div>\\n              <p className=\\\"text-xs text-[#8E99A8]\\\">{isAr ? \'\331\205\330\265\330\247\330\261\331\212\331\201 \330\247\331\204\330\264\331\207\330\261\' : \'Monthly Expenses\'}</p>\\n              <p className=\\\"text-base sm:text-lg font-semibold font-mono-nums text-[#F4F6F8] mt-1\\\" data-testid=\\\"home-monthly-expenses\\\">\\n                {formatEgp(metrics.monthlyExpenses, lang)}\\n              </p>\\n            </div>\\n            <div>\\n              <p className=\\\"text-xs text-[#8E99A8]\\\">{isAr ? \'\330\252\331\202\330\257\331\205 \330\247\331\204\330\247\330\257\330\256\330\247\330\261\' : \'Savings Progress\'}</p>\\n              <p className=\\\"text-base sm:text-lg font-semibold font-mono-nums text-[#F4F6F8] mt-1\\\">\\n                {metrics.savingsProgressPct}%\\n              </p>\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* Energy & AI Daily Briefing Card */}\\n        <div className=\\\"lg:col-span-5 bg-[#13171C] border border-[#232A33] rounded-2xl p-6 flex flex-col justify-between gap-4\\\">\\n          <div className=\\\"flex items-start justify-between gap-3\\\">\\n            <div>\\n              <p className=\\\"text-xs text-[#8E99A8] flex items-center gap-1.5\\\">\\n                <Zap className=\\\"w-3.5 h-3.5 text-emerald-400\\\" />\\n                {isAr ? \'\331\205\330\244\330\264\330\261 \330\247\331\204\330\267\330\247\331\202\330\251 \330\247\331\204\330\252\331\202\330\257\331\212\330\261\331\212\' : \'Estimated Energy Indicator\'}\\n              </p>\\n              <div className=\\\"flex items-baseline gap-2.5 mt-2\\\">\\n                <span className=\\\"text-3xl font-bold font-mono-nums text-[#F4F6F8]\\\">\\n                  {metrics.energy.estimatedScore !== null ? `${metrics.energy.estimatedScore}%` : UI_TEXT[lang].common.unavailable}\\n                </span>\\n                <span className=\\\"text-xs text-[#8E99A8]\\\">\\n                  {metrics.energy.level === \'high\'\\n                    ? isAr ? \'\330\267\330\247\331\202\330\251 \331\205\330\261\330\252\331\201\330\271\330\251\' : \'High readiness\'\\n                    : metrics.energy.level === \'moderate\'\\n                      ? isAr ? \'\330\267\330\247\331\202\330\251 \331\205\330\252\331\210\330\263\330\267\330\251\' : \'Moderate\'\\n                      : metrics.energy.level === \'low\'\\n                        ? isAr ? \'\331\212\331\217\331\206\330\265\330\255 \330\250\330\247\331\204\330\261\330\247\330\255\330\251\' : \'Prioritize recovery\'\\n                        : \'\'}\\n                </span>\\n              </div>\\n            </div>\\n            <span className=\\\"text-xs text-[#8E99A8] font-mono-nums\\\">\\n              {metrics.energy.baselineDaysLogged}/{metrics.energy.baselineTargetDays} {isAr ? \'\331\212\331\210\331\205 \330\243\330\263\330\247\330\263\' : \'baseline d\'}\\n            </span>\\n          </div>\\n\\n          <div className=\\\"space-y-2 text-xs text-[#A9B3C1] pt-3 border-t border-[#232A33]\\\">\\n            <p className=\\\"text-[#F4F6F8] font-medium\\\">\\n              {isAr ? \'\330\252\331\210\330\265\331\212\330\251 \330\247\331\204\330\252\330\261\331\203\331\212\330\262:\' : \'Focus recommendation:\'}\\n            </p>\\n            <p className=\\\"leading-relaxed\\\">\\n              {isAr ? metrics.energy.recommendationsAr[0] : metrics.energy.recommendationsEn[0]}\\n            </p>\\n            <p className=\\\"text-[11px] text-[#758091]\\\">{UI_TEXT[lang].common.nonMedicalNotice}</p>\\n          </div>\\n        </div>\\n      </section>\\n\\n      {/* Productivity & Health Summaries */}\\n      <section className=\\\"grid grid-cols-1 md:grid-cols-2 gap-5\\\">\\n        {/* Productivity Summary */}\\n        <div className=\\\"bg-[#13171C] border border-[#232A33] rounded-2xl p-6 space-y-4\\\">\\n          <div className=\\\"flex items-center justify-between\\\">\\n            <h2 className=\\\"text-base font-semibold text-[#F4F6F8] flex items-center gap-2\\\">\\n              <CalendarClock className=\\\"w-4 h-4 text-emerald-400\\\" />\\n              {isAr ? \'\331\205\331\204\330\256\330\265 \330\247\331\204\330\245\331\206\330\252\330\247\330\254\331\212\330\251 \331\210\330\247\331\204\331\210\331\202\330\252\' : \'Productivity & Time\'}\\n            </h2>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => onNavigate(\'time\')}\\n              className=\\\"text-xs text-emerald-400 hover:underline flex items-center gap-1\\\"\\n            >\\n              {isAr ? \'\330\245\330\257\330\247\330\261\330\251 \330\247\331\204\331\212\331\210\331\205\' : \'Open Time\'}\\n              <ArrowIcon className=\\\"w-3.5 h-3.5\\\" />\\n            </button>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-3 gap-3 text-sm\\\">\\n            <div>\\n              <p className=\\\"text-xs text-[#8E99A8]\\\">{isAr ? \'\330\247\331\204\331\205\331\203\330\252\331\205\331\204\330\251 \330\247\331\204\331\212\331\210\331\205\' : \'Completed\'}</p>\\n              <p className=\\\"text-xl font-bold font-mono-nums text-emerald-400 mt-1\\\">\\n                {metrics.completedToday}/{metrics.todayTasks.length}\\n              </p>\\n            </div>\\n            <div>\\n              <p className=\\\"text-xs text-[#8E99A8]\\\">{isAr ? \'\330\247\331\204\331\205\331\210\330\247\330\271\331\212\330\257 \330\247\331\204\331\212\331\210\331\205\' : \'Events\'}</p>\\n              <p className=\\\"text-xl font-bold font-mono-nums text-[#F4F6F8] mt-1\\\">{metrics.todayEvents.length}</p>\\n            </div>\\n            <div>\\n              <p className=\\\"text-xs text-[#8E99A8]\\\">{isAr ? \'\331\210\331\202\330\252 \330\247\331\204\330\252\330\261\331\203\331\212\330\262\' : \'Focus Time\'}</p>\\n              <p className=\\\"text-xl font-bold font-mono-nums text-[#F4F6F8] mt-1\\\">\\n                {metrics.focusMinutesToday} {isAr ? \'\330\257\' : \'m\'}\\n              </p>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"pt-3 border-t border-[#232A33] space-y-2\\\">\\n            {metrics.todayTasks.slice(0, 3).map((t) => (\\n              <div key={t.id} className=\\\"flex items-center justify-between text-xs py-1\\\">\\n                <span className={t.status === \'completed\' ? \'line-through text-[#6C7787]\' : \'text-[#E2E8F0]\'}>\\n                  {t.title}\\n                </span>\\n                <span className=\\\"font-mono-nums text-[#8E99A8] shrink-0 ms-3\\\">\\n                  {t.scheduledStart || \'\342\200\224\'} \302\267 {t.estimatedMinutes}{isAr ? \'\330\257\' : \'m\'}\\n                </span>\\n              </div>\\n            ))}\\n          </div>\\n        </div>\\n\\n        {/* Health Summary */}\\n        <div className=\\\"bg-[#13171C] border border-[#232A33] rounded-2xl p-6 space-y-4\\\">\\n          <div className=\\\"flex items-center justify-between\\\">\\n            <h2 className=\\\"text-base font-semibold text-[#F4F6F8] flex items-center gap-2\\\">\\n              <Activity className=\\\"w-4 h-4 text-emerald-400\\\" />\\n              {isAr ? \'\331\205\331\204\330\256\330\265 \330\247\331\204\330\265\330\255\330\251 \331\210\330\247\331\204\331\206\330\264\330\247\330\267\' : \'Health & Activity\'}\\n            </h2>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => onNavigate(\'health\')}\\n              className=\\\"text-xs text-emerald-400 hover:underline flex items-center gap-1\\\"\\n            >\\n              {isAr ? \'\330\263\330\254\331\204 \330\247\331\204\330\265\330\255\330\251\' : \'Open Health\'}\\n              <ArrowIcon className=\\\"w-3.5 h-3.5\\\" />\\n            </button>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-2 sm:grid-cols-4 gap-3\\\">\\n            <div>\\n              <p className=\\\"text-xs text-[#8E99A8]\\\">{isAr ? \'\330\247\331\204\331\206\331\210\331\205\' : \'Sleep\'}</p>\\n              <p className=\\\"text-lg font-bold font-mono-nums text-[#F4F6F8] mt-1\\\">\\n                {metrics.latestHealth?.sleepHours != null\\n                  ? `${metrics.latestHealth.sleepHours} ${isAr ? \'\330\263\' : \'h\'}`\\n                  : UI_TEXT[lang].common.unavailable}\\n              </p>\\n            </div>\\n            <div>\\n              <p className=\\\"text-xs text-[#8E99A8]\\\">{isAr ? \'\330\247\331\204\330\256\330\267\331\210\330\247\330\252\' : \'Steps\'}</p>\\n              <p className=\\\"text-lg font-bold font-mono-nums text-[#F4F6F8] mt-1\\\">\\n                {metrics.latestHealth?.steps != null\\n                  ? metrics.latestHealth.steps.toLocaleString(\'en-US\')\\n                  : UI_TEXT[lang].common.unavailable}\\n              </p>\\n            </div>\\n            <div>\\n              <p className=\\\"text-xs text-[#8E99A8]\\\">{isAr ? \'\330\263\330\271\330\261\330\247\330\252 \331\206\330\264\330\267\330\251\' : \'Active kcal\'}</p>\\n              <p className=\\\"text-lg font-bold font-mono-nums text-[#F4F6F8] mt-1\\\">\\n                {metrics.latestHealth?.activeCalories != null\\n                  ? `${metrics.latestHealth.activeCalories}`\\n                  : UI_TEXT[lang].common.unavailable}\\n              </p>\\n            </div>\\n            <div>\\n              <p className=\\\"text-xs text-[#8E99A8]\\\">{isAr ? \'\331\206\330\250\330\266 \330\247\331\204\330\261\330\247\330\255\330\251\' : \'Resting HR\'}</p>\\n              <p className=\\\"text-lg font-bold font-mono-nums text-[#F4F6F8] mt-1\\\">\\n                {metrics.latestHealth?.restingHeartRate != null\\n                  ? `${metrics.latestHealth.restingHeartRate} bpm`\\n                  : UI_TEXT[lang].common.unavailable}\\n              </p>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"pt-3 border-t border-[#232A33] flex items-center justify-between text-xs text-[#8E99A8]\\\">\\n            <span>\\n              {isAr ? \'\330\247\331\204\331\205\330\265\330\257\330\261:\' : \'Source:\'}{\' \'}\\n              {metrics.latestHealth?.source === \'manual\'\\n                ? isAr ? \'\330\245\330\257\330\256\330\247\331\204 \331\212\330\257\331\210\331\212\' : \'Manual log\'\\n                : metrics.latestHealth?.source || UI_TEXT[lang].common.unavailable}\\n            </span>\\n            <span className=\\\"font-mono-nums\\\">\\n              {isAr ? \'\331\207\330\257\331\201 \330\247\331\204\330\256\330\267\331\210\330\247\330\252:\' : \'Goal:\'}{\' \'}\\n              {metrics.latestHealth?.steps\\n                ? `${Math.min(100, Math.round((metrics.latestHealth.steps / data.profile.dailyStepTarget) * 100))}%`\\n                : \'0%\'}\\n            </span>\\n          </div>\\n        </div>\\n      </section>\\n\\n      {/* AI Daily Briefing Section */}\\n      <section className=\\\"bg-[#13171C] border border-[#232A33] rounded-2xl p-6 space-y-4\\\">\\n        <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\\\">\\n          <div>\\n            <h2 className=\\\"text-base font-semibold text-[#F4F6F8] flex items-center gap-2\\\">\\n              <Sparkles className=\\\"w-4 h-4 text-emerald-400\\\" />\\n              {isAr ? \'\330\247\331\204\331\205\331\204\330\256\330\265 \330\247\331\204\331\212\331\210\331\205\331\212 \330\247\331\204\330\260\331\203\331\212 (AI Daily Briefing)\' : \'AI Daily Briefing\'}\\n            </h2>\\n            <p className=\\\"text-xs text-[#8E99A8] mt-0.5\\\">\\n              {isAr\\n                ? \'\330\252\330\255\331\204\331\212\331\204 \331\205\330\256\330\252\330\265\330\261 \331\205\330\250\331\206\331\212 \331\201\331\202\330\267 \330\271\331\204\331\211 \330\243\330\261\331\202\330\247\331\205\331\203 \330\247\331\204\331\201\330\271\331\204\331\212\330\251 \330\271\330\250\330\261 Gemini Flash-Lite \342\200\224 \330\250\330\257\331\210\331\206 \330\250\331\212\330\247\331\206\330\247\330\252 \331\205\330\256\330\252\331\204\331\202\330\251.\'\\n                : \'Concise briefing grounded strictly in your recorded metrics via Gemini Flash-Lite.\'}\\n            </p>\\n          </div>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={handleGenerateBriefing}\\n            disabled={briefingLoading}\\n            className=\\\"min-h-[40px] px-4 py-2 rounded-xl bg-[#191F27] border border-[#2A3340] hover:border-emerald-500/60 text-xs font-semibold text-[#F4F6F8] transition-colors flex items-center gap-2 whitespace-nowrap self-start sm:self-auto\\\"\\n          >\\n            {briefingLoading ? <Loader2 className=\\\"w-3.5 h-3.5 animate-spin text-emerald-400\\\" /> : <RefreshCw className=\\\"w-3.5 h-3.5 text-emerald-400\\\" />}\\n            {briefing\\n              ? isAr ? \'\330\252\330\255\330\257\331\212\330\253 \330\247\331\204\331\205\331\204\330\256\330\265\' : \'Refresh Briefing\'\\n              : isAr ? \'\330\252\331\210\331\204\331\212\330\257 \331\205\331\204\330\256\330\265 \330\247\331\204\331\212\331\210\331\205\' : \'Generate Today\342\200\231s Briefing\'}\\n          </button>\\n        </div>\\n\\n        {briefingError ? (\\n          <div className=\\\"p-3.5 rounded-xl bg-red-500/10 border border-red-500/30 text-xs text-red-300\\\">\\n            {briefingError}\\n          </div>\\n        ) : null}\\n\\n        {briefing ? (\\n          <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-4 pt-2 border-t border-[#232A33] text-sm\\\">\\n            <div className=\\\"space-y-1\\\">\\n              <p className=\\\"text-xs font-semibold text-emerald-400\\\">{isAr ? \'\331\205\331\204\330\247\330\255\330\270\330\251 \331\205\330\247\331\204\331\212\330\251\' : \'Financial Observation\'}</p>\\n              <p className=\\\"text-[#D2DAE5] leading-relaxed\\\">{briefing.financialObservation}</p>\\n            </div>\\n            <div className=\\\"space-y-1\\\">\\n              <p className=\\\"text-xs font-semibold text-emerald-400\\\">{isAr ? \'\331\205\331\204\330\247\330\255\330\270\330\251 \330\247\331\204\330\245\331\206\330\252\330\247\330\254\331\212\330\251\' : \'Productivity Observation\'}</p>\\n              <p className=\\\"text-[#D2DAE5] leading-relaxed\\\">{briefing.productivityObservation}</p>\\n            </div>\\n            <div className=\\\"space-y-1\\\">\\n              <p className=\\\"text-xs font-semibold text-emerald-400\\\">{isAr ? \'\331\205\331\204\330\247\330\255\330\270\330\251 \330\247\331\204\330\265\330\255\330\251 \331\210\330\247\331\204\330\267\330\247\331\202\330\251\' : \'Health Observation\'}</p>\\n              <p className=\\\"text-[#D2DAE5] leading-relaxed\\\">{briefing.healthObservation}</p>\\n            </div>\\n            <div className=\\\"space-y-1\\\">\\n              <p className=\\\"text-xs font-semibold text-amber-400\\\">{isAr ? \'\330\252\330\260\331\203\331\212\330\261 \331\205\331\207\331\205\' : \'Important Reminder\'}</p>\\n              <p className=\\\"text-[#D2DAE5] leading-relaxed\\\">{briefing.importantReminder}</p>\\n            </div>\\n            {briefing.recommendations?.length > 0 ? (\\n              <div className=\\\"md:col-span-2 pt-3 border-t border-[#232A33] space-y-2\\\">\\n                <p className=\\\"text-xs font-semibold text-[#F4F6F8]\\\">{isAr ? \'\330\252\331\210\330\265\331\212\330\247\330\252 \330\271\331\205\331\204\331\212\330\251 \331\204\331\204\331\212\331\210\331\205\' : \'Practical Recommendations\'}</p>\\n                <ul className=\\\"space-y-1.5\\\">\\n                  {briefing.recommendations.map((rec, idx) => (\\n                    <li key={idx} className=\\\"flex items-start gap-2 text-xs sm:text-sm text-[#C8D0DC]\\\">\\n                      <CheckCircle2 className=\\\"w-4 h-4 text-emerald-400 shrink-0 mt-0.5\\\" />\\n                      <span>{rec}</span>\\n                    </li>\\n                  ))}\\n                </ul>\\n              </div>\\n            ) : null}\\n          </div>\\n        ) : (\\n          <div className=\\\"pt-3 border-t border-[#232A33] grid grid-cols-1 md:grid-cols-3 gap-4 text-xs text-[#A9B3C1]\\\">\\n            <div>\\n              <p className=\\\"font-semibold text-[#F4F6F8] mb-1\\\">{isAr ? \'\330\247\331\204\331\205\330\247\331\204\331\212\330\247\330\252\' : \'Finance\'}</p>\\n              <p>\\n                {isAr\\n                  ? `\331\205\330\271\330\257\331\204 \330\247\331\204\330\247\330\257\330\256\330\247\330\261 \330\247\331\204\330\264\331\207\330\261\331\212 \330\247\331\204\330\255\330\247\331\204\331\212 ${metrics.savingsRate}% \331\205\330\271 ${metrics.overdueInvoices.length} \331\201\330\247\330\252\331\210\330\261\330\251 \331\201\330\261\331\212\331\204\330\247\331\206\330\263 \331\205\330\252\330\243\330\256\330\261\330\251 \330\252\330\255\330\252\330\247\330\254 \331\205\330\252\330\247\330\250\330\271\330\251.`\\n                  : `Current monthly savings rate is ${metrics.savingsRate}% with ${metrics.overdueInvoices.length} overdue freelance invoice(s).`}\\n              </p>\\n            </div>\\n            <div>\\n              <p className=\\\"font-semibold text-[#F4F6F8] mb-1\\\">{isAr ? \'\330\247\331\204\330\245\331\206\330\252\330\247\330\254\331\212\330\251\' : \'Productivity\'}</p>\\n              <p>\\n                {isAr\\n                  ? `\331\205\330\252\330\250\331\202\331\212 ${metrics.remainingToday} \331\205\331\207\330\247\331\205 \330\247\331\204\331\212\331\210\331\205 \342\200\224 \330\247\330\263\330\252\330\272\331\204 \330\247\331\204\331\201\330\252\330\261\330\251 \330\247\331\204\330\265\330\250\330\247\330\255\331\212\330\251 \331\204\331\204\331\205\331\207\330\247\331\205 \330\247\331\204\330\271\331\205\331\212\331\202\330\251.`\\n                  : `${metrics.remainingToday} tasks remaining today \342\200\224 prioritize deep work during your morning peak.`}\\n              </p>\\n            </div>\\n            <div>\\n              <p className=\\\"font-semibold text-[#F4F6F8] mb-1\\\">{isAr ? \'\330\247\331\204\330\265\330\255\330\251\' : \'Health\'}</p>\\n              <p>\\n                {isAr\\n                  ? `\330\247\330\266\330\272\330\267 \\\"\330\252\331\210\331\204\331\212\330\257 \331\205\331\204\330\256\330\265 \330\247\331\204\331\212\331\210\331\205\\\" \331\204\331\204\330\255\330\265\331\210\331\204 \330\271\331\204\331\211 \331\202\330\261\330\247\330\241\330\251 \331\205\330\256\330\265\330\265\330\251 \331\205\331\206 Gemini \330\250\331\206\330\247\330\241\331\213 \330\271\331\204\331\211 \331\203\331\204 \330\250\331\212\330\247\331\206\330\247\330\252\331\203.`\\n                  : `Click \\\"Generate Today\'s Briefing\\\" for a live Gemini analysis grounded in your data.`}\\n              </p>\\n            </div>\\n          </div>\\n        )}\\n      </section>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create Module 01 Home Dashboard displaying unified Finance, Productivity, Health, Energy summaries and live Gemini AI Daily Briefing\", \"Overwrite\":true, \"TargetFile\":\"/src/components/HomeDashboard.tsx\", \"toolAction\":\"Creating HomeDashboard component\", \"toolSummary\":\"Create HomeDashboard\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_6024804069680065087"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useMemo, useState } from \'react\';\\nimport {\\n  Bar,\\n  BarChart,\\n  CartesianGrid,\\n  Cell,\\n  Pie,\\n  PieChart,\\n  ResponsiveContainer,\\n  Tooltip,\\n  XAxis,\\n  YAxis,\\n} from \'recharts\';\\nimport { Mic, Plus, Trash2 } from \'lucide-react\';\\nimport { useLifeOs } from \'../context/LifeOsContext\';\\nimport { CURRENT_MONTH, TODAY_ISO } from \'../data/seedData\';\\nimport {\\n  DEFAULT_EXPENSE_CATEGORIES,\\n  getCategoryLabel,\\n  INCOME_SOURCE_LABELS,\\n  INCOME_STATUS_LABELS,\\n  INVESTMENT_CATEGORY_LABELS,\\n  PAYMENT_METHOD_LABELS,\\n  SAVINGS_CATEGORY_LABELS,\\n} from \'../i18n/translations\';\\nimport {\\n  calculateAvailableCashPiasters,\\n  calculateBudgetProgress,\\n  calculateInvestmentMetrics,\\n  calculateNetWorthPiasters,\\n  calculatePendingReceivablesPiasters,\\n  calculateSavingsGoalProgress,\\n  calculateSavingsRatePercent,\\n  calculateTotalExpensesPiasters,\\n  calculateTotalPaidIncomePiasters,\\n  egpToPiasters,\\n  formatEgp,\\n  getPaidCashFromIncome,\\n  getUnpaidAmountFromIncome,\\n  piastersToEgp,\\n} from \'../utils/finance\';\\nimport { ConfirmDialog } from \'./ConfirmDialog\';\\nimport type {\\n  IncomeSource,\\n  IncomeStatus,\\n  InvestmentCategory,\\n  PaymentMethod,\\n  SavingsCategory,\\n} from \'../types/lifeos\';\\n\\ntype FinanceTab = \'overview\' | \'expenses\' | \'income\' | \'budgets\' | \'savings\' | \'investments\';\\n\\nconst CHART_COLORS = [\'#34D399\', \'#60A5FA\', \'#F59E0B\', \'#A78BFA\', \'#F472B6\', \'#38BDF8\', \'#94A3B8\'];\\n\\ninterface FinanceModuleProps {\\n  onOpenVoiceExpense: () => void;\\n}\\n\\nexport const FinanceModule: React.FC<FinanceModuleProps> = ({ onOpenVoiceExpense }) => {\\n  const {\\n    data,\\n    lang,\\n    addExpense,\\n    deleteExpense,\\n    addIncome,\\n    updateIncomeStatus,\\n    deleteIncome,\\n    upsertBudget,\\n    deleteBudget,\\n    addSavingsGoal,\\n    contributeSavingsGoal,\\n    deleteSavingsGoal,\\n    addInvestment,\\n    updateInvestmentValuation,\\n    deleteInvestment,\\n    addCustomCategory,\\n  } = useLifeOs();\\n\\n  const isAr = lang === \'ar\';\\n  const [tab, setTab] = useState<FinanceTab>(\'overview\');\\n  const [confirmDelete, setConfirmDelete] = useState<{ type: string; id: string; label: string } | null>(null);\\n\\n  // Expense form state\\n  const [expDesc, setExpDesc] = useState(\'\');\\n  const [expAmount, setExpAmount] = useState(\'\');\\n  const [expCategory, setExpCategory] = useState(\'food\');\\n  const [expDate, setExpDate] = useState(TODAY_ISO);\\n  const [expMethod, setExpMethod] = useState<PaymentMethod>(\'cash\');\\n  const [expRecurring, setExpRecurring] = useState(false);\\n  const [expFilterCat, setExpFilterCat] = useState(\'all\');\\n  const [expSearch, setExpSearch] = useState(\'\');\\n  const [newCustomCat, setNewCustomCat] = useState(\'\');\\n  const [expError, setExpError] = useState<string | null>(null);\\n\\n  // Income form state\\n  const [incTitle, setIncTitle] = useState(\'\');\\n  const [incAmount, setIncAmount] = useState(\'\');\\n  const [incPaidAmount, setIncPaidAmount] = useState(\'\');\\n  const [incSource, setIncSource] = useState<IncomeSource>(\'freelance\');\\n  const [incStatus, setIncStatus] = useState<IncomeStatus>(\'invoiced\');\\n  const [incDate, setIncDate] = useState(TODAY_ISO);\\n  const [incProject, setIncProject] = useState(\'\');\\n  const [incError, setIncError] = useState<string | null>(null);\\n\\n  // Budget form state\\n  const [budCat, setBudCat] = useState(\'food\');\\n  const [budLimit, setBudLimit] = useState(\'\');\\n\\n  // Savings form state\\n  const [savTitle, setSavTitle] = useState(\'\');\\n  const [savCat, setSavCat] = useState<SavingsCategory>(\'emergency\');\\n  const [savTarget, setSavTarget] = useState(\'\');\\n  const [savCurrent, setSavCurrent] = useState(\'0\');\\n  const [savDate, setSavDate] = useState(\'2027-06-01\');\\n\\n  // Investment form state\\n  const [invName, setInvName] = useState(\'\');\\n  const [invCat, setInvCat] = useState<InvestmentCategory>(\'gold\');\\n  const [invQty, setInvQty] = useState(\'\');\\n  const [invBuyPrice, setInvBuyPrice] = useState(\'\');\\n  const [invCurPrice, setInvCurPrice] = useState(\'\');\\n  const [invFees, setInvFees] = useState(\'0\');\\n\\n  const allCategories = [...DEFAULT_EXPENSE_CATEGORIES, ...(data.profile.customCategories || [])];\\n\\n  const stats = useMemo(() => {\\n    const availableCash = calculateAvailableCashPiasters(data.incomeRecords, data.expenseRecords);\\n    const paidIncome = calculateTotalPaidIncomePiasters(data.incomeRecords, CURRENT_MONTH);\\n    const monthExpenses = calculateTotalExpensesPiasters(data.expenseRecords, CURRENT_MONTH);\\n    const pendingReceivables = calculatePendingReceivablesPiasters(data.incomeRecords);\\n    const savingsRate = calculateSavingsRatePercent(paidIncome, monthExpenses);\\n    const netWorth = calculateNetWorthPiasters({\\n      availableCashPiasters: availableCash,\\n      savingsGoals: data.savingsGoals,\\n      investments: data.investments,\\n      liabilitiesPiasters: data.profile.liabilitiesPiasters,\\n    });\\n\\n    // Category spending breakdown\\n    const catMap = new Map<string, number>();\\n    data.expenseRecords\\n      .filter((e) => e.date.startsWith(CURRENT_MONTH))\\n      .forEach((e) => {\\n        catMap.set(e.category, (catMap.get(e.category) || 0) + e.amountPiasters);\\n      });\\n    const categoryChartData = Array.from(catMap.entries())\\n      .map(([cat, piasters]) => ({\\n        key: cat,\\n        name: getCategoryLabel(cat, lang),\\n        egp: Math.round(piastersToEgp(piasters)),\\n      }))\\n      .sort((a, b) => b.egp - a.egp);\\n\\n    // Salary vs Freelance paid breakdown\\n    const salaryPaid = data.incomeRecords\\n      .filter((i) => i.source === \'fixed_salary\')\\n      .reduce((s, r) => s + getPaidCashFromIncome(r), 0);\\n    const freelancePaid = data.incomeRecords\\n      .filter((i) => i.source === \'freelance\')\\n      .reduce((s, r) => s + getPaidCashFromIncome(r), 0);\\n    const freelancePending = data.incomeRecords\\n      .filter((i) => i.source === \'freelance\')\\n      .reduce((s, r) => s + getUnpaidAmountFromIncome(r), 0);\\n\\n    const cashFlowChartData = [\\n      { name: isAr ? \'\330\247\331\204\331\205\330\261\330\252\330\250 (\331\205\330\255\330\265\331\221\331\204)\' : \'Salary (Paid)\', value: Math.round(piastersToEgp(salaryPaid)) },\\n      { name: isAr ? \'\331\201\330\261\331\212\331\204\330\247\331\206\330\263 (\331\205\330\255\330\265\331\221\331\204)\' : \'Freelance (Paid)\', value: Math.round(piastersToEgp(freelancePaid)) },\\n      { name: isAr ? \'\330\247\331\204\331\205\330\265\330\247\330\261\331\212\331\201\' : \'Expenses\', value: Math.round(piastersToEgp(monthExpenses)) },\\n      { name: isAr ? \'\331\201\330\261\331\212\331\204\330\247\331\206\330\263 \331\205\330\271\331\204\331\202\' : \'Unpaid Freelance\', value: Math.round(piastersToEgp(freelancePending)) },\\n    ];\\n\\n    return {\\n      availableCash,\\n      paidIncome,\\n      monthExpenses,\\n      pendingReceivables,\\n      savingsRate,\\n      netWorth,\\n      categoryChartData,\\n      cashFlowChartData,\\n    };\\n  }, [data, lang, isAr]);\\n\\n  const filteredExpenses = useMemo(() => {\\n    return data.expenseRecords\\n      .filter((e) => (expFilterCat === \'all\' ? true : e.category === expFilterCat))\\n      .filter((e) =>\\n        expSearch.trim()\\n          ? e.description.toLowerCase().includes(expSearch.trim().toLowerCase()) ||\\n            getCategoryLabel(e.category, lang).toLowerCase().includes(expSearch.trim().toLowerCase())\\n          : true,\\n      )\\n      .sort((a, b) => b.date.localeCompare(a.date));\\n  }, [data.expenseRecords, expFilterCat, expSearch, lang]);\\n\\n  const handleAddExpense = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    const numericAmount = Number(expAmount);\\n    if (!expDesc.trim() || !Number.isFinite(numericAmount) || numericAmount <= 0) {\\n      setExpError(isAr ? \'\330\243\330\257\330\256\331\204 \331\210\330\265\331\201\330\247\331\213 \331\210\331\205\330\250\331\204\330\272\330\247\331\213 \330\265\330\255\331\212\330\255\330\247\331\213 \330\243\331\203\330\250\330\261 \331\205\331\206 \330\265\331\201\330\261.\' : \'Enter a valid description and positive EGP amount.\');\\n      return;\\n    }\\n    setExpError(null);\\n    await addExpense({\\n      description: expDesc.trim(),\\n      amountPiasters: egpToPiasters(numericAmount),\\n      currency: \'EGP\',\\n      category: expCategory,\\n      date: expDate,\\n      paymentMethod: expMethod,\\n      entrySource: \'manual\',\\n      recurring: expRecurring,\\n    });\\n    setExpDesc(\'\');\\n    setExpAmount(\'\');\\n    setExpRecurring(false);\\n  };\\n\\n  const handleAddIncome = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    const amount = Number(incAmount);\\n    if (!incTitle.trim() || !Number.isFinite(amount) || amount <= 0) {\\n      setIncError(isAr ? \'\330\243\330\257\330\256\331\204 \330\271\331\206\331\210\330\247\331\206 \330\247\331\204\330\257\330\256\331\204 \331\210\331\205\330\250\331\204\330\272\330\247\331\213 \330\265\330\255\331\212\330\255\330\247\331\213.\' : \'Enter a valid title and positive EGP amount.\');\\n      return;\\n    }\\n    setIncError(null);\\n    const paid = incStatus === \'fully_paid\' ? amount : incStatus === \'partially_paid\' ? Number(incPaidAmount || 0) : 0;\\n    await addIncome({\\n      title: incTitle.trim(),\\n      amountPiasters: egpToPiasters(amount),\\n      paidAmountPiasters: egpToPiasters(Math.min(amount, Math.max(0, paid))),\\n      currency: \'EGP\',\\n      source: incSource,\\n      status: incStatus,\\n      dateReceived: incStatus === \'fully_paid\' || incStatus === \'partially_paid\' ? TODAY_ISO : undefined,\\n      expectedPaymentDate: incDate,\\n      projectName: incProject.trim() || undefined,\\n    });\\n    setIncTitle(\'\');\\n    setIncAmount(\'\');\\n    setIncPaidAmount(\'\');\\n    setIncProject(\'\');\\n  };\\n\\n  const handleAddBudget = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    const limit = Number(budLimit);\\n    if (!Number.isFinite(limit) || limit <= 0) return;\\n    const existing = data.budgets.find((b) => b.category === budCat && b.monthKey === CURRENT_MONTH);\\n    await upsertBudget({\\n      id: existing?.id,\\n      category: budCat,\\n      monthKey: CURRENT_MONTH,\\n      limitPiasters: egpToPiasters(limit),\\n    });\\n    setBudLimit(\'\');\\n  };\\n\\n  const handleAddSavings = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    const target = Number(savTarget);\\n    const current = Number(savCurrent || 0);\\n    if (!savTitle.trim() || !Number.isFinite(target) || target <= 0) return;\\n    await addSavingsGoal({\\n      title: savTitle.trim(),\\n      category: savCat,\\n      targetPiasters: egpToPiasters(target),\\n      currentPiasters: egpToPiasters(Math.max(0, current)),\\n      targetDate: savDate,\\n    });\\n    setSavTitle(\'\');\\n    setSavTarget(\'\');\\n    setSavCurrent(\'0\');\\n  };\\n\\n  const handleAddInvestment = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    const qty = Number(invQty);\\n    const buy = Number(invBuyPrice);\\n    const cur = Number(invCurPrice);\\n    const fees = Number(invFees || 0);\\n    if (!invName.trim() || qty <= 0 || buy <= 0 || cur <= 0) return;\\n    await addInvestment({\\n      name: invName.trim(),\\n      category: invCat,\\n      quantity: qty,\\n      purchasePricePiasters: egpToPiasters(buy),\\n      currentValuationPiasters: egpToPiasters(cur),\\n      feesPiasters: egpToPiasters(Math.max(0, fees)),\\n      realizedPnlPiasters: 0,\\n      purchaseDate: TODAY_ISO,\\n      valuationSource: \'manual\',\\n    });\\n    setInvName(\'\');\\n    setInvQty(\'\');\\n    setInvBuyPrice(\'\');\\n    setInvCurPrice(\'\');\\n    setInvFees(\'0\');\\n  };\\n\\n  const executeConfirmedDelete = async () => {\\n    if (!confirmDelete) return;\\n    if (confirmDelete.type === \'expense\') await deleteExpense(confirmDelete.id);\\n    if (confirmDelete.type === \'income\') await deleteIncome(confirmDelete.id);\\n    if (confirmDelete.type === \'budget\') await deleteBudget(confirmDelete.id);\\n    if (confirmDelete.type === \'savings\') await deleteSavingsGoal(confirmDelete.id);\\n    if (confirmDelete.type === \'investment\') await deleteInvestment(confirmDelete.id);\\n    setConfirmDelete(null);\\n  };\\n\\n  const tabs: Array<{ id: FinanceTab; label: string }> = [\\n    { id: \'overview\', label: isAr ? \'\331\206\330\270\330\261\330\251 \330\271\330\247\331\205\330\251 \331\210\330\252\330\255\331\204\331\212\331\204\330\247\330\252\' : \'Overview\' },\\n    { id: \'expenses\', label: isAr ? \'\330\247\331\204\331\205\330\265\330\247\330\261\331\212\331\201\' : \'Expenses\' },\\n    { id: \'income\', label: isAr ? \'\330\247\331\204\330\257\330\256\331\204 \331\210\330\247\331\204\331\201\330\261\331\212\331\204\330\247\331\206\330\263\' : \'Income\' },\\n    { id: \'budgets\', label: isAr ? \'\330\247\331\204\331\205\331\212\330\262\330\247\331\206\331\212\330\247\330\252\' : \'Budgets\' },\\n    { id: \'savings\', label: isAr ? \'\330\247\331\204\330\247\330\257\330\256\330\247\330\261\' : \'Savings\' },\\n    { id: \'investments\', label: isAr ? \'\330\247\331\204\330\247\330\263\330\252\330\253\331\205\330\247\330\261\330\247\330\252\' : \'Investments\' },\\n  ];\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\\\">\\n        <div>\\n          <h1 className=\\\"text-2xl font-bold text-[#F4F6F8]\\\">{isAr ? \'\330\247\331\204\330\260\331\203\330\247\330\241 \330\247\331\204\331\205\330\247\331\204\331\212\' : \'Finance Intelligence\'}</h1>\\n          <p className=\\\"text-xs text-[#8E99A8] mt-1\\\">\\n            {isAr\\n              ? \'\330\255\330\263\330\247\330\250\330\247\330\252 \330\257\331\202\331\212\331\202\330\251 \330\250\330\247\331\204\331\202\330\261\331\210\330\264 (EGP) \342\200\224 \331\204\330\247 \331\212\331\217\330\255\330\263\330\250 \330\247\331\204\331\201\330\261\331\212\331\204\330\247\331\206\330\263 \330\272\331\212\330\261 \330\247\331\204\331\205\330\257\331\201\331\210\330\271 \330\266\331\205\331\206 \330\247\331\204\330\261\330\265\331\212\330\257 \330\247\331\204\331\205\330\252\330\247\330\255.\'\\n              : \'Exact minor-unit EGP tracking \342\200\224 unpaid freelance invoices never inflate cash balance.\'}\\n          </p>\\n        </div>\\n\\n        <button\\n          type=\\\"button\\\"\\n          onClick={onOpenVoiceExpense}\\n          className=\\\"min-h-[44px] px-4 py-2 rounded-xl bg-emerald-500 text-[#07110C] font-semibold text-sm hover:bg-emerald-400 transition-colors flex items-center gap-2 whitespace-nowrap self-start sm:self-auto\\\"\\n        >\\n          <Mic className=\\\"w-4 h-4\\\" />\\n          {isAr ? \'\331\205\330\265\330\261\331\210\331\201 \330\250\330\247\331\204\330\265\331\210\330\252\' : \'Voice Expense\'}\\n        </button>\\n      </div>\\n\\n      {/* Sub-navigation segmented bar */}\\n      <div className=\\\"flex items-center gap-1.5 overflow-x-auto pb-1\\\">\\n        {tabs.map((item) => (\\n          <button\\n            key={item.id}\\n            type=\\\"button\\\"\\n            onClick={() => setTab(item.id)}\\n            className={`min-h-[40px] px-3.5 py-2 rounded-xl text-xs font-semibold transition-colors whitespace-nowrap shrink-0 ${\\n              tab === item.id\\n                ? \'bg-emerald-500 text-[#07110C]\'\\n                : \'bg-[#13171C] border border-[#232A33] text-[#A9B3C1] hover:text-[#F4F6F8]\'\\n            }`}\\n          >\\n            {item.label}\\n          </button>\\n        ))}\\n      </div>\\n\\n      {/* Top Financial KPI Row */}\\n      <div className=\\\"grid grid-cols-2 lg:grid-cols-4 gap-4\\\">\\n        <div className=\\\"bg-[#13171C] border border-[#232A33] rounded-2xl p-4\\\">\\n          <p className=\\\"text-xs text-[#8E99A8]\\\">{isAr ? \'\330\247\331\204\330\261\330\265\331\212\330\257 \330\247\331\204\331\206\331\202\330\257\331\212 \330\247\331\204\331\205\330\252\330\247\330\255\' : \'Available Cash\'}</p>\\n          <p className=\\\"text-xl font-bold font-mono-nums text-emerald-400 mt-1\\\" data-testid=\\\"finance-available-cash\\\">\\n            {formatEgp(stats.availableCash, lang)}\\n          </p>\\n        </div>\\n        <div className=\\\"bg-[#13171C] border border-[#232A33] rounded-2xl p-4\\\">\\n          <p className=\\\"text-xs text-[#8E99A8]\\\">{isAr ? \'\330\265\330\247\331\201\331\212 \330\247\331\204\330\253\330\261\331\210\330\251 (\330\243\330\265\331\210\331\204 - \330\247\331\204\330\252\330\262\330\247\331\205\330\247\330\252)\' : \'Net Worth\'}</p>\\n          <p className=\\\"text-xl font-bold font-mono-nums text-[#F4F6F8] mt-1\\\">\\n            {formatEgp(stats.netWorth.netWorthPiasters, lang)}\\n          </p>\\n        </div>\\n        <div className=\\\"bg-[#13171C] border border-[#232A33] rounded-2xl p-4\\\">\\n          <p className=\\\"text-xs text-[#8E99A8]\\\">{isAr ? \'\331\205\330\265\330\247\330\261\331\212\331\201 \331\207\330\260\330\247 \330\247\331\204\330\264\331\207\330\261\' : \'Month Expenses\'}</p>\\n          <p className=\\\"text-xl font-bold font-mono-nums text-[#F4F6F8] mt-1\\\" data-testid=\\\"finance-month-expenses\\\">\\n            {formatEgp(stats.monthExpenses, lang)}\\n          </p>\\n        </div>\\n        <div className=\\\"bg-[#13171C] border border-[#232A33] rounded-2xl p-4\\\">\\n          <p className=\\\"text-xs text-[#8E99A8]\\\">{isAr ? \'\331\205\330\263\330\252\330\255\331\202\330\247\330\252 \330\272\331\212\330\261 \331\205\330\255\330\265\331\221\331\204\330\251\' : \'Pending Receivables\'}</p>\\n          <p className=\\\"text-xl font-bold font-mono-nums text-amber-400 mt-1\\\" data-testid=\\\"finance-pending-receivables\\\">\\n            {formatEgp(stats.pendingReceivables, lang)}\\n          </p>\\n        </div>\\n      </div>\\n\\n      {/* TAB 1: OVERVIEW & ANALYTICS */}\\n      {tab === \'overview\' ? (\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-2 gap-5\\\">\\n          <div className=\\\"bg-[#13171C] border border-[#232A33] rounded-2xl p-5 space-y-4\\\">\\n            <div className=\\\"flex items-center justify-between\\\">\\n              <h2 className=\\\"text-sm font-semibold text-[#F4F6F8]\\\">\\n                {isAr ? \'\330\247\331\204\330\252\330\257\331\201\331\202 \330\247\331\204\331\206\331\202\330\257\331\212: \330\247\331\204\331\205\330\261\330\252\330\250 \331\205\331\202\330\247\330\250\331\204 \330\247\331\204\331\201\330\261\331\212\331\204\330\247\331\206\330\263 \331\210\330\247\331\204\331\205\330\265\330\247\330\261\331\212\331\201 (\330\254.\331\205)\' : \'Cash Flow: Salary vs Freelance & Expenses (EGP)\'}\\n              </h2>\\n              <span className=\\\"text-xs text-[#8E99A8] font-mono-nums\\\">\\n                {isAr ? \'\331\205\330\271\330\257\331\204 \330\247\331\204\330\247\330\257\330\256\330\247\330\261:\' : \'Savings Rate:\'} {stats.savingsRate}%\\n              </span>\\n            </div>\\n            <div className=\\\"h-64 w-full\\\" dir=\\\"ltr\\\">\\n              <ResponsiveContainer width=\\\"100%\\\" height=\\\"100%\\\">\\n                <BarChart data={stats.cashFlowChartData} margin={{ top: 8, right: 8, left: 0, bottom: 8 }}>\\n                  <CartesianGrid stroke=\\\"#232A33\\\" strokeDasharray=\\\"3 3\\\" vertical={false} />\\n                  <XAxis dataKey=\\\"name\\\" tick={{ fill: \'#8E99A8\', fontSize: 11 }} axisLine={false} tickLine={false} />\\n                  <YAxis tick={{ fill: \'#8E99A8\', fontSize: 11 }} axisLine={false} tickLine={false} />\\n                  <Tooltip\\n                    contentStyle={{ backgroundColor: \'#0B0D10\', border: \'1px solid #232A33\', borderRadius: 12, color: \'#F4F6F8\', fontSize: 12 }}\\n                  />\\n                  <Bar dataKey=\\\"value\\\" radius={[8, 8, 0, 0]}>\\n                    {stats.cashFlowChartData.map((_, i) => (\\n                      <Cell key={i} fill={i === 2 ? \'#EF4444\' : i === 3 ? \'#F59E0B\' : \'#34D399\'} />\\n                    ))}\\n                  </Bar>\\n                </BarChart>\\n              </ResponsiveContainer>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"bg-[#13171C] border border-[#232A33] rounded-2xl p-5 space-y-4\\\">\\n            <h2 className=\\\"text-sm font-semibold text-[#F4F6F8]\\\">\\n              {isAr ? \'\330\252\331\210\330\262\331\212\330\271 \330\247\331\204\331\205\330\265\330\247\330\261\331\212\331\201 \330\255\330\263\330\250 \330\247\331\204\330\252\330\265\331\206\331\212\331\201 (\330\254.\331\205)\' : \'Spending by Category (EGP)\'}\\n            </h2>\\n            <div className=\\\"h-64 w-full grid grid-cols-1 sm:grid-cols-2 items-center gap-3\\\">\\n              <div className=\\\"h-52 w-full\\\" dir=\\\"ltr\\\">\\n                <ResponsiveContainer width=\\\"100%\\\" height=\\\"100%\\\">\\n                  <PieChart>\\n                    <Pie\\n                      data={stats.categoryChartData}\\n                      dataKey=\\\"egp\\\"\\n                      nameKey=\\\"name\\\"\\n                      cx=\\\"50%\\\"\\n                      cy=\\\"50%\\\"\\n                      innerRadius={48}\\n                      outerRadius={78}\\n                      paddingAngle={2}\\n                    >\\n                      {stats.categoryChartData.map((_, i) => (\\n                        <Cell key={i} fill={CHART_COLORS[i % CHART_COLORS.length]} />\\n                      ))}\\n                    </Pie>\\n                    <Tooltip\\n                      contentStyle={{ backgroundColor: \'#0B0D10\', border: \'1px solid #232A33\', borderRadius: 12, color: \'#F4F6F8\', fontSize: 12 }}\\n                    />\\n                  </PieChart>\\n                </ResponsiveContainer>\\n              </div>\\n              <div className=\\\"space-y-2 max-h-56 overflow-y-auto\\\">\\n                {stats.categoryChartData.map((row, idx) => (\\n                  <div key={row.key} className=\\\"flex items-center justify-between text-xs py-1 border-b border-[#1D232C]\\\">\\n                    <span className=\\\"flex items-center gap-2 text-[#D2DAE5]\\\">\\n                      <span\\n                        className=\\\"w-2.5 h-2.5 rounded-sm shrink-0\\\"\\n                        style={{ backgroundColor: CHART_COLORS[idx % CHART_COLORS.length] }}\\n                      />\\n                      {row.name}\\n                    </span>\\n                    <span className=\\\"font-mono-nums text-[#F4F6F8]\\\">{row.egp.toLocaleString(\'en-US\')} {isAr ? \'\330\254.\331\205\' : \'EGP\'}</span>\\n                  </div>\\n                ))}\\n              </div>\\n            </div>\\n          </div>\\n\\n          {/* Net Worth Formula Breakdown */}\\n          <div className=\\\"lg:col-span-2 bg-[#13171C] border border-[#232A33] rounded-2xl p-5\\\">\\n            <h2 className=\\\"text-sm font-semibold text-[#F4F6F8] mb-4\\\">\\n              {isAr ? \'\330\252\331\201\330\265\331\212\331\204 \330\265\330\247\331\201\331\212 \330\247\331\204\330\253\330\261\331\210\330\251 (\330\245\330\254\331\205\330\247\331\204\331\212 \330\247\331\204\330\243\330\265\331\210\331\204 \342\210\222 \330\245\330\254\331\205\330\247\331\204\331\212 \330\247\331\204\330\247\331\204\330\252\330\262\330\247\331\205\330\247\330\252)\' : \'Net Worth Breakdown (Total Assets \342\210\222 Total Liabilities)\'}\\n            </h2>\\n            <div className=\\\"grid grid-cols-2 sm:grid-cols-5 gap-4 text-xs\\\">\\n              <div>\\n                <p className=\\\"text-[#8E99A8]\\\">{isAr ? \'\330\247\331\204\331\206\331\202\330\257 \330\247\331\204\331\205\330\252\330\247\330\255\' : \'Available Cash\'}</p>\\n                <p className=\\\"text-sm font-semibold font-mono-nums text-[#F4F6F8] mt-1\\\">{formatEgp(stats.availableCash, lang)}</p>\\n              </div>\\n              <div>\\n                <p className=\\\"text-[#8E99A8]\\\">{isAr ? \'\330\243\330\261\330\265\330\257\330\251 \330\247\331\204\330\247\330\257\330\256\330\247\330\261\' : \'Savings Buckets\'}</p>\\n                <p className=\\\"text-sm font-semibold font-mono-nums text-[#F4F6F8] mt-1\\\">{formatEgp(stats.netWorth.savingsTotalPiasters, lang)}</p>\\n              </div>\\n              <div>\\n                <p className=\\\"text-[#8E99A8]\\\">{isAr ? \'\330\247\331\204\330\247\330\263\330\252\330\253\331\205\330\247\330\261\330\247\330\252 (\330\252\331\202\331\212\331\212\331\205 \331\212\330\257\331\210\331\212)\' : \'Investments (Manual)\'}</p>\\n                <p className=\\\"text-sm font-semibold font-mono-nums text-[#F4F6F8] mt-1\\\">{formatEgp(stats.netWorth.investmentsValuePiasters, lang)}</p>\\n              </div>\\n              <div>\\n                <p className=\\\"text-[#8E99A8]\\\">{isAr ? \'\330\247\331\204\330\247\331\204\330\252\330\262\330\247\331\205\330\247\330\252 \331\210\330\247\331\204\330\257\331\212\331\210\331\206\' : \'Liabilities\'}</p>\\n                <p className=\\\"text-sm font-semibold font-mono-nums text-red-400 mt-1\\\">-{formatEgp(stats.netWorth.totalLiabilitiesPiasters, lang)}</p>\\n              </div>\\n              <div>\\n                <p className=\\\"text-[#8E99A8]\\\">{isAr ? \'\330\265\330\247\331\201\331\212 \330\247\331\204\330\253\330\261\331\210\330\251\' : \'Net Worth\'}</p>\\n                <p className=\\\"text-sm font-bold font-mono-nums text-emerald-400 mt-1\\\">{formatEgp(stats.netWorth.netWorthPiasters, lang)}</p>\\n              </div>\\n            </div>\\n          </div>\\n        </div>\\n      ) : null}\\n\\n      {/* TAB 2: EXPENSES */}\\n      {tab === \'expenses\' ? (\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-5\\\">\\n          <form onSubmit={handleAddExpense} className=\\\"lg:col-span-5 bg-[#13171C] border border-[#232A33] rounded-2xl p-5 space-y-4 self-start\\\">\\n            <h2 className=\\\"text-sm font-semibold text-[#F4F6F8]\\\">{isAr ? \'\330\245\330\266\330\247\331\201\330\251 \331\205\330\265\330\261\331\210\331\201 \330\254\330\257\331\212\330\257\' : \'Add Expense\'}</h2>\\n            {expError ? <p className=\\\"text-xs text-red-400\\\">{expError}</p> : null}\\n\\n            <div>\\n              <label htmlFor=\\\"exp-desc\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">\\n                {isAr ? \'\330\247\331\204\331\210\330\265\331\201\' : \'Description\'}\\n              </label>\\n              <input\\n                id=\\\"exp-desc\\\"\\n                type=\\\"text\\\"\\n                value={expDesc}\\n                onChange={(e) => setExpDesc(e.target.value)}\\n                placeholder={isAr ? \'\331\205\330\253\330\247\331\204: \330\272\330\257\330\247\330\241 \331\205\330\271 \330\247\331\204\330\243\330\265\330\257\331\202\330\247\330\241\' : \'e.g., Lunch with friends\'}\\n                className=\\\"w-full min-h-[44px] px-3.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8] focus:outline-none focus:border-emerald-500\\\"\\n              />\\n            </div>\\n\\n            <div className=\\\"grid grid-cols-2 gap-3\\\">\\n              <div>\\n                <label htmlFor=\\\"exp-amount\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">\\n                  {isAr ? \'\330\247\331\204\331\205\330\250\331\204\330\272 (\330\254.\331\205)\' : \'Amount (EGP)\'}\\n                </label>\\n                <input\\n                  id=\\\"exp-amount\\\"\\n                  type=\\\"number\\\"\\n                  step=\\\"0.01\\\"\\n                  value={expAmount}\\n                  onChange={(e) => setExpAmount(e.target.value)}\\n                  placeholder=\\\"250\\\"\\n                  className=\\\"w-full min-h-[44px] px-3.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8] focus:outline-none focus:border-emerald-500\\\"\\n                />\\n              </div>\\n              <div>\\n                <label htmlFor=\\\"exp-date\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">\\n                  {isAr ? \'\330\247\331\204\330\252\330\247\330\261\331\212\330\256\' : \'Date\'}\\n                </label>\\n                <input\\n                  id=\\\"exp-date\\\"\\n                  type=\\\"date\\\"\\n                  value={expDate}\\n                  onChange={(e) => setExpDate(e.target.value)}\\n                  className=\\\"w-full min-h-[44px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\\\"\\n                />\\n              </div>\\n            </div>\\n\\n            <div className=\\\"grid grid-cols-2 gap-3\\\">\\n              <div>\\n                <label htmlFor=\\\"exp-cat\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">\\n                  {isAr ? \'\330\247\331\204\330\252\330\265\331\206\331\212\331\201\' : \'Category\'}\\n                </label>\\n                <select\\n                  id=\\\"exp-cat\\\"\\n                  value={expCategory}\\n                  onChange={(e) => setExpCategory(e.target.value)}\\n                  className=\\\"w-full min-h-[44px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\\\"\\n                >\\n                  {allCategories.map((c) => (\\n                    <option key={c} value={c}>\\n                      {getCategoryLabel(c, lang)}\\n                    </option>\\n                  ))}\\n                </select>\\n              </div>\\n              <div>\\n                <label htmlFor=\\\"exp-method\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">\\n                  {isAr ? \'\330\267\330\261\331\212\331\202\330\251 \330\247\331\204\330\257\331\201\330\271\' : \'Payment Method\'}\\n                </label>\\n                <select\\n                  id=\\\"exp-method\\\"\\n                  value={expMethod}\\n                  onChange={(e) => setExpMethod(e.target.value as PaymentMethod)}\\n                  className=\\\"w-full min-h-[44px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\\\"\\n                >\\n                  {(Object.keys(PAYMENT_METHOD_LABELS) as PaymentMethod[]).map((m) => (\\n                    <option key={m} value={m}>\\n                      {PAYMENT_METHOD_LABELS[m][lang]}\\n                    </option>\\n                  ))}\\n                </select>\\n              </div>\\n            </div>\\n\\n            <label className=\\\"flex items-center gap-2 text-xs text-[#A9B3C1] cursor-pointer\\\">\\n              <input\\n                type=\\\"checkbox\\\"\\n                checked={expRecurring}\\n                onChange={(e) => setExpRecurring(e.target.checked)}\\n                className=\\\"rounded border-[#232A33] bg-[#0B0D10]\\\"\\n              />\\n              {isAr ? \'\331\205\330\265\330\261\331\210\331\201 \330\264\331\207\330\261\331\212 \331\205\330\252\331\203\330\261\330\261\' : \'Recurring monthly expense\'}\\n            </label>\\n\\n            <button\\n              type=\\\"submit\\\"\\n              className=\\\"w-full min-h-[44px] rounded-xl bg-emerald-500 text-[#07110C] font-semibold text-sm hover:bg-emerald-400 transition-colors flex items-center justify-center gap-2\\\"\\n            >\\n              <Plus className=\\\"w-4 h-4\\\" />\\n              {isAr ? \'\330\255\331\201\330\270 \330\247\331\204\331\205\330\265\330\261\331\210\331\201\' : \'Save Expense\'}\\n            </button>\\n\\n            <div className=\\\"pt-3 border-t border-[#232A33] flex gap-2\\\">\\n              <input\\n                type=\\\"text\\\"\\n                value={newCustomCat}\\n                onChange={(e) => setNewCustomCat(e.target.value)}\\n                placeholder={isAr ? \'\330\243\330\266\331\201 \330\252\330\265\331\206\331\212\331\201 \331\205\330\256\330\265\330\265...\' : \'Add custom category...\'}\\n                aria-label={isAr ? \'\330\252\330\265\331\206\331\212\331\201 \331\205\330\256\330\265\330\265 \330\254\330\257\331\212\330\257\' : \'New custom category\'}\\n                className=\\\"flex-1 min-h-[38px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-xs text-[#F4F6F8]\\\"\\n              />\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => {\\n                  if (newCustomCat.trim()) {\\n                    void addCustomCategory(newCustomCat);\\n                    setExpCategory(newCustomCat.trim());\\n                    setNewCustomCat(\'\');\\n                  }\\n                }}\\n                className=\\\"min-h-[38px] px-3 rounded-xl bg-[#191F27] border border-[#232A33] text-xs font-medium text-[#E2E8F0] hover:border-emerald-500/50 whitespace-nowrap\\\"\\n              >\\n                {isAr ? \'\330\245\330\266\330\247\331\201\330\251 \330\252\330\265\331\206\331\212\331\201\' : \'Add\'}\\n              </button>\\n            </div>\\n          </form>\\n\\n          <div className=\\\"lg:col-span-7 bg-[#13171C] border border-[#232A33] rounded-2xl p-5 space-y-4\\\">\\n            <div className=\\\"flex flex-col sm:flex-row gap-2.5 justify-between\\\">\\n              <input\\n                type=\\\"search\\\"\\n                value={expSearch}\\n                onChange={(e) => setExpSearch(e.target.value)}\\n                placeholder={isAr ? \'\330\247\330\250\330\255\330\253 \331\201\331\212 \330\247\331\204\331\205\330\265\330\247\330\261\331\212\331\201...\' : \'Search expenses...\'}\\n                aria-label={isAr ? \'\330\250\330\255\330\253 \330\247\331\204\331\205\330\265\330\247\330\261\331\212\331\201\' : \'Search expenses\'}\\n                className=\\\"flex-1 min-h-[40px] px-3.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-xs text-[#F4F6F8]\\\"\\n              />\\n              <select\\n                value={expFilterCat}\\n                onChange={(e) => setExpFilterCat(e.target.value)}\\n                aria-label={isAr ? \'\330\252\330\265\331\201\331\212\330\251 \330\255\330\263\330\250 \330\247\331\204\330\252\330\265\331\206\331\212\331\201\' : \'Filter by category\'}\\n                className=\\\"min-h-[40px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-xs text-[#F4F6F8]\\\"\\n              >\\n                <option value=\\\"all\\\">{isAr ? \'\331\203\331\204 \330\247\331\204\330\252\330\265\331\206\331\212\331\201\330\247\330\252\' : \'All categories\'}</option>\\n                {allCategories.map((c) => (\\n                  <option key={c} value={c}>\\n                    {getCategoryLabel(c, lang)}\\n                  </option>\\n                ))}\\n              </select>\\n            </div>\\n\\n            <div className=\\\"divide-y divide-[#1D232C]\\\">\\n              {filteredExpenses.map((exp) => (\\n                <div key={exp.id} className=\\\"py-3 flex items-center justify-between gap-3\\\">\\n                  <div className=\\\"min-w-0\\\">\\n                    <p className=\\\"text-sm font-medium text-[#F4F6F8] truncate\\\">{exp.description}</p>\\n                    <p className=\\\"text-xs text-[#8E99A8] mt-0.5\\\">\\n                      {getCategoryLabel(exp.category, lang)} \302\267 {PAYMENT_METHOD_LABELS[exp.paymentMethod][lang]} \302\267{\' \'}\\n                      <span className=\\\"font-mono-nums\\\">{exp.date}</span>\\n                      {exp.recurring ? (isAr ? \' \302\267 \331\205\330\252\331\203\330\261\330\261\' : \' \302\267 Recurring\') : \'\'}\\n                    </p>\\n                  </div>\\n                  <div className=\\\"flex items-center gap-3 shrink-0\\\">\\n                    <span className=\\\"text-sm font-semibold font-mono-nums text-[#F4F6F8]\\\">\\n                      -{formatEgp(exp.amountPiasters, lang)}\\n                    </span>\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => setConfirmDelete({ type: \'expense\', id: exp.id, label: exp.description })}\\n                      aria-label={`${isAr ? \'\330\255\330\260\331\201\' : \'Delete\'} ${exp.description}`}\\n                      className=\\\"min-h-[36px] min-w-[36px] flex items-center justify-center rounded-lg text-[#758091] hover:text-red-400 hover:bg-red-500/10\\\"\\n                    >\\n                      <Trash2 className=\\\"w-4 h-4\\\" />\\n                    </button>\\n                  </div>\\n                </div>\\n              ))}\\n              {filteredExpenses.length === 0 ? (\\n                <p className=\\\"py-8 text-center text-xs text-[#8E99A8]\\\">\\n                  {isAr ? \'\331\204\330\247 \330\252\331\210\330\254\330\257 \331\205\330\265\330\247\330\261\331\212\331\201 \331\205\330\267\330\247\330\250\331\202\330\251.\' : \'No matching expenses.\'}\\n                </p>\\n              ) : null}\\n            </div>\\n          </div>\\n        </div>\\n      ) : null}\\n\\n      {/* TAB 3: INCOME & FREELANCE */}\\n      {tab === \'income\' ? (\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-5\\\">\\n          <form onSubmit={handleAddIncome} className=\\\"lg:col-span-5 bg-[#13171C] border border-[#232A33] rounded-2xl p-5 space-y-4 self-start\\\">\\n            <h2 className=\\\"text-sm font-semibold text-[#F4F6F8]\\\">{isAr ? \'\330\245\330\266\330\247\331\201\330\251 \331\205\330\265\330\257\330\261 \330\257\330\256\331\204 / \331\201\330\247\330\252\331\210\330\261\330\251 \331\201\330\261\331\212\331\204\330\247\331\206\330\263\' : \'Add Income / Freelance Invoice\'}</h2>\\n            {incError ? <p className=\\\"text-xs text-red-400\\\">{incError}</p> : null}\\n\\n            <div>\\n              <label htmlFor=\\\"inc-title\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">\\n                {isAr ? \'\330\247\331\204\330\271\331\206\331\210\330\247\331\206\' : \'Title\'}\\n              </label>\\n              <input\\n                id=\\\"inc-title\\\"\\n                type=\\\"text\\\"\\n                value={incTitle}\\n                onChange={(e) => setIncTitle(e.target.value)}\\n                placeholder={isAr ? \'\331\205\330\253\330\247\331\204: \330\252\330\265\331\205\331\212\331\205 \331\205\331\210\331\202\330\271 \330\264\330\261\331\203\330\251 \330\247\331\204\331\206\331\210\330\261\' : \'e.g., Client Website Redesign\'}\\n                className=\\\"w-full min-h-[44px] px-3.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\\\"\\n              />\\n            </div>\\n\\n            <div className=\\\"grid grid-cols-2 gap-3\\\">\\n              <div>\\n                <label htmlFor=\\\"inc-amount\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">\\n                  {isAr ? \'\330\247\331\204\331\205\330\250\331\204\330\272 \330\247\331\204\330\245\330\254\331\205\330\247\331\204\331\212 (\330\254.\331\205)\' : \'Total Amount (EGP)\'}\\n                </label>\\n                <input\\n                  id=\\\"inc-amount\\\"\\n                  type=\\\"number\\\"\\n                  value={incAmount}\\n                  onChange={(e) => setIncAmount(e.target.value)}\\n                  placeholder=\\\"8000\\\"\\n                  className=\\\"w-full min-h-[44px] px-3.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\\\"\\n                />\\n              </div>\\n              <div>\\n                <label htmlFor=\\\"inc-source\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">\\n                  {isAr ? \'\330\247\331\204\331\205\330\265\330\257\330\261\' : \'Source\'}\\n                </label>\\n                <select\\n                  id=\\\"inc-source\\\"\\n                  value={incSource}\\n                  onChange={(e) => setIncSource(e.target.value as IncomeSource)}\\n                  className=\\\"w-full min-h-[44px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\\\"\\n                >\\n                  {(Object.keys(INCOME_SOURCE_LABELS) as IncomeSource[]).map((s) => (\\n                    <option key={s} value={s}>\\n                      {INCOME_SOURCE_LABELS[s][lang]}\\n                    </option>\\n                  ))}\\n                </select>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"grid grid-cols-2 gap-3\\\">\\n              <div>\\n                <label htmlFor=\\\"inc-status\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">\\n                  {isAr ? \'\330\255\330\247\331\204\330\251 \330\247\331\204\330\252\330\255\330\265\331\212\331\204\' : \'Payment Status\'}\\n                </label>\\n                <select\\n                  id=\\\"inc-status\\\"\\n                  value={incStatus}\\n                  onChange={(e) => setIncStatus(e.target.value as IncomeStatus)}\\n                  className=\\\"w-full min-h-[44px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\\\"\\n                >\\n                  {(Object.keys(INCOME_STATUS_LABELS) as IncomeStatus[]).map((st) => (\\n                    <option key={st} value={st}>\\n                      {INCOME_STATUS_LABELS[st][lang]}\\n                    </option>\\n                  ))}\\n                </select>\\n              </div>\\n              <div>\\n                <label htmlFor=\\\"inc-date\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">\\n                  {isAr ? \'\330\252\330\247\330\261\331\212\330\256 \330\247\331\204\330\257\331\201\330\271 \330\247\331\204\331\205\330\252\331\210\331\202\330\271\' : \'Expected Date\'}\\n                </label>\\n                <input\\n                  id=\\\"inc-date\\\"\\n                  type=\\\"date\\\"\\n                  value={incDate}\\n                  onChange={(e) => setIncDate(e.target.value)}\\n                  className=\\\"w-full min-h-[44px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\\\"\\n                />\\n              </div>\\n            </div>\\n\\n            {incStatus === \'partially_paid\' ? (\\n              <div>\\n                <label htmlFor=\\\"inc-paid\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">\\n                  {isAr ? \'\330\247\331\204\331\205\330\250\331\204\330\272 \330\247\331\204\331\205\330\263\330\252\331\204\331\205 \331\201\330\271\331\204\331\212\330\247\331\213 (\330\254.\331\205)\' : \'Amount Received So Far (EGP)\'}\\n                </label>\\n                <input\\n                  id=\\\"inc-paid\\\"\\n                  type=\\\"number\\\"\\n                  value={incPaidAmount}\\n                  onChange={(e) => setIncPaidAmount(e.target.value)}\\n                  placeholder=\\\"3000\\\"\\n                  className=\\\"w-full min-h-[44px] px-3.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\\\"\\n                />\\n              </div>\\n            ) : null}\\n\\n            <div>\\n              <label htmlFor=\\\"inc-project\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">\\n                {isAr ? \'\330\247\331\204\331\205\330\264\330\261\331\210\330\271 (\330\247\330\256\330\252\331\212\330\247\330\261\331\212)\' : \'Project (Optional)\'}\\n              </label>\\n              <input\\n                id=\\\"inc-project\\\"\\n                type=\\\"text\\\"\\n                value={incProject}\\n                onChange={(e) => setIncProject(e.target.value)}\\n                className=\\\"w-full min-h-[44px] px-3.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\\\"\\n              />\\n            </div>\\n\\n            <button\\n              type=\\\"submit\\\"\\n              className=\\\"w-full min-h-[44px] rounded-xl bg-emerald-500 text-[#07110C] font-semibold text-sm hover:bg-emerald-400 transition-colors\\\"\\n            >\\n              {isAr ? \'\330\255\331\201\330\270 \330\263\330\254\331\204 \330\247\331\204\330\257\330\256\331\204\' : \'Save Income Record\'}\\n            </button>\\n          </form>\\n\\n          <div className=\\\"lg:col-span-7 bg-[#13171C] border border-[#232A33] rounded-2xl p-5 divide-y divide-[#1D232C]\\\">\\n            {data.incomeRecords.map((rec) => {\\n              const paid = getPaidCashFromIncome(rec);\\n              const unpaid = getUnpaidAmountFromIncome(rec);\\n              return (\\n                <div key={rec.id} className=\\\"py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3\\\">\\n                  <div>\\n                    <p className=\\\"text-sm font-semibold text-[#F4F6F8]\\\">{rec.title}</p>\\n                    <p className=\\\"text-xs text-[#8E99A8] mt-0.5\\\">\\n                      {INCOME_SOURCE_LABELS[rec.source][lang]} \302\267{\' \'}\\n                      <span\\n                        className={\\n                          rec.status === \'fully_paid\'\\n                            ? \'text-emerald-400\'\\n                            : rec.status === \'overdue\'\\n                              ? \'text-red-400\'\\n                              : \'text-amber-400\'\\n                        }\\n                      >\\n                        {INCOME_STATUS_LABELS[rec.status][lang]}\\n                      </span>\\n                      {\' \302\267 \'}\\n                      <span className=\\\"font-mono-nums\\\">{rec.expectedPaymentDate}</span>\\n                      {rec.projectName ? ` \302\267 ${rec.projectName}` : \'\'}\\n                    </p>\\n                  </div>\\n\\n                  <div className=\\\"flex items-center gap-3 shrink-0\\\">\\n                    <div className=\\\"text-end\\\">\\n                      <p className=\\\"text-sm font-bold font-mono-nums text-[#F4F6F8]\\\">{formatEgp(rec.amountPiasters, lang)}</p>\\n                      {unpaid > 0 ? (\\n                        <p className=\\\"text-[11px] font-mono-nums text-amber-400\\\">\\n                          {isAr ? `\331\205\330\255\330\265\331\221\331\204 ${formatEgp(paid, lang)} \302\267 \331\205\330\271\331\204\331\202 ${formatEgp(unpaid, lang)}` : `Paid ${formatEgp(paid, lang)} \302\267 Due ${formatEgp(unpaid, lang)}`}\\n                        </p>\\n                      ) : (\\n                        <p className=\\\"text-[11px] text-emerald-400\\\">{isAr ? \'\331\205\330\266\330\247\331\201 \331\204\331\204\330\261\330\265\331\212\330\257 \330\247\331\204\331\205\330\252\330\247\330\255\' : \'In available cash\'}</p>\\n                      )}\\n                    </div>\\n                    {rec.status !== \'fully_paid\' ? (\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => void updateIncomeStatus(rec.id, \'fully_paid\', rec.amountPiasters)}\\n                        className=\\\"min-h-[36px] px-2.5 rounded-lg border border-emerald-500/40 text-xs text-emerald-300 hover:bg-emerald-500/10 whitespace-nowrap\\\"\\n                      >\\n                        {isAr ? \'\330\252\330\243\331\203\331\212\330\257 \330\247\331\204\330\252\330\255\330\265\331\212\331\204\' : \'Mark Paid\'}\\n                      </button>\\n                    ) : null}\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => setConfirmDelete({ type: \'income\', id: rec.id, label: rec.title })}\\n                      aria-label={`${isAr ? \'\330\255\330\260\331\201\' : \'Delete\'} ${rec.title}`}\\n                      className=\\\"min-h-[36px] min-w-[36px] flex items-center justify-center rounded-lg text-[#758091] hover:text-red-400\\\"\\n                    >\\n                      <Trash2 className=\\\"w-4 h-4\\\" />\\n                    </button>\\n                  </div>\\n                </div>\\n              );\\n            })}\\n          </div>\\n        </div>\\n      ) : null}\\n\\n      {/* TAB 4: BUDGETS */}\\n      {tab === \'budgets\' ? (\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-5\\\">\\n          <form onSubmit={handleAddBudget} className=\\\"lg:col-span-4 bg-[#13171C] border border-[#232A33] rounded-2xl p-5 space-y-4 self-start\\\">\\n            <h2 className=\\\"text-sm font-semibold text-[#F4F6F8]\\\">{isAr ? \'\330\252\330\255\330\257\331\212\330\257 \330\243\331\210 \330\252\330\271\330\257\331\212\331\204 \331\205\331\212\330\262\330\247\331\206\331\212\330\251 \330\247\331\204\330\264\331\207\330\261\' : \'Set Monthly Budget\'}</h2>\\n            <div>\\n              <label htmlFor=\\\"bud-cat\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">\\n                {isAr ? \'\330\247\331\204\331\206\330\267\330\247\331\202 / \330\247\331\204\330\252\330\265\331\206\331\212\331\201\' : \'Category\'}\\n              </label>\\n              <select\\n                id=\\\"bud-cat\\\"\\n                value={budCat}\\n                onChange={(e) => setBudCat(e.target.value)}\\n                className=\\\"w-full min-h-[44px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\\\"\\n              >\\n                <option value=\\\"overall\\\">{getCategoryLabel(\'overall\', lang)}</option>\\n                {allCategories.map((c) => (\\n                  <option key={c} value={c}>\\n                    {getCategoryLabel(c, lang)}\\n                  </option>\\n                ))}\\n              </select>\\n            </div>\\n            <div>\\n              <label htmlFor=\\\"bud-limit\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">\\n                {isAr ? \'\330\247\331\204\330\255\330\257 \330\247\331\204\330\264\331\207\330\261\331\212 (\330\254.\331\205)\' : \'Monthly Limit (EGP)\'}\\n              </label>\\n              <input\\n                id=\\\"bud-limit\\\"\\n                type=\\\"number\\\"\\n                value={budLimit}\\n                onChange={(e) => setBudLimit(e.target.value)}\\n                placeholder=\\\"3500\\\"\\n                className=\\\"w-full min-h-[44px] px-3.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\\\"\\n              />\\n            </div>\\n            <button\\n              type=\\\"submit\\\"\\n              className=\\\"w-full min-h-[44px] rounded-xl bg-emerald-500 text-[#07110C] font-semibold text-sm hover:bg-emerald-400\\\"\\n            >\\n              {isAr ? \'\330\255\331\201\330\270 \330\247\331\204\331\205\331\212\330\262\330\247\331\206\331\212\330\251\' : \'Save Budget\'}\\n            </button>\\n          </form>\\n\\n          <div className=\\\"lg:col-span-8 bg-[#13171C] border border-[#232A33] rounded-2xl p-5 divide-y divide-[#1D232C]\\\">\\n            {data.budgets.map((b) => {\\n              const prog = calculateBudgetProgress(b, data.expenseRecords);\\n              const barColor =\\n                prog.status === \'exceeded\' ? \'bg-red-500\' : prog.status === \'warning\' ? \'bg-amber-400\' : \'bg-emerald-500\';\\n              return (\\n                <div key={b.id} className=\\\"py-4 space-y-2.5\\\">\\n                  <div className=\\\"flex items-center justify-between gap-3\\\">\\n                    <div>\\n                      <p className=\\\"text-sm font-semibold text-[#F4F6F8]\\\">{getCategoryLabel(b.category, lang)}</p>\\n                      <p className=\\\"text-xs text-[#8E99A8] font-mono-nums mt-0.5\\\">\\n                        {formatEgp(prog.spentPiasters, lang)} / {formatEgp(b.limitPiasters, lang)} \302\267{\' \'}\\n                        <span\\n                          className={\\n                            prog.status === \'exceeded\'\\n                              ? \'text-red-400 font-semibold\'\\n                              : prog.status === \'warning\'\\n                                ? \'text-amber-400 font-semibold\'\\n                                : \'text-emerald-400\'\\n                          }\\n                        >\\n                          {prog.percentUsed}%{\' \'}\\n                          {prog.status === \'exceeded\'\\n                            ? isAr ? \'(\330\252\330\254\330\247\331\210\330\262 \330\247\331\204\330\255\330\257)\' : \'(Exceeded)\'\\n                            : prog.status === \'warning\'\\n                              ? isAr ? \'(\331\202\330\261\330\250 \330\247\331\204\330\255\330\257)\' : \'(Near limit)\'\\n                              : isAr ? \'(\330\266\331\205\331\206 \330\247\331\204\330\256\330\267\330\251)\' : \'(On track)\'}\\n                        </span>\\n                      </p>\\n                    </div>\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => setConfirmDelete({ type: \'budget\', id: b.id, label: getCategoryLabel(b.category, lang) })}\\n                      aria-label={`${isAr ? \'\330\255\330\260\331\201 \331\205\331\212\330\262\330\247\331\206\331\212\330\251\' : \'Delete budget\'} ${getCategoryLabel(b.category, lang)}`}\\n                      className=\\\"min-h-[36px] min-w-[36px] flex items-center justify-center rounded-lg text-[#758091] hover:text-red-400\\\"\\n                    >\\n                      <Trash2 className=\\\"w-4 h-4\\\" />\\n                    </button>\\n                  </div>\\n                  <div className=\\\"h-2 rounded-full bg-[#0B0D10] overflow-hidden\\\">\\n                    <div\\n                      className={`h-full rounded-full transition-all ${barColor}`}\\n                      style={{ width: `${Math.min(100, prog.percentUsed)}%` }}\\n                    />\\n                  </div>\\n                </div>\\n              );\\n            })}\\n          </div>\\n        </div>\\n      ) : null}\\n\\n      {/* TAB 5: SAVINGS GOALS */}\\n      {tab === \'savings\' ? (\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-5\\\">\\n          <form onSubmit={handleAddSavings} className=\\\"lg:col-span-4 bg-[#13171C] border border-[#232A33] rounded-2xl p-5 space-y-4 self-start\\\">\\n            <h2 className=\\\"text-sm font-semibold text-[#F4F6F8]\\\">{isAr ? \'\331\207\330\257\331\201 \330\247\330\257\330\256\330\247\330\261 \330\254\330\257\331\212\330\257\' : \'New Savings Goal\'}</h2>\\n            <div>\\n              <label htmlFor=\\\"sav-title\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\247\330\263\331\205 \330\247\331\204\331\207\330\257\331\201\' : \'Goal Name\'}</label>\\n              <input\\n                id=\\\"sav-title\\\"\\n                type=\\\"text\\\"\\n                value={savTitle}\\n                onChange={(e) => setSavTitle(e.target.value)}\\n                placeholder={isAr ? \'\331\205\330\253\330\247\331\204: \330\265\331\206\330\257\331\210\331\202 \330\263\331\201\330\261\' : \'e.g., Travel Fund\'}\\n                className=\\\"w-full min-h-[44px] px-3.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\\\"\\n              />\\n            </div>\\n            <div>\\n              <label htmlFor=\\\"sav-cat\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\247\331\204\330\252\330\265\331\206\331\212\331\201\' : \'Category\'}</label>\\n              <select\\n                id=\\\"sav-cat\\\"\\n                value={savCat}\\n                onChange={(e) => setSavCat(e.target.value as SavingsCategory)}\\n                className=\\\"w-full min-h-[44px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\\\"\\n              >\\n                {(Object.keys(SAVINGS_CATEGORY_LABELS) as SavingsCategory[]).map((c) => (\\n                  <option key={c} value={c}>{SAVINGS_CATEGORY_LABELS[c][lang]}</option>\\n                ))}\\n              </select>\\n            </div>\\n            <div className=\\\"grid grid-cols-2 gap-3\\\">\\n              <div>\\n                <label htmlFor=\\\"sav-target\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\247\331\204\331\205\330\263\330\252\331\207\330\257\331\201 (\330\254.\331\205)\' : \'Target (EGP)\'}</label>\\n                <input\\n                  id=\\\"sav-target\\\"\\n                  type=\\\"number\\\"\\n                  value={savTarget}\\n                  onChange={(e) => setSavTarget(e.target.value)}\\n                  className=\\\"w-full min-h-[44px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\\\"\\n                />\\n              </div>\\n              <div>\\n                <label htmlFor=\\\"sav-cur\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\247\331\204\330\255\330\247\331\204\331\212 (\330\254.\331\205)\' : \'Current (EGP)\'}</label>\\n                <input\\n                  id=\\\"sav-cur\\\"\\n                  type=\\\"number\\\"\\n                  value={savCurrent}\\n                  onChange={(e) => setSavCurrent(e.target.value)}\\n                  className=\\\"w-full min-h-[44px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\\\"\\n                />\\n              </div>\\n            </div>\\n            <div>\\n              <label htmlFor=\\\"sav-date\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\247\331\204\330\252\330\247\330\261\331\212\330\256 \330\247\331\204\331\205\330\263\330\252\331\207\330\257\331\201\' : \'Target Date\'}</label>\\n              <input\\n                id=\\\"sav-date\\\"\\n                type=\\\"date\\\"\\n                value={savDate}\\n                onChange={(e) => setSavDate(e.target.value)}\\n                className=\\\"w-full min-h-[44px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\\\"\\n              />\\n            </div>\\n            <button type=\\\"submit\\\" className=\\\"w-full min-h-[44px] rounded-xl bg-emerald-500 text-[#07110C] font-semibold text-sm hover:bg-emerald-400\\\">\\n              {isAr ? \'\330\245\331\206\330\264\330\247\330\241 \331\207\330\257\331\201 \330\247\331\204\330\247\330\257\330\256\330\247\330\261\' : \'Create Savings Goal\'}\\n            </button>\\n          </form>\\n\\n          <div className=\\\"lg:col-span-8 bg-[#13171C] border border-[#232A33] rounded-2xl p-5 divide-y divide-[#1D232C]\\\">\\n            {data.savingsGoals.map((goal) => {\\n              const prog = calculateSavingsGoalProgress(goal, TODAY_ISO);\\n              return (\\n                <div key={goal.id} className=\\\"py-4 space-y-3\\\">\\n                  <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\\\">\\n                    <div>\\n                      <p className=\\\"text-sm font-semibold text-[#F4F6F8]\\\">{goal.title}</p>\\n                      <p className=\\\"text-xs text-[#8E99A8] mt-0.5\\\">\\n                        {SAVINGS_CATEGORY_LABELS[goal.category][lang]} \302\267 {isAr ? \'\330\247\331\204\331\205\331\210\330\271\330\257:\' : \'Target:\'}{\' \'}\\n                        <span className=\\\"font-mono-nums\\\">{goal.targetDate}</span> \302\267 {isAr ? \'\331\205\331\202\330\252\330\261\330\255 \330\264\331\207\330\261\331\212\330\247\331\213:\' : \'Suggested/mo:\'}{\' \'}\\n                        <span className=\\\"font-mono-nums text-emerald-400\\\">{formatEgp(prog.suggestedMonthlyContributionPiasters, lang)}</span>\\n                      </p>\\n                    </div>\\n                    <div className=\\\"flex items-center gap-2 shrink-0\\\">\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => void contributeSavingsGoal(goal.id, egpToPiasters(1000))}\\n                        className=\\\"min-h-[36px] px-3 rounded-lg border border-emerald-500/40 text-xs font-medium text-emerald-300 hover:bg-emerald-500/10 whitespace-nowrap\\\"\\n                      >\\n                        {isAr ? \'+ 1,000 \330\254.\331\205\' : \'+ EGP 1,000\'}\\n                      </button>\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => setConfirmDelete({ type: \'savings\', id: goal.id, label: goal.title })}\\n                        aria-label={`${isAr ? \'\330\255\330\260\331\201\' : \'Delete\'} ${goal.title}`}\\n                        className=\\\"min-h-[36px] min-w-[36px] flex items-center justify-center rounded-lg text-[#758091] hover:text-red-400\\\"\\n                      >\\n                        <Trash2 className=\\\"w-4 h-4\\\" />\\n                      </button>\\n                    </div>\\n                  </div>\\n                  <div className=\\\"flex items-center justify-between text-xs font-mono-nums\\\">\\n                    <span className=\\\"text-[#F4F6F8]\\\">{formatEgp(goal.currentPiasters, lang)} / {formatEgp(goal.targetPiasters, lang)}</span>\\n                    <span className=\\\"text-emerald-400\\\">{prog.progressPercent}% \302\267 {isAr ? \'\331\205\330\252\330\250\331\202\331\212\' : \'Left\'} {formatEgp(prog.remainingPiasters, lang)}</span>\\n                  </div>\\n                  <div className=\\\"h-2 rounded-full bg-[#0B0D10] overflow-hidden\\\">\\n                    <div className=\\\"h-full bg-emerald-500 rounded-full\\\" style={{ width: `${prog.progressPercent}%` }} />\\n                  </div>\\n                </div>\\n              );\\n            })}\\n          </div>\\n        </div>\\n      ) : null}\\n\\n      {/* TAB 6: INVESTMENT TRACKER */}\\n      {tab === \'investments\' ? (\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-5\\\">\\n          <form onSubmit={handleAddInvestment} className=\\\"lg:col-span-4 bg-[#13171C] border border-[#232A33] rounded-2xl p-5 space-y-3.5 self-start\\\">\\n            <div>\\n              <h2 className=\\\"text-sm font-semibold text-[#F4F6F8]\\\">{isAr ? \'\330\245\330\266\330\247\331\201\330\251 \330\243\330\265\331\204 \330\247\330\263\330\252\330\253\331\205\330\247\330\261\331\212 (\331\205\330\252\330\247\330\250\330\271\330\251 \331\212\330\257\331\210\331\212\330\251)\' : \'Add Investment Holding\'}</h2>\\n              <p className=\\\"text-[11px] text-[#8E99A8] mt-1\\\">\\n                {isAr\\n                  ? \'\330\252\330\252\330\250\330\271 \331\212\330\257\331\210\331\212 \331\204\331\204\331\205\330\255\331\201\330\270\330\251 \331\201\331\202\330\267 \342\200\224 \331\204\330\247 \331\212\331\206\331\201\330\260 \330\265\331\201\331\202\330\247\330\252 \330\252\331\204\331\202\330\247\330\246\331\212\330\251 \331\210\331\204\330\247 \331\212\331\202\330\257\331\205 \331\210\330\271\331\210\330\257\330\247\331\213 \330\250\330\271\331\210\330\247\330\246\330\257.\'\\n                  : \'Manual portfolio tracker only \342\200\224 no automated execution or guaranteed returns.\'}\\n              </p>\\n            </div>\\n            <div>\\n              <label htmlFor=\\\"inv-name\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\247\330\263\331\205 \330\247\331\204\330\243\330\265\331\204\' : \'Asset Name\'}</label>\\n              <input\\n                id=\\\"inv-name\\\"\\n                type=\\\"text\\\"\\n                value={invName}\\n                onChange={(e) => setInvName(e.target.value)}\\n                placeholder={isAr ? \'\331\205\330\253\330\247\331\204: \330\263\330\250\331\212\331\203\330\251 \330\260\331\207\330\250 5 \330\254\330\261\330\247\331\205\' : \'e.g., 24K Gold Bullion\'}\\n                className=\\\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\\\"\\n              />\\n            </div>\\n            <div className=\\\"grid grid-cols-2 gap-3\\\">\\n              <div>\\n                <label htmlFor=\\\"inv-cat\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\247\331\204\331\201\330\246\330\251\' : \'Type\'}</label>\\n                <select\\n                  id=\\\"inv-cat\\\"\\n                  value={invCat}\\n                  onChange={(e) => setInvCat(e.target.value as InvestmentCategory)}\\n                  className=\\\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\\\"\\n                >\\n                  {(Object.keys(INVESTMENT_CATEGORY_LABELS) as InvestmentCategory[]).map((c) => (\\n                    <option key={c} value={c}>{INVESTMENT_CATEGORY_LABELS[c][lang]}</option>\\n                  ))}\\n                </select>\\n              </div>\\n              <div>\\n                <label htmlFor=\\\"inv-qty\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\247\331\204\331\203\331\205\331\212\330\251\' : \'Quantity\'}</label>\\n                <input\\n                  id=\\\"inv-qty\\\"\\n                  type=\\\"number\\\"\\n                  step=\\\"0.01\\\"\\n                  value={invQty}\\n                  onChange={(e) => setInvQty(e.target.value)}\\n                  className=\\\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\\\"\\n                />\\n              </div>\\n            </div>\\n            <div className=\\\"grid grid-cols-2 gap-3\\\">\\n              <div>\\n                <label htmlFor=\\\"inv-buy\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\263\330\271\330\261 \330\247\331\204\330\264\330\261\330\247\330\241 \331\204\331\204\331\210\330\255\330\257\330\251\' : \'Buy Price/Unit\'}</label>\\n                <input\\n                  id=\\\"inv-buy\\\"\\n                  type=\\\"number\\\"\\n                  value={invBuyPrice}\\n                  onChange={(e) => setInvBuyPrice(e.target.value)}\\n                  className=\\\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\\\"\\n                />\\n              </div>\\n              <div>\\n                <label htmlFor=\\\"inv-cur\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\247\331\204\330\252\331\202\331\212\331\212\331\205 \330\247\331\204\330\255\330\247\331\204\331\212 \331\204\331\204\331\210\330\255\330\257\330\251\' : \'Current Val/Unit\'}</label>\\n                <input\\n                  id=\\\"inv-cur\\\"\\n                  type=\\\"number\\\"\\n                  value={invCurPrice}\\n                  onChange={(e) => setInvCurPrice(e.target.value)}\\n                  className=\\\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\\\"\\n                />\\n              </div>\\n            </div>\\n            <div>\\n              <label htmlFor=\\\"inv-fees\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\247\331\204\331\205\330\265\331\206\330\271\331\212\330\251 / \330\247\331\204\330\271\331\205\331\210\331\204\330\247\330\252 (\330\254.\331\205)\' : \'Fees (EGP)\'}</label>\\n              <input\\n                id=\\\"inv-fees\\\"\\n                type=\\\"number\\\"\\n                value={invFees}\\n                onChange={(e) => setInvFees(e.target.value)}\\n                className=\\\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\\\"\\n              />\\n            </div>\\n            <button type=\\\"submit\\\" className=\\\"w-full min-h-[44px] rounded-xl bg-emerald-500 text-[#07110C] font-semibold text-sm hover:bg-emerald-400\\\">\\n              {isAr ? \'\330\245\330\266\330\247\331\201\330\251 \331\204\331\204\331\205\330\255\331\201\330\270\330\251\' : \'Add Holding\'}\\n            </button>\\n          </form>\\n\\n          <div className=\\\"lg:col-span-8 bg-[#13171C] border border-[#232A33] rounded-2xl p-5 divide-y divide-[#1D232C]\\\">\\n            {data.investments.map((asset) => {\\n              const m = calculateInvestmentMetrics(asset);\\n              return (\\n                <div key={asset.id} className=\\\"py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3\\\">\\n                  <div>\\n                    <p className=\\\"text-sm font-semibold text-[#F4F6F8]\\\">{asset.name}</p>\\n                    <p className=\\\"text-xs text-[#8E99A8] mt-0.5\\\">\\n                      {INVESTMENT_CATEGORY_LABELS[asset.category][lang]} \302\267 {isAr ? \'\330\247\331\204\331\203\331\205\331\212\330\251:\' : \'Qty:\'}{\' \'}\\n                      <span className=\\\"font-mono-nums\\\">{asset.quantity}</span> \302\267{\' \'}\\n                      <span className=\\\"text-amber-300\\\">\\n                        {asset.valuationSource === \'manual\'\\n                          ? isAr ? \'\330\252\331\202\331\212\331\212\331\205 \331\205\331\217\330\257\330\256\331\204 \331\212\330\257\331\210\331\212\330\247\331\213\' : \'Manual valuation\'\\n                          : isAr ? \'\330\263\330\271\330\261 \330\263\331\210\331\202 \331\205\331\210\330\253\331\221\331\202\' : \'Verified market price\'}\\n                      </span>\\n                    </p>\\n                  </div>\\n                  <div className=\\\"flex items-center gap-3 shrink-0\\\">\\n                    <div className=\\\"text-end\\\">\\n                      <p className=\\\"text-sm font-bold font-mono-nums text-[#F4F6F8]\\\">{formatEgp(m.currentValuePiasters, lang)}</p>\\n                      <p className={`text-xs font-mono-nums ${m.unrealizedPnlPiasters >= 0 ? \'text-emerald-400\' : \'text-red-400\'}`}>\\n                        {m.unrealizedPnlPiasters >= 0 ? \'+\' : \'\'}\\n                        {formatEgp(m.unrealizedPnlPiasters, lang)} ({m.unrealizedPnlPercent.toFixed(1)}%)\\n                      </p>\\n                    </div>\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() =>\\n                        void updateInvestmentValuation(asset.id, Math.round(asset.currentValuationPiasters * 1.02))\\n                      }\\n                      className=\\\"min-h-[36px] px-2.5 rounded-lg border border-[#232A33] text-xs text-[#C8D0DC] hover:border-emerald-500/50 whitespace-nowrap\\\"\\n                    >\\n                      {isAr ? \'+2% \330\252\331\202\331\212\331\212\331\205\' : \'+2% Val\'}\\n                    </button>\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => setConfirmDelete({ type: \'investment\', id: asset.id, label: asset.name })}\\n                      aria-label={`${isAr ? \'\330\255\330\260\331\201\' : \'Delete\'} ${asset.name}`}\\n                      className=\\\"min-h-[36px] min-w-[36px] flex items-center justify-center rounded-lg text-[#758091] hover:text-red-400\\\"\\n                    >\\n                      <Trash2 className=\\\"w-4 h-4\\\" />\\n                    </button>\\n                  </div>\\n                </div>\\n              );\\n            })}\\n          </div>\\n        </div>\\n      ) : null}\\n\\n      <ConfirmDialog\\n        open={Boolean(confirmDelete)}\\n        title={isAr ? \'\330\252\330\243\331\203\331\212\330\257 \330\247\331\204\330\255\330\260\331\201\' : \'Confirm Deletion\'}\\n        description={\\n          isAr\\n            ? `\331\207\331\204 \330\243\331\206\330\252 \331\205\330\252\330\243\331\203\330\257 \331\205\331\206 \330\255\330\260\331\201 \\\"${confirmDelete?.label}\\\"\330\237 \331\204\330\247 \331\212\331\205\331\203\331\206 \330\247\331\204\330\252\330\261\330\247\330\254\330\271 \330\271\331\206 \331\207\330\260\330\247 \330\247\331\204\330\245\330\254\330\261\330\247\330\241.`\\n            : `Are you sure you want to delete \\\"${confirmDelete?.label}\\\"? This action cannot be undone.`\\n        }\\n        confirmLabel={isAr ? \'\330\255\330\260\331\201 \331\206\331\207\330\247\330\246\331\212\330\247\331\213\' : \'Delete\'}\\n        cancelLabel={isAr ? \'\330\245\331\204\330\272\330\247\330\241\' : \'Cancel\'}\\n        tone=\\\"danger\\\"\\n        onConfirm={() => void executeConfirmedDelete()}\\n        onCancel={() => setConfirmDelete(null)}\\n      />\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create Module 02 Finance Intelligence covering analytics charts, expenses, unpaid-freelance-safe income, budgets, savings goals, and manual investments\", \"Overwrite\":true, \"TargetFile\":\"/src/components/FinanceModule.tsx\", \"toolAction\":\"Creating FinanceModule component\", \"toolSummary\":\"Create FinanceModule\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_6024804069680064388"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect, useMemo, useState } from \'react\';\\nimport {\\n  Bar,\\n  BarChart,\\n  CartesianGrid,\\n  ResponsiveContainer,\\n  Tooltip,\\n  XAxis,\\n  YAxis,\\n} from \'recharts\';\\nimport { Check, Pause, Play, Plus, RotateCcw, Trash2 } from \'lucide-react\';\\nimport { useLifeOs } from \'../context/LifeOsContext\';\\nimport { TODAY_ISO } from \'../data/seedData\';\\nimport { TASK_CATEGORY_LABELS, TASK_PRIORITY_LABELS } from \'../i18n/translations\';\\nimport { isOutsideWorkingHours, sortTasksForSmartSchedule } from \'../utils/energy\';\\nimport { ConfirmDialog } from \'./ConfirmDialog\';\\nimport type { TaskCategory, TaskPriority } from \'../types/lifeos\';\\n\\ntype TimeTab = \'tasks\' | \'calendar\' | \'focus\' | \'analytics\';\\n\\nexport const TimeModule: React.FC = () => {\\n  const {\\n    data,\\n    lang,\\n    addTask,\\n    toggleTaskStatus,\\n    deleteTask,\\n    addCalendarEvent,\\n    deleteCalendarEvent,\\n    addFocusSession,\\n  } = useLifeOs();\\n\\n  const isAr = lang === \'ar\';\\n  const [tab, setTab] = useState<TimeTab>(\'tasks\');\\n\\n  // Task form state\\n  const [title, setTitle] = useState(\'\');\\n  const [priority, setPriority] = useState<TaskPriority>(\'high\');\\n  const [category, setCategory] = useState<TaskCategory>(\'deep_work\');\\n  const [deadline, setDeadline] = useState(TODAY_ISO);\\n  const [scheduledStart, setScheduledStart] = useState(\'09:30\');\\n  const [estimatedMinutes, setEstimatedMinutes] = useState(\'45\');\\n  const [pendingOutOfHoursTask, setPendingOutOfHoursTask] = useState(false);\\n\\n  // Calendar event form state\\n  const [evtTitle, setEvtTitle] = useState(\'\');\\n  const [evtType, setEvtType] = useState<\'work\' | \'personal\'>(\'work\');\\n  const [evtDate, setEvtDate] = useState(TODAY_ISO);\\n  const [evtStart, setEvtStart] = useState(\'10:00\');\\n  const [evtEnd, setEvtEnd] = useState(\'11:00\');\\n  const [calFilter, setCalFilter] = useState<\'all\' | \'work\' | \'personal\'>(\'all\');\\n  const [confirmDeleteEvent, setConfirmDeleteEvent] = useState<{ id: string; title: string } | null>(null);\\n\\n  // Focus Mode Pomodoro state\\n  const [focusLabel, setFocusLabel] = useState(isAr ? \'\330\254\331\204\330\263\330\251 \330\252\330\261\331\203\331\212\330\262 \330\265\330\250\330\247\330\255\331\212\330\251\' : \'Morning Deep Work\');\\n  const [presetMinutes, setPresetMinutes] = useState(25);\\n  const [secondsLeft, setSecondsLeft] = useState(25 * 60);\\n  const [isRunning, setIsRunning] = useState(false);\\n  const [distractions, setDistractions] = useState(0);\\n\\n  useEffect(() => {\\n    if (!isRunning) return;\\n    const timer = window.setInterval(() => {\\n      setSecondsLeft((prev) => {\\n        if (prev <= 1) {\\n          setIsRunning(false);\\n          void addFocusSession({\\n            label: focusLabel || \'Focus Session\',\\n            durationMinutes: presetMinutes,\\n            distractions,\\n            date: TODAY_ISO,\\n          });\\n          return presetMinutes * 60;\\n        }\\n        return prev - 1;\\n      });\\n    }, 1000);\\n    return () => window.clearInterval(timer);\\n  }, [isRunning, focusLabel, presetMinutes, distractions, addFocusSession]);\\n\\n  const sortedTasks = useMemo(\\n    () => sortTasksForSmartSchedule(data.tasks, data.profile.peakConcentration),\\n    [data.tasks, data.profile.peakConcentration],\\n  );\\n\\n  const filteredEvents = useMemo(() => {\\n    return data.calendarEvents\\n      .filter((e) => (calFilter === \'all\' ? true : e.calendarType === calFilter))\\n      .sort((a, b) => `${a.date} ${a.startTime}`.localeCompare(`${b.date} ${b.startTime}`));\\n  }, [data.calendarEvents, calFilter]);\\n\\n  const timeAnalytics = useMemo(() => {\\n    const byCat = new Map<TaskCategory, { planned: number; actual: number }>();\\n    (Object.keys(TASK_CATEGORY_LABELS) as TaskCategory[]).forEach((c) => byCat.set(c, { planned: 0, actual: 0 }));\\n    data.tasks.forEach((t) => {\\n      const cur = byCat.get(t.category) || { planned: 0, actual: 0 };\\n      cur.planned += t.estimatedMinutes;\\n      cur.actual += t.actualMinutes;\\n      byCat.set(t.category, cur);\\n    });\\n    return Array.from(byCat.entries()).map(([cat, v]) => ({\\n      name: TASK_CATEGORY_LABELS[cat][lang],\\n      planned: v.planned,\\n      actual: v.actual,\\n    }));\\n  }, [data.tasks, lang]);\\n\\n  const commitNewTask = async () => {\\n    await addTask({\\n      title: title.trim(),\\n      priority,\\n      category,\\n      status: \'todo\',\\n      deadline,\\n      scheduledStart: scheduledStart || undefined,\\n      estimatedMinutes: Math.max(5, Number(estimatedMinutes) || 30),\\n      actualMinutes: 0,\\n    });\\n    setTitle(\'\');\\n    setPendingOutOfHoursTask(false);\\n  };\\n\\n  const handleTaskSubmit = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!title.trim()) return;\\n    if (isOutsideWorkingHours(scheduledStart, data.profile.workStartHour, data.profile.workEndHour)) {\\n      setPendingOutOfHoursTask(true);\\n      return;\\n    }\\n    await commitNewTask();\\n  };\\n\\n  const handleAddEvent = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!evtTitle.trim()) return;\\n    await addCalendarEvent({\\n      title: evtTitle.trim(),\\n      calendarType: evtType,\\n      date: evtDate,\\n      startTime: evtStart,\\n      endTime: evtEnd,\\n    });\\n    setEvtTitle(\'\');\\n  };\\n\\n  const selectPreset = (mins: number) => {\\n    setIsRunning(false);\\n    setPresetMinutes(mins);\\n    setSecondsLeft(mins * 60);\\n    setDistractions(0);\\n  };\\n\\n  const logSessionNow = async () => {\\n    const elapsedMins = Math.max(1, Math.round((presetMinutes * 60 - secondsLeft) / 60) || presetMinutes);\\n    setIsRunning(false);\\n    await addFocusSession({\\n      label: focusLabel.trim() || (isAr ? \'\330\254\331\204\330\263\330\251 \330\252\330\261\331\203\331\212\330\262\' : \'Focus Session\'),\\n      durationMinutes: elapsedMins,\\n      distractions,\\n      date: TODAY_ISO,\\n    });\\n    setSecondsLeft(presetMinutes * 60);\\n    setDistractions(0);\\n  };\\n\\n  const mm = String(Math.floor(secondsLeft / 60)).padStart(2, \'0\');\\n  const ss = String(secondsLeft % 60).padStart(2, \'0\');\\n\\n  const tabs: Array<{ id: TimeTab; label: string }> = [\\n    { id: \'tasks\', label: isAr ? \'\330\247\331\204\331\205\331\207\330\247\331\205 \331\210\330\247\331\204\330\254\330\257\331\210\331\204\330\251 \330\247\331\204\330\260\331\203\331\212\330\251\' : \'Smart Tasks\' },\\n    { id: \'calendar\', label: isAr ? \'\330\247\331\204\330\252\331\202\331\210\331\212\331\205\' : \'Calendar\' },\\n    { id: \'focus\', label: isAr ? \'\331\210\330\266\330\271 \330\247\331\204\330\252\330\261\331\203\331\212\330\262 (Pomodoro)\' : \'Focus Mode\' },\\n    { id: \'analytics\', label: isAr ? \'\330\252\330\255\331\204\331\212\331\204\330\247\330\252 \330\247\331\204\331\210\331\202\330\252\' : \'Time Analytics\' },\\n  ];\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      <div>\\n        <h1 className=\\\"text-2xl font-bold text-[#F4F6F8]\\\">{isAr ? \'\330\245\330\257\330\247\330\261\330\251 \330\247\331\204\331\210\331\202\330\252 \331\210\330\247\331\204\330\245\331\206\330\252\330\247\330\254\331\212\330\251\' : \'Time Intelligence\'}</h1>\\n        <p className=\\\"text-xs text-[#8E99A8] mt-1\\\">\\n          {isAr\\n            ? `\330\243\331\210\331\204\331\210\331\212\330\251 \330\247\331\204\330\252\330\261\331\203\331\212\330\262 \330\247\331\204\330\271\331\205\331\212\331\202 \331\201\331\212 \330\247\331\204\330\265\330\250\330\247\330\255 (${data.profile.workStartHour}:00 \342\200\223 ${data.profile.workEndHour}:00) \331\205\330\271 \330\252\331\206\330\250\331\212\331\207 \331\202\330\250\331\204 \330\247\331\204\330\254\330\257\331\210\331\204\330\251 \330\256\330\247\330\261\330\254 \330\263\330\247\330\271\330\247\330\252 \330\247\331\204\330\271\331\205\331\204.`\\n            : `Deep work prioritized during your ${data.profile.peakConcentration} peak (${data.profile.workStartHour}:00\342\200\223${data.profile.workEndHour}:00).`}\\n        </p>\\n      </div>\\n\\n      <div className=\\\"flex items-center gap-1.5 overflow-x-auto pb-1\\\">\\n        {tabs.map((t) => (\\n          <button\\n            key={t.id}\\n            type=\\\"button\\\"\\n            onClick={() => setTab(t.id)}\\n            className={`min-h-[40px] px-3.5 py-2 rounded-xl text-xs font-semibold transition-colors whitespace-nowrap shrink-0 ${\\n              tab === t.id\\n                ? \'bg-emerald-500 text-[#07110C]\'\\n                : \'bg-[#13171C] border border-[#232A33] text-[#A9B3C1] hover:text-[#F4F6F8]\'\\n            }`}\\n          >\\n            {t.label}\\n          </button>\\n        ))}\\n      </div>\\n\\n      {/* TAB 1: SMART TASKS */}\\n      {tab === \'tasks\' ? (\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-5\\\">\\n          <form onSubmit={handleTaskSubmit} className=\\\"lg:col-span-4 bg-[#13171C] border border-[#232A33] rounded-2xl p-5 space-y-4 self-start\\\">\\n            <h2 className=\\\"text-sm font-semibold text-[#F4F6F8]\\\">{isAr ? \'\330\245\330\266\330\247\331\201\330\251 \331\205\331\207\331\205\330\251 \330\254\330\257\331\212\330\257\330\251\' : \'Add Task\'}</h2>\\n            <div>\\n              <label htmlFor=\\\"task-title\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\271\331\206\331\210\330\247\331\206 \330\247\331\204\331\205\331\207\331\205\330\251\' : \'Task Title\'}</label>\\n              <input\\n                id=\\\"task-title\\\"\\n                type=\\\"text\\\"\\n                value={title}\\n                onChange={(e) => setTitle(e.target.value)}\\n                placeholder={isAr ? \'\331\205\330\253\330\247\331\204: \331\205\330\261\330\247\330\254\330\271\330\251 \330\256\330\267\330\251 \330\247\331\204\331\205\330\264\330\261\331\210\330\271\' : \'e.g., Review project roadmap\'}\\n                className=\\\"w-full min-h-[44px] px-3.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\\\"\\n              />\\n            </div>\\n\\n            <div className=\\\"grid grid-cols-2 gap-3\\\">\\n              <div>\\n                <label htmlFor=\\\"task-priority\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\247\331\204\330\243\331\210\331\204\331\210\331\212\330\251\' : \'Priority\'}</label>\\n                <select\\n                  id=\\\"task-priority\\\"\\n                  value={priority}\\n                  onChange={(e) => setPriority(e.target.value as TaskPriority)}\\n                  className=\\\"w-full min-h-[44px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\\\"\\n                >\\n                  {(Object.keys(TASK_PRIORITY_LABELS) as TaskPriority[]).map((p) => (\\n                    <option key={p} value={p}>{TASK_PRIORITY_LABELS[p][lang]}</option>\\n                  ))}\\n                </select>\\n              </div>\\n              <div>\\n                <label htmlFor=\\\"task-cat\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\247\331\204\331\206\331\210\330\271\' : \'Category\'}</label>\\n                <select\\n                  id=\\\"task-cat\\\"\\n                  value={category}\\n                  onChange={(e) => setCategory(e.target.value as TaskCategory)}\\n                  className=\\\"w-full min-h-[44px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\\\"\\n                >\\n                  {(Object.keys(TASK_CATEGORY_LABELS) as TaskCategory[]).map((c) => (\\n                    <option key={c} value={c}>{TASK_CATEGORY_LABELS[c][lang]}</option>\\n                  ))}\\n                </select>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"grid grid-cols-3 gap-2.5\\\">\\n              <div>\\n                <label htmlFor=\\\"task-start\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\247\331\204\331\210\331\202\330\252\' : \'Time\'}</label>\\n                <input\\n                  id=\\\"task-start\\\"\\n                  type=\\\"time\\\"\\n                  value={scheduledStart}\\n                  onChange={(e) => setScheduledStart(e.target.value)}\\n                  className=\\\"w-full min-h-[42px] px-2 rounded-xl bg-[#0B0D10] border border-[#232A33] text-xs font-mono-nums text-[#F4F6F8]\\\"\\n                />\\n              </div>\\n              <div>\\n                <label htmlFor=\\\"task-mins\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\247\331\204\331\205\330\257\330\251 (\330\257)\' : \'Mins\'}</label>\\n                <input\\n                  id=\\\"task-mins\\\"\\n                  type=\\\"number\\\"\\n                  value={estimatedMinutes}\\n                  onChange={(e) => setEstimatedMinutes(e.target.value)}\\n                  className=\\\"w-full min-h-[42px] px-2.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-xs font-mono-nums text-[#F4F6F8]\\\"\\n                />\\n              </div>\\n              <div>\\n                <label htmlFor=\\\"task-dl\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\247\331\204\330\252\330\247\330\261\331\212\330\256\' : \'Date\'}</label>\\n                <input\\n                  id=\\\"task-dl\\\"\\n                  type=\\\"date\\\"\\n                  value={deadline}\\n                  onChange={(e) => setDeadline(e.target.value)}\\n                  className=\\\"w-full min-h-[42px] px-2 rounded-xl bg-[#0B0D10] border border-[#232A33] text-xs font-mono-nums text-[#F4F6F8]\\\"\\n                />\\n              </div>\\n            </div>\\n\\n            <button\\n              type=\\\"submit\\\"\\n              className=\\\"w-full min-h-[44px] rounded-xl bg-emerald-500 text-[#07110C] font-semibold text-sm hover:bg-emerald-400 flex items-center justify-center gap-2\\\"\\n            >\\n              <Plus className=\\\"w-4 h-4\\\" />\\n              {isAr ? \'\330\245\330\266\330\247\331\201\330\251 \331\204\331\204\330\254\330\257\331\210\331\204 \330\247\331\204\330\260\331\203\331\212\' : \'Add to Smart Schedule\'}\\n            </button>\\n          </form>\\n\\n          <div className=\\\"lg:col-span-8 bg-[#13171C] border border-[#232A33] rounded-2xl p-5 divide-y divide-[#1D232C]\\\">\\n            {sortedTasks.map((task) => (\\n              <div key={task.id} className=\\\"py-3.5 flex items-start justify-between gap-3\\\">\\n                <div className=\\\"flex items-start gap-3 min-w-0\\\">\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => void toggleTaskStatus(task.id)}\\n                    aria-label={`${isAr ? \'\330\252\330\250\330\257\331\212\331\204 \330\255\330\247\331\204\330\251\' : \'Toggle status\'} ${task.title}`}\\n                    className={`mt-0.5 min-h-[28px] min-w-[28px] rounded-lg border flex items-center justify-center transition-colors shrink-0 ${\\n                      task.status === \'completed\'\\n                        ? \'bg-emerald-500 border-emerald-500 text-[#07110C]\'\\n                        : \'border-[#33404F] text-transparent hover:border-emerald-400\'\\n                    }`}\\n                  >\\n                    <Check className=\\\"w-4 h-4\\\" />\\n                  </button>\\n                  <div className=\\\"min-w-0\\\">\\n                    <p className={`text-sm font-medium ${task.status === \'completed\' ? \'line-through text-[#6C7787]\' : \'text-[#F4F6F8]\'}`}>\\n                      {task.title}\\n                    </p>\\n                    <p className=\\\"text-xs text-[#8E99A8] mt-0.5\\\">\\n                      <span\\n                        className={\\n                          task.priority === \'critical\'\\n                            ? \'text-red-400\'\\n                            : task.priority === \'high\'\\n                              ? \'text-amber-400\'\\n                              : \'text-[#8E99A8]\'\\n                        }\\n                      >\\n                        {TASK_PRIORITY_LABELS[task.priority][lang]}\\n                      </span>\\n                      {\' \302\267 \'}\\n                      {TASK_CATEGORY_LABELS[task.category][lang]}\\n                      {\' \302\267 \'}\\n                      <span className=\\\"font-mono-nums\\\">\\n                        {task.scheduledStart || \'\342\200\224\'} ({task.estimatedMinutes}{isAr ? \'\330\257\' : \'m\'})\\n                      </span>\\n                    </p>\\n                  </div>\\n                </div>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => void deleteTask(task.id)}\\n                  aria-label={`${isAr ? \'\330\255\330\260\331\201\' : \'Delete\'} ${task.title}`}\\n                  className=\\\"min-h-[36px] min-w-[36px] flex items-center justify-center rounded-lg text-[#758091] hover:text-red-400 shrink-0\\\"\\n                >\\n                  <Trash2 className=\\\"w-4 h-4\\\" />\\n                </button>\\n              </div>\\n            ))}\\n          </div>\\n        </div>\\n      ) : null}\\n\\n      {/* TAB 2: CALENDAR */}\\n      {tab === \'calendar\' ? (\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-5\\\">\\n          <form onSubmit={handleAddEvent} className=\\\"lg:col-span-4 bg-[#13171C] border border-[#232A33] rounded-2xl p-5 space-y-4 self-start\\\">\\n            <h2 className=\\\"text-sm font-semibold text-[#F4F6F8]\\\">{isAr ? \'\330\245\330\266\330\247\331\201\330\251 \331\205\331\210\330\271\330\257 \330\254\330\257\331\212\330\257\' : \'Add Calendar Event\'}</h2>\\n            <div>\\n              <label htmlFor=\\\"evt-title\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\247\330\263\331\205 \330\247\331\204\331\205\331\210\330\271\330\257\' : \'Event Title\'}</label>\\n              <input\\n                id=\\\"evt-title\\\"\\n                type=\\\"text\\\"\\n                value={evtTitle}\\n                onChange={(e) => setEvtTitle(e.target.value)}\\n                className=\\\"w-full min-h-[44px] px-3.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\\\"\\n              />\\n            </div>\\n            <div className=\\\"grid grid-cols-2 gap-3\\\">\\n              <div>\\n                <label htmlFor=\\\"evt-type\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\247\331\204\330\252\331\202\331\210\331\212\331\205\' : \'Calendar\'}</label>\\n                <select\\n                  id=\\\"evt-type\\\"\\n                  value={evtType}\\n                  onChange={(e) => setEvtType(e.target.value as \'work\' | \'personal\')}\\n                  className=\\\"w-full min-h-[44px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\\\"\\n                >\\n                  <option value=\\\"work\\\">{isAr ? \'\330\247\331\204\330\271\331\205\331\204\' : \'Work\'}</option>\\n                  <option value=\\\"personal\\\">{isAr ? \'\330\264\330\256\330\265\331\212\' : \'Personal\'}</option>\\n                </select>\\n              </div>\\n              <div>\\n                <label htmlFor=\\\"evt-date\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\247\331\204\330\252\330\247\330\261\331\212\330\256\' : \'Date\'}</label>\\n                <input\\n                  id=\\\"evt-date\\\"\\n                  type=\\\"date\\\"\\n                  value={evtDate}\\n                  onChange={(e) => setEvtDate(e.target.value)}\\n                  className=\\\"w-full min-h-[44px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-xs font-mono-nums text-[#F4F6F8]\\\"\\n                />\\n              </div>\\n            </div>\\n            <div className=\\\"grid grid-cols-2 gap-3\\\">\\n              <div>\\n                <label htmlFor=\\\"evt-start\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\331\205\331\206\' : \'Start\'}</label>\\n                <input\\n                  id=\\\"evt-start\\\"\\n                  type=\\\"time\\\"\\n                  value={evtStart}\\n                  onChange={(e) => setEvtStart(e.target.value)}\\n                  className=\\\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-xs font-mono-nums text-[#F4F6F8]\\\"\\n                />\\n              </div>\\n              <div>\\n                <label htmlFor=\\\"evt-end\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\245\331\204\331\211\' : \'End\'}</label>\\n                <input\\n                  id=\\\"evt-end\\\"\\n                  type=\\\"time\\\"\\n                  value={evtEnd}\\n                  onChange={(e) => setEvtEnd(e.target.value)}\\n                  className=\\\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-xs font-mono-nums text-[#F4F6F8]\\\"\\n                />\\n              </div>\\n            </div>\\n            <button type=\\\"submit\\\" className=\\\"w-full min-h-[44px] rounded-xl bg-emerald-500 text-[#07110C] font-semibold text-sm hover:bg-emerald-400\\\">\\n              {isAr ? \'\330\245\330\266\330\247\331\201\330\251 \331\204\331\204\330\252\331\202\331\210\331\212\331\205\' : \'Create Event\'}\\n            </button>\\n          </form>\\n\\n          <div className=\\\"lg:col-span-8 bg-[#13171C] border border-[#232A33] rounded-2xl p-5 space-y-4\\\">\\n            <div className=\\\"flex items-center justify-between gap-3\\\">\\n              <div className=\\\"flex items-center gap-1.5\\\">\\n                {([\'all\', \'work\', \'personal\'] as const).map((f) => (\\n                  <button\\n                    key={f}\\n                    type=\\\"button\\\"\\n                    onClick={() => setCalFilter(f)}\\n                    className={`min-h-[34px] px-3 rounded-lg text-xs font-medium ${\\n                      calFilter === f ? \'bg-[#232A33] text-[#F4F6F8]\' : \'text-[#8E99A8] hover:text-[#F4F6F8]\'\\n                    }`}\\n                  >\\n                    {f === \'all\' ? (isAr ? \'\330\247\331\204\331\203\331\204\' : \'All\') : f === \'work\' ? (isAr ? \'\330\247\331\204\330\271\331\205\331\204\' : \'Work\') : (isAr ? \'\330\264\330\256\330\265\331\212\' : \'Personal\')}\\n                  </button>\\n                ))}\\n              </div>\\n              <span className=\\\"text-xs text-[#8E99A8]\\\">\\n                {isAr ? \'\331\205\330\262\330\247\331\205\331\206\330\251 Google Calendar: \331\205\330\252\330\247\330\255\330\251 \331\205\331\206 \330\265\331\201\330\255\330\251 \330\247\331\204\330\255\330\263\330\247\330\250\330\247\330\252 \330\247\331\204\331\205\330\252\330\265\331\204\330\251\' : \'Google Calendar sync: configure in Connected Accounts\'}\\n              </span>\\n            </div>\\n\\n            <div className=\\\"divide-y divide-[#1D232C]\\\">\\n              {filteredEvents.map((ev) => (\\n                <div key={ev.id} className=\\\"py-3.5 flex items-center justify-between gap-3\\\">\\n                  <div>\\n                    <p className=\\\"text-sm font-medium text-[#F4F6F8]\\\">{ev.title}</p>\\n                    <p className=\\\"text-xs text-[#8E99A8] font-mono-nums mt-0.5\\\">\\n                      {ev.date} \302\267 {ev.startTime}\342\200\223{ev.endTime} \302\267 {ev.calendarType === \'work\' ? (isAr ? \'\330\271\331\205\331\204\' : \'Work\') : (isAr ? \'\330\264\330\256\330\265\331\212\' : \'Personal\')}\\n                    </p>\\n                  </div>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => setConfirmDeleteEvent({ id: ev.id, title: ev.title })}\\n                    aria-label={`${isAr ? \'\330\255\330\260\331\201 \331\205\331\210\330\271\330\257\' : \'Delete event\'} ${ev.title}`}\\n                    className=\\\"min-h-[36px] min-w-[36px] flex items-center justify-center rounded-lg text-[#758091] hover:text-red-400\\\"\\n                  >\\n                    <Trash2 className=\\\"w-4 h-4\\\" />\\n                  </button>\\n                </div>\\n              ))}\\n            </div>\\n          </div>\\n        </div>\\n      ) : null}\\n\\n      {/* TAB 3: FOCUS MODE */}\\n      {tab === \'focus\' ? (\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-5\\\">\\n          <div className=\\\"lg:col-span-6 bg-[#13171C] border border-[#232A33] rounded-2xl p-6 flex flex-col items-center text-center space-y-5\\\">\\n            <div className=\\\"flex items-center gap-2\\\">\\n              {[25, 50, 15].map((m) => (\\n                <button\\n                  key={m}\\n                  type=\\\"button\\\"\\n                  onClick={() => selectPreset(m)}\\n                  className={`min-h-[38px] px-3.5 rounded-xl text-xs font-mono-nums font-semibold ${\\n                    presetMinutes === m ? \'bg-emerald-500 text-[#07110C]\' : \'bg-[#0B0D10] border border-[#232A33] text-[#A9B3C1]\'\\n                  }`}\\n                >\\n                  {m} {isAr ? \'\330\257\331\202\331\212\331\202\330\251\' : \'min\'}\\n                </button>\\n              ))}\\n            </div>\\n\\n            <input\\n              type=\\\"text\\\"\\n              value={focusLabel}\\n              onChange={(e) => setFocusLabel(e.target.value)}\\n              aria-label={isAr ? \'\330\271\331\206\331\210\330\247\331\206 \330\254\331\204\330\263\330\251 \330\247\331\204\330\252\330\261\331\203\331\212\330\262\' : \'Focus session label\'}\\n              className=\\\"w-full max-w-xs text-center min-h-[40px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\\\"\\n            />\\n\\n            <p className=\\\"text-6xl font-bold font-mono-nums text-[#F4F6F8] tracking-tight\\\" data-testid=\\\"focus-timer-display\\\">\\n              {mm}:{ss}\\n            </p>\\n\\n            <div className=\\\"flex flex-wrap items-center justify-center gap-3\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setIsRunning((r) => !r)}\\n                className=\\\"min-h-[44px] px-6 rounded-xl bg-emerald-500 text-[#07110C] font-semibold text-sm hover:bg-emerald-400 flex items-center gap-2\\\"\\n              >\\n                {isRunning ? <Pause className=\\\"w-4 h-4\\\" /> : <Play className=\\\"w-4 h-4\\\" />}\\n                {isRunning ? (isAr ? \'\330\245\331\212\331\202\330\247\331\201 \331\205\330\244\331\202\330\252\' : \'Pause\') : (isAr ? \'\330\247\330\250\330\257\330\243 \330\247\331\204\330\252\330\261\331\203\331\212\330\262\' : \'Start Focus\')}\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => selectPreset(presetMinutes)}\\n                aria-label={isAr ? \'\330\245\330\271\330\247\330\257\330\251 \330\266\330\250\330\267 \330\247\331\204\331\205\330\244\331\202\330\252\' : \'Reset timer\'}\\n                className=\\\"min-h-[44px] min-w-[44px] rounded-xl bg-[#191F27] border border-[#232A33] text-[#C8D0DC] flex items-center justify-center\\\"\\n              >\\n                <RotateCcw className=\\\"w-4 h-4\\\" />\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setDistractions((d) => d + 1)}\\n                className=\\\"min-h-[44px] px-3.5 rounded-xl bg-[#191F27] border border-[#232A33] text-xs font-medium text-amber-300\\\"\\n              >\\n                {isAr ? `\330\252\330\263\330\254\331\212\331\204 \331\205\331\202\330\247\330\267\330\271\330\251 (${distractions})` : `Log Distraction (${distractions})`}\\n              </button>\\n            </div>\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => void logSessionNow()}\\n              className=\\\"text-xs text-emerald-400 hover:underline pt-1\\\"\\n            >\\n              {isAr ? \'\330\245\331\206\331\207\330\247\330\241 \331\210\330\252\330\263\330\254\331\212\331\204 \330\247\331\204\330\254\331\204\330\263\330\251 \331\201\331\212 \330\247\331\204\330\263\330\254\331\204\' : \'Finish & Save Session to History\'}\\n            </button>\\n          </div>\\n\\n          <div className=\\\"lg:col-span-6 bg-[#13171C] border border-[#232A33] rounded-2xl p-5 space-y-4\\\">\\n            <h2 className=\\\"text-sm font-semibold text-[#F4F6F8]\\\">{isAr ? \'\330\263\330\254\331\204 \330\254\331\204\330\263\330\247\330\252 \330\247\331\204\330\252\330\261\331\203\331\212\330\262\' : \'Focus Session History\'}</h2>\\n            <div className=\\\"divide-y divide-[#1D232C]\\\">\\n              {data.focusSessions.map((s) => (\\n                <div key={s.id} className=\\\"py-3 flex items-center justify-between text-xs\\\">\\n                  <div>\\n                    <p className=\\\"text-sm font-medium text-[#F4F6F8]\\\">{s.label}</p>\\n                    <p className=\\\"text-[#8E99A8] font-mono-nums mt-0.5\\\">\\n                      {s.date} \302\267 {isAr ? `${s.distractions} \331\205\331\202\330\247\330\267\330\271\330\247\330\252` : `${s.distractions} distractions`}\\n                    </p>\\n                  </div>\\n                  <span className=\\\"font-mono-nums font-semibold text-emerald-400\\\">\\n                    {s.durationMinutes} {isAr ? \'\330\257\331\202\331\212\331\202\330\251\' : \'min\'}\\n                  </span>\\n                </div>\\n              ))}\\n            </div>\\n          </div>\\n        </div>\\n      ) : null}\\n\\n      {/* TAB 4: TIME ANALYTICS */}\\n      {tab === \'analytics\' ? (\\n        <div className=\\\"bg-[#13171C] border border-[#232A33] rounded-2xl p-5 space-y-4\\\">\\n          <h2 className=\\\"text-sm font-semibold text-[#F4F6F8]\\\">\\n            {isAr ? \'\330\247\331\204\331\210\331\202\330\252 \330\247\331\204\331\205\330\256\330\267\330\267 \331\205\331\202\330\247\330\250\331\204 \330\247\331\204\331\210\331\202\330\252 \330\247\331\204\331\201\330\271\331\204\331\212 \330\255\330\263\330\250 \330\247\331\204\331\206\331\210\330\271 (\330\250\330\247\331\204\330\257\331\202\330\247\330\246\331\202)\' : \'Planned vs Actual Time by Category (Minutes)\'}\\n          </h2>\\n          <div className=\\\"h-72 w-full\\\" dir=\\\"ltr\\\">\\n            <ResponsiveContainer width=\\\"100%\\\" height=\\\"100%\\\">\\n              <BarChart data={timeAnalytics} margin={{ top: 8, right: 12, left: 0, bottom: 8 }}>\\n                <CartesianGrid stroke=\\\"#232A33\\\" strokeDasharray=\\\"3 3\\\" vertical={false} />\\n                <XAxis dataKey=\\\"name\\\" tick={{ fill: \'#8E99A8\', fontSize: 11 }} axisLine={false} tickLine={false} />\\n                <YAxis tick={{ fill: \'#8E99A8\', fontSize: 11 }} axisLine={false} tickLine={false} />\\n                <Tooltip\\n                  contentStyle={{ backgroundColor: \'#0B0D10\', border: \'1px solid #232A33\', borderRadius: 12, color: \'#F4F6F8\', fontSize: 12 }}\\n                />\\n                <Bar dataKey=\\\"planned\\\" name={isAr ? \'\330\247\331\204\331\205\330\256\330\267\330\267\' : \'Planned\'} fill=\\\"#3B82F6\\\" radius={[6, 6, 0, 0]} />\\n                <Bar dataKey=\\\"actual\\\" name={isAr ? \'\330\247\331\204\331\201\330\271\331\204\331\212\' : \'Actual\'} fill=\\\"#34D399\\\" radius={[6, 6, 0, 0]} />\\n              </BarChart>\\n            </ResponsiveContainer>\\n          </div>\\n        </div>\\n      ) : null}\\n\\n      <ConfirmDialog\\n        open={pendingOutOfHoursTask}\\n        title={isAr ? \'\330\252\330\243\331\203\331\212\330\257 \330\254\330\257\331\210\331\204\330\251 \330\256\330\247\330\261\330\254 \330\263\330\247\330\271\330\247\330\252 \330\247\331\204\330\271\331\205\331\204\' : \'Schedule Outside Working Hours?\'}\\n        description={\\n          isAr\\n            ? `\330\247\331\204\331\205\331\210\330\271\330\257 \330\247\331\204\331\205\330\256\330\252\330\247\330\261 (${scheduledStart}) \331\212\331\202\330\271 \330\256\330\247\330\261\330\254 \330\263\330\247\330\271\330\247\330\252 \330\271\331\205\331\204\331\203 \330\247\331\204\331\205\330\255\330\257\330\257\330\251 (${data.profile.workStartHour}:00 \342\200\223 ${data.profile.workEndHour}:00). \331\207\331\204 \330\252\330\261\331\212\330\257 \330\252\330\243\331\203\331\212\330\257 \330\254\330\257\331\210\331\204\330\251 \330\247\331\204\331\205\331\207\331\205\330\251 \331\201\331\212 \331\207\330\260\330\247 \330\247\331\204\331\210\331\202\330\252\330\237`\\n            : `The selected time (${scheduledStart}) is outside your working hours (${data.profile.workStartHour}:00\342\200\223${data.profile.workEndHour}:00). Confirm scheduling anyway?`\\n        }\\n        confirmLabel={isAr ? \'\330\252\330\243\331\203\331\212\330\257 \330\247\331\204\330\254\330\257\331\210\331\204\330\251\' : \'Confirm Schedule\'}\\n        cancelLabel={isAr ? \'\330\252\330\271\330\257\331\212\331\204 \330\247\331\204\331\210\331\202\330\252\' : \'Adjust Time\'}\\n        onConfirm={() => void commitNewTask()}\\n        onCancel={() => setPendingOutOfHoursTask(false)}\\n      />\\n\\n      <ConfirmDialog\\n        open={Boolean(confirmDeleteEvent)}\\n        title={isAr ? \'\330\255\330\260\331\201 \331\205\331\210\330\271\330\257 \331\205\331\206 \330\247\331\204\330\252\331\202\331\210\331\212\331\205\' : \'Delete Calendar Event\'}\\n        description={\\n          isAr\\n            ? `\331\207\331\204 \330\252\330\261\331\212\330\257 \330\255\330\260\331\201 \\\"${confirmDeleteEvent?.title}\\\" \331\205\331\206 \330\247\331\204\330\252\331\202\331\210\331\212\331\205\330\237`\\n            : `Delete \\\"${confirmDeleteEvent?.title}\\\" from your calendar?`\\n        }\\n        confirmLabel={isAr ? \'\330\255\330\260\331\201 \330\247\331\204\331\205\331\210\330\271\330\257\' : \'Delete Event\'}\\n        cancelLabel={isAr ? \'\330\245\331\204\330\272\330\247\330\241\' : \'Cancel\'}\\n        tone=\\\"danger\\\"\\n        onConfirm={async () => {\\n          if (confirmDeleteEvent) await deleteCalendarEvent(confirmDeleteEvent.id);\\n          setConfirmDeleteEvent(null);\\n        }}\\n        onCancel={() => setConfirmDeleteEvent(null)}\\n      />\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create Module 03 Time Intelligence with Smart Morning Schedule, outside-hours guard, Calendar, live Focus Pomodoro timer, and Time Analytics chart\", \"Overwrite\":true, \"TargetFile\":\"/src/components/TimeModule.tsx\", \"toolAction\":\"Creating TimeModule component\", \"toolSummary\":\"Create TimeModule\"}"
      original_name: "write_to_file"
