              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    <li key={idx} className=\"flex items-start gap-2 text-xs sm:text-sm text-[#C8D0DC]\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                      <CheckCircle2 className=\"w-4 h-4 text-emerald-400 shrink-0 mt-0.5\" />"
