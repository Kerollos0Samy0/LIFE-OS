              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              : isAr ? \'\330\252\331\210\331\204\331\212\330\257 \331\205\331\204\330\256\330\265 \330\247\331\204\331\212\331\210\331\205\' : \'Generate Today\342\200\231s Briefing\'}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          </button>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
