      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Ensure JetBrains Mono falls back to Cairo for Arabic units like \330\254.\331\205 so Arabic letters never disconnect in monospace numeric spans\", \"EndLine\":44, \"Instruction\":\"Include Cairo and Plus Jakarta Sans in --font-mono fallback stack before generic monospace\", \"ReplacementContent\":\"    --font-ar: \\\"Cairo\\\", \\\"Plus Jakarta Sans\\\", system-ui, sans-serif;\\n    --font-en: \\\"Plus Jakarta Sans\\\", \\\"Cairo\\\", system-ui, sans-serif;\\n    --font-mono: \\\"JetBrains Mono\\\", \\\"Cairo\\\", \\\"Plus Jakarta Sans\\\", sans-serif;\", \"StartLine\":6, \"TargetContent\":\"    --font-ar: \\\"Cairo\\\", \\\"Plus Jakarta Sans\\\", system-ui, sans-serif;\\n    --font-en: \\\"Plus Jakarta Sans\\\", \\\"Cairo\\\", system-ui, sans-serif;\\n    --font-mono: \\\"JetBrains Mono\\\", ui-monospace, SFMono-Regular, monospace;\", \"TargetFile\":\"/src/index.css\", \"toolAction\":\"Fixing Arabic fallback in font-mono-nums\", \"toolSummary\":\"Fix Arabic monospace fallback\"}"
