              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                    <p className=\"text-[#8E99A8] font-mono-nums mt-0.5\">"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                      {s.date} \302\267 {isAr ? `${s.distractions} \331\205\331\202\330\247\330\267\330\271\330\247\330\252` : `${s.distractions} distractions`}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
