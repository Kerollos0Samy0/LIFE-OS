            }
            lines {
              text: "              {isAr ? \'\330\247\330\263\330\252\330\256\330\261\330\247\330\254 \331\205\330\271\330\247\331\205\331\204\330\251 \331\205\331\206 \330\261\330\263\330\247\331\204\330\251 \330\245\331\212\330\265\330\247\331\204 / \330\245\330\264\330\271\330\247\330\261 \330\250\331\206\331\203\331\212 (\331\202\330\261\330\247\330\241\330\251 \331\201\331\202\330\267)\' : \'Financial Email / Notification Receipt Extractor\'}"
