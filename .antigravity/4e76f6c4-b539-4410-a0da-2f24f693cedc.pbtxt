              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                  <span className=\"font-mono-nums font-semibold text-emerald-400\">"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                    {s.durationMinutes} {isAr ? \'\330\257\331\202\331\212\331\202\330\251\' : \'min\'}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                  </span>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                </div>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              ))}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
