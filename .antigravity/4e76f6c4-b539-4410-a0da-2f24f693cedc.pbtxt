              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                {isAr ? \'\330\247\331\204\331\206\330\267\330\247\331\202 / \330\247\331\204\330\252\330\265\331\206\331\212\331\201\' : \'Category\'}"
