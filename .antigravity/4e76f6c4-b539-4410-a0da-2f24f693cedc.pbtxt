      thinking_signature: "\022\330\023\n\325\023\001i\024}\023\221\247[\203K\023\247\024\314\300\344\'\033o\257\255k\346|\313R\035\035\302\327*\371\343\020s\356\360#\002\231\271\214\004\363\223\315M\354\361\307\333^w\037C\203\370\267\347|\334\003\202\322\347e\205\365z\365U\\\305\275n\235\252\372nRB\025\351E\022\264m\250D\270\204\004y\205\371\255\315\351K\325\t\302-\263\340JK\261\227\364:\337x\016\233\325A*9\300\216\366,\275mq\357N\360]w?z-\305\330\274\211\261\253p\235\367%(js\257\365\016\b\364\332\236\342)\333f<\325\\\004\331\0348i\313\255\020mG7\367Z0C{\244\334\342\376\351\301x{O4\336\322\255*\272k\021\270\036\365\203\344Q&\r\312\312N-\220\367\350\314\034A\363\216\361\334\2041{\257\232\342\030[\2432\032\362\366\032#{u\323J\232\210\267\257k<A\324LF\201}\033e\207\253\031I\331\340\257\300\240L\vn\225q\242\262M\365j41\203\277\331\"O\022\016L\261\335,\022\241\271\337+u\333\247 c\030\351.\016O\343\352\256#\025\335\334\260\231\300\006IX\n\237T\270\356\266RE2\026\342\272\3774\242,\303\312\355\336\346\252\004\205\261\017\006\363\257\250\353i\315a\203\021ZlfV\324\260<M\362\245\334\177\035\307\227\021\372OQW\262\324\33320\266>\331;qe\177H\321\362\250\253K\250\325\032H?\223\223\221\266\232`\372\345)7\r\224O\316l/\362\222X\264\264\255\321U)K\371H\220\264v\321\351r\251O\373\343\363\323D\360/w\342\a\004\317\337\301\364\210M\'\034\362\035\272\324\323\207\236\304\035\016t\371\0023I\365$\005f\342\232xMj\277\315\2605\367\315\270k~|\314&s\357\236\2661\f\300\006\224\307\226\227\214\212]^\363.\354\032\357\314\226\227\376\275\235\226\257\235a\345_J\204\020\201\035\261LD\\\021\336\276\310\370\247\265\262D\303p\315}\374\216n\272\032\266H\206{*[\251\303\035\360\324$\253\265\337\202R\375q\231\353RV9\375\364\027b\272\2411`.>3\375\271\303\003\263B\212\354\264*\211\361\016F\351H\304\345\025mP\363\350\270\n\244\272o0Tc8\374\244\340\361H\017X\t\005\004\f\037\377\305.\177?eJ\276\273`\217L\a\231\317\360C-+\235JD\246\373h\341\2053\257\206Nj\265\234r\304\216\033v\035\236\337\267\025\037\336\324p\305{\343\307F.\276\235\266\312\252c\003;\025\212,]\034\313\330\"\343\323g\373\334\247\307|\225_\254ay\2754s\313\202\037\306\214\365I\003\203\243\245\201\212)d\214-BU&\260\213x0\302\225T0c\035c\360\260\'\206V\373\022\b_\305\034\245\\\2203\304\314\270X\277\364\025\246s.\237\331\207\030\"\311\273\213\210sR\366\034\023\306\177,\371H(dhIN\271\277~\231\177\361e\241\267|8\312\006\306\362{/\351{<\335\221\273u\370S\034\355zJ\b\363\230y\221[\276\227\340sf-l\370\234\340\257\377W\355\324/\260cZF\224\316\253\342D\345Ab\375d\261\352:\203\316\367z\341\034\367-\254\366\350\251\n\356Y\207\242wk\321\f\360\254 \276\204\210\265S2K@\024\202k\033{SCU\2325\022\302\307JV\t\035\362V\361\326+\225\0327\275\276(0\256\035\373\r\322\f\203\334;a-\017SG(\255\017\241f\340\337Y\"\177\272\212\260\362\341[D\v\205\270P\300#\213z_>s\356@\326\320N\027\032\230\222O\377\002\227@B\211\311\033\371\272\271\317\001:u\221s\025{\236\373e\r35#\274\346\002\367\340\aF\3572|N\277b\277!,\274\251\022\235]\242\323\264Oi\t\2048\243\230A\000\v\0338<#Uj\363\273\035\312vM\\8S\310\240\314\346\242 \303\274\354\316\366\217\320\'@\221\205\204\361\214\206f3\002\000\024\352\261\'6y\\)\305I\2011\361\322\262\003?\227\332\354\2313\271\345td\2633\240\016\261\033\324\035\203\364\221\361\365\370\326\266\221vp\300\366\255\273u\277l\n.\361+\272[\263\346^.\177\244I\035\243\336\366_D\310\0262\203K8\251\374qw(\n6\370\001s-c\341C\326\205?\275\232\301\3216zt\264_\271\031\025\006\322\030\323\036\274&\303\376{\177\322\231\276\025\317\235\017\323Lis\324Tm\366\237o\034)\370%Yh*\021{\213 \317\226\302\343N\224$A\252r\204\335\226#W*\263*\234\006\373:\306\267\363\217\212\305\t\253\027n\210\023D\021\251T\214\324\261\035>\367\271\245O\345\250\240THB\000I\223i|\354(\3369\030\363\223]\331\332\352lE\023\363\273C\235As\367~l\264Q\346\301\230K\220\200O\200\223\366\312h;K\376\262yPg3Q\310\277\343\321\201\242\246\022\001)\300\361)\252\313\025\353\354C\231s\262\337\352\305t\335\262\220\212Pt4]\017\366\2173\024\371\177\227\353\177\230G*\256\235!\325\342\353\3409\