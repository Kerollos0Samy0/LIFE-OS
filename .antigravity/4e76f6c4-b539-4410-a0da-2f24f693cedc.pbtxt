    command_line: "trap \'playwright-cli close\' EXIT\nplaywright-cli open --browser=chromium http://localhost:3000 && \\\n  playwright-cli resize 1440 900 && \\\n  playwright-cli run-code \'async (page) => {\n    // 1. Navigate to Finance\n    await page.getByRole(\"button\", { name: \"\330\247\331\204\331\205\330\247\331\204\331\212\330\247\330\252\" }).first().click();\n    await page.waitForTimeout(500);\n    await page.screenshot({ path: \".playwright-cli/r1-finance.png\" });\n\n    const cashBefore = await page.getByTestId(\"finance-available-cash\").textContent();\n    const pendingBefore = await page.getByTestId(\"finance-pending-receivables\").textContent();\n\n    // 2. Add Expense (250 EGP)\n    await page.getByRole(\"button\", { name: \"\330\247\331\204\331\205\330\265\330\247\330\261\331\212\331\201\" }).click();\n    await page.getByLabel(\"\330\247\331\204\331\210\330\265\331\201\").fill(\"\330\271\330\264\330\247\330\241 \330\252\330\254\330\261\331\212\330\250\331\212\");\n    await page.getByLabel(\"\330\247\331\204\331\205\330\250\331\204\330\272 (\330\254.\331\205)\").fill(\"250\");\n    await page.getByRole(\"button\", { name: \"\330\255\331\201\330\270 \330\247\331\204\331\205\330\265\330\261\331\210\331\201\" }).click();\n    await page.waitForTimeout(250);\n    const cashAfterExpense = await page.getByTestId(\"finance-available-cash\").textContent();\n\n    // 3. Add Unpaid Freelance Invoice (5000 EGP invoiced) -> cash MUST stay unchanged, pending MUST increase by 5000!\n    await page.getByRole(\"button\", { name: \"\330\247\331\204\330\257\330\256\331\204 \331\210\330\247\331\204\331\201\330\261\331\212\331\204\330\247\331\206\330\263\" }).click();\n    await page.getByLabel(\"\330\247\331\204\330\271\331\206\331\210\330\247\331\206\").fill(\"\331\205\330\264\330\261\331\210\330\271 \331\201\330\261\331\212\331\204\330\247\331\206\330\263 \330\272\331\212\330\261 \331\205\330\257\331\201\331\210\330\271\");\n    await page.getByLabel(\"\330\247\331\204\331\205\330\250\331\204\330\272 \330\247\331\204\330\245\330\254\331\205\330\247\331\204\331\212 (\330\254.\331\205)\").fill(\"5000\");\n    await page.getByRole(\"button\", { name: \"\330\255\331\201\330\270 \330\263\330\254\331\204 \330\247\331\204\330\257\330\256\331\204\" }).click();\n    await page.waitForTimeout(250);\n    const cashAfterUnpaid = await page.getByTestId(\"finance-available-cash\").textContent();\n    const pendingAfterUnpaid = await page.getByTestId(\"finance-pending-receivables\").textContent();\n\n    // 4. Navigate to Time & test Focus Timer\n    await page.getByRole(\"button\", { name: \"\330\247\331\204\331\210\331\202\330\252\" }).first().click();\n    await page.getByRole(\"button\", { name: \"\331\210\330\266\330\271 \330\247\331\204\330\252\330\261\331\203\331\212\330\262 (Pomodoro)\" }).click();\n    await page.getByRole(\"button\", { name: \"\330\247\330\250\330\257\330\243 \330\247\331\204\330\252\330\261\331\203\331\212\330\262\" }).click();\n    await page.waitForTimeout(1200);\n    const timerVal = await page.getByTestId(\"focus-timer-display\").textContent();\n\n    // 5. Switch to English LTR\n    await page.getByRole(\"button\", { name: /English/ }).first().click();\n    await page.waitForTimeout(300);\n    const dirAfterFlip = await page.evaluate(() => document.documentElement.dir);\n    await page.screenshot({ path: \".playwright-cli/r1-en-ltr.png\" });\n\n    console.log(JSON.stringify({\n      cashBefore,\n      cashAfterExpense,\n      cashAfterUnpaid,\n      pendingBefore,\n      pendingAfterUnpaid,\n      timerVal,\n      dirAfterFlip\n    }));\n  }\' && \\\n  playwright-cli console"
