      arguments_json: "{\"Description\":\"Add DailyMicroGoal persistence, Firestore listener, seed support, and CRUD helpers to LifeOsContext\", \"Instruction\":\"Import DailyMicroGoal, load fallback in loadLocalDataset, bind daily_micro_goals listener, seed in seedCloudFromSample, and add upsertDailyMicroGoal, updateDailyMicroGoalProgress, deleteDailyMicroGoal\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":43, \"ReplacementContent\":\"  CalendarEvent,\\n  DailyMicroGoal,\\n  EnergyLog,\\n  ExpenseRecord,\\n  FocusSession,\\n  HealthLog,\\n  IncomeRecord,\\n  InvestmentAsset,\\n  Language,\\n  LifeOsDataset,\\n  PersonalGoal,\\n  SavingsGoal,\\n  TaskItem,\\n  UserProfile,\\n} from \'../types/lifeos\';\", \"StartLine\":29, \"TargetContent\":\"  CalendarEvent,\\n  EnergyLog,\\n  ExpenseRecord,\\n  FocusSession,\\n  HealthLog,\\n  IncomeRecord,\\n  InvestmentAsset,\\n  Language,\\n  LifeOsDataset,\\n  PersonalGoal,\\n  SavingsGoal,\\n  TaskItem,\\n  UserProfile,\\n} from \'../types/lifeos\';\"}, {\"AllowMultiple\":false, \"EndLine\":64, \"ReplacementContent\":\"      return {\\n        ...fallback,\\n        ...parsed,\\n        profile: { ...fallback.profile, ...(parsed.profile || {}) },\\n        dailyMicroGoals: Array.isArray(parsed.dailyMicroGoals) ? parsed.dailyMicroGoals : fallback.dailyMicroGoals,\\n        aiUsage: { ...fallback.aiUsage, ...(parsed.aiUsage || {}) },\\n      };\", \"StartLine\":56, \"TargetContent\":\"      return {\\n        ...fallback,\\n        ...parsed,\\n        profile: { ...fallback.profile, ...(parsed.profile || {}) },\\n        aiUsage: { ...fallback.aiUsage, ...(parsed.aiUsage || {}) },\\n      };\"}, {\"AllowMultiple\":false, \"EndLine\":116, \"ReplacementContent\":\"  // Goals\\n  addGoal: (item: Omit<PersonalGoal, \'id\' | \'userId\'>) => Promise<void>;\\n  toggleGoalMilestone: (goalId: string, milestoneId: string) => Promise<void>;\\n  appendGoalMilestones: (goalId: string, titles: string[]) => Promise<void>;\\n  deleteGoal: (id: string) => Promise<void>;\\n  // Daily Micro-Goal\\n  upsertDailyMicroGoal: (item: Omit<DailyMicroGoal, \'id\' | \'userId\'>) => Promise<void>;\\n  updateDailyMicroGoalProgress: (id: string, currentValue: number) => Promise<void>;\\n  deleteDailyMicroGoal: (id: string) => Promise<void>;\\n  // AI Usage tracking\", \"StartLine\":109, \"TargetContent\":\"  // Goals\\n  addGoal: (item: Omit<PersonalGoal, \'id\' | \'userId\'>) => Promise<void>;\\n  toggleGoalMilestone: (goalId: string, milestoneId: string) => Promise<void>;\\n  appendGoalMilestones: (goalId: string, titles: string[]) => Promise<void>;\\n  deleteGoal: (id: string) => Promise<void>;\\n  // AI Usage tracking\"}, {\"AllowMultiple\":false, \"EndLine\":265, \"ReplacementContent\":\"    bindCollection<EnergyLog>(\'energy_logs\', \'energyLogs\');\\n    bindCollection<PersonalGoal>(\'goals\', \'goals\');\\n    bindCollection<DailyMicroGoal>(\'daily_micro_goals\', \'dailyMicroGoals\');\", \"StartLine\":260, \"TargetContent\":\"    bindCollection<EnergyLog>(\'energy_logs\', \'energyLogs\');\\n    bindCollection<PersonalGoal>(\'goals\', \'goals\');\"}, {\"AllowMultiple\":false, \"EndLine\":328, \"ReplacementContent\":\"    sample.goals.forEach(({ id, ...rest }) => {\\n      batch.set(doc(db, \'users\', uid, \'goals\', id), { ...rest, userId: uid, createdAt: ts, updatedAt: ts });\\n    });\\n    sample.dailyMicroGoals.forEach(({ id, ...rest }) => {\\n      batch.set(doc(db, \'users\', uid, \'daily_micro_goals\', id), { ...rest, userId: uid, createdAt: ts, updatedAt: ts });\\n    });\", \"StartLine\":322, \"TargetContent\":\"    sample.goals.forEach(({ id, ...rest }) => {\\n      batch.set(doc(db, \'users\', uid, \'goals\', id), { ...rest, userId: uid, createdAt: ts, updatedAt: ts });\\n    });\"}, {\"AllowMultiple\":false, \"EndLine\":1091, \"ReplacementContent\":\"  const deleteGoal = useCallback(\\n    async (id: string) => {\\n      if (isCloudMode && user) {\\n        try {\\n          await deleteDoc(doc(db, \'users\', user.uid, \'goals\', id));\\n        } catch (err) {\\n          handleFirestoreError(err, OperationType.DELETE, `users/${user.uid}/goals/${id}`);\\n        }\\n      } else {\\n        setData((prev) => ({ ...prev, goals: prev.goals.filter((g) => g.id !== id) }));\\n      }\\n    },\\n    [isCloudMode, user],\\n  );\\n\\n  // --- Daily Micro-Goals ---\\n  const upsertDailyMicroGoal = useCallback(\\n    async (item: Omit<DailyMicroGoal, \'id\' | \'userId\'>) => {\\n      const cleanDate = item.date.trim().slice(0, 32) || TODAY_ISO;\\n      const id = `mg-${cleanDate.replace(/[^0-9]/g, \'\') || \'today\'}`;\\n      const uid = user?.uid || \'local-demo-user\';\\n      const existing = data.dailyMicroGoals.find((g) => g.date === cleanDate || g.id === id);\\n      const cleanTitle = item.title.trim().slice(0, 140);\\n      if (!cleanTitle) return;\\n      const cleanUnit = item.unit.trim().slice(0, 32) || \'units\';\\n      const cleanTarget = Math.min(100000, Math.max(1, Math.round(item.targetValue)));\\n      const cleanCurrent = Math.min(100000, Math.max(0, Math.round(item.currentValue)));\\n      const completed = Boolean(item.completed || cleanCurrent >= cleanTarget);\\n\\n      const record: DailyMicroGoal = {\\n        id: existing?.id || id,\\n        userId: uid,\\n        date: cleanDate,\\n        title: cleanTitle,\\n        category: item.category,\\n        targetValue: cleanTarget,\\n        currentValue: cleanCurrent,\\n        unit: cleanUnit,\\n        completed,\\n      };\\n\\n      if (isCloudMode && user) {\\n        const path = `users/${user.uid}/daily_micro_goals/${record.id}`;\\n        try {\\n          const payload = {\\n            userId: user.uid,\\n            date: record.date,\\n            title: record.title,\\n            category: record.category,\\n            targetValue: record.targetValue,\\n            currentValue: record.currentValue,\\n            unit: record.unit,\\n            completed: record.completed,\\n            updatedAt: serverTimestamp(),\\n          };\\n          if (existing) {\\n            await updateDoc(doc(db, \'users\', user.uid, \'daily_micro_goals\', record.id), {\\n              date: record.date,\\n              title: record.title,\\n              category: record.category,\\n              targetValue: record.targetValue,\\n              currentValue: record.currentValue,\\n              unit: record.unit,\\n              completed: record.completed,\\n              updatedAt: serverTimestamp(),\\n            });\\n          } else {\\n            await setDoc(doc(db, \'users\', user.uid, \'daily_micro_goals\', record.id), {\\n              ...payload,\\n              createdAt: serverTimestamp(),\\n            });\\n          }\\n        } catch (err) {\\n          handleFirestoreError(err, OperationType.WRITE, path);\\n        }\\n      } else {\\n        setData((prev) => ({\\n          ...prev,\\n          dailyMicroGoals: existing\\n            ? prev.dailyMicroGoals.map((g) => (g.id === record.id ? record : g))\\n            : [record, ...prev.dailyMicroGoals],\\n        }));\\n      }\\n    },\\n    [data.dailyMicroGoals, isCloudMode, user],\\n  );\\n\\n  const updateDailyMicroGoalProgress = useCallback(\\n    async (id: string, currentValue: number) => {\\n      const target = data.dailyMicroGoals.find((g) => g.id === id);\\n      if (!target) return;\\n      const nextCurrent = Math.min(100000, Math.max(0, Math.round(currentValue)));\\n      const nextCompleted = nextCurrent >= target.targetValue;\\n      if (isCloudMode && user) {\\n        const path = `users/${user.uid}/daily_micro_goals/${id}`;\\n        try {\\n          await updateDoc(doc(db, \'users\', user.uid, \'daily_micro_goals\', id), {\\n            currentValue: nextCurrent,\\n            completed: nextCompleted,\\n            updatedAt: serverTimestamp(),\\n          });\\n        } catch (err) {\\n          handleFirestoreError(err, OperationType.UPDATE, path);\\n        }\\n      } else {\\n        setData((prev) => ({\\n          ...prev,\\n          dailyMicroGoals: prev.dailyMicroGoals.map((g) =>\\n            g.id === id ? { ...g, currentValue: nextCurrent, completed: nextCompleted } : g,\\n          ),\\n        }));\\n      }\\n    },\\n    [data.dailyMicroGoals, isCloudMode, user],\\n  );\\n\\n  const deleteDailyMicroGoal = useCallback(\\n    async (id: string) => {\\n      if (isCloudMode && user) {\\n        const path = `users/${user.uid}/daily_micro_goals/${id}`;\\n        try {\\n          await deleteDoc(doc(db, \'users\', user.uid, \'daily_micro_goals\', id));\\n        } catch (err) {\\n          handleFirestoreError(err, OperationType.DELETE, path);\\n        }\\n      } else {\\n        setData((prev) => ({\\n          ...prev,\\n          dailyMicroGoals: prev.dailyMicroGoals.filter((g) => g.id !== id),\\n        }));\\n      }\\n    },\\n    [isCloudMode, user],\\n  );\", \"StartLine\":1074, \"TargetContent\":\"  const deleteGoal = useCallback(\\n    async (id: string) => {\\n      if (isCloudMode && user) {\\n        try {\\n          await deleteDoc(doc(db, \'users\', user.uid, \'goals\', id));\\n        } catch (err) {\\n          handleFirestoreError(err, OperationType.DELETE, `users/${user.uid}/goals/${id}`);\\n        }\\n      } else {\\n        setData((prev) => ({ ...prev, goals: prev.goals.filter((g) => g.id !== id) }));\\n      }\\n    },\\n    [isCloudMode, user],\\n  );\"}, {\"AllowMultiple\":false, \"EndLine\":1182, \"ReplacementContent\":\"        appendGoalMilestones,\\n        deleteGoal,\\n        upsertDailyMicroGoal,\\n        updateDailyMicroGoalProgress,\\n        deleteDailyMicroGoal,\\n        recordAiUsage,\", \"StartLine\":1173, \"TargetContent\":\"        appendGoalMilestones,\\n        deleteGoal,\\n        recordAiUsage,\"}], \"TargetFile\":\"/src/context/LifeOsContext.tsx\", \"toolAction\":\"Updating LifeOsContext for micro-goals\", \"toolSummary\":\"Update LifeOsContext.tsx\"}"
