            }
            lines {
              text: "            <div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <p className=\"font-semibold text-[#F4F6F8] mb-1\">{isAr ? \'\330\247\331\204\331\205\330\247\331\204\331\212\330\247\330\252\' : \'Finance\'}</p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                {isAr"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  ? `\331\205\330\271\330\257\331\204 \330\247\331\204\330\247\330\257\330\256\330\247\330\261 \330\247\331\204\330\264\331\207\330\261\331\212 \330\247\331\204\330\255\330\247\331\204\331\212 ${metrics.savingsRate}% \331\205\330\271 ${metrics.overdueInvoices.length} \331\201\330\247\330\252\331\210\330\261\330\251 \331\201\330\261\331\212\331\204\330\247\331\206\330\263 \331\205\330\252\330\243\330\256\330\261\330\251 \330\252\330\255\330\252\330\247\330\254 \331\205\330\252\330\247\330\250\330\271\330\251.`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  : `Current monthly savings rate is ${metrics.savingsRate}% with ${metrics.overdueInvoices.length} overdue freelance invoice(s).`}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              </p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            <div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <p className=\"font-semibold text-[#F4F6F8] mb-1\">{isAr ? \'\330\247\331\204\330\245\331\206\330\252\330\247\330\254\331\212\330\251\' : \'Productivity\'}</p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
