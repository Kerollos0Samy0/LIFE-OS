              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {/* AI Daily Briefing Section */}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      <section className=\"bg-[#13171C] border border-[#232A33] rounded-2xl p-6 space-y-4\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          <div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            <h2 className=\"text-base font-semibold text-[#F4F6F8] flex items-center gap-2\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <Sparkles className=\"w-4 h-4 text-emerald-400\" />"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              {isAr ? \'\330\247\331\204\331\205\331\204\330\256\330\265 \330\247\331\204\331\212\331\210\331\205\331\212 \330\247\331\204\330\260\331\203\331\212 (AI Daily Briefing)\' : \'AI Daily Briefing\'}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            </h2>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            <p className=\"text-xs text-[#8E99A8] mt-0.5\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              {isAr"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                ? \'\330\252\330\255\331\204\331\212\331\204 \331\205\330\256\330\252\330\265\330\261 \331\205\330\250\331\206\331\212 \331\201\331\202\330\267 \330\271\331\204\331\211 \330\243\330\261\331\202\330\247\331\205\331\203 \330\247\331\204\331\201\330\271\331\204\331\212\330\251 \330\271\330\250\330\261 Gemini Flash-Lite \342\200\224 \330\250\330\257\331\210\331\206 \330\250\331\212\330\247\331\206\330\247\330\252 \331\205\330\256\330\252\331\204\331\202\330\251.\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                : \'Concise briefing grounded strictly in your recorded metrics via Gemini Flash-Lite.\'}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
