            }
            lines {
              text: "              ? \'\330\247\331\204\330\265\331\202 \331\206\330\265 \330\245\330\264\330\271\330\247\330\261 \330\257\331\201\330\271 \330\243\331\210 \330\245\331\212\330\265\330\247\331\204 \330\264\330\261\330\247\330\241 \331\204\330\252\330\255\331\204\331\212\331\204\331\207 \331\203\330\250\331\212\330\247\331\206\330\247\330\252 \330\272\331\212\330\261 \331\205\331\210\330\253\331\210\331\202\330\251 \330\271\330\250\330\261 Gemini Flash-Lite\330\214 \330\253\331\205 \330\261\330\247\330\254\330\271\331\207 \331\202\330\250\331\204 \330\247\331\204\330\255\331\201\330\270.\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
