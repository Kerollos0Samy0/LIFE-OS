  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useMemo, useState } from \'react\';\nimport { Check, Loader2, Send, Sparkles } from \'lucide-react\';\nimport { useLifeOs } from \'../context/LifeOsContext\';\nimport { CURRENT_MONTH, TODAY_ISO } from \'../data/seedData\';\nimport {\n  calculateAvailableCashPiasters,\n  calculatePendingReceivablesPiasters,\n  calculateTotalExpensesPiasters,\n  calculateTotalPaidIncomePiasters,\n  egpToPiasters,\n} from \'../utils/finance\';\nimport { calculateEnergyEstimate } from \'../utils/energy\';\nimport type { AiChatMessage, AiModelId, TaskCategory, TaskPriority } from \'../types/lifeos\';\n\ntype AiDomain = \'general\' | \'finance\' | \'productivity\' | \'health\';\n\nexport const LifeAiModule: React.FC = () => {\n  const { data, lang, recordAiUsage, addExpense, addTask } = useLifeOs();\n  const isAr = lang === \'ar\';\n\n  const [domain, setDomain] = useState<AiDomain>(\'general\');\n  const [model, setModel] = useState<AiModelId>(data.profile.aiDefaultModel);\n  const [input, setInput] = useState(\'\');\n  const [loading, setLoading] = useState(false);\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\n  const [messages, setMessages] = useState<AiChatMessage[]>([\n    {\n      id: \'welcome-ai\',\n      role: \'assistant\',\n      content: isAr\n        ? \'\330\243\331\207\331\204\330\247\331\213 \330\250\331\203 \331\201\331\212 LIFE AI. \330\250\331\202\330\261\330\243 \331\201\331\202\330\267 \330\247\331\204\330\250\331\212\330\247\331\206\330\247\330\252 \330\247\331\204\331\205\330\267\331\204\331\210\330\250\330\251 \331\204\330\263\330\244\330\247\331\204\331\203 (\330\247\331\204\331\205\330\247\331\204\331\212\330\251\330\214 \330\247\331\204\330\245\331\206\330\252\330\247\330\254\331\212\330\251\330\214 \330\247\331\204\330\265\330\255\330\251\330\214 \330\243\331\210 \330\247\331\204\331\205\330\261\330\247\330\254\330\271\330\251 \330\247\331\204\330\243\330\263\330\250\331\210\330\271\331\212\330\251) \331\210\330\250\330\263\330\252\330\243\330\260\331\206\331\203 \331\202\330\250\331\204 \330\252\331\206\331\201\331\212\330\260 \330\243\331\212 \330\252\330\271\330\257\331\212\331\204 \330\243\331\210 \330\245\330\266\330\247\331\201\330\251.\'\n        : \'Welcome to LIFE AI. I query only the minimum scoped context for your question and always ask for confirmation before saving any changes.\',\n      timestamp: TODAY_ISO,\n    },\n  ]);\n\n  // Scoped minimal context selector (never dumps the entire database!)\n  const scopedContext = useMemo(() => {\n    const availableCashEgp = calculateAvailableCashPiasters(data.incomeRecords, data.expenseRecords) / 100;\n    const paidIncomeEgp = calculateTotalPaidIncomePiasters(data.incomeRecords, CURRENT_MONTH) / 100;\n    const monthExpensesEgp = calculateTotalExpensesPiasters(data.expenseRecords, CURRENT_MONTH) / 100;\n    const pendingFreelanceEgp = calculatePendingReceivablesPiasters(data.incomeRecords) / 100;\n\n    if (domain === \'finance\') {\n      return {\n        currency: \'EGP\',\n        availableCashEgp,\n        paidIncomeEgp,\n        monthExpensesEgp,\n        pendingFreelanceEgp,\n        recentExpenses: data.expenseRecords.slice(0, 6).map((e) => ({\n          desc: e.description,\n          egp: e.amountPiasters / 100,\n          cat: e.category,\n          date: e.date,\n        })),\n        budgetsCount: data.budgets.length,\n        savingsGoalsCount: data.savingsGoals.length,\n      };\n    }\n    if (domain === \'productivity\') {\n      return {\n        peakConcentration: data.profile.peakConcentration,\n        workHours: `${data.profile.workStartHour}:00-${data.profile.workEndHour}:00`,\n        pendingTasks: data.tasks\n          .filter((t) => t.status !== \'completed\')\n          .slice(0, 6)\n          .map((t) => ({ title: t.title, priority: t.priority, category: t.category, mins: t.estimatedMinutes })),\n        focusSessionsToday: data.focusSessions.filter((f) => f.date === TODAY_ISO).length,\n      };\n    }\n    if (domain === \'health\') {\n      const latestHealth = [...data.healthLogs].sort((a, b) => b.date.localeCompare(a.date))[0];\n      const energy = calculateEnergyEstimate({\n        healthLogs: data.healthLogs,\n        appUsageLogs: data.appUsageLogs,\n        energyLogs: data.energyLogs,\n        dailyStepTarget: data.profile.dailyStepTarget,\n        targetSleepHours: data.profile.targetSleepHours,\n        peakConcentration: data.profile.peakConcentration,\n      });\n      return {\n        sleepHours: latestHealth?.sleepHours ?? \'unavailable\',\n        steps: latestHealth?.steps ?? \'unavailable\',\n        restingHr: latestHealth?.restingHeartRate ?? \'unavailable\',\n        estimatedEnergyScore: energy.estimatedScore ?? \'unavailable\',\n        nighttimeScreenMins: energy.measuredFactors.nighttimeScreenMinutes ?? \'unavailable\',\n      };\n    }\n    return {\n      availableCashEgp,\n      monthExpensesEgp,\n      pendingFreelanceEgp,\n      openTasksCount: data.tasks.filter((t) => t.status !== \'completed\').length,\n      activeGoalsCount: data.goals.length,\n      peakConcentration: data.profile.peakConcentration,\n    };\n  }, [data, domain]);\n\n  const quotaReached = data.aiUsage.requestsToday >= data.profile.aiDailyLimit;\n\n  const sendMessage = async (textToSend?: string) => {\n    const cleanText = (textToSend ?? input).trim();\n    if (!cleanText || loading) return;\n    if (quotaReached) {\n      setErrorMsg(\n        isAr\n          ? `\331\210\330\265\331\204\330\252 \331\204\331\204\330\255\330\257 \330\247\331\204\331\212\331\210\331\205\331\212 \330\247\331\204\331\205\330\255\330\257\330\257 (${data.profile.aiDailyLimit} \330\267\331\204\330\250). \331\212\331\205\331\203\331\206\331\203 \330\252\330\271\330\257\331\212\331\204\331\207 \331\205\331\206 \330\247\331\204\330\245\330\271\330\257\330\247\330\257\330\247\330\252.`\n          : `Daily AI request limit (${data.profile.aiDailyLimit}) reached. Adjust it in Settings.`,\n      );\n      return;\n    }\n\n    setErrorMsg(null);\n    const userMsg: AiChatMessage = {\n      id: `u-${Date.now()}`,\n      role: \'user\',\n      content: cleanText,\n      timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n    };\n    setMessages((prev) => [...prev, userMsg]);\n    setInput(\'\');\n    setLoading(true);\n\n    try {\n      const res = await fetch(\'/api/ai/chat\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          message: cleanText,\n          language: lang,\n          domain,\n          model,\n          context: scopedContext,\n          history: messages.slice(-5).map((m) => ({ role: m.role, content: m.content })),\n        }),\n      });\n      const json = await res.json();\n      if (!res.ok) {\n        throw new Error(json.error || \'LIFE AI error\');\n      }\n\n      const tokensUsed = Number(json.tokensUsed || 0);\n      recordAiUsage(model, tokensUsed);\n\n      const aiMsg: AiChatMessage = {\n        id: `a-${Date.now()}`,\n        role: \'assistant\',\n        content: json.reply || \'\',\n        model,\n        tokensUsed,\n        proposal: json.proposal,\n        timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n      };\n      setMessages((prev) => [...prev, aiMsg]);\n    } catch (err) {\n      setErrorMsg(err instanceof Error ? err.message : \'Request failed\');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleConfirmProposal = async (msg: AiChatMessage) => {\n    if (!msg.proposal || msg.proposalApplied) return;\n    const p = msg.proposal;\n    if (p.type === \'add_expense\') {\n      await addExpense({\n        description: String(p.payload.description || \'Expense\'),\n        amountPiasters: egpToPiasters(Number(p.payload.amountEgp || 0)),\n        currency: \'EGP\',\n        category: String(p.payload.category || \'other\'),\n        date: TODAY_ISO,\n        paymentMethod: \'cash\',\n        entrySource: \'manual\',\n        recurring: false,\n      });\n    } else if (p.type === \'add_task\') {\n      await addTask({\n        title: String(p.payload.title || \'New Task\'),\n        priority: (p.payload.priority as TaskPriority) || \'medium\',\n        category: (p.payload.category as TaskCategory) || \'deep_work\',\n        status: \'todo\',\n        deadline: TODAY_ISO,\n        estimatedMinutes: Number(p.payload.estimatedMinutes || 45),\n        actualMinutes: 0,\n      });\n    }\n    setMessages((prev) =>\n      prev.map((m) => (m.id === msg.id ? { ...m, proposalApplied: true } : m)),\n    );\n  };\n\n  const quickPrompts = isAr\n    ? [\n        \'\331\204\330\256\331\221\330\265 \331\210\330\266\330\271\331\212 \330\247\331\204\331\205\330\247\331\204\331\212 \331\207\330\260\330\247 \330\247\331\204\330\264\331\207\330\261 \331\210\330\247\331\202\330\252\330\261\330\255 \330\252\330\255\330\263\331\212\331\206 \331\204\331\204\331\205\331\212\330\262\330\247\331\206\331\212\330\251\',\n        \'\330\261\330\252\331\221\330\250 \331\205\331\207\330\247\331\205\331\212 \330\247\331\204\331\205\330\252\330\250\331\202\331\212\330\251 \330\255\330\263\330\250 \330\260\330\261\331\210\330\251 \330\252\330\261\331\203\331\212\330\262\331\212 \330\247\331\204\330\265\330\250\330\247\330\255\331\212\330\251\',\n        \'\330\263\330\254\331\221\331\204 \331\205\330\265\330\261\331\210\331\201 120 \330\254\331\206\331\212\331\207 \331\202\331\207\331\210\330\251 \331\210\330\264\330\247\331\212 \330\247\331\204\331\206\331\207\330\247\330\261\330\257\331\207\',\n      ]\n    : [\n        \'Summarize my monthly cash flow and budget improvements\',\n        \'Prioritize my remaining tasks around my morning peak\',\n        \'Add an expense of 120 EGP for coffee today\',\n      ];\n\n  return (\n    <div className=\"space-y-5\">\n      <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n        <div>\n          <h1 className=\"text-2xl font-bold text-[#F4F6F8] flex items-center gap-2\">\n            <Sparkles className=\"w-5 h-5 text-emerald-400\" />\n            LIFE AI\n          </h1>\n          <p className=\"text-xs text-[#8E99A8] mt-1\">\n            {isAr\n              ? \'\331\205\330\263\330\247\330\271\330\257\331\203 \330\247\331\204\330\264\330\256\330\265\331\212 \330\271\330\250\330\261 Gemini API \331\205\331\206 \330\247\331\204\330\256\330\247\330\257\331\205 \342\200\224 \330\252\331\210\330\254\331\212\331\207 \330\260\331\203\331\212 \331\204\331\204\331\206\331\205\330\247\330\260\330\254 \331\210\331\205\331\210\330\247\331\201\331\202\330\251 \330\245\331\204\330\262\330\247\331\205\331\212\330\251 \331\202\330\250\331\204 \330\243\331\212 \330\252\330\271\330\257\331\212\331\204.\'\n              : \'Server-side Gemini personal assistant with model routing, minimal scoped context, and action confirmation.\'}\n          </p>\n        </div>\n\n        {/* AI Usage & Cost Quota Stats */}\n        <div className=\"text-xs text-[#8E99A8] font-mono-nums flex flex-wrap items-center gap-3\">\n          <span>\n            {isAr ? \'\330\247\331\204\330\267\331\204\330\250\330\247\330\252 \330\247\331\204\331\212\331\210\331\205:\' : \'Today:\'}{\' \'}\n            <strong className=\"text-[#F4F6F8]\">\n              {data.aiUsage.requestsToday}/{data.profile.aiDailyLimit}\n            </strong>\n          </span>\n          <span>\302\267</span>\n          <span>\n            {isAr ? \'\330\247\331\204\330\252\331\210\331\203\331\206\330\262 \331\207\330\260\330\247 \330\247\331\204\330\264\331\207\330\261:\' : \'Tokens/mo:\'}{\' \'}\n            <strong className=\"text-[#F4F6F8]\">{data.aiUsage.tokensThisMonth.toLocaleString(\'en-US\')}</strong>\n          </span>\n        </div>\n      </div>\n\n      {/* Domain & Model Routing Controls */}\n      <div className=\"bg-[#13171C] border border-[#232A33] rounded-2xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n        <div className=\"flex items-center gap-1.5 overflow-x-auto\">\n          {(\n            [\n              { id: \'general\', label: isAr ? \'\331\205\330\261\330\247\330\254\330\271\330\251 \330\271\330\247\331\205\330\251\' : \'General\' },\n              { id: \'finance\', label: isAr ? \'\330\247\331\204\331\205\330\247\331\204\331\212\330\251\' : \'Finance\' },\n              { id: \'productivity\', label: isAr ? \'\330\247\331\204\330\245\331\206\330\252\330\247\330\254\331\212\330\251\' : \'Productivity\' },\n              { id: \'health\', label: isAr ? \'\330\247\331\204\330\265\330\255\330\251\' : \'Health\' },\n            ] as const\n          ).map((d) => (\n            <button\n              key={d.id}\n              type=\"button\"\n              onClick={() => setDomain(d.id)}\n              className={`min-h-[36px] px-3 rounded-xl text-xs font-semibold transition-colors whitespace-nowrap ${\n                domain === d.id ? \'bg-emerald-500 text-[#07110C]\' : \'text-[#A9B3C1] hover:bg-[#1B212A]\'\n              }`}\n            >\n              {d.label}\n            </button>\n          ))}\n        </div>\n\n        <div className=\"flex items-center gap-2 shrink-0\">\n          <label htmlFor=\"ai-model-select\" className=\"text-xs text-[#8E99A8] whitespace-nowrap\">\n            {isAr ? \'\330\247\331\204\331\206\331\205\331\210\330\260\330\254:\' : \'Model:\'}\n          </label>\n          <select\n            id=\"ai-model-select\"\n            value={model}\n            onChange={(e) => setModel(e.target.value as AiModelId)}\n            className=\"min-h-[36px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-xs font-mono-nums text-[#F4F6F8]\"\n          >\n            <option value=\"gemini-3.1-flash-lite\">Gemini Flash-Lite ({isAr ? \'\330\263\330\261\331\212\330\271 \331\210\330\247\331\202\330\252\330\265\330\247\330\257\331\212\' : \'Fast / Low Cost\'})</option>\n            <option value=\"gemini-4-hydrogen\">Gemini Flash ({isAr ? \'\330\252\330\255\331\204\331\212\331\204 \330\243\330\271\331\205\331\202\' : \'Deep Analysis\'})</option>\n          </select>\n        </div>\n      </div>\n\n      {/* Chat Thread */}\n      <div className=\"bg-[#13171C] border border-[#232A33] rounded-2xl p-5 flex flex-col gap-4 min-h-[380px] max-h-[540px]\">\n        <div className=\"flex-1 overflow-y-auto space-y-4 pe-1\">\n          {messages.map((msg) => (\n            <div\n              key={msg.id}\n              className={`flex flex-col ${msg.role === \'user\' ? \'items-end\' : \'items-start\'}`}\n            >\n              <div\n                className={`max-w-[85%] rounded-2xl px-4 py-3 text-sm leading-relaxed whitespace-pre-wrap ${\n                  msg.role === \'user\'\n                    ? \'bg-emerald-500/15 border border-emerald-500/30 text-[#F4F6F8]\'\n                    : \'bg-[#0B0D10] border border-[#232A33] text-[#DCE3EC]\'\n                }`}\n              >\n                <p>{msg.content}</p>\n                {msg.proposal ? (\n                  <div className=\"mt-3 pt-3 border-t border-[#232A33] space-y-2.5\">\n                    <p className=\"text-xs font-semibold text-amber-300\">\n                      {isAr ? \'\330\245\330\254\330\261\330\247\330\241 \331\205\331\202\330\252\330\261\330\255 \331\212\330\255\330\252\330\247\330\254 \330\252\330\243\331\203\331\212\330\257\331\203:\' : \'Proposed action awaiting confirmation:\'}\n                    </p>\n                    <p className=\"text-xs text-[#F4F6F8]\">{msg.proposal.summary}</p>\n                    <button\n                      type=\"button\"\n                      disabled={msg.proposalApplied}\n                      onClick={() => void handleConfirmProposal(msg)}\n                      className=\"min-h-[36px] px-3.5 rounded-xl bg-emerald-500 text-[#07110C] text-xs font-semibold hover:bg-emerald-400 disabled:opacity-60 inline-flex items-center gap-1.5\"\n                    >\n                      <Check className=\"w-3.5 h-3.5\" />\n                      {msg.proposalApplied\n                        ? isAr ? \'\330\252\331\205 \330\247\331\204\330\252\331\206\331\201\331\212\330\260 \331\210\330\247\331\204\330\255\331\201\330\270\' : \'Confirmed & Saved\'\n                        : isAr ? \'\330\252\330\243\331\203\331\212\330\257 \331\210\330\252\331\206\331\201\331\212\330\260\' : \'Confirm & Apply\'}\n                    </button>\n                  </div>\n                ) : null}\n              </div>\n              <span className=\"text-[11px] text-[#6C7787] font-mono-nums mt-1 px-1\">\n                {msg.timestamp}\n                {msg.model ? ` \302\267 ${msg.model}` : \'\'}\n                {msg.tokensUsed ? ` \302\267 ${msg.tokensUsed} tok` : \'\'}\n              </span>\n            </div>\n          ))}\n          {loading ? (\n            <div className=\"flex items-center gap-2 text-xs text-[#8E99A8]\">\n              <Loader2 className=\"w-4 h-4 animate-spin text-emerald-400\" />\n              {isAr ? \'LIFE AI \331\212\330\255\331\204\331\204 \330\250\331\212\330\247\331\206\330\247\330\252\331\203 \330\247\331\204\331\205\330\255\330\257\330\257\330\251...\' : \'LIFE AI is analyzing your scoped metrics...\'}\n            </div>\n          ) : null}\n        </div>\n\n        {errorMsg ? (\n          <div className=\"p-3 rounded-xl bg-red-500/10 border border-red-500/30 text-xs text-red-300\">\n            {errorMsg}\n          </div>\n        ) : null}\n\n        <div className=\"flex flex-wrap gap-2 text-xs\">\n          {quickPrompts.map((p, idx) => (\n            <button\n              key={idx}\n              type=\"button\"\n              onClick={() => void sendMessage(p)}\n              className=\"px-3 py-1.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-[#A9B3C1] hover:text-emerald-400 hover:border-emerald-500/40 transition-colors\"\n            >\n              {p}\n            </button>\n          ))}\n        </div>\n\n        <form\n          onSubmit={(e) => {\n            e.preventDefault();\n            void sendMessage();\n          }}\n          className=\"flex gap-2 pt-2 border-t border-[#232A33]\"\n        >\n          <input\n            type=\"text\"\n            value={input}\n            onChange={(e) => setInput(e.target.value)}\n            placeholder={isAr ? \'\330\247\330\263\330\243\331\204 \330\271\331\206 \331\205\330\265\330\247\330\261\331\212\331\201\331\203\330\214 \331\205\331\207\330\247\331\205\331\203\330\214 \331\206\331\210\331\205\331\203\330\214 \330\243\331\210 \330\247\330\267\331\204\330\250 \331\205\330\261\330\247\330\254\330\271\330\251 \330\243\330\263\330\250\331\210\330\271\331\212\330\251...\' : \'Ask about spending, schedule, sleep, or weekly review...\'}\n            aria-label={isAr ? \'\330\261\330\263\330\247\331\204\330\251 \330\245\331\204\331\211 LIFE AI\' : \'Message LIFE AI\'}\n            className=\"flex-1 min-h-[44px] px-4 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8] focus:outline-none focus:border-emerald-500\"\n          />\n          <button\n            type=\"submit\"\n            disabled={loading || !input.trim()}\n            aria-label={isAr ? \'\330\245\330\261\330\263\330\247\331\204\' : \'Send\'}\n            className=\"min-h-[44px] px-5 rounded-xl bg-emerald-500 text-[#07110C] font-semibold text-sm hover:bg-emerald-400 disabled:opacity-50 flex items-center gap-2\"\n          >\n            <Send className=\"w-4 h-4\" />\n            <span className=\"hidden sm:inline\">{isAr ? \'\330\245\330\261\330\263\330\247\331\204\' : \'Send\'}</span>\n          </button>\n        </form>\n      </div>\n    </div>\n  );\n};\n"
