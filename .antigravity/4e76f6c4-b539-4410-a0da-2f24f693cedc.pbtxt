              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              >"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                {isAr ? `\330\252\330\263\330\254\331\212\331\204 \331\205\331\202\330\247\330\267\330\271\330\251 (${distractions})` : `Log Distraction (${distractions})`}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              </button>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            </div>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            <button"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              type=\"button\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              onClick={() => void logSessionNow()}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              className=\"text-xs text-emerald-400 hover:underline pt-1\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            >"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              {isAr ? \'\330\245\331\206\331\207\330\247\330\241 \331\210\330\252\330\263\330\254\331\212\331\204 \330\247\331\204\330\254\331\204\330\263\330\251 \331\201\331\212 \330\247\331\204\330\263\330\254\331\204\' : \'Finish & Save Session to History\'}"
