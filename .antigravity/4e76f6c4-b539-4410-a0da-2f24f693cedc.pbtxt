              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                <Bar dataKey=\"actual\" name={isAr ? \'\330\247\331\204\331\201\330\271\331\204\331\212\' : \'Actual\'} fill=\"#34D399\" radius={[6, 6, 0, 0]} />"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "                <Bar dataKey=\"planned\" name={isAr ? \'\330\247\331\204\331\205\330\256\330\267\330\267\' : \'Planned\'} fill=\"#3B82F6\" radius={[6, 6, 0, 0]} isAnimationActive={false} />"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                <Bar dataKey=\"actual\" name={isAr ? \'\330\247\331\204\331\201\330\271\331\204\331\212\' : \'Actual\'} fill=\"#34D399\" radius={[6, 6, 0, 0]} isAnimationActive={false} />"
