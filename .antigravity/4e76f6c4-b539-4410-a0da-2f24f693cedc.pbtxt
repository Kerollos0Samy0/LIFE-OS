\'\330\247\330\254\330\252\331\205\330\247\330\271\331\212\', en: \'Social\' },\\n};\\n\\nexport const UI_TEXT = {\\n  ar: {\\n    brandTagline: \'\330\247\331\201\331\207\331\205 \330\255\331\212\330\247\330\252\331\203. \330\243\330\257\330\261 \331\205\330\263\330\252\331\202\330\250\331\204\331\203.\',\\n    nav: {\\n      home: \'\330\247\331\204\330\261\330\246\331\212\330\263\331\212\330\251\',\\n      finance: \'\330\247\331\204\331\205\330\247\331\204\331\212\330\247\330\252\',\\n      time: \'\330\247\331\204\331\210\331\202\330\252\',\\n      health: \'\330\247\331\204\330\265\330\255\330\251\',\\n      ai: \'LIFE AI\',\\n      wellbeing: \'\330\247\331\204\330\261\331\201\330\247\331\207\331\212\330\251 \330\247\331\204\330\261\331\202\331\205\331\212\330\251\',\\n      goals: \'\330\247\331\204\330\243\331\207\330\257\330\247\331\201\',\\n      reports: \'\330\247\331\204\330\252\331\202\330\247\330\261\331\212\330\261\',\\n      connections: \'\330\247\331\204\330\255\330\263\330\247\330\250\330\247\330\252 \330\247\331\204\331\205\330\252\330\265\331\204\330\251\',\\n      settings: \'\330\247\331\204\330\245\330\271\330\257\330\247\330\257\330\247\330\252\',\\n      more: \'\330\247\331\204\331\205\330\262\331\212\330\257\',\\n    },\\n    auth: {\\n      signInGoogle: \'\330\252\330\263\330\254\331\212\331\204 \330\247\331\204\330\257\330\256\331\210\331\204 \330\250\331\200 Google\',\\n      signOut: \'\330\252\330\263\330\254\331\212\331\204 \330\247\331\204\330\256\330\261\331\210\330\254\',\\n      cloudSynced: \'\331\205\330\252\330\265\331\204 \330\250\331\200 Cloud Firestore\',\\n      localSampleMode: \'\331\210\330\266\330\271 \330\252\330\254\330\261\331\212\330\250\331\212 \331\205\330\255\331\204\331\212\',\\n      syncNotice: \'\330\247\331\204\330\250\331\212\330\247\331\206\330\247\330\252 \330\247\331\204\331\205\330\271\330\261\331\210\330\266\330\251 \330\252\330\254\330\261\331\212\330\250\331\212\330\251 \331\210\331\205\330\255\