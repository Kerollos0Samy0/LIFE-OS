          target_content: "import React, { useMemo, useState } from \'react\';\nimport {\n  Activity,\n  ArrowUpLeft,\n  ArrowUpRight,\n  CalendarClock,\n  CheckCircle2,\n  Loader2,\n  Mic,\n  RefreshCw,\n  Sparkles,\n  Wallet,\n  Zap,\n} from \'lucide-react\';\nimport { useLifeOs } from \'../context/LifeOsContext\';"
          replacement_content: "import React, { useMemo, useState } from \'react\';\nimport {\n  Activity,\n  ArrowUpLeft,\n  ArrowUpRight,\n  CalendarClock,\n  CheckCircle2,\n  Loader2,\n  Mic,\n  Minus,\n  Pencil,\n  Plus,\n  RefreshCw,\n  Sparkles,\n  Target,\n  Wallet,\n  Zap,\n} from \'lucide-react\';\nimport { useLifeOs } from \'../context/LifeOsContext\';\nimport { DailyMicroGoalModal } from \'./DailyMicroGoalModal\';"
          start_line: 1
          end_line: 16
        }
        replacement_chunks {
          target_content: "import type { NavDestination } from \'../types/lifeos\';\n\ninterface DailyBriefingResponse {\n  financialObservation: string;\n  productivityObservation: string;\n  healthObservation: string;\n  importantReminder: string;\n  recommendations: string[];\n}\n\ninterface HomeDashboardProps {\n  onNavigate: (dest: NavDestination) => void;\n  onOpenVoiceExpense: () => void;\n}\n\nexport const HomeDashboard: React.FC<HomeDashboardProps> = ({ onNavigate, onOpenVoiceExpense }) => {\n  const { data, lang, recordAiUsage, isCloudMode, signInWithGoogle, seedCloudFromSample } = useLifeOs();\n  const isAr = lang === \'ar\';\n\n  const [briefing, setBriefing] = useState<DailyBriefingResponse | null>(null);\n  const [briefingLoading, setBriefingLoading] = useState(false);\n  const [briefingError, setBriefingError] = useState<string | null>(null);"
          replacement_content: "import type { MicroGoalCategory, NavDestination } from \'../types/lifeos\';\n\nconst MICRO_GOAL_CATEGORY_LABELS: Record<MicroGoalCategory, { ar: string; en: string }> = {\n  focus: { ar: \'\330\247\331\204\330\252\330\261\331\203\331\212\330\262\', en: \'Focus\' },\n  finance: { ar: \'\330\247\331\204\331\205\330\247\331\204\331\212\330\247\330\252\', en: \'Finance\' },\n  health: { ar: \'\330\247\331\204\330\265\330\255\330\251\', en: \'Health\' },\n  wellbeing: { ar: \'\330\247\331\204\330\252\331\210\330\247\330\262\331\206 \330\247\331\204\330\261\331\202\331\205\331\212\', en: \'Wellbeing\' },\n  personal: { ar: \'\330\264\330\256\330\265\331\212\', en: \'Personal\' },\n};\n\nfunction getMicroGoalStep(targetValue: number): number {\n  if (targetValue >= 2000) return 500;\n  if (targetValue >= 500) return 100;\n  if (targetValue >= 60) return 15;\n  if (targetValue >= 20) return 5;\n  return 1;\n}\n\ninterface DailyBriefingResponse {\n  financialObservation: string;\n  productivityObservation: string;\n  healthObservation: string;\n  importantReminder: string;\n  recommendations: string[];\n}\n\ninterface HomeDashboardProps {\n  onNavigate: (dest: NavDestination) => void;\n  onOpenVoiceExpense: () => void;\n}\n\nexport const HomeDashboard: React.FC<HomeDashboardProps> = ({ onNavigate, onOpenVoiceExpense }) => {\n  const {\n    data,\n    lang,\n    recordAiUsage,\n    isCloudMode,\n    signInWithGoogle,\n    seedCloudFromSample,\n    updateDailyMicroGoalProgress,\n  } = useLifeOs();\n  const isAr = lang === \'ar\';\n\n  const [briefing, setBriefing] = useState<DailyBriefingResponse | null>(null);\n  const [briefingLoading, setBriefingLoading] = useState(false);\n  const [briefingError, setBriefingError] = useState<string | null>(null);\n  const [microGoalModalOpen, setMicroGoalModalOpen] = useState(false);\n\n  const todayMicroGoal = useMemo(\n    () => data.dailyMicroGoals.find((g) => g.date === TODAY_ISO) || null,\n    [data.dailyMicroGoals],\n  );\n\n  const microGoalPct = todayMicroGoal\n    ? Math.min(100, Math.round((todayMicroGoal.currentValue / Math.max(1, todayMicroGoal.targetValue)) * 100))\n    : 0;\n  const microGoalStep = todayMicroGoal ? getMicroGoalStep(todayMicroGoal.targetValue) : 1;"
