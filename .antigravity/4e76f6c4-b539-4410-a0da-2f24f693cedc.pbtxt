1\204\330\257\330\256\331\204 \331\210\330\247\331\204\331\201\330\261\331\212\331\204\330\247\331\206\330\263\" }).click();    await page.getByLabel(\"\330\247\331\204\330\271\331\206\331\210\330\247\331\206\").fill(\"\331\205\330\264\330\261\331\210\330\271 \331\201\330\261\331\212\331\204\330\247\331\206\330\263 \330\272\331\212\330\261 \331\205\330\257\331\201\331\210\330\271\");    await page.getByLabel(\"\330\247\331\204\331\205\330\250\331\204\330\272 \330\247\331\204\330\245\330\254\331\205\330\247\331\204\331\212 (\330\254.\331\205)\").fill(\"5000\");    await page.getByRole(\"button\", { name: \"\330\255\331\201\330\270 \330\263\330\254\331\204 \330\247\331\204\330\257\330\256\331\204\" }).click();    await page.waitForTimeout(250);    const cashAfterUnpaid = await page.getByTestId(\"finance-available-cash\").textContent();    const pendingAfterUnpaid = await page.getByTestId(\"finance-pending-receivables\").textContent();    // 4. Navigate to Time & test Focus Timer    await page.getByRole(\"button\", { name: \"\330\247\331\204\331\210\331\202\330\252\" }).first().click();    await page.getByRole(\"button\", { name: \"\331\210\330\266\330\271 \330\247\331\204\330\252\330\261\331\203\331\212\330\262 (Pomodoro)\" }).click();    await page.getByRole(\"button\", { name: \"\330\247\330\250\330\257\330\243 \330\247\331\204\330\252\330\261\331\203\331\212\330\262\" }).click();    await page.waitForTimeout(1200);    const timerVal = await page.getByTestId(\"focus-timer-display\").textContent();    // 5. Switch to English LTR    await page.getByRole(\"button\", { name: /English/ }).first().click();    await page.waitForTimeout(300);    const dirAfterFlip = await page.evaluate(() => document.documentElement.dir);    await page.screenshot({ path: \".playwright-cli/r1-en-ltr.png\" });    console.log(JSON.stringify({      cashBefore,      cashAfterExpense,      cashAfterUnpaid,      pendingBefore,      pendingAfterUnpaid,      timerVal,      dirAfterFlip    }));  })(page);```### ResultTotal messages: 3 (Errors: 0, Warnings: 0)Returning 1 messages for level \"info\"[INFO] %cDownload the React DevTools for a better development experience: https://react.dev/link/react-devtools font-weight:bold @ http://localhost:3000/node_modules/.vite/deps/react-dom_client.js?v=a21fa093:15801Browser \'default\' closed\n\n### Latest snapshot (.playwright-cli/page-2026-11-23T05-32-34-270Z.yml)\n```yaml\n- generic [ref=e3]:\n  - complementary [ref=e4]:\n    - button \"LIFE OS\" [ref=e6]\n    - navigation \"\330\247\331\204\331\202\330\247\330\246\331\205\330\251 \330\247\331\204\330\261\330\246\331\212\330\263\331\212\330\251\" [ref=e7]:\n      - generic [ref=e8]:\n        - button \"\330\247\331\204\330\261\330\246\331\212\330\263\331\212\330\251\" [ref=e9]\n        - button \"\330\247\331\204\331\205\330\247\331\204\331\212\330\247\330\252\" [ref=e14]\n        - button \"\330\247\331\204\331\210\331\202\330\252\" [ref=e19]\n        - button \"\330\247\331\204\330\265\330\255\330\251\" [ref=e24]\n        - button \"LIFE AI\" [ref=e28]\n      - generic [ref=e33]:\n        - paragraph [ref=e34]: \330\247\331\204\330\243\331\202\330\263\330\247\331\205 \330\247\331\204\330\245\330\266\330\247\331\201\331\212\330\251\n        - button \"\330\247\331\204\330\261\331\201\330\247\331\207\331\212\330\251 \330\247\331\204\330\261\331\202\331\205\331\212\330\251\" [ref=e35]\n        - button \"\330\247\331\204\330\243\331\207\330\257\330\247\331\201\" [ref=e39]\n        - button \"\330\247\331\204\330\252\331\202\330\247\330\261\331\212\330\261\" [ref=e45]\n        - button \"\330\247\331\204\330\255\330\263\330\247\330\250\330\247\330\252 \330\247\331\204\331\205\330\252\330\265\331\204\330\251\" [ref=e49]\n        - button \"\330\247\331\204\330\245\330\271\330\257\330\247\330\257\330\247\330\252\" [ref=e54]\n    - generic [ref=e59]:\n      - button \"English (LTR) AR\" [ref=e60]:\n        - generic [ref=e61]: English (LTR)\n        - generic [ref=e65]: AR\