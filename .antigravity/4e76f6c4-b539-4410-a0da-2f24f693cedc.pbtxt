      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"{\\n  \\\"entities\\\": {\\n    \\\"UserProfile\\\": {\\n      \\\"title\\\": \\\"UserProfile\\\",\\n      \\\"description\\\": \\\"User profile, work schedule, personalization settings, and currency preferences.\\\",\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"userId\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 128, \\\"pattern\\\": \\\"^[a-zA-Z0-9_\\\\\\\\-]+$\\\" },\\n        \\\"displayName\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 120 },\\n        \\\"email\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"email\\\", \\\"maxLength\\\": 200 },\\n        \\\"language\\\": { \\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"ar\\\", \\\"en\\\"] },\\n        \\\"currency\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 10 },\\n        \\\"dailyWorkHours\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"workStartHour\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"workEndHour\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"targetSleepHours\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"peakConcentration\\\": { \\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"morning\\\", \\\"afternoon\\\", \\\"evening\\\"] },\\n        \\\"financialGoal\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 200 },\\n        \\\"smartphone\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 60 },\\n        \\\"smartwatch\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 80 },\\n        \\\"dailyStepTarget\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"aiDefaultModel\\\": { \\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"gemini-3.1-flash-lite\\\", \\\"gemini-4-hydrogen\\\"] },\\n        \\\"aiDailyLimit\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"liabilitiesPiasters\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"createdAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" },\\n        \\\"updatedAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" }\\n      },\\n      \\\"required\\\": [\\\"userId\\\", \\\"displayName\\\", \\\"language\\\", \\\"currency\\\", \\\"dailyWorkHours\\\", \\\"peakConcentration\\\", \\\"createdAt\\\", \\\"updatedAt\\\"]\\n    },\\n    \\\"IncomeRecord\\\": {\\n      \\\"title\\\": \\\"IncomeRecord\\\",\\n      \\\"description\\\": \\\"Salary, freelance project, or additional income record stored in integer piasters.\\\",\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"userId\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 128, \\\"pattern\\\": \\\"^[a-zA-Z0-9_\\\\\\\\-]+$\\\" },\\n        \\\"title\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 160 },\\n        \\\"amountPiasters\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"paidAmountPiasters\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"currency\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 10 },\\n        \\\"source\\\": { \\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"fixed_salary\\\", \\\"freelance\\\", \\\"additional\\\"] },\\n        \\\"status\\\": { \\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"expected\\\", \\\"invoiced\\\", \\\"partially_paid\\\", \\\"fully_paid\\\", \\\"overdue\\\"] },\\n        \\\"dateReceived\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 32 },\\n        \\\"expectedPaymentDate\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 32 },\\n        \\\"projectName\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 120 },\\n        \\\"notes\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 500 },\\n        \\\"createdAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" },\\n        \\\"updatedAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" }\\n      },\\n      \\\"required\\\": [\\\"userId\\\", \\\"title\\\", \\\"amountPiasters\\\", \\\"paidAmountPiasters\\\", \\\"currency\\\", \\\"source\\\", \\\"status\\\", \\\"expectedPaymentDate\\\", \\\"createdAt\\\", \\\"updatedAt\\\"]\\n    },\\n    \\\"ExpenseRecord\\\": {\\n      \\\"title\\\": \\\"ExpenseRecord\\\",\\n      \\\"description\\\": \\\"Personal expense transaction stored in integer piasters.\\\",\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"userId\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 128, \\\"pattern\\\": \\\"^[a-zA-Z0-9_\\\\\\\\-]+$\\\" },\\n        \\\"description\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 200 },\\n        \\\"amountPiasters\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"currency\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 10 },\\n        \\\"category\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 60 },\\n        \\\"date\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 32 },\\n        \\\"paymentMethod\\\": { \\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"cash\\\", \\\"card\\\", \\\"instapay\\\", \\\"wallet\\\", \\\"bank_transfer\\\"] },\\n        \\\"entrySource\\\": { \\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"manual\\\", \\\"voice\\\", \\\"receipt\\\", \\\"notification\\\", \\\"email_import\\\"] },\\n        \\\"recurring\\\": { \\\"type\\\": \\\"boolean\\\" },\\n        \\\"notes\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 500 },\\n        \\\"createdAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" },\\n        \\\"updatedAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" }\\n      },\\n      \\\"required\\\": [\\\"userId\\\", \\\"description\\\", \\\"amountPiasters\\\", \\\"currency\\\", \\\"category\\\", \\\"date\\\", \\\"paymentMethod\\\", \\\"entrySource\\\", \\\"recurring\\\", \\\"createdAt\\\", \\\"updatedAt\\\"]\\n    },\\n    \\\"Budget\\\": {\\n      \\\"title\\\": \\\"Budget\\\",\\n      \\\"description\\\": \\\"Monthly overall or category-specific spending budget in piasters.\\\",\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"userId\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 128, \\\"pattern\\\": \\\"^[a-zA-Z0-9_\\\\\\\\-]+$\\\" },\\n        \\\"category\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 60 },\\n        \\\"monthKey\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 10 },\\n        \\\"limitPiasters\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"createdAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" },\\n        \\\"updatedAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" }\\n      },\\n      \\\"required\\\": [\\\"userId\\\", \\\"category\\\", \\\"monthKey\\\", \\\"limitPiasters\\\", \\\"createdAt\\\", \\\"updatedAt\\\"]\\n    },\\n    \\\"SavingsGoal\\\": {\\n      \\\"title\\\": \\\"SavingsGoal\\\",\\n      \\\"description\\\": \\\"Targeted savings bucket stored in integer piasters.\\\",\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"userId\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 128, \\\"pattern\\\": \\\"^[a-zA-Z0-9_\\\\\\\\-]+$\\\" },\\n        \\\"title\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 140 },\\n        \\\"category\\\": { \\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"emergency\\\", \\\"purchases\\\", \\\"education\\\", \\\"travel\\\", \\\"investments\\\", \\\"custom\\\"] },\\n        \\\"targetPiasters\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"currentPiasters\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"targetDate\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 32 },\\n        \\\"createdAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" },\\n        \\\"updatedAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" }\\n      },\\n      \\\"required\\\": [\\\"userId\\\", \\\"title\\\", \\\"category\\\", \\\"targetPiasters\\\", \\\"currentPiasters\\\", \\\"targetDate\\\", \\\"createdAt\\\", \\\"updatedAt\\\"]\\n    },\\n    \\\"InvestmentAsset\\\": {\\n      \\\"title\\\": \\\"InvestmentAsset\\\",\\n      \\\"description\\\": \\\"Manual investment portfolio holding with explicit manual valuation tracking.\\\",\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"userId\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 128, \\\"pattern\\\": \\\"^[a-zA-Z0-9_\\\\\\\\-]+$\\\" },\\n        \\\"name\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 140 },\\n        \\\"category\\\": { \\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"gold\\\", \\\"stocks\\\", \\\"mutual_funds\\\", \\\"etfs\\\", \\\"other\\\"] },\\n        \\\"quantity\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"purchasePricePiasters\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"currentValuationPiasters\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"feesPiasters\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"realizedPnlPiasters\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"purchaseDate\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 32 },\\n        \\\"valuationSource\\\": { \\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"manual\\\", \\\"verified_market\\\"] },\\n        \\\"createdAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" },\\n        \\\"updatedAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" }\\n      },\\n      \\\"required\\\": [\\\"userId\\\", \\\"name\\\", \\\"category\\\", \\\"quantity\\\", \\\"purchasePricePiasters\\\", \\\"currentValuationPiasters\\\", \\\"feesPiasters\\\", \\\"realizedPnlPiasters\\\", \\\"purchaseDate\\\", \\\"valuationSource\\\", \\\"createdAt\\\", \\\"updatedAt\\\"]\\n    },\\n    \\\"TaskItem\\\": {\\n      \\\"title\\\": \\\"TaskItem\\\",\\n      \\\"description\\\": \\\"Scheduled or backlog personal/work task.\\\",\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"userId\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 128, \\\"pattern\\\": \\\"^[a-zA-Z0-9_\\\\\\\\-]+$\\\" },\\n        \\\"title\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 200 },\\n        \\\"description\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 600 },\\n        \\\"priority\\\": { \\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"critical\\\", \\\"high\\\", \\\"medium\\\", \\\"low\\\"] },\\n        \\\"category\\\": { \\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"deep_work\\\", \\\"admin\\\", \\\"meetings\\\", \\\"personal\\\", \\\"rest\\\", \\\"commute\\\"] },\\n        \\\"status\\\": { \\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"todo\\\", \\\"in_progress\\\", \\\"completed\\\"] },\\n        \\\"deadline\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 32 },\\n        \\\"scheduledStart\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 16 },\\n        \\\"estimatedMinutes\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"actualMinutes\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"project\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 120 },\\n        \\\"createdAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" },\\n        \\\"updatedAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" }\\n      },\\n      \\\"required\\\": [\\\"userId\\\", \\\"title\\\", \\\"priority\\\", \\\"category\\\", \\\"status\\\", \\\"deadline\\\", \\\"estimatedMinutes\\\", \\\"actualMinutes\\\", \\\"createdAt\\\", \\\"updatedAt\\\"]\\n    },\\n    \\\"CalendarEvent\\\": {\\n      \\\"title\\\": \\\"CalendarEvent\\\",\\n      \\\"description\\\": \\\"Personal or work scheduled calendar event.\\\",\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"userId\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 128, \\\"pattern\\\": \\\"^[a-zA-Z0-9_\\\\\\\\-]+$\\\" },\\n        \\\"title\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 200 },\\n        \\\"calendarType\\\": { \\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"work\\\", \\\"personal\\\"] },\\n        \\\"date\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 32 },\\n        \\\"startTime\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 16 },\\n        \\\"endTime\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 16 },\\n        \\\"notes\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 400 },\\n        \\\"createdAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" },\\n        \\\"updatedAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" }\\n      },\\n      \\\"required\\\": [\\\"userId\\\", \\\"title\\\", \\\"calendarType\\\", \\\"date\\\", \\\"startTime\\\", \\\"endTime\\\", \\\"createdAt\\\", \\\"updatedAt\\\"]\\n    },\\n    \\\"FocusSession\\\": {\\n      \\\"title\\\": \\\"FocusSession\\\",\\n      \\\"description\\\": \\\"Completed Pomodoro or custom focus session.\\\",\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"userId\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 128, \\\"pattern\\\": \\\"^[a-zA-Z0-9_\\\\\\\\-]+$\\\" },\\n        \\\"label\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 140 },\\n        \\\"durationMinutes\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"distractions\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"date\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 32 },\\n        \\\"createdAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" }\\n      },\\n      \\\"required\\\": [\\\"userId\\\", \\\"label\\\", \\\"durationMinutes\\\", \\\"distractions\\\", \\\"date\\\", \\\"createdAt\\\"]\\n    },\\n    \\\"HealthLog\\\": {\\n      \\\"title\\\": \\\"HealthLog\\\",\\n      \\\"description\\\": \\\"Daily health metrics with explicit source and availability metadata.\\\",\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"userId\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 128, \\\"pattern\\\": \\\"^[a-zA-Z0-9_\\\\\\\\-]+$\\\" },\\n        \\\"date\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 32 },\\n        \\\"sleepHours\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"sleepBedtime\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 16 },\\n        \\\"steps\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"activeCalories\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"restingHeartRate\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"source\\\": { \\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"manual\\\", \\\"health_connect\\\", \\\"xiaomi_band\\\"] },\\n        \\\"createdAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" },\\n        \\\"updatedAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" }\\n      },\\n      \\\"required\\\": [\\\"userId\\\", \\\"date\\\", \\\"source\\\", \\\"createdAt\\\", \\\"updatedAt\\\"]\\n    },\\n    \\\"AppUsageLog\\\": {\\n      \\\"title\\\": \\\"AppUsageLog\\\",\\n      \\\"description\\\": \\\"Daily digital wellbeing app usage duration in minutes by category.\\\",\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"userId\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 128, \\\"pattern\\\": \\\"^[a-zA-Z0-9_\\\\\\\\-]+$\\\" },\\n        \\\"date\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 32 },\\n        \\\"productivityMinutes\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"communicationMinutes\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"socialMediaMinutes\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"entertainmentMinutes\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"educationMinutes\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"otherMinutes\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"nighttimeMinutes\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"interruptions\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"source\\\": { \\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"manual\\\", \\\"usage_stats\\\"] },\\n        \\\"createdAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" },\\n        \\\"updatedAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" }\\n      },\\n      \\\"required\\\": [\\\"userId\\\", \\\"date\\\", \\\"productivityMinutes\\\", \\\"socialMediaMinutes\\\", \\\"nighttimeMinutes\\\", \\\"source\\\", \\\"createdAt\\\", \\\"updatedAt\\\"]\\n    },\\n    \\\"EnergyLog\\\": {\\n      \\\"title\\\": \\\"EnergyLog\\\",\\n      \\\"description\\\": \\\"Self-reported energy, mood, focus, and stress check-in.\\\",\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"userId\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 128, \\\"pattern\\\": \\\"^[a-zA-Z0-9_\\\\\\\\-]+$\\\" },\\n        \\\"date\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 32 },\\n        \\\"energyLevel\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"moodLevel\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"focusLevel\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"stressLevel\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"notes\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 300 },\\n        \\\"createdAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" }\\n      },\\n      \\\"required\\\": [\\\"userId\\\", \\\"date\\\", \\\"energyLevel\\\", \\\"moodLevel\\\", \\\"focusLevel\\\", \\\"stressLevel\\\", \\\"createdAt\\\"]\\n    },\\n    \\\"PersonalGoal\\\": {\\n      \\\"title\\\": \\\"PersonalGoal\\\",\\n      \\\"description\\\": \\\"Personal goal with category, progress, deadline, and bounded milestone titles.\\\",\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"userId\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 128, \\\"pattern\\\": \\\"^[a-zA-Z0-9_\\\\\\\\-]+$\\\" },\\n        \\\"title\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 180 },\\n        \\\"description\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 500 },\\n        \\\"category\\\": { \\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"financial\\\", \\\"professional\\\", \\\"educational\\\", \\\"health\\\", \\\"personal\\\", \\\"social\\\"] },\\n        \\\"targetLabel\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 120 },\\n        \\\"startDate\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 32 },\\n        \\\"deadline\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 32 },\\n        \\\"progress\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"milestones\\\": { \\\"type\\\": \\\"array\\\" },\\n        \\\"createdAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" },\\n        \\\"updatedAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" }\\n      },\\n      \\\"required\\\": [\\\"userId\\\", \\\"title\\\", \\\"category\\\", \\\"targetLabel\\\", \\\"deadline\\\", \\\"progress\\\", \\\"createdAt\\\", \\\"updatedAt\\\"]\\n    }\\n  },\\n  \\\"firestore\\\": {\\n    \\\"/users/{userId}\\\": {\\n      \\\"schema\\\": { \\\"$ref\\\": \\\"#/entities/UserProfile\\\" },\\n      \\\"description\\\": \\\"Private user profile and personalization settings, readable and writable only by the owner.\\\"\\n    },\\n    \\\"/users/{userId}/income_records/{recordId}\\\": {\\n      \\\"schema\\\": { \\\"$ref\\\": \\\"#/entities/IncomeRecord\\\" },\\n      \\\"description\\\": \\\"Owner-scoped income records.\\\"\\n    },\\n    \\\"/users/{userId}/expense_records/{recordId}\\\": {\\n      \\\"schema\\\": { \\\"$ref\\\": \\\"#/entities/ExpenseRecord\\\" },\\n      \\\"description\\\": \\\"Owner-scoped expense records.\\\"\\n    },\\n    \\\"/users/{userId}/budgets/{budgetId}\\\": {\\n      \\\"schema\\\": { \\\"$ref\\\": \\\"#/entities/Budget\\\" },\\n      \\\"description\\\": \\\"Owner-scoped monthly and category budgets.\\\"\\n    },\\n    \\\"/users/{userId}/savings_goals/{goalId}\\\": {\\n      \\\"schema\\\": { \\\"$ref\\\": \\\"#/entities/SavingsGoal\\\" },\\n      \\\"description\\\": \\\"Owner-scoped savings goals.\\\"\\n    },\\n    \\\"/users/{userId}/investments/{investmentId}\\\": {\\n      \\\"schema\\\": { \\\"$ref\\\": \\\"#/entities/InvestmentAsset\\\" },\\n      \\\"description\\\": \\\"Owner-scoped manual investment portfolio holdings.\\\"\\n    },\\n    \\\"/users/{userId}/tasks/{taskId}\\\": {\\n      \\\"schema\\\": { \\\"$ref\\\": \\\"#/entities/TaskItem\\\" },\\n      \\\"description\\\": \\\"Owner-scoped tasks.\\\"\\n    },\\n    \\\"/users/{userId}/calendar_events/{eventId}\\\": {\\n      \\\"schema\\\": { \\\"$ref\\\": \\\"#/entities/CalendarEvent\\\" },\\n      \\\"description\\\": \\\"Owner-scoped calendar events.\\\"\\n    },\\n    \\\"/users/{userId}/focus_sessions/{sessionId}\\\": {\\n      \\\"schema\\\": { \\\"$ref\\\": \\\"#/entities/FocusSession\\\" },\\n      \\\"description\\\": \\\"Owner-scoped focus timer sessions.\\\"\\n    },\\n    \\\"/users/{userId}/health_logs/{logId}\\\": {\\n      \\\"schema\\\": { \\\"$ref\\\": \\\"#/entities/HealthLog\\\" },\\n      \\\"description\\\": \\\"Owner-scoped health and sleep logs.\\\"\\n    },\\n    \\\"/users/{userId}/app_usage/{usageId}\\\": {\\n      \\\"schema\\\": { \\\"$ref\\\": \\\"#/entities/AppUsageLog\\\" },\\n      \\\"description\\\": \\\"Owner-scoped digital wellbeing app usage logs.\\\"\\n    },\\n    \\\"/users/{userId}/energy_logs/{logId}\\\": {\\n      \\\"schema\\\": { \\\"$ref\\\": \\\"#/entities/EnergyLog\\\" },\\n      \\\"description\\\": \\\"Owner-scoped self-reported energy check-in logs.\\\"\\n    },\\n    \\\"/users/{userId}/goals/{goalId}\\\": {\\n      \\\"schema\\\": { \\\"$ref\\\": \\\"#/entities/PersonalGoal\\\" },\\n      \\\"description\\\": \\\"Owner-scoped personal goals.\\\"\\n    }\\n  }\\n}\\n\", \"Description\":\"Create Firebase Blueprint defining LIFE OS entities and strict owner-scoped Firestore collections\", \"Overwrite\":true, \"TargetFile\":\"/firebase-blueprint.json\", \"toolAction\":\"Creating firebase-blueprint.json\", \"toolSummary\":\"Create firebase-blueprint.json\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_11737517663962645021"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"# LIFE OS \342\200\224 Firestore Security Specification (Phase 0 TDD)\\n\\n## 1. Data Invariants\\n1. **Strict Single-Tenant Ownership**: Every document lives under `/users/{userId}` or a direct subcollection `/users/{userId}/{subcollection}/{docId}`. No user may read, list, create, update, or delete another user\'s documents.\\n2. **Verified Identity**: All authenticated read/write operations require `request.auth != null && request.auth.uid == userId && request.auth.token.email_verified == true`.\\n3. **Integer Minor Units**: Financial amounts (`amountPiasters`, `paidAmountPiasters`, `limitPiasters`, `targetPiasters`, `currentPiasters`, `purchasePricePiasters`, `currentValuationPiasters`, `feesPiasters`) must be non-negative bounded numbers (`>= 0` and `<= 1000000000000`).\\n4. **Immutable Ownership & Timestamps**: `userId` and `createdAt` cannot change after creation; `createdAt == request.time` on create and `updatedAt == request.time` on update.\\n5. **Bounded Strings & Arrays**: Every string field has an explicit `.size()` upper bound matching `firebase-blueprint.json`; `milestones` array on `goals` is strictly bounded to `<= 20` items.\\n6. **Zero Shadow Fields**: Create operations validate `hasAll` and `hasOnly`; update operations validate `affectedKeys().hasOnly(...)` combined with `isValid[Entity]()`.\\n7. **Path ID Hardening**: All single-document operations validate `isValidId(docId)` (`^[a-zA-Z0-9_\\\\-]+$`, `<= 128` chars).\\n\\n## 2. The \\\"Dirty Dozen\\\" Attack Payloads (All Must Return PERMISSION_DENIED)\\n1. **Cross-User Read**: User B attempts `get /users/userA/expense_records/exp1`.\\n2. **Cross-User List**: User B attempts `list /users/userA/income_records`.\\n3. **Unverified Email Write**: User A with `email_verified: false` attempts to create `/users/userA/expense_records/exp1`.\\n4. **Identity Spoofing**: User A creates `/users/userA/expense_records/exp1` with `userId: \\\"userB\\\"`.\\n5. **Shadow Field Injection**: User A adds `isAdmin: true` to `/users/userA` or `isVerified: true` to an expense record.\\n6. **Negative Amount Poisoning**: User A submits `amountPiasters: -50000` on an expense record.\\n7. **Resource Exhaustion / 1MB String**: User A submits a 50,000-character `description` string on a task.\\n8. **ID Poisoning**: User A writes to `/users/userA/tasks/invalid$id!with*badchars`.\\n9. **Immutable Field Tampering**: User A updates `createdAt` or `userId` on an existing expense record.\\n10. **Forged Client Timestamp**: User A creates a document with a backdated `createdAt` instead of `serverTimestamp()` (`request.time`).\\n11. **Unbounded Array Injection**: User A writes a `goals` document with 25 items in `milestones` (limit 20).\\n12. **PII Leak Attempt**: Unauthenticated or non-owner user attempts to read `/users/userA` containing `email`.\\n\", \"Description\":\"Create Phase 0 Firestore security specification documenting data invariants and adversarial attack payloads\", \"Overwrite\":true, \"TargetFile\":\"/security_spec.md\", \"toolAction\":\"Creating security_spec.md\", \"toolSummary\":\"Create security_spec.md\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_11737517663962647968"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import firebaseRulesPlugin from \'@firebase/eslint-plugin-security-rules\';\\n\\nexport default [\\n  {\\n    ignores: [\'dist/**/*\', \'node_modules/**/*\', \'src/**/*\', \'*.ts\', \'*.tsx\', \'*.js\', \'*.mjs\'],\\n  },\\n  firebaseRulesPlugin.configs[\'flat/recommended\'],\\n];\\n\", \"Description\":\"Configure ESLint with @firebase/eslint-plugin-security-rules to audit Firestore rules\", \"Overwrite\":true, \"TargetFile\":\"/eslint.config.mjs\", \"toolAction\":\"Creating eslint.config.mjs\", \"toolSummary\":\"Create eslint.config.mjs\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_11737517663962646819"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"rules_version = \'2\';\\nservice cloud.firestore {\\n  match /databases/{database}/documents {\\n    // Pillar 1 / Global Safety Net: Default deny all unmatched paths\\n    match /{document=**} {\\n      allow read, write: if false;\\n    }\\n\\n    // --- Hardened Global Primitives ---\\n    function isSignedIn() {\\n      return request.auth != null;\\n    }\\n\\n    function isVerifiedUser() {\\n      return isSignedIn() && request.auth.token.email_verified == true;\\n    }\\n\\n    function isOwner(userId) {\\n      return isVerifiedUser() && request.auth.uid == userId;\\n    }\\n\\n    function isValidId(id) {\\n      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches(\'^[a-zA-Z0-9_\\\\\\\\-]+$\');\\n    }\\n\\n    function incoming() {\\n      return request.resource.data;\\n    }\\n\\n    function existing() {\\n      return resource.data;\\n    }\\n\\n    function isValidOptionalString(data, field, maxLen) {\\n      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);\\n    }\\n\\n    function isValidNonNegNumber(val, maxVal) {\\n      return (val is int || val is float) && val >= 0 && val <= maxVal;\\n    }\\n\\n    function isValidMoney(val) {\\n      return isValidNonNegNumber(val, 1000000000000);\\n    }\\n\\n    // --- Validation Blueprints (Pillar 2: Called on BOTH create & update) ---\\n    function isValidUserProfile(data, userId) {\\n      return data.keys().hasAll([\'userId\', \'displayName\', \'language\', \'currency\', \'dailyWorkHours\', \'peakConcentration\', \'createdAt\', \'updatedAt\'])\\n        && data.keys().hasOnly([\\n          \'userId\', \'displayName\', \'email\', \'language\', \'currency\',\\n          \'dailyWorkHours\', \'workStartHour\', \'workEndHour\', \'targetSleepHours\',\\n          \'peakConcentration\', \'financialGoal\', \'smartphone\', \'smartwatch\',\\n          \'dailyStepTarget\', \'aiDefaultModel\', \'aiDailyLimit\', \'liabilitiesPiasters\',\\n          \'createdAt\', \'updatedAt\'\\n        ])\\n        && data.userId == userId\\n        && isValidId(data.userId)\\n        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120\\n        && isValidOptionalString(data, \'email\', 200)\\n        && data.language in [\'ar\', \'en\']\\n        && data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 10\\n        && isValidNonNegNumber(data.dailyWorkHours, 24)\\n        && (!(\'workStartHour\' in data) || isValidNonNegNumber(data.workStartHour, 23))\\n        && (!(\'workEndHour\' in data) || isValidNonNegNumber(data.workEndHour, 24))\\n        && (!(\'targetSleepHours\' in data) || isValidNonNegNumber(data.targetSleepHours, 24))\\n        && data.peakConcentration in [\'morning\', \'afternoon\', \'evening\']\\n        && isValidOptionalString(data, \'financialGoal\', 200)\\n        && isValidOptionalString(data, \'smartphone\', 60)\\n        && isValidOptionalString(data, \'smartwatch\', 80)\\n        && (!(\'dailyStepTarget\' in data) || isValidNonNegNumber(data.dailyStepTarget, 100000))\\n        && (!(\'aiDefaultModel\' in data) || data.aiDefaultModel in [\'gemini-3.1-flash-lite\', \'gemini-4-hydrogen\'])\\n        && (!(\'aiDailyLimit\' in data) || isValidNonNegNumber(data.aiDailyLimit, 500))\\n        && (!(\'liabilitiesPiasters\' in data) || isValidMoney(data.liabilitiesPiasters))\\n        && data.createdAt is timestamp\\n        && data.updatedAt is timestamp;\\n    }\\n\\n    function isValidIncomeRecord(data, userId) {\\n      return data.keys().hasAll([\'userId\', \'title\', \'amountPiasters\', \'paidAmountPiasters\', \'currency\', \'source\', \'status\', \'expectedPaymentDate\', \'createdAt\', \'updatedAt\'])\\n        && data.keys().hasOnly([\\n          \'userId\', \'title\', \'amountPiasters\', \'paidAmountPiasters\', \'currency\',\\n          \'source\', \'status\', \'dateReceived\', \'expectedPaymentDate\', \'projectName\',\\n          \'notes\', \'createdAt\', \'updatedAt\'\\n        ])\\n        && data.userId == userId\\n        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160\\n        && isValidMoney(data.amountPiasters)\\n        && isValidMoney(data.paidAmountPiasters)\\n        && data.paidAmountPiasters <= data.amountPiasters\\n        && data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 10\\n        && data.source in [\'fixed_salary\', \'freelance\', \'additional\']\\n        && data.status in [\'expected\', \'invoiced\', \'partially_paid\', \'fully_paid\', \'overdue\']\\n        && isValidOptionalString(data, \'dateReceived\', 32)\\n        && data.expectedPaymentDate is string && data.expectedPaymentDate.size() >= 1 && data.expectedPaymentDate.size() <= 32\\n        && isValidOptionalString(data, \'projectName\', 120)\\n        && isValidOptionalString(data, \'notes\', 500)\\n        && data.createdAt is timestamp\\n        && data.updatedAt is timestamp;\\n    }\\n\\n    function isValidExpenseRecord(data, userId) {\\n      return data.keys().hasAll([\'userId\', \'description\', \'amountPiasters\', \'currency\', \'category\', \'date\', \'paymentMethod\', \'entrySource\', \'recurring\', \'createdAt\', \'updatedAt\'])\\n        && data.keys().hasOnly([\\n          \'userId\', \'description\', \'amountPiasters\', \'currency\', \'category\',\\n          \'date\', \'paymentMethod\', \'entrySource\', \'recurring\', \'notes\', \'createdAt\', \'updatedAt\'\\n        ])\\n        && data.userId == userId\\n        && data.description is string && data.description.size() >= 1 && data.description.size() <= 200\\n        && isValidMoney(data.amountPiasters)\\n        && data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 10\\n        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60\\n        && data.date is string && data.date.size() >= 1 && data.date.size() <= 32\\n        && data.paymentMethod in [\'cash\', \'card\', \'instapay\', \'wallet\', \'bank_transfer\']\\n        && data.entrySource in [\'manual\', \'voice\', \'receipt\', \'notification\', \'email_import\']\\n        && data.recurring is bool\\n        && isValidOptionalString(data, \'notes\', 500)\\n        && data.createdAt is timestamp\\n        && data.updatedAt is timestamp;\\n    }\\n\\n    function isValidBudget(data, userId) {\\n      return data.keys().hasAll([\'userId\', \'category\', \'monthKey\', \'limitPiasters\', \'createdAt\', \'updatedAt\'])\\n        && data.keys().hasOnly([\'userId\', \'category\', \'monthKey\', \'limitPiasters\', \'createdAt\', \'updatedAt\'])\\n        && data.userId == userId\\n        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60\\n        && data.monthKey is string && data.monthKey.size() >= 4 && data.monthKey.size() <= 10\\n        && isValidMoney(data.limitPiasters)\\n        && data.createdAt is timestamp\\n        && data.updatedAt is timestamp;\\n    }\\n\\n    function isValidSavingsGoal(data, userId) {\\n      return data.keys().hasAll([\'userId\', \'title\', \'category\', \'targetPiasters\', \'currentPiasters\', \'targetDate\', \'createdAt\', \'updatedAt\'])\\n        && data.keys().hasOnly([\'userId\', \'title\', \'category\', \'targetPiasters\', \'currentPiasters\', \'targetDate\', \'createdAt\', \'updatedAt\'])\\n        && data.userId == userId\\n        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140\\n        && data.category in [\'emergency\', \'purchases\', \'education\', \'travel\', \'investments\', \'custom\']\\n        && isValidMoney(data.targetPiasters)\\n        && isValidMoney(data.currentPiasters)\\n        && data.targetDate is string && data.targetDate.size() >= 1 && data.targetDate.size() <= 32\\n        && data.createdAt is timestamp\\n        && data.updatedAt is timestamp;\\n    }\\n\\n    function isValidInvestmentAsset(data, userId) {\\n      return data.keys().hasAll([\'userId\', \'name\', \'category\', \'quantity\', \'purchasePricePiasters\', \'currentValuationPiasters\', \'feesPiasters\', \'realizedPnlPiasters\', \'purchaseDate\', \'valuationSource\', \'createdAt\', \'updatedAt\'])\\n        && data.keys().hasOnly([\'userId\', \'name\', \'category\', \'quantity\', \'purchasePricePiasters\', \'currentValuationPiasters\', \'feesPiasters\', \'realizedPnlPiasters\', \'purchaseDate\', \'valuationSource\', \'createdAt\', \'updatedAt\'])\\n        && data.userId == userId\\n        && data.name is string && data.name.size() >= 1 && data.name.size() <= 140\\n        && data.category in [\'gold\', \'stocks\', \'mutual_funds\', \'etfs\', \'other\']\\n        && isValidNonNegNumber(data.quantity, 1000000000)\\n        && isValidMoney(data.purchasePricePiasters)\\n        && isValidMoney(data.currentValuationPiasters)\\n        && isValidMoney(data.feesPiasters)\\n        && (data.realizedPnlPiasters is int || data.realizedPnlPiasters is float)\\n        && data.realizedPnlPiasters >= -1000000000000 && data.realizedPnlPiasters <= 1000000000000\\n        && data.purchaseDate is string && data.purchaseDate.size() >= 1 && data.purchaseDate.size() <= 32\\n        && data.valuationSource in [\'manual\', \'verified_market\']\\n        && data.createdAt is timestamp\\n        && data.updatedAt is timestamp;\\n    }\\n\\n    function isValidTaskItem(data, userId) {\\n      return data.keys().hasAll([\'userId\', \'title\', \'priority\', \'category\', \'status\', \'deadline\', \'estimatedMinutes\', \'actualMinutes\', \'createdAt\', \'updatedAt\'])\\n        && data.keys().hasOnly([\'userId\', \'title\', \'description\', \'priority\', \'category\', \'status\', \'deadline\', \'scheduledStart\', \'estimatedMinutes\', \'actualMinutes\', \'project\', \'createdAt\', \'updatedAt\'])\\n        && data.userId == userId\\n        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200\\n        && isValidOptionalString(data, \'description\', 600)\\n        && data.priority in [\'critical\', \'high\', \'medium\', \'low\']\\n        && data.category in [\'deep_work\', \'admin\', \'meetings\', \'personal\', \'rest\', \'commute\']\\n        && data.status in [\'todo\', \'in_progress\', \'completed\']\\n        && data.deadline is string && data.deadline.size() >= 1 && data.deadline.size() <= 32\\n        && isValidOptionalString(data, \'scheduledStart\', 16)\\n        && isValidNonNegNumber(data.estimatedMinutes, 1440)\\n        && isValidNonNegNumber(data.actualMinutes, 1440)\\n        && isValidOptionalString(data, \'project\', 120)\\n        && data.createdAt is timestamp\\n        && data.updatedAt is timestamp;\\n    }\\n\\n    function isValidCalendarEvent(data, userId) {\\n      return data.keys().hasAll([\'userId\', \'title\', \'calendarType\', \'date\', \'startTime\', \'endTime\', \'createdAt\', \'updatedAt\'])\\n        && data.keys().hasOnly([\'userId\', \'title\', \'calendarType\', \'date\', \'startTime\', \'endTime\', \'notes\', \'createdAt\', \'updatedAt\'])\\n        && data.userId == userId\\n        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200\\n        && data.calendarType in [\'work\', \'personal\']\\n        && data.date is string && data.date.size() >= 1 && data.date.size() <= 32\\n        && data.startTime is string && data.startTime.size() >= 1 && data.startTime.size() <= 16\\n        && data.endTime is string && data.endTime.size() >= 1 && data.endTime.size() <= 16\\n        && isValidOptionalString(data, \'notes\', 400)\\n        && data.createdAt is timestamp\\n        && data.updatedAt is timestamp;\\n    }\\n\\n    function isValidFocusSession(data, userId) {\\n      return data.keys().hasAll([\'userId\', \'label\', \'durationMinutes\', \'distractions\', \'date\', \'createdAt\'])\\n        && data.keys().hasOnly([\'userId\', \'label\', \'durationMinutes\', \'distractions\', \'date\', \'createdAt\'])\\n        && data.userId == userId\\n        && data.label is string && data.label.size() >= 1 && data.label.size() <= 140\\n        && isValidNonNegNumber(data.durationMinutes, 480)\\n        && isValidNonNegNumber(data.distractions, 500)\\n        && data.date is string && data.date.size() >= 1 && data.date.size() <= 32\\n        && data.createdAt is timestamp;\\n    }\\n\\n    function isValidHealthLog(data, userId) {\\n      return data.keys().hasAll([\'userId\', \'date\', \'source\', \'createdAt\', \'updatedAt\'])\\n        && data.keys().hasOnly([\'userId\', \'date\', \'sleepHours\', \'sleepBedtime\', \'steps\', \'activeCalories\', \'restingHeartRate\', \'source\', \'createdAt\', \'updatedAt\'])\\n        && data.userId == userId\\n        && data.date is string && data.date.size() >= 1 && data.date.size() <= 32\\n        && (!(\'sleepHours\' in data) || isValidNonNegNumber(data.sleepHours, 24))\\n        && isValidOptionalString(data, \'sleepBedtime\', 16)\\n        && (!(\'steps\' in data) || isValidNonNegNumber(data.steps, 200000))\\n        && (!(\'activeCalories\' in data) || isValidNonNegNumber(data.activeCalories, 20000))\\n        && (!(\'restingHeartRate\' in data) || isValidNonNegNumber(data.restingHeartRate, 240))\\n        && data.source in [\'manual\', \'health_connect\', \'xiaomi_band\']\\n        && data.createdAt is timestamp\\n        && data.updatedAt is timestamp;\\n    }\\n\\n    function isValidAppUsageLog(data, userId) {\\n      return data.keys().hasAll([\'userId\', \'date\', \'productivityMinutes\', \'socialMediaMinutes\', \'nighttimeMinutes\', \'source\', \'createdAt\', \'updatedAt\'])\\n        && data.keys().hasOnly([\'userId\', \'date\', \'productivityMinutes\', \'communicationMinutes\', \'socialMediaMinutes\', \'entertainmentMinutes\', \'educationMinutes\', \'otherMinutes\', \'nighttimeMinutes\', \'interruptions\', \'source\', \'createdAt\', \'updatedAt\'])\\n        && data.userId == userId\\n        && data.date is string && data.date.size() >= 1 && data.date.size() <= 32\\n        && isValidNonNegNumber(data.productivityMinutes, 1440)\\n        && (!(\'communicationMinutes\' in data) || isValidNonNegNumber(data.communicationMinutes, 1440))\\n        && isValidNonNegNumber(data.socialMediaMinutes, 1440)\\n        && (!(\'entertainmentMinutes\' in data) || isValidNonNegNumber(data.entertainmentMinutes, 1440))\\n        && (!(\'educationMinutes\' in data) || isValidNonNegNumber(data.educationMinutes, 1440))\\n        && (!(\'otherMinutes\' in data) || isValidNonNegNumber(data.otherMinutes, 1440))\\n        && isValidNonNegNumber(data.nighttimeMinutes, 720)\\n        && (!(\'interruptions\' in data) || isValidNonNegNumber(data.interruptions, 2000))\\n        && data.source in [\'manual\', \'usage_stats\']\\n        && data.createdAt is timestamp\\n        && data.updatedAt is timestamp;\\n    }\\n\\n    function isValidEnergyLog(data, userId) {\\n      return data.keys().hasAll([\'userId\', \'date\', \'energyLevel\', \'moodLevel\', \'focusLevel\', \'stressLevel\', \'createdAt\'])\\n        && data.keys().hasOnly([\'userId\', \'date\', \'energyLevel\', \'moodLevel\', \'focusLevel\', \'stressLevel\', \'notes\', \'createdAt\'])\\n        && data.userId == userId\\n        && data.date is string && data.date.size() >= 1 && data.date.size() <= 32\\n        && isValidNonNegNumber(data.energyLevel, 10)\\n        && isValidNonNegNumber(data.moodLevel, 10)\\n        && isValidNonNegNumber(data.focusLevel, 10)\\n        && isValidNonNegNumber(data.stressLevel, 10)\\n        && isValidOptionalString(data, \'notes\', 300)\\n        && data.createdAt is timestamp;\\n    }\\n\\n    function isValidPersonalGoal(data, userId) {\\n      return data.keys().hasAll([\'userId\', \'title\', \'category\', \'targetLabel\', \'deadline\', \'progress\', \'createdAt\', \'updatedAt\'])\\n        && data.keys().hasOnly([\'userId\', \'title\', \'description\', \'category\', \'targetLabel\', \'startDate\', \'deadline\', \'progress\', \'milestones\', \'createdAt\', \'updatedAt\'])\\n        && data.userId == userId\\n        && data.title is string && data.title.size() >= 1 && data.title.size() <= 180\\n        && isValidOptionalString(data, \'description\', 500)\\n        && data.category in [\'financial\', \'professional\', \'educational\', \'health\', \'personal\', \'social\']\\n        && data.targetLabel is string && data.targetLabel.size() >= 1 && data.targetLabel.size() <= 120\\n        && isValidOptionalString(data, \'startDate\', 32)\\n        && data.deadline is string && data.deadline.size() >= 1 && data.deadline.size() <= 32\\n        && isValidNonNegNumber(data.progress, 100)\\n        && (!(\'milestones\' in data) || (data.milestones is list && data.milestones.size() <= 20 && (data.milestones.size() == 0 || data.milestones[0] is map)))\\n        && data.createdAt is timestamp\\n        && data.updatedAt is timestamp;\\n    }\\n\\n    // --- User Root & PII-Isolated Profile ---\\n    match /users/{userId} {\\n      allow get: if isOwner(userId) && isValidId(userId);\\n      allow list: if false;\\n      allow create: if isOwner(userId)\\n        && isValidId(userId)\\n        && isValidUserProfile(incoming(), userId)\\n        && incoming().createdAt == request.time\\n        && incoming().updatedAt == request.time;\\n      allow update: if isOwner(userId)\\n        && isValidId(userId)\\n        && isValidUserProfile(incoming(), userId)\\n        && incoming().userId == existing().userId\\n        && incoming().createdAt == existing().createdAt\\n        && incoming().updatedAt == request.time\\n        && incoming().diff(existing()).affectedKeys().hasOnly([\\n          \'displayName\', \'email\', \'language\', \'currency\',\\n          \'dailyWorkHours\', \'workStartHour\', \'workEndHour\', \'targetSleepHours\',\\n          \'peakConcentration\', \'financialGoal\', \'smartphone\', \'smartwatch\',\\n          \'dailyStepTarget\', \'aiDefaultModel\', \'aiDailyLimit\', \'liabilitiesPiasters\',\\n          \'updatedAt\'\\n        ]);\\n      allow delete: if isOwner(userId) && isValidId(userId);\\n\\n      // --- Income Records ---\\n      match /income_records/{recordId} {\\n        allow get: if isOwner(userId) && isValidId(recordId);\\n        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;\\n        allow create: if isOwner(userId) && isValidId(recordId)\\n          && isValidIncomeRecord(incoming(), userId)\\n          && incoming().createdAt == request.time\\n          && incoming().updatedAt == request.time;\\n        allow update: if isOwner(userId) && isValidId(recordId)\\n          && isValidIncomeRecord(incoming(), userId)\\n          && incoming().userId == existing().userId\\n          && incoming().createdAt == existing().createdAt\\n          && incoming().updatedAt == request.time\\n          && incoming().diff(existing()).affectedKeys().hasOnly([\\n            \'title\', \'amountPiasters\', \'paidAmountPiasters\', \'source\', \'status\',\\n            \'dateReceived\', \'expectedPaymentDate\', \'projectName\', \'notes\', \'updatedAt\'\\n          ]);\\n        allow delete: if isOwner(userId) && isValidId(recordId);\\n      }\\n\\n      // --- Expense Records ---\\n      match /expense_records/{recordId} {\\n        allow get: if isOwner(userId) && isValidId(recordId);\\n        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;\\n        allow create: if isOwner(userId) && isValidId(recordId)\\n          && isValidExpenseRecord(incoming(), userId)\\n          && incoming().createdAt == request.time\\n          && incoming().updatedAt == request.time;\\n        allow update: if isOwner(userId) && isValidId(recordId)\\n          && isValidExpenseRecord(incoming(), userId)\\n          && incoming().userId == existing().userId\\n          && incoming().createdAt == existing().createdAt\\n          && incoming().updatedAt == request.time\\n          && incoming().diff(existing()).affectedKeys().hasOnly([\\n            \'description\', \'amountPiasters\', \'category\', \'date\', \'paymentMethod\', \'recurring\', \'notes\', \'updatedAt\'\\n          ]);\\n        allow delete: if isOwner(userId) && isValidId(recordId);\\n      }\\n\\n      // --- Budgets ---\\n      match /budgets/{budgetId} {\\n        allow get: if isOwner(userId) && isValidId(budgetId);\\n        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;\\n        allow create: if isOwner(userId) && isValidId(budgetId)\\n          && isValidBudget(incoming(), userId)\\n          && incoming().createdAt == request.time\\n          && incoming().updatedAt == request.time;\\n        allow update: if isOwner(userId) && isValidId(budgetId)\\n          && isValidBudget(incoming(), userId)\\n          && incoming().userId == existing().userId\\n          && incoming().createdAt == existing().createdAt\\n          && incoming().updatedAt == request.time\\n          && incoming().diff(existing()).affectedKeys().hasOnly([\'category\', \'monthKey\', \'limitPiasters\', \'updatedAt\']);\\n        allow delete: if isOwner(userId) && isValidId(budgetId);\\n      }\\n\\n      // --- Savings Goals ---\\n      match /savings_goals/{goalId} {\\n        allow get: if isOwner(userId) && isValidId(goalId);\\n        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;\\n        allow create: if isOwner(userId) && isValidId(goalId)\\n          && isValidSavingsGoal(incoming(), userId)\\n          && incoming().createdAt == request.time\\n          && incoming().updatedAt == request.time;\\n        allow update: if isOwner(userId) && isValidId(goalId)\\n          && isValidSavingsGoal(incoming(), userId)\\n          && incoming().userId == existing().userId\\n          && incoming().createdAt == existing().createdAt\\n          && incoming().updatedAt == request.time\\n          && incoming().diff(existing()).affectedKeys().hasOnly([\'title\', \'category\', \'targetPiasters\', \'currentPiasters\', \'targetDate\', \'updatedAt\']);\\n        allow delete: if isOwner(userId) && isValidId(goalId);\\n      }\\n\\n      // --- Investments ---\\n      match /investments/{investmentId} {\\n        allow get: if isOwner(userId) && isValidId(investmentId);\\n        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;\\n        allow create: if isOwner(userId) && isValidId(investmentId)\\n          && isValidInvestmentAsset(incoming(), userId)\\n          && incoming().createdAt == request.time\\n          && incoming().updatedAt == request.time;\\n        allow update: if isOwner(userId) && isValidId(investmentId)\\n          && isValidInvestmentAsset(incoming(), userId)\\n          && incoming().userId == existing().userId\\n          && incoming().createdAt == existing().createdAt\\n          && incoming().updatedAt == request.time\\n          && incoming().diff(existing()).affectedKeys().hasOnly([\\n            \'name\', \'category\', \'quantity\', \'purchasePricePiasters\',\\n            \'currentValuationPiasters\', \'feesPiasters\', \'realizedPnlPiasters\',\\n            \'purchaseDate\', \'valuationSource\', \'updatedAt\'\\n          ]);\\n        allow delete: if isOwner(userId) && isValidId(investmentId);\\n      }\\n\\n      // --- Tasks ---\\n      match /tasks/{taskId} {\\n        allow get: if isOwner(userId) && isValidId(taskId);\\n        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;\\n        allow create: if isOwner(userId) && isValidId(taskId)\\n          && isValidTaskItem(incoming(), userId)\\n          && incoming().createdAt == request.time\\n          && incoming().updatedAt == request.time;\\n        allow update: if isOwner(userId) && isValidId(taskId)\\n          && isValidTaskItem(incoming(), userId)\\n          && incoming().userId == existing().userId\\n          && incoming().createdAt == existing().createdAt\\n     