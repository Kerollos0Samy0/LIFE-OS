            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            <p className=\"text-6xl font-bold font-mono-nums text-[#F4F6F8] tracking-tight\" data-testid=\"focus-timer-display\">"
