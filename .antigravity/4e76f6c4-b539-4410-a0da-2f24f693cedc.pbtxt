            }
            lines {
              text: "          <div className=\"p-3.5 rounded-xl bg-red-500/10 border border-red-500/30 text-xs text-red-300\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            {briefingError}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ) : null}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        {briefing ? ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4 pt-2 border-t border-[#232A33] text-sm\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            <div className=\"space-y-1\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <p className=\"text-xs font-semibold text-emerald-400\">{isAr ? \'\331\205\331\204\330\247\330\255\330\270\330\251 \331\205\330\247\331\204\331\212\330\251\' : \'Financial Observation\'}</p>"
