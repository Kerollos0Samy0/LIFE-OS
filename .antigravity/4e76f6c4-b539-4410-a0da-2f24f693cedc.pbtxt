    source: CORTEX_STEP_SOURCE_USER_EXPLICIT
    source_trajectory_step_info {
      trajectory_id: "4e76f6c4-b539-4410-a0da-2f24f693cedc"
      step_index: 1
      cascade_id: "4e76f6c4-b539-4410-a0da-2f24f693cedc"
