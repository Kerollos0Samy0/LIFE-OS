  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { Check, Loader2, Plus, Sparkles, Trash2 } from \'lucide-react\';\nimport { useLifeOs } from \'../context/LifeOsContext\';\nimport { TODAY_ISO } from \'../data/seedData\';\nimport { GOAL_CATEGORY_LABELS } from \'../i18n/translations\';\nimport type { GoalCategory, PersonalGoal } from \'../types/lifeos\';\n\nexport const GoalsModule: React.FC = () => {\n  const { data, lang, addGoal, toggleGoalMilestone, appendGoalMilestones, deleteGoal, recordAiUsage } = useLifeOs();\n  const isAr = lang === \'ar\';\n\n  const [title, setTitle] = useState(\'\');\n  const [description, setDescription] = useState(\'\');\n  const [category, setCategory] = useState<GoalCategory>(\'financial\');\n  const [targetLabel, setTargetLabel] = useState(\'\');\n  const [deadline, setDeadline] = useState(\'2027-06-01\');\n  const [suggestingGoalId, setSuggestingGoalId] = useState<string | null>(null);\n  const [aiError, setAiError] = useState<string | null>(null);\n\n  const handleAddGoal = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!title.trim() || !targetLabel.trim()) return;\n    await addGoal({\n      title: title.trim(),\n      description: description.trim() || undefined,\n      category,\n      targetLabel: targetLabel.trim(),\n      startDate: TODAY_ISO,\n      deadline,\n      progress: 0,\n      milestones: [\n        { id: `ms-init-${Date.now()}`, title: isAr ? \'\330\252\330\255\330\257\331\212\330\257 \330\256\330\267\330\251 \330\247\331\204\330\243\330\263\330\250\331\210\330\271 \330\247\331\204\330\243\331\210\331\204\' : \'Define week-1 action plan\', completed: false },\n      ],\n    });\n    setTitle(\'\');\n    setDescription(\'\');\n    setTargetLabel(\'\');\n  };\n\n  const handleAiMilestones = async (goal: PersonalGoal) => {\n    setSuggestingGoalId(goal.id);\n    setAiError(null);\n    try {\n      const res = await fetch(\'/api/ai/goal-milestones\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          title: goal.title,\n          category: goal.category,\n          targetLabel: goal.targetLabel,\n          language: lang,\n        }),\n      });\n      const json = await res.json();\n      if (!res.ok) throw new Error(json.error || \'Failed to suggest milestones\');\n      if (json.tokensUsed) recordAiUsage(\'gemini-3.1-flash-lite\', json.tokensUsed);\n      if (Array.isArray(json.milestones) && json.milestones.length > 0) {\n        await appendGoalMilestones(goal.id, json.milestones);\n      }\n    } catch (err) {\n      setAiError(err instanceof Error ? err.message : \'Error suggesting milestones\');\n    } finally {\n      setSuggestingGoalId(null);\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      <div>\n        <h1 className=\"text-2xl font-bold text-[#F4F6F8]\">{isAr ? \'\330\247\331\204\330\243\331\207\330\257\330\247\331\201 \330\247\331\204\330\264\330\256\330\265\331\212\330\251\' : \'Personal Goals\'}</h1>\n        <p className=\"text-xs text-[#8E99A8] mt-1\">\n          {isAr\n            ? \'\330\245\330\257\330\247\330\261\330\251 \330\243\331\207\330\257\330\247\331\201\331\203 \330\247\331\204\331\205\330\247\331\204\331\212\330\251 \331\210\330\247\331\204\331\205\331\207\331\206\331\212\330\251 \331\210\330\247\331\204\330\252\330\271\331\204\331\212\331\205\331\212\330\251 \331\210\330\247\331\204\330\265\330\255\331\212\330\251 \331\210\330\247\331\204\330\264\330\256\330\265\331\212\330\251 \331\205\330\271 \330\247\331\202\330\252\330\261\330\247\330\255 \330\256\330\267\331\210\330\247\330\252 \330\271\331\205\331\204\331\212\330\251 \330\271\330\250\330\261 Gemini.\'\n            : \'Track financial, professional, educational, health, personal, and social goals with Gemini milestone suggestions.\'}\n        </p>\n      </div>\n\n      {aiError ? (\n        <div className=\"p-3.5 rounded-xl bg-red-500/10 border border-red-500/30 text-xs text-red-300\">{aiError}</div>\n      ) : null}\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-5\">\n        <form onSubmit={handleAddGoal} className=\"lg:col-span-4 bg-[#13171C] border border-[#232A33] rounded-2xl p-5 space-y-4 self-start\">\n          <h2 className=\"text-sm font-semibold text-[#F4F6F8]\">{isAr ? \'\330\245\330\266\330\247\331\201\330\251 \331\207\330\257\331\201 \330\254\330\257\331\212\330\257\' : \'Create Personal Goal\'}</h2>\n          <div>\n            <label htmlFor=\"goal-title\" className=\"block text-xs text-[#8E99A8] mb-1\">{isAr ? \'\330\271\331\206\331\210\330\247\331\206 \330\247\331\204\331\207\330\257\331\201\' : \'Goal Title\'}</label>\n            <input\n              id=\"goal-title\"\n              type=\"text\"\n              value={title}\n              onChange={(e) => setTitle(e.target.value)}\n              placeholder={isAr ? \'\331\205\330\253\330\247\331\204: \330\245\330\252\331\202\330\247\331\206 \330\252\330\267\331\210\331\212\330\261 \330\252\330\267\330\250\331\212\331\202\330\247\330\252 \330\247\331\204\331\205\331\210\330\250\330\247\331\212\331\204\' : \'e.g., Ship side project MVP\'}\n              className=\"w-full min-h-[44px] px-3.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\"\n            />\n          </div>\n          <div className=\"grid grid-cols-2 gap-3\">\n            <div>\n              <label htmlFor=\"goal-cat\" className=\"block text-xs text-[#8E99A8] mb-1\">{isAr ? \'\330\247\331\204\331\201\330\246\330\251\' : \'Category\'}</label>\n              <select\n                id=\"goal-cat\"\n                value={category}\n                onChange={(e) => setCategory(e.target.value as GoalCategory)}\n                className=\"w-full min-h-[44px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\"\n              >\n                {(Object.keys(GOAL_CATEGORY_LABELS) as GoalCategory[]).map((c) => (\n                  <option key={c} value={c}>{GOAL_CATEGORY_LABELS[c][lang]}</option>\n                ))}\n              </select>\n            </div>\n            <div>\n              <label htmlFor=\"goal-dl\" className=\"block text-xs text-[#8E99A8] mb-1\">{isAr ? \'\330\247\331\204\331\205\331\210\330\271\330\257 \330\247\331\204\331\205\330\263\330\252\331\207\330\257\331\201\' : \'Deadline\'}</label>\n              <input\n                id=\"goal-dl\"\n                type=\"date\"\n                value={deadline}\n                onChange={(e) => setDeadline(e.target.value)}\n                className=\"w-full min-h-[44px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-xs font-mono-nums text-[#F4F6F8]\"\n              />\n            </div>\n          </div>\n          <div>\n            <label htmlFor=\"goal-target\" className=\"block text-xs text-[#8E99A8] mb-1\">{isAr ? \'\330\247\331\204\331\205\330\271\331\212\330\247\330\261 \330\247\331\204\331\205\330\263\330\252\331\207\330\257\331\201\' : \'Measurable Target\'}</label>\n            <input\n              id=\"goal-target\"\n              type=\"text\"\n              value={targetLabel}\n              onChange={(e) => setTargetLabel(e.target.value)}\n              placeholder={isAr ? \'\331\205\330\253\330\247\331\204: 50,000 \330\254.\331\205 \330\243\331\210 3 \330\264\331\207\330\247\330\257\330\247\330\252\' : \'e.g., 50,000 EGP or 3 courses\'}\n              className=\"w-full min-h-[44px] px-3.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\"\n            />\n          </div>\n          <div>\n            <label htmlFor=\"goal-desc\" className=\"block text-xs text-[#8E99A8] mb-1\">{isAr ? \'\330\247\331\204\331\210\330\265\331\201 (\330\247\330\256\330\252\331\212\330\247\330\261\331\212)\' : \'Description (Optional)\'}</label>\n            <textarea\n              id=\"goal-desc\"\n              rows={2}\n              value={description}\n              onChange={(e) => setDescription(e.target.value)}\n              className=\"w-full p-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\"\n            />\n          </div>\n          <button type=\"submit\" className=\"w-full min-h-[44px] rounded-xl bg-emerald-500 text-[#07110C] font-semibold text-sm hover:bg-emerald-400 flex items-center justify-center gap-2\">\n            <Plus className=\"w-4 h-4\" />\n            {isAr ? \'\330\255\331\201\330\270 \330\247\331\204\331\207\330\257\331\201\' : \'Save Goal\'}\n          </button>\n        </form>\n\n        <div className=\"lg:col-span-8 space-y-4\">\n          {data.goals.map((goal) => (\n            <div key={goal.id} className=\"bg-[#13171C] border border-[#232A33] rounded-2xl p-5 space-y-4\">\n              <div className=\"flex items-start justify-between gap-3\">\n                <div>\n                  <p className=\"text-xs text-[#8E99A8]\">\n                    {GOAL_CATEGORY_LABELS[goal.category][lang]} \302\267 {goal.targetLabel} \302\267{\' \'}\n                    <span className=\"font-mono-nums\">{goal.deadline}</span>\n                  </p>\n                  <h3 className=\"text-base font-semibold text-[#F4F6F8] mt-1\">{goal.title}</h3>\n                  {goal.description ? <p className=\"text-xs text-[#A9B3C1] mt-1\">{goal.description}</p> : null}\n                </div>\n                <div className=\"flex items-center gap-2 shrink-0\">\n                  <button\n                    type=\"button\"\n                    disabled={suggestingGoalId === goal.id}\n                    onClick={() => void handleAiMilestones(goal)}\n                    className=\"min-h-[36px] px-3 rounded-xl border border-[#2A3340] text-xs font-medium text-emerald-400 hover:bg-[#1A212B] flex items-center gap-1.5 whitespace-nowrap\"\n                  >\n                    {suggestingGoalId === goal.id ? <Loader2 className=\"w-3.5 h-3.5 animate-spin\" /> : <Sparkles className=\"w-3.5 h-3.5\" />}\n                    {isAr ? \'\330\247\331\202\330\252\330\261\330\247\330\255 \330\256\330\267\331\210\330\247\330\252 AI\' : \'AI Milestones\'}\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => void deleteGoal(goal.id)}\n                    aria-label={`${isAr ? \'\330\255\330\260\331\201 \331\207\330\257\331\201\' : \'Delete goal\'} ${goal.title}`}\n                    className=\"min-h-[36px] min-w-[36px] flex items-center justify-center rounded-lg text-[#758091] hover:text-red-400\"\n                  >\n                    <Trash2 className=\"w-4 h-4\" />\n                  </button>\n                </div>\n              </div>\n\n              <div className=\"space-y-1.5\">\n                <div className=\"flex justify-between text-xs font-mono-nums\">\n                  <span className=\"text-[#8E99A8]\">{isAr ? \'\331\206\330\263\330\250\330\251 \330\247\331\204\330\245\331\206\330\254\330\247\330\262\' : \'Progress\'}</span>\n                  <span className=\"text-emerald-400 font-semibold\">{goal.progress}%</span>\n                </div>\n                <div className=\"h-2 rounded-full bg-[#0B0D10] overflow-hidden\">\n                  <div className=\"h-full bg-emerald-500 rounded-full transition-all\" style={{ width: `${goal.progress}%` }} />\n                </div>\n              </div>\n\n              <div className=\"pt-3 border-t border-[#232A33] space-y-2\">\n                {goal.milestones.map((m) => (\n                  <button\n                    key={m.id}\n                    type=\"button\"\n                    onClick={() => void toggleGoalMilestone(goal.id, m.id)}\n                    className=\"w-full flex items-center gap-2.5 text-start text-xs py-1.5 hover:text-[#F4F6F8] transition-colors\"\n                  >\n                    <span\n                      className={`w-5 h-5 rounded-md border flex items-center justify-center shrink-0 ${\n                        m.completed ? \'bg-emerald-500 border-emerald-500 text-[#07110C]\' : \'border-[#33404F] text-transparent\'\n                      }`}\n                    >\n                      <Check className=\"w-3.5 h-3.5\" />\n                    </span>\n                    <span className={m.completed ? \'line-through text-[#6C7787]\' : \'text-[#D2DAE5]\'}>{m.title}</span>\n                  </button>\n                ))}\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
