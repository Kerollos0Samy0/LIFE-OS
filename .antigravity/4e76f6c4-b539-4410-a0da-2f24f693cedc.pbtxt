wner(userId) && isValidId(logId);\\n        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;\\n        allow create: if isOwner(userId) && isValidId(logId)\\n          && isValidHealthLog(incoming(), userId)\\n          && incoming().createdAt == request.time\\n          && incoming().updatedAt == request.time;\\n        allow update: if isOwner(userId) && isValidId(logId)\\n          && isValidHealthLog(incoming(), userId)\\n          && incoming().userId == existing().userId\\n          && incoming().createdAt == existing().createdAt\\n          && incoming().updatedAt == request.time\\n          && incoming().diff(existing()).affectedKeys().hasOnly([\'sleepHours\', \'sleepBedtime\', \'steps\', \'activeCalories\', \'restingHeartRate\', \'source\', \'updatedAt\']);\\n        allow delete: if isOwner(userId) && isValidId(logId);\\n      }\\n\\n      // --- App Usage Logs ---\\n      match /app_usage/{usageId} {\\n        allow get: if isOwner(userId) && isValidId(usageId);\\n        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;\\n        allow create: if isOwner(userId) && isValidId(usageId)\\n          && isValidAppUsageLog(incoming(), userId)\\n          && incoming().createdAt == request.time\\n          && incoming().updatedAt == request.time;\\n        allow update: if isOwner(userId) && isValidId(usageId)\\n          && isValidAppUsageLog(incoming(), userId)\\n          && incoming().userId == existing().userId\\n          && incoming().createdAt == existing().createdAt\\n          && incoming().updatedAt == request.time\\n          && incoming().diff(existing()).affectedKeys().hasOnly([\\n            \'productivityMinutes\', \'communicationMinutes\', \'socialMediaMinutes\',\\n            \'entertainmentMinutes\', \'educationMinutes\', \'otherMinutes\',\\n            \'nighttimeMinutes\', \'interruptions\', \'source\', \'updatedAt\'\\n          ]);\\n        allow delete: if isOwner(userId) && isValidId(usageId);\\n      }\\n\\n      // --- Energy Logs ---\\n      match /energy_logs/{logId} {\\n        allow get: if isOwner(userId) && isValidId(logId);\\n        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;\\n        allow create: if isOwner(userId) && isValidId(logId)\\n          && isValidEnergyLog(incoming(), userId)\\n          && incoming().createdAt == request.time;\\n        allow update: if false;\\n        allow delete: if isOwner(userId) && isValidId(logId);\\n      }\\n\\n      // --- Personal Goals ---\\n      match /goals/{goalId} {\\n        allow get: if isOwner(userId) && isValidId(goalId);\\n        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;\\n        allow create: if isOwner(userId) && isValidId(goalId)\\n          && isValidPersonalGoal(incoming(), userId)\\n          && incoming().createdAt == request.time\\n          && incoming().updatedAt == request.time;\\n        allow update: if isOwner(userId) && isValidId(goalId)\\n          && isValidPersonalGoal(incoming(), userId)\\n          && incoming().userId == existing().userId\\n          && incoming().createdAt == existing().createdAt\\n          && incoming().updatedAt == request.time\\n          && incoming().diff(existing()).affectedKeys().hasOnly([\\n            \'title\', \'description\', \'category\', \'targetLabel\', \'startDate\',\\n            \'deadline\', \'progress\', \'milestones\', \'updatedAt\'\\n          ]);\\n        allow delete: if isOwner(userId) && isValidId(goalId);\\n      }\\n    }\\n  }\\n}\\n\", \"Description\":\"Draft hardened Firestore security rules implementing the Eight Pillars across all LIFE OS collections\", \"Overwrite\":true, \"TargetFile\":\"/DRAFT_firestore.rules\", \"toolAction\":\"Drafting Firestore security rules\", \"toolSummary\":\"Draft Firestore rules\"}"
