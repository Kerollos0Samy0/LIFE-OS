        instruction: "@import \"tailwindcss\";\n@custom-variant dark (&:where(.dark, .dark *));\n\n@layer base {\n  :root {\n    --font-ar: \"Cairo\", \"Plus Jakarta Sans\", system-ui, sans-serif;\n    --font-en: \"Plus Jakarta Sans\", \"Cairo\", system-ui, sans-serif;\n    --font-mono: \"JetBrains Mono\", ui-monospace, SFMono-Regular, monospace;\n    --bg-canvas: #0b0d10;\n    --bg-surface: #13171c;\n    --bg-elevated: #191f27;\n    --border-hairline: #232a33;\n    --text-primary: #f4f6f8;\n    --text-secondary: #8e99a8;\n    --accent-primary: #34d399;\n  }\n\n  html {\n    background-color: var(--bg-canvas);\n    color: var(--text-primary);\n    font-family: var(--font-ar);\n    scroll-behavior: smooth;\n  }\n\n  html[lang=\"en\"] {\n    font-family: var(--font-en);\n  }\n\n  body {\n    margin: 0;\n    min-height: 100dvh;\n    background-color: var(--bg-canvas);\n    color: var(--text-primary);\n    overflow-x: hidden;\n  }\n\n  h1, h2, h3 {\n    text-wrap: balance;\n  }\n}\n\n.font-mono-nums {\n  font-family: var(--font-mono);\n  font-variant-numeric: tabular-nums;\n}\n\n.tabular-nums {\n  font-variant-numeric: tabular-nums;\n}\n\n/* Custom slim dark scrollbar */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n\n::-webkit-scrollbar-track {\n  background: #0b0d10;\n}\n\n::-webkit-scrollbar-thumb {\n  background: #252c36;\n  border-radius: 9999px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: #33404f;\n}\n\n@media print {\n  .no-print {\n    display: none !important;\n  }\n  body {\n    background: #ffffff !important;\n    color: #0f172a !important;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after {\n    animation-duration: 0.01ms !important;\n    transition-duration: 0.01ms !important;\n  }\n}\n"
        path {
          absolute_uri: "file:///src/index.css"
        }
        overwrite: true
      }
    }
