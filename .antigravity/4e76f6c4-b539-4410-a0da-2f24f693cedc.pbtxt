  view_file {
    absolute_path_uri: "file:///src/components/VoiceExpenseModal.tsx"
    end_line: 341
    content: "import React, { useState } from \'react\';\nimport { Check, Loader2, Mic, MicOff, X } from \'lucide-react\';\nimport { useLifeOs } from \'../context/LifeOsContext\';\nimport {\n  DEFAULT_EXPENSE_CATEGORIES,\n  getCategoryLabel,\n  PAYMENT_METHOD_LABELS,\n} from \'../i18n/translations\';\nimport { TODAY_ISO } from \'../data/seedData\';\nimport { egpToPiasters } from \'../utils/finance\';\nimport type { ParsedExpenseProposal, PaymentMethod } from \'../types/lifeos\';\n\ninterface VoiceExpenseModalProps {\n  open: boolean;\n  onClose: () => void;\n}\n\ninterface SpeechRecognitionInstance {\n  lang: string;\n  interimResults: boolean;\n  maxAlternatives: number;\n  start: () => void;\n  stop: () => void;\n  onresult: ((ev: { results: ArrayLike<ArrayLike<{ transcript: string }>> }) => void) | null;\n  onerror: ((ev: { error: string }) => void) | null;\n  onend: (() => void) | null;\n}\n\nexport const VoiceExpenseModal: React.FC<VoiceExpenseModalProps> = ({ open, onClose }) => {\n  const { lang, addExpense, recordAiUsage, data } = useLifeOs();\n  const [inputText, setInputText] = useState(\'\');\n  const [isListening, setIsListening] = useState(false);\n  const [isParsing, setIsParsing] = useState(false);\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\n  const [proposal, setProposal] = useState<ParsedExpenseProposal | null>(null);\n  const [savedSuccess, setSavedSuccess] = useState(false);\n\n  if (!open) return null;\n\n  const isAr = lang === \'ar\';\n  const allCategories = [...DEFAULT_EXPENSE_CATEGORIES, ...(data.profile.customCategories || [])];\n\n  const handleVoiceCapture = () => {\n    setErrorMsg(null);\n    const w = window as unknown as {\n      SpeechRecognition?: new () => SpeechRecognitionInstance;\n      webkitSpeechRecognition?: new () => SpeechRecognitionInstance;\n    };\n    const SpeechRec = w.SpeechRecognition || w.webkitSpeechRecognition;\n    if (!SpeechRec) {\n      setErrorMsg(\n        isAr\n          ? \'\330\247\331\204\330\252\330\271\330\261\331\201 \330\247\331\204\330\265\331\210\330\252\331\212 \330\247\331\204\331\205\330\250\330\247\330\264\330\261 \330\272\331\212\330\261 \331\205\330\257\330\271\331\210\331\205 \331\201\331\212 \331\207\330\260\330\247 \330\247\331\204\331\205\330\252\330\265\331\201\330\255 \342\200\224 \331\212\331\205\331\203\331\206\331\203 \331\203\330\252\330\247\330\250\330\251 \330\247\331\204\330\254\331\205\331\204\330\251 \330\250\330\247\331\204\330\271\330\247\331\205\331\212\330\251 \330\247\331\204\331\205\330\265\330\261\331\212\330\251 \331\205\330\250\330\247\330\264\330\261\330\251 \330\243\330\257\331\206\330\247\331\207.\'\n          : \'Browser Speech Recognition is unavailable here \342\200\224 type your expense sentence directly below.\',\n      );\n      return;\n    }\n\n    const recognition = new SpeechRec();\n    recognition.lang = isAr ? \'ar-EG\' : \'en-US\';\n    recognition.interimResults = false;\n    recognition.maxAlternatives = 1;\n    setIsListening(true);\n\n    recognition.onresult = (event) => {\n      const transcript = event.results[0]?.[0]?.transcript || \'\';\n      setInputText(transcript);\n      setIsListening(false);\n    };\n    recognition.onerror = () => {\n      setIsListening(false);\n      setErrorMsg(isAr ? \'\330\252\330\271\330\260\331\221\330\261 \330\247\331\204\330\252\331\202\330\247\330\267 \330\247\331\204\330\265\331\210\330\252\330\214 \330\254\330\261\331\221\330\250 \330\247\331\204\331\203\330\252\330\247\330\250\330\251 \330\243\331\210 \330\245\330\271\330\247\330\257\330\251 \330\247\331\204\331\205\330\255\330\247\331\210\331\204\330\251.\' : \'Could not capture audio. Please type or retry.\');\n    };\n    recognition.onend = () => setIsListening(false);\n    recognition.start();\n  };\n\n  const handleParse = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!inputText.trim()) return;\n    setErrorMsg(null);\n    setProposal(null);\n    setSavedSuccess(false);\n    setIsParsing(true);\n\n    try {\n      const res = await fetch(\'/api/ai/parse-expense\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          text: inputText.trim(),\n          sourceType: \'voice\',\n          todayIso: TODAY_ISO,\n        }),\n      });\n      const json = await res.json();\n      if (!res.ok) {\n        throw new Error(json.error || \'Parsing failed\');\n      }\n      if (json.tokensUsed) {\n        recordAiUsage(\'gemini-3.1-flash-lite\', json.tokensUsed);\n      }\n      setProposal(json.proposal as ParsedExpenseProposal);\n    } catch (err) {\n      setErrorMsg(err instanceof Error ? err.message : \'Failed to parse expense\');\n    } finally {\n      setIsParsing(false);\n    }\n  };\n\n  const handleConfirmSave = async () => {\n    if (!proposal || proposal.amountEgp <= 0 || !proposal.description.trim()) {\n      setErrorMsg(isAr ? \'\331\212\330\261\330\254\331\211 \330\247\331\204\330\252\330\243\331\203\330\257 \331\205\331\206 \330\247\331\204\331\205\330\250\331\204\330\272 \331\210\330\247\331\204\331\210\330\265\331\201 \331\202\330\250\331\204 \330\247\331\204\330\255\331\201\330\270.\' : \'Please verify amount and description before saving.\');\n      return;\n    }\n    await addExpense({\n      description: proposal.description,\n      amountPiasters: egpToPiasters(proposal.amountEgp),\n      currency: \'EGP\',\n      category: proposal.category || \'other\',\n      date: proposal.date || TODAY_ISO,\n      paymentMethod: proposal.paymentMethod || \'cash\',\n      entrySource: \'voice\',\n      recurring: false,\n      notes: proposal.notes,\n    });\n    setSavedSuccess(true);\n    setTimeout(() => {\n      setSavedSuccess(false);\n      setProposal(null);\n      setInputText(\'\');\n      onClose();\n    }, 600);\n  };\n\n  return (\n    <div\n      className=\"fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-black/75 backdrop-blur-sm p-4\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-labelledby=\"voice-expense-title\"\n    >\n      <div className=\"w-full max-w-lg bg-[#13171C] border border-[#232A33] rounded-2xl p-6 space-y-5 max-h-[90vh] overflow-y-auto\">\n        <div className=\"flex items-center justify-between gap-4\">\n          <div>\n            <h2 id=\"voice-expense-title\" className=\"text-base font-semibold text-[#F4F6F8]\">\n              {isAr ? \'\330\252\330\263\330\254\331\212\331\204 \331\205\330\265\330\261\331\210\331\201 \330\250\330\247\331\204\330\265\331\210\330\252 \330\243\331\210 \330\247\331\204\331\206\330\265 \330\247\331\204\330\267\330\250\331\212\330\271\331\212\' : \'Voice & Natural-Language Expense Entry\'}\n            </h2>\n            <p className=\"text-xs text-[#8E99A8] mt-1\">\n              {isAr\n                ? \'\330\252\330\255\331\204\331\212\331\204 \330\260\331\203\331\212 \330\271\330\250\330\261 Gemini Flash-Lite \331\205\330\271 \330\264\330\247\330\264\330\251 \330\252\330\243\331\203\331\212\330\257 \330\245\331\204\330\262\330\247\331\205\331\212\330\251 \331\202\330\250\331\204 \330\247\331\204\330\255\331\201\330\270.\'\n                : \'Parsed via Gemini Flash-Lite with mandatory confirmation before saving.\'}\n            </p>\n          </div>\n          <button\n            type=\"button\"\n            onClick={onClose}\n            aria-label={isAr ? \'\330\245\330\272\331\204\330\247\331\202\' : \'Close\'}\n            className=\"min-h-[40px] min-w-[40px] flex items-center justify-center rounded-xl text-[#8E99A8] hover:text-[#F4F6F8] hover:bg-[#1C222B]\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        <form onSubmit={handleParse} className=\"space-y-3\">\n          <label htmlFor=\"voice-expense-input\" className=\"block text-xs font-medium text-[#A9B3C1]\">\n            {isAr ? \'\330\247\330\252\331\203\331\204\331\205 \330\243\331\210 \330\247\331\203\330\252\330\250 \330\247\331\204\331\205\330\265\330\261\331\210\331\201 \330\250\330\247\331\204\330\271\330\247\331\205\331\212\330\251 \330\247\331\204\331\205\330\265\330\261\331\212\330\251\' : \'Speak or type your expense naturally\'}\n          </label>\n          <div className=\"flex gap-2\">\n            <input\n              id=\"voice-expense-input\"\n              type=\"text\"\n              value={inputText}\n              onChange={(e) => setInputText(e.target.value)}\n              placeholder={isAr ? \'\331\205\330\253\330\247\331\204: \330\257\331\201\330\271\330\252 150 \330\254\331\206\331\212\331\207 \331\205\331\210\330\247\330\265\331\204\330\247\330\252 \330\247\331\204\331\206\331\207\330\247\330\261\330\257\331\207\' : \'e.g., Paid 150 EGP for Uber today\'}\n              className=\"flex-1 min-h-[44px] px-3.5 py-2.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8] placeholder:text-[#5E6877] focus:outline-none focus:border-emerald-500\"\n            />\n            <button\n              type=\"button\"\n              onClick={handleVoiceCapture}\n              aria-label={isAr ? \'\330\252\330\263\330\254\331\212\331\204 \330\265\331\210\330\252\331\212\' : \'Start voice input\'}\n              className={`min-h-[44px] min-w-[44px] px-3 rounded-xl border transition-colors flex items-center justify-center ${\n                isListening\n                  ? \'bg-red-500/20 border-red-500 text-red-400\'\n                  : \'bg-[#191F27] border-[#232A33] text-[#C8D0DC] hover:border-emerald-500/60\'\n              }`}\n            >\n              {isListening ? <MicOff className=\"w-4 h-4\" /> : <Mic className=\"w-4 h-4\" />}\n            </button>\n          </div>\n\n          <div className=\"flex flex-wrap gap-2 text-xs\">\n            <button\n              type=\"button\"\n              onClick={() => setInputText(\'\330\257\331\201\330\271\330\252 150 \330\254\331\206\331\212\331\207 \331\205\331\210\330\247\330\265\331\204\330\247\330\252 \330\247\331\204\331\206\331\207\330\247\330\261\330\257\331\207\')}\n              className=\"text-[#8E99A8] hover:text-emerald-400 underline underline-offset-4 transition-colors\"\n            >\n              \"\330\257\331\201\330\271\330\252 150 \330\254\331\206\331\212\331\207 \331\205\331\210\330\247\330\265\331\204\330\247\330\252 \330\247\331\204\331\206\331\207\330\247\330\261\330\257\331\207\"\n            </button>\n            <span className=\"text-[#404A58]\">\302\267</span>\n            <button\n              type=\"button\"\n              onClick={() => setInputText(\'\330\247\330\264\330\252\330\261\331\212\330\252 \331\202\331\207\331\210\330\251 \331\210\330\272\330\257\330\247 \330\250 220 \330\254\331\206\331\212\331\207 \331\203\330\247\330\264\')}\n              className=\"text-[#8E99A8] hover:text-emerald-400 underline underline-offset-4 transition-colors\"\n            >\n              \"\330\247\330\264\330\252\330\261\331\212\330\252 \331\202\331\207\331\210\330\251 \331\210\330\272\330\257\330\247 \330\250 220 \330\254\331\206\331\212\331\207 \331\203\330\247\330\264\"\n            </button>\n          </div>\n\n          <button\n            type=\"submit\"\n            disabled={isParsing || !inputText.trim()}\n            className=\"w-full min-h-[44px] rounded-xl bg-emerald-500 text-[#07110C] font-semibold text-sm hover:bg-emerald-400 disabled:opacity-50 transition-colors flex items-center justify-center gap-2\"\n          >\n            {isParsing ? <Loader2 className=\"w-4 h-4 animate-spin\" /> : null}\n            {isParsing\n              ? isAr ? \'\330\254\330\247\330\261\331\212 \330\247\331\204\330\252\330\255\331\204\331\212\331\204...\' : \'Parsing...\'\n              : isAr ? \'\330\252\330\255\331\204\331\212\331\204 \330\247\331\204\331\205\330\265\330\261\331\210\331\201 \331\202\330\250\331\204 \330\247\331\204\330\255\331\201\330\270\' : \'Extract & Review Expense\'}\n          </button>\n        </form>\n\n        {errorMsg ? (\n          <div className=\"p-3.5 rounded-xl bg-red-500/10 border border-red-500/30 text-xs text-red-300\">\n            {errorMsg}\n          </div>\n        ) : null}\n\n        {proposal ? (\n          <div className=\"pt-4 border-t border-[#232A33] space-y-4\">\n            <div className=\"flex items-center justify-between text-xs text-[#8E99A8]\">\n              <span className=\"font-semibold text-emerald-400\">\n                {isAr ? \'\331\205\330\261\330\247\330\254\330\271\330\251 \331\210\330\252\330\243\331\203\331\212\330\257 \330\247\331\204\331\205\330\271\330\247\331\205\331\204\330\251 (\330\245\331\204\330\262\330\247\331\205\331\212)\' : \'Confirm Extracted Transaction (Required)\'}\n              </span>\n              <span className=\"font-mono-nums\">\n                {isAr ? \'\330\257\331\202\330\251 \330\247\331\204\330\252\330\255\331\204\331\212\331\204:\' : \'Confidence:\'} {Math.round((proposal.confidence || 0) * 100)}%\n              </span>\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n              <div>\n                <label htmlFor=\"prop-amount\" className=\"block text-xs text-[#8E99A8] mb-1\">\n                  {isAr ? \'\330\247\331\204\331\205\330\250\331\204\330\272 (\330\254.\331\205)\' : \'Amount (EGP)\'}\n                </label>\n                <input\n                  id=\"prop-amount\"\n                  type=\"number\"\n                  step=\"0.01\"\n                  value={proposal.amountEgp}\n                  onChange={(e) => setProposal({ ...proposal, amountEgp: Number(e.target.value) })}\n                  className=\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\"\n                />\n              </div>\n\n              <div>\n                <label htmlFor=\"prop-cat\" className=\"block text-xs text-[#8E99A8] mb-1\">\n                  {isAr ? \'\330\247\331\204\330\252\330\265\331\206\331\212\331\201\' : \'Category\'}\n                </label>\n                <select\n                  id=\"prop-cat\"\n                  value={proposal.category}\n                  onChange={(e) => setProposal({ ...proposal, category: e.target.value })}\n                  className=\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\"\n                >\n                  {allCategories.map((cat) => (\n                    <option key={cat} value={cat}>\n                      {getCategoryLabel(cat, lang)}\n                    </option>\n                  ))}\n                </select>\n              </div>\n\n              <div className=\"sm:col-span-2\">\n                <label htmlFor=\"prop-desc\" className=\"block text-xs text-[#8E99A8] mb-1\">\n                  {isAr ? \'\330\247\331\204\331\210\330\265\331\201\' : \'Description\'}\n                </label>\n                <input\n                  id=\"prop-desc\"\n                  type=\"text\"\n                  value={proposal.description}\n                  onChange={(e) => setProposal({ ...proposal, description: e.target.value })}\n                  className=\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\"\n                />\n              </div>\n\n              <div>\n                <label htmlFor=\"prop-date\" className=\"block text-xs text-[#8E99A8] mb-1\">\n                  {isAr ? \'\330\247\331\204\330\252\330\247\330\261\331\212\330\256\' : \'Date\'}\n                </label>\n                <input\n                  id=\"prop-date\"\n                  type=\"date\"\n                  value={proposal.date}\n                  onChange={(e) => setProposal({ ...proposal, date: e.target.value })}\n                  className=\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\"\n                />\n              </div>\n\n              <div>\n                <label htmlFor=\"prop-method\" className=\"block text-xs text-[#8E99A8] mb-1\">\n                  {isAr ? \'\330\267\330\261\331\212\331\202\330\251 \330\247\331\204\330\257\331\201\330\271\' : \'Payment Method\'}\n                </label>\n                <select\n                  id=\"prop-method\"\n                  value={proposal.paymentMethod}\n                  onChange={(e) => setProposal({ ...proposal, paymentMethod: e.target.value as PaymentMethod })}\n                  className=\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\"\n                >\n                  {(Object.keys(PAYMENT_METHOD_LABELS) as PaymentMethod[]).map((m) => (\n                    <option key={m} value={m}>\n                      {PAYMENT_METHOD_LABELS[m][lang]}\n                    </option>\n                  ))}\n                </select>\n              </div>\n            </div>\n\n            <div className=\"flex items-center justify-end gap-3 pt-1\">\n              <button\n                type=\"button\"\n                onClick={() => setProposal(null)}\n                className=\"min-h-[44px] px-4 rounded-xl border border-[#232A33] text-sm text-[#C8D0DC] hover:bg-[#1B212A]\"\n              >\n                {isAr ? \'\330\245\331\204\330\272\330\247\330\241\' : \'Discard\'}\n              </button>\n              <button\n                type=\"button\"\n                onClick={handleConfirmSave}\n                className=\"min-h-[44px] px-5 rounded-xl bg-emerald-500 text-[#07110C] font-semibold text-sm hover:bg-emerald-400 flex items-center gap-2\"\n              >\n                <Check className=\"w-4 h-4\" />\n                {savedSuccess\n                  ? isAr ? \'\330\252\331\205 \330\247\331\204\330\255\331\201\330\270\' : \'Saved\'\n                  : isAr ? \'\330\252\330\243\331\203\331\212\330\257 \331\210\330\255\331\201\330\270 \330\247\331\204\331\205\330\265\330\261\331\210\331\201\' : \'Confirm & Save Expense\'}\n              </button>\n            </div>\n          </div>\n        ) : null}\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 342
    num_bytes: 14447
    line_range_bytes: 14447
  }
}
