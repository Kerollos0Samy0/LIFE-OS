      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add MicroGoalCategory and DailyMicroGoal types to LifeOsDataset\", \"EndLine\":278, \"Instruction\":\"Add MicroGoalCategory and DailyMicroGoal interfaces and include dailyMicroGoals in LifeOsDataset\", \"ReplacementContent\":\"export type GoalCategory = \'financial\' | \'professional\' | \'educational\' | \'health\' | \'personal\' | \'social\';\\n\\nexport interface GoalMilestone {\\n  id: string;\\n  title: string;\\n  completed: boolean;\\n}\\n\\nexport interface PersonalGoal {\\n  id: string;\\n  userId: string;\\n  title: string;\\n  description?: string;\\n  category: GoalCategory;\\n  targetLabel: string;\\n  startDate: string;\\n  deadline: string;\\n  progress: number; // 0-100\\n  milestones: GoalMilestone[];\\n}\\n\\nexport type MicroGoalCategory = \'focus\' | \'finance\' | \'health\' | \'wellbeing\' | \'personal\';\\n\\nexport interface DailyMicroGoal {\\n  id: string;\\n  userId: string;\\n  date: string; // YYYY-MM-DD\\n  title: string;\\n  category: MicroGoalCategory;\\n  targetValue: number;\\n  currentValue: number;\\n  unit: string;\\n  completed: boolean;\\n}\\n\\nexport interface ParsedExpenseProposal {\\n  description: string;\\n  amountEgp: number;\\n  category: string;\\n  date: string;\\n  paymentMethod: PaymentMethod;\\n  confidence: number;\\n  notes?: string;\\n}\\n\\nexport interface AiChatActionProposal {\\n  type: \'add_expense\' | \'add_task\';\\n  summary: string;\\n  payload: Record<string, unknown>;\\n}\\n\\nexport interface AiChatMessage {\\n  id: string;\\n  role: \'user\' | \'assistant\';\\n  content: string;\\n  model?: AiModelId;\\n  timestamp: string;\\n  tokensUsed?: number;\\n  proposal?: AiChatActionProposal;\\n  proposalApplied?: boolean;\\n}\\n\\nexport interface AiUsageStats {\\n  dateKey: string;\\n  requestsToday: number;\\n  tokensThisMonth: number;\\n  flashLiteCalls: number;\\n  flashCalls: number;\\n}\\n\\nexport interface LifeOsDataset {\\n  profile: UserProfile;\\n  incomeRecords: IncomeRecord[];\\n  expenseRecords: ExpenseRecord[];\\n  budgets: Budget[];\\n  savingsGoals: SavingsGoal[];\\n  investments: InvestmentAsset[];\\n  tasks: TaskItem[];\\n  calendarEvents: CalendarEvent[];\\n  focusSessions: FocusSession[];\\n  healthLogs: HealthLog[];\\n  appUsageLogs: AppUsageLog[];\\n  energyLogs: EnergyLog[];\\n  goals: PersonalGoal[];\\n  dailyMicroGoals: DailyMicroGoal[];\\n  aiUsage: AiUsageStats;\\n}\", \"StartLine\":206, \"TargetContent\":\"export type GoalCategory = \'financial\' | \'professional\' | \'educational\' | \'health\' | \'personal\' | \'social\';\\n\\nexport interface GoalMilestone {\\n  id: string;\\n  title: string;\\n  completed: boolean;\\n}\\n\\nexport interface PersonalGoal {\\n  id: string;\\n  userId: string;\\n  title: string;\\n  description?: string;\\n  category: GoalCategory;\\n  targetLabel: string;\\n  startDate: string;\\n  deadline: string;\\n  progress: number; // 0-100\\n  milestones: GoalMilestone[];\\n}\\n\\nexport interface ParsedExpenseProposal {\\n  description: string;\\n  amountEgp: number;\\n  category: string;\\n  date: string;\\n  paymentMethod: PaymentMethod;\\n  confidence: number;\\n  notes?: string;\\n}\\n\\nexport interface AiChatActionProposal {\\n  type: \'add_expense\' | \'add_task\';\\n  summary: string;\\n  payload: Record<string, unknown>;\\n}\\n\\nexport interface AiChatMessage {\\n  id: string;\\n  role: \'user\' | \'assistant\';\\n  content: string;\\n  model?: AiModelId;\\n  timestamp: string;\\n  tokensUsed?: number;\\n  proposal?: AiChatActionProposal;\\n  proposalApplied?: boolean;\\n}\\n\\nexport interface AiUsageStats {\\n  dateKey: string;\\n  requestsToday: number;\\n  tokensThisMonth: number;\\n  flashLiteCalls: number;\\n  flashCalls: number;\\n}\\n\\nexport interface LifeOsDataset {\\n  profile: UserProfile;\\n  incomeRecords: IncomeRecord[];\\n  expenseRecords: ExpenseRecord[];\\n  budgets: Budget[];\\n  savingsGoals: SavingsGoal[];\\n  investments: InvestmentAsset[];\\n  tasks: TaskItem[];\\n  calendarEvents: CalendarEvent[];\\n  focusSessions: FocusSession[];\\n  healthLogs: HealthLog[];\\n  appUsageLogs: AppUsageLog[];\\n  energyLogs: EnergyLog[];\\n  goals: PersonalGoal[];\\n  aiUsage: AiUsageStats;\\n}\", \"TargetFile\":\"/src/types/lifeos.ts\", \"toolAction\":\"Adding DailyMicroGoal types\", \"toolSummary\":\"Update lifeos.ts types\"}"
