            lines {
              text: "  estimatedScore: number | null; // 0-100, null if zero inputs available"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  level: \'high\' | \'moderate\' | \'low\' | \'unavailable\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  baselineDaysLogged: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  baselineTargetDays: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  measuredFactors: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    sleepHours: number | null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    sleepConsistencyPercent: number | null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    steps: number | null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    nighttimeScreenMinutes: number | null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    restingHeartRate: number | null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  };"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  selfReportedEnergy: number | null; // 1-10"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  recommendationsAr: string[];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  recommendationsEn: string[];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Transparent, non-medical personal energy estimator."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Gracefully re-weights only available metrics; never fabricates missing sensor data."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function calculateEnergyEstimate(params: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  healthLogs: HealthLog[];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  appUsageLogs: AppUsageLog[];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  energyLogs: EnergyLog[];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  dailyStepTarget: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  targetSleepHours: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  peakConcentration: PeakConcentration;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}): EnergyEstimateBreakdown {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const { healthLogs, appUsageLogs, energyLogs, dailyStepTarget, targetSleepHours, peakConcentration } = params;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const sortedHealth = [...healthLogs].sort((a, b) => b.date.localeCompare(a.date));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const sortedUsage = [...appUsageLogs].sort((a, b) => b.date.localeCompare(a.date));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const sortedEnergy = [...energyLogs].sort((a, b) => b.date.localeCompare(a.date));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const latestHealth = sortedHealth[0];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const latestUsage = sortedUsage[0];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const latestEnergy = sortedEnergy[0];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const sleepHours = latestHealth?.sleepHours ?? null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const steps = latestHealth?.steps ?? null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const restingHeartRate = latestHealth?.restingHeartRate ?? null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const nighttimeScreenMinutes = latestUsage?.nighttimeMinutes ?? null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const selfReportedEnergy = latestEnergy?.energyLevel ?? null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Sleep consistency based on standard deviation of recent sleep hours (up to 7 days)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const recentSleeps = sortedHealth"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    .slice(0, 7)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    .map((h) => h.sleepHours)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    .filter((v): v is number => typeof v === \'number\' && Number.isFinite(v));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let sleepConsistencyPercent: number | null = null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (recentSleeps.length >= 2) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const avg = recentSleeps.reduce((s, x) => s + x, 0) / recentSleeps.length;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const variance = recentSleeps.reduce((s, x) => s + (x - avg) ** 2, 0) / recentSleeps.length;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const stdDev = Math.sqrt(variance);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    sleepConsistencyPercent = Math.max(0, Math.min(100, Math.round(100 - stdDev * 25)));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let weightedSum = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let totalWeight = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // 1. Sleep duration (weight 30) \342\200\224 optimal ~7-8h, scaled thoughtfully for baseline"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (sleepHours !== null) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const optimal = Math.max(7, targetSleepHours);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const sleepScore = Math.max(0, Math.min(100, Math.round((sleepHours / optimal) * 100)));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    weightedSum += sleepScore * 30;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    totalWeight += 30;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // 2. Sleep consistency (weight 15)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (sleepConsistencyPercent !== null) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    weightedSum += sleepConsistencyPercent * 15;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    totalWeight += 15;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // 3. Activity / Steps (weight 20)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (steps !== null) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const stepRatio = steps / Math.max(1000, dailyStepTarget);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const activityScore = Math.max(0, Math.min(100, Math.round(stepRatio * 100)));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    weightedSum += activityScore * 20;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    totalWeight += 20;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // 4. Digital Wellbeing nighttime screen penalty (weight 15)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (nighttimeScreenMinutes !== null) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const digitalScore = Math.max(0, Math.min(100, Math.round(100 - nighttimeScreenMinutes * 1.1)));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    weightedSum += digitalScore * 15;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    totalWeight += 15;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // 5. Self-reported energy & stress check-in (weight 20)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (latestEnergy) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const selfScore = Math.max("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      Math.min(100, Math.round(((latestEnergy.energyLevel + latestEnergy.focusLevel + (11 - latestEnergy.stressLevel)) / 30) * 100)),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    weightedSum += selfScore * 20;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    totalWeight += 20;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const estimatedScore = totalWeight > 0 ? Math.round(weightedSum / totalWeight) : null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const level: EnergyEstimateBreakdown[\'level\'] ="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    estimatedScore === null"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ? \'unavailable\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      : estimatedScore >= 72"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ? \'high\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        : estimatedScore >= 48"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          ? \'moderate\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          : \'low\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const uniqueDates = new Set(["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ...healthLogs.map((h) => h.date),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ...energyLogs.map((e) => e.date),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ...appUsageLogs.map((u) => u.date),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ]);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const recommendationsAr: string[] = [];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const recommendationsEn: string[] = [];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (peakConcentration === \'morning\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    recommendationsAr.push(\'\330\247\330\250\330\257\330\243 \330\250\330\243\330\265\330\271\330\250 \331\205\331\207\331\205\330\251 \330\252\330\261\331\203\331\212\330\262 \330\271\331\205\331\212\331\202 \331\202\330\250\331\204 \330\247\331\204\330\263\330\247\330\271\330\251 11 \330\265\330\250\330\247\330\255\330\247\331\213 \331\204\330\247\330\263\330\252\330\272\331\204\330\247\331\204 \330\260\330\261\331\210\330\251 \330\252\330\261\331\203\331\212\330\262\331\203 \330\247\331\204\330\265\330\250\330\247\330\255\331\212\330\251.\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    recommendationsEn.push(\'Schedule your hardest deep-work task before 11:00 AM to match your morning concentration peak.\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (sleepHours !== null && sleepHours < 6) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    recommendationsAr.push(`\331\206\331\210\331\205\331\203 \330\247\331\204\330\243\330\256\331\212\330\261 (${sleepHours} \330\263\330\247\330\271\330\247\330\252) \330\243\331\202\331\204 \331\205\331\206 \330\247\331\204\331\205\331\210\330\265\331\211 \330\250\331\207 \342\200\224 \330\256\331\217\330\257 \330\247\330\263\330\252\330\261\330\247\330\255\330\251 \331\202\330\265\331\212\330\261\330\251 15 \330\257\331\202\331\212\331\202\330\251 \330\250\330\271\330\257 \330\247\331\204\330\270\331\207\330\261 \331\210\330\247\330\250\330\252\330\271\330\257 \330\271\331\206 \330\247\331\204\330\264\330\247\330\264\330\247\330\252 \331\202\330\250\331\204 \330\247\331\204\331\206\331\210\331\205.`);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    recommendationsEn.push(`Your recent sleep (${sleepHours}h) is short \342\200\224 plan a 15-minute afternoon break and wind down earlier tonight.`);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (nighttimeScreenMinutes !== null && nighttimeScreenMinutes >= 45) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    recommendationsAr.push(`\330\247\330\263\330\252\330\256\330\257\330\247\331\205 \330\247\331\204\331\205\331\210\330\250\330\247\331\212\331\204 \330\250\330\247\331\204\331\204\331\212\331\204 \331\210\330\265\331\204 ${nighttimeScreenMinutes} \330\257\331\202\331\212\331\202\330\251 \342\200\224 \330\254\330\261\330\250 \330\252\331\202\331\204\331\212\331\204 \330\247\331\204\330\263\331\210\330\264\331\212\330\247\331\204 \331\205\331\212\330\257\331\212\330\247 \331\202\330\250\331\204 \330\247\331\204\331\206\331\210\331\205 \330\250\330\263\330\247\330\271\330\251.`);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    recommendationsEn.push(`Nighttime phone usage reached ${nighttimeScreenMinutes} min \342\200\224 try silencing social apps 1 hour before bed.`);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (recommendationsAr.length < 2) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    recommendationsAr.push(\'\330\255\330\247\331\201\330\270 \330\271\331\204\331\211 \331\201\331\210\330\247\330\265\331\204 \330\261\330\247\330\255\330\251 \331\202\330\265\331\212\330\261\330\251 \331\203\331\204 25\342\200\22350 \330\257\331\202\331\212\331\202\330\251 \331\204\331\204\330\255\331\201\330\247\330\270 \330\271\331\204\331\211 \330\253\330\250\330\247\330\252 \330\267\330\247\331\202\330\252\331\203 \330\267\331\210\330\247\331\204 \330\263\330\247\330\271\330\247\330\252 \330\247\331\204\330\264\330\272\331\204.\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    recommendationsEn.push(\'Keep short recovery breaks every 25\342\200\22350 minutes to sustain focus across your 8-hour workday.\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    estimatedScore,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    level,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    baselineDaysLogged: uniqueDates.size,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    baselineTargetDays: 30,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    measuredFactors: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      sleepHours,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      sleepConsistencyPercent,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      steps,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      nighttimeScreenMinutes,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      restingHeartRate,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    selfReportedEnergy,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    recommendationsAr,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    recommendationsEn,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  };"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Checks whether a proposed task start time (HH:mm) falls outside configured working hours."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function isOutsideWorkingHours("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  scheduledStart: string | undefined,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  workStartHour: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  workEndHour: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "): boolean {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (!scheduledStart || !/^\\d{2}:\\d{2}$/.test(scheduledStart)) return false;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const [hh, mm] = scheduledStart.split(\':\').map(Number);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const decimalHour = hh + mm / 60;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return decimalHour < workStartHour || decimalHour >= workEndHour;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Smart schedule ordering: places high-priority deep work first for morning-peak users."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function sortTasksForSmartSchedule(tasks: TaskItem[], peak: PeakConcentration): TaskItem[] {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const priorityRank: Record<TaskItem[\'priority\'], number> = {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    critical: 4,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    high: 3,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    medium: 2,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    low: 1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  };"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return [...tasks].sort((a, b) => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (a.status === \'completed\' && b.status !== \'completed\') return 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (a.status !== \'completed\' && b.status === \'completed\') return -1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const aDeepBoost = peak === \'morning\' && a.category === \'deep_work\' ? 1.5 : 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const bDeepBoost = peak === \'morning\' && b.category === \'deep_work\' ? 1.5 : 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const scoreA = priorityRank[a.priority] + aDeepBoost;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const scoreB = priorityRank[b.priority] + bDeepBoost;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (scoreB !== scoreA) return scoreB - scoreA;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return (a.scheduledStart || \'23:59\').localeCompare(b.scheduledStart || \'23:59\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  });"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
          }
        }
        absolute_uri: "file:///src/utils/energy.ts"
        create_file: true
      }
    }
    use_fast_apply: true
    description: "Implement transparent non-medical energy estimation model and morning-peak smart scheduling helpers"
    diff_stats {
      additions: 202
    }
  }
