Future.\',\\n    nav: {\\n      home: \'Home\',\\n      finance: \'Finance\',\\n      time: \'Time\',\\n      health: \'Health\',\\n      ai: \'LIFE AI\',\\n      wellbeing: \'Wellbeing\',\\n      goals: \'Goals\',\\n      reports: \'Reports\',\\n      connections: \'Connections\',\\n      settings: \'Settings\',\\n      more: \'More\',\\n    },\\n    auth: {\\n      signInGoogle: \'Sign in with Google\',\\n      signOut: \'Sign out\',\\n      cloudSynced: \'Synced with Cloud Firestore\',\\n      localSampleMode: \'Local Sample Mode\',\\n      syncNotice: \'Showing sample local workspace data. Sign in with Google for encrypted cloud sync via Firestore.\',\\n    },\\n    common: {\\n      unavailable: \'Unavailable\',\\n      save: \'Save\',\\n      cancel: \'Cancel\',\\n      confirm: \'Confirm\',\\n      delete: \'Delete\',\\n      edit: \'Edit\',\\n      add: \'Add\',\\n      close: \'Close\',\\n      today: \'Today\',\\n      loading: \'Loading...\',\\n      egp: \'EGP\',\\n      hours: \'h\',\\n      minutes: \'min\',\\n      manualEntry: \'Manual entry\',\\n      nonMedicalNotice: \'Personal estimation for daily planning only \342\200\224 not a medical measurement or diagnosis.\',\\n    },\\n  },\\n} as const;\\n\", \"Description\":\"Create complete Arabic (Egyptian-friendly) and English translations and domain labels for LIFE OS\", \"Overwrite\":true, \"TargetFile\":\"/src/i18n/translations.ts\", \"toolAction\":\"Creating Arabic and English translations\", \"toolSummary\":\"Create i18n translations\"}"
