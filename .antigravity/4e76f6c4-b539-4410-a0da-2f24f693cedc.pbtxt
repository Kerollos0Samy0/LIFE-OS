              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <p className=\"text-xs font-semibold text-emerald-400\">{isAr ? \'\331\205\331\204\330\247\330\255\330\270\330\251 \330\247\331\204\330\245\331\206\330\252\330\247\330\254\331\212\330\251\' : \'Productivity Observation\'}</p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
