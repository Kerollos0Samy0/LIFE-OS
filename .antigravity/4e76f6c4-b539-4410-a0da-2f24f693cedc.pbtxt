              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {tab === \'budgets\' ? ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-5\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          <form onSubmit={handleAddBudget} className=\"lg:col-span-4 bg-[#13171C] border border-[#232A33] rounded-2xl p-5 space-y-4 self-start\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            <h2 className=\"text-sm font-semibold text-[#F4F6F8]\">{isAr ? \'\330\252\330\255\330\257\331\212\330\257 \330\243\331\210 \330\252\330\271\330\257\331\212\331\204 \331\205\331\212\330\262\330\247\331\206\331\212\330\251 \330\247\331\204\330\264\331\207\330\261\' : \'Set Monthly Budget\'}</h2>"
