              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            <span className=\"font-mono-nums\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              {isAr ? \'\331\207\330\257\331\201 \330\247\331\204\330\256\330\267\331\210\330\247\330\252:\' : \'Goal:\'}{\' \'}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              {metrics.latestHealth?.steps"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                ? `${Math.min(100, Math.round((metrics.latestHealth.steps / data.profile.dailyStepTarget) * 100))}%`"
