              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ) : ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          <div className=\"pt-3 border-t border-[#232A33] grid grid-cols-1 md:grid-cols-3 gap-4 text-xs text-[#A9B3C1]\">"
