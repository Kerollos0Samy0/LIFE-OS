  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { Check, Loader2, Mail, Shield, Upload } from \'lucide-react\';\nimport { useLifeOs } from \'../context/LifeOsContext\';\nimport { TODAY_ISO } from \'../data/seedData\';\nimport { egpToPiasters, piastersToEgp } from \'../utils/finance\';\nimport { getCategoryLabel } from \'../i18n/translations\';\nimport { ConfirmDialog } from \'./ConfirmDialog\';\nimport type { AiModelId, ParsedExpenseProposal, PeakConcentration } from \'../types/lifeos\';\n\ninterface ConnectionsSettingsProps {\n  mode: \'connections\' | \'settings\';\n}\n\nexport const ConnectionsSettingsModule: React.FC<ConnectionsSettingsProps> = ({ mode }) => {\n  const {\n    data,\n    lang,\n    user,\n    isCloudMode,\n    signInWithGoogle,\n    signOut,\n    updateProfile,\n    addExpense,\n    recordAiUsage,\n    exportJsonBackup,\n    importJsonBackup,\n    resetAllData,\n  } = useLifeOs();\n\n  const isAr = lang === \'ar\';\n\n  // Untrusted financial email parser (Gmail read-only extraction pattern)\n  const [emailSnippet, setEmailSnippet] = useState(\'\');\n  const [parsingEmail, setParsingEmail] = useState(false);\n  const [emailProposal, setEmailProposal] = useState<ParsedExpenseProposal | null>(null);\n  const [emailError, setEmailError] = useState<string | null>(null);\n  const [emailSaved, setEmailSaved] = useState(false);\n\n  // Settings form state\n  const [displayName, setDisplayName] = useState(data.profile.displayName);\n  const [dailyWorkHours, setDailyWorkHours] = useState(String(data.profile.dailyWorkHours));\n  const [workStart, setWorkStart] = useState(String(data.profile.workStartHour));\n  const [workEnd, setWorkEnd] = useState(String(data.profile.workEndHour));\n  const [targetSleep, setTargetSleep] = useState(String(data.profile.targetSleepHours));\n  const [peak, setPeak] = useState<PeakConcentration>(data.profile.peakConcentration);\n  const [financialGoal, setFinancialGoal] = useState(data.profile.financialGoal);\n  const [smartwatch, setSmartwatch] = useState(data.profile.smartwatch);\n  const [stepTarget, setStepTarget] = useState(String(data.profile.dailyStepTarget));\n  const [liabilitiesEgp, setLiabilitiesEgp] = useState(String(piastersToEgp(data.profile.liabilitiesPiasters)));\n  const [aiModel, setAiModel] = useState<AiModelId>(data.profile.aiDefaultModel);\n  const [aiLimit, setAiLimit] = useState(String(data.profile.aiDailyLimit));\n  const [settingsSaved, setSettingsSaved] = useState(false);\n  const [importStatus, setImportStatus] = useState<string | null>(null);\n  const [confirmReset, setConfirmReset] = useState(false);\n\n  const handleParseEmail = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!emailSnippet.trim()) return;\n    setParsingEmail(true);\n    setEmailError(null);\n    setEmailProposal(null);\n    setEmailSaved(false);\n    try {\n      const res = await fetch(\'/api/ai/parse-expense\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ text: emailSnippet.trim(), sourceType: \'email\', todayIso: TODAY_ISO }),\n      });\n      const json = await res.json();\n      if (!res.ok) throw new Error(json.error || \'Could not parse email receipt\');\n      if (json.tokensUsed) recordAiUsage(\'gemini-3.1-flash-lite\', json.tokensUsed);\n      setEmailProposal(json.proposal as ParsedExpenseProposal);\n    } catch (err) {\n      setEmailError(err instanceof Error ? err.message : \'Email parse error\');\n    } finally {\n      setParsingEmail(false);\n    }\n  };\n\n  const handleConfirmEmailExpense = async () => {\n    if (!emailProposal || emailProposal.amountEgp <= 0) return;\n    await addExpense({\n      description: emailProposal.description,\n      amountPiasters: egpToPiasters(emailProposal.amountEgp),\n      currency: \'EGP\',\n      category: emailProposal.category || \'other\',\n      date: emailProposal.date || TODAY_ISO,\n      paymentMethod: emailProposal.paymentMethod || \'card\',\n      entrySource: \'email_import\',\n      recurring: false,\n      notes: emailProposal.notes,\n    });\n    setEmailSaved(true);\n    setEmailProposal(null);\n    setEmailSnippet(\'\');\n  };\n\n  const handleSaveSettings = async (e: React.FormEvent) => {\n    e.preventDefault();\n    await updateProfile({\n      displayName: displayName.trim() || data.profile.displayName,\n      dailyWorkHours: Math.max(1, Math.min(18, Number(dailyWorkHours) || 8)),\n      workStartHour: Math.max(0, Math.min(23, Number(workStart) || 9)),\n      workEndHour: Math.max(1, Math.min(24, Number(workEnd) || 17)),\n      targetSleepHours: Math.max(3, Math.min(12, Number(targetSleep) || 6)),\n      peakConcentration: peak,\n      financialGoal: financialGoal.trim(),\n      smartwatch: smartwatch.trim(),\n      dailyStepTarget: Math.max(1000, Number(stepTarget) || 8000),\n      liabilitiesPiasters: egpToPiasters(Math.max(0, Number(liabilitiesEgp) || 0)),\n      aiDefaultModel: aiModel,\n      aiDailyLimit: Math.max(5, Math.min(500, Number(aiLimit) || 40)),\n    });\n    setSettingsSaved(true);\n    setTimeout(() => setSettingsSaved(false), 1800);\n  };\n\n  const handleImportFile = (ev: React.ChangeEvent<HTMLInputElement>) => {\n    const file = ev.target.files?.[0];\n    if (!file) return;\n    const reader = new FileReader();\n    reader.onload = () => {\n      const ok = importJsonBackup(String(reader.result || \'\'));\n      setImportStatus(\n        ok\n          ? isAr ? \'\330\252\331\205 \330\247\330\263\330\252\330\271\330\247\330\257\330\251 \330\247\331\204\331\206\330\263\330\256\330\251 \330\247\331\204\330\247\330\255\330\252\331\212\330\247\330\267\331\212\330\251 \330\250\331\206\330\254\330\247\330\255.\' : \'Backup restored successfully.\'\n          : isAr ? \'\331\205\331\204\331\201 \330\247\331\204\331\206\330\263\330\256\330\251 \330\247\331\204\330\247\330\255\330\252\331\212\330\247\330\267\331\212\330\251 \330\272\331\212\330\261 \330\265\330\247\331\204\330\255.\' : \'Invalid backup file format.\',\n      );\n    };\n    reader.readAsText(file);\n  };\n\n  if (mode === \'connections\') {\n    const integrations = [\n      {\n        name: isAr ? \'\330\255\330\263\330\247\330\250 Google \331\210 Cloud Firestore\' : \'Google Account & Cloud Firestore\',\n        status: isCloudMode\n          ? isAr ? `\331\205\330\252\330\265\331\204 (${user?.email})` : `Connected (${user?.email})`\n          : isAr ? \'\330\272\331\212\330\261 \331\205\330\252\330\265\331\204 (\331\210\330\266\330\271 \331\205\330\255\331\204\331\212)\' : \'Not connected (Local Mode)\',\n        live: isCloudMode,\n        privacy: isAr\n          ? \'\330\252\330\256\330\262\331\212\331\206 \331\205\330\264\331\201\331\221\330\261 \331\210\331\202\331\210\330\247\330\271\330\257 \330\243\331\205\330\247\331\206 \330\252\330\271\330\262\331\204 \330\250\331\212\330\247\331\206\330\247\330\252\331\203 \330\250\330\247\331\204\331\203\330\247\331\205\331\204 \330\250\330\247\330\263\331\205 \330\247\331\204\331\205\330\263\330\252\330\256\330\257\331\205 \330\247\331\204\330\256\330\247\330\265 \330\250\331\203 \331\201\331\202\330\267.\'\n          : \'Owner-isolated Firestore security rules keep all personal records strictly private to your UID.\',\n        action: isCloudMode\n          ? { label: isAr ? \'\330\252\330\263\330\254\331\212\331\204 \330\247\331\204\330\256\330\261\331\210\330\254\' : \'Sign out\', fn: () => void signOut() }\n          : { label: isAr ? \'\330\252\330\263\330\254\331\212\331\204 \330\247\331\204\330\257\330\256\331\210\331\204 \330\250\331\200 Google\' : \'Sign in with Google\', fn: () => void signInWithGoogle() },\n      },\n      {\n        name: \'Google Calendar\',\n        status: isAr ? \'\331\212\330\252\330\267\331\204\330\250 \330\252\331\201\330\271\331\212\331\204 OAuth (\330\252\331\202\331\210\331\212\331\205 \331\205\330\255\331\204\331\212 \331\206\330\264\330\267)\' : \'OAuth Not Enabled (Local Calendar Active)\',\n        live: false,\n        privacy: isAr\n          ? \'\331\212\330\267\331\204\330\250 \330\243\331\202\331\204 \330\265\331\204\330\247\330\255\331\212\330\251 \331\205\331\205\331\203\331\206\330\251 \331\204\331\202\330\261\330\247\330\241\330\251 \331\210\330\245\331\206\330\264\330\247\330\241 \330\247\331\204\330\243\330\255\330\257\330\247\330\253 \331\210\331\212\330\244\331\203\330\257 \330\257\330\247\330\246\331\205\330\247\331\213 \331\202\330\250\331\204 \330\247\331\204\330\255\330\260\331\201.\'\n          : \'Uses least-privilege event scopes and always confirms before deleting events.\',\n      },\n      {\n        name: \'Google Drive (LIFE OS Folder)\',\n        status: isAr ? \'\331\212\330\252\330\267\331\204\330\250 \330\252\331\201\330\271\331\212\331\204 OAuth (\330\252\330\265\330\257\331\212\330\261 JSON \331\205\330\255\331\204\331\212 \331\205\330\252\330\247\330\255)\' : \'OAuth Not Enabled (Local JSON Export Ready)\',\n        live: false,\n        privacy: isAr\n          ? \'\331\212\330\265\331\204 \331\201\331\202\330\267 \331\204\331\205\330\254\331\204\330\257 LIFE OS \330\247\331\204\331\205\330\256\330\265\330\265 \331\204\331\204\331\206\330\263\330\256 \330\247\331\204\330\247\330\255\330\252\331\212\330\247\330\267\331\212 \331\210\330\247\331\204\330\252\331\202\330\247\330\261\331\212\330\261.\'\n          : \'Uses narrowest drive.file permissions strictly for LIFE OS exports and backups.\',\n      },\n      {\n        name: \'Gmail (Read-Only Financial Emails)\',\n        status: isAr ? \'\331\212\330\252\330\267\331\204\330\250 \330\252\331\201\330\271\331\212\331\204 OAuth (\330\247\331\204\331\205\330\263\330\252\330\256\330\261\330\254 \330\247\331\204\331\212\330\257\331\210\331\212 \331\205\330\252\330\247\330\255 \330\243\330\257\331\206\330\247\331\207)\' : \'OAuth Not Enabled (Manual Parser Below)\',\n        live: false,\n        privacy: isAr\n          ? \'\331\202\330\261\330\247\330\241\330\251 \331\201\331\202\330\267 (\331\204\330\247 \331\212\330\261\330\263\331\204 \331\210\331\204\330\247 \331\212\330\255\330\260\331\201 \331\210\331\204\330\247 \331\212\330\271\330\257\331\204 \330\247\331\204\330\261\330\263\330\247\330\246\331\204 \330\243\330\250\330\257\330\247\331\213) \331\210\331\212\330\271\330\247\331\205\331\204 \331\205\330\255\330\252\331\210\331\211 \330\247\331\204\330\245\331\212\331\205\331\212\331\204 \331\203\330\250\331\212\330\247\331\206\330\247\330\252 \330\272\331\212\330\261 \331\205\331\210\330\253\331\210\331\202\330\251.\'\n          : \'Read-only in V1 \342\200\224 never sends, deletes, or modifies email; treats email text as untrusted data.\',\n      },\n      {\n        name: \'Android Health Connect & Xiaomi Smart Band\',\n        status: isAr ? \'\331\212\330\252\330\267\331\204\330\250 \330\252\330\267\330\250\331\212\331\202 Android \330\243\330\265\331\204\331\212 (\330\247\331\204\330\252\330\263\330\254\331\212\331\204 \330\247\331\204\331\212\330\257\331\210\331\212 \331\205\330\252\330\247\330\255)\' : \'Requires Native Android (Manual Logging Active)\',\n        live: false,\n        privacy: isAr\n          ? \'\331\212\331\202\330\261\330\243 \331\201\331\202\330\267 \330\247\331\204\331\205\331\202\330\247\331\212\331\212\330\263 \330\247\331\204\330\265\330\255\331\212\330\251 \330\247\331\204\330\252\331\212 \330\252\331\210\330\247\331\201\331\202 \330\271\331\204\331\212\331\207\330\247 \330\265\330\261\330\247\330\255\330\251\331\213 \330\271\330\250\330\261 Health Connect.\'\n          : \'Reads only explicitly authorized metrics through Android Health Connect.\',\n      },\n      {\n        name: \'Android Usage Stats (Digital Wellbeing)\',\n        status: isAr ? \'\331\212\330\252\330\267\331\204\330\250 \330\245\330\260\331\206 Android (\330\247\331\204\330\252\330\263\330\254\331\212\331\204 \330\247\331\204\331\212\330\257\331\210\331\212 \331\205\330\252\330\247\330\255)\' : \'Requires Android Permission (Manual Logging Active)\',\n        live: false,\n        privacy: isAr\n          ? \'\331\205\330\257\330\251 \330\247\330\263\330\252\330\256\330\257\330\247\331\205 \330\247\331\204\330\252\330\267\330\250\331\212\331\202\330\247\330\252 \331\201\331\202\330\267 \342\200\224 \331\204\330\247 \331\212\331\202\330\261\330\243 \330\247\331\204\330\261\330\263\330\247\330\246\331\204 \330\243\331\210 \331\203\331\204\331\205\330\247\330\252 \330\247\331\204\331\205\330\261\331\210\330\261 \330\243\331\210 \331\204\331\210\330\255\330\251 \330\247\331\204\331\205\331\201\330\247\330\252\331\212\330\255.\'\n          : \'App duration metadata only \342\200\224 never reads messages, passwords, or keystrokes.\',\n      },\n    ];\n\n    return (\n      <div className=\"space-y-6\">\n        <div>\n          <h1 className=\"text-2xl font-bold text-[#F4F6F8]\">{isAr ? \'\330\247\331\204\330\255\330\263\330\247\330\250\330\247\330\252 \330\247\331\204\331\205\330\252\330\265\331\204\330\251 \331\210\330\247\331\204\330\256\330\265\331\210\330\265\331\212\330\251\' : \'Connected Accounts & Privacy\'}</h1>\n          <p className=\"text-xs text-[#8E99A8] mt-1\">\n            {isAr\n              ? \'\330\264\331\201\330\247\331\201\331\212\330\251 \331\203\330\247\331\205\331\204\330\251 \330\255\331\210\331\204 \330\247\331\204\330\252\331\203\330\247\331\205\331\204\330\247\330\252 \330\247\331\204\331\201\330\271\330\247\331\204\330\251 \330\255\330\247\331\204\331\212\330\247\331\213 \331\210\330\247\331\204\330\252\331\203\330\247\331\205\331\204\330\247\330\252 \330\247\331\204\330\252\331\212 \330\252\330\252\330\267\331\204\330\250 \330\243\330\260\331\210\331\206\330\247\330\252 Android \330\243\331\210 OAuth.\'\n              : \'Honest availability status and privacy disclosures for every ecosystem integration.\'}\n          </p>\n        </div>\n\n        <div className=\"bg-[#13171C] border border-[#232A33] rounded-2xl divide-y divide-[#1D232C]\">\n          {integrations.map((item) => (\n            <div key={item.name} className=\"p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n              <div className=\"space-y-1\">\n                <p className=\"text-sm font-semibold text-[#F4F6F8]\">{item.name}</p>\n                <p className={`text-xs font-medium ${item.live ? \'text-emerald-400\' : \'text-[#8E99A8]\'}`}>{item.status}</p>\n                <p className=\"text-xs text-[#758091] flex items-center gap-1.5 pt-0.5\">\n                  <Shield className=\"w-3.5 h-3.5 shrink-0 text-emerald-400/70\" />\n                  {item.privacy}\n                </p>\n              </div>\n              {item.action ? (\n                <button\n                  type=\"button\"\n                  onClick={item.action.fn}\n                  className=\"min-h-[40px] px-4 rounded-xl bg-emerald-500 text-[#07110C] text-xs font-semibold hover:bg-emerald-400 whitespace-nowrap shrink-0 self-start sm:self-center\"\n                >\n                  {item.action.label}\n                </button>\n              ) : null}\n            </div>\n          ))}\n        </div>\n\n        {/* Financial Email Receipt Extractor (Treats email as untrusted data + requires confirmation) */}\n        <div className=\"bg-[#13171C] border border-[#232A33] rounded-2xl p-5 space-y-4\">\n          <div className=\"flex items-center gap-2\">\n            <Mail className=\"w-4 h-4 text-emerald-400\" />\n            <h2 className=\"text-sm font-semibold text-[#F4F6F8]\">\n              {isAr ? \'\330\247\330\263\330\252\330\256\330\261\330\247\330\254 \331\205\330\271\330\247\331\205\331\204\330\251 \331\205\331\206 \330\261\330\263\330\247\331\204\330\251 \330\245\331\212\330\265\330\247\331\204 / \330\245\330\264\330\271\330\247\330\261 \330\250\331\206\331\203\331\212 (\331\202\330\261\330\247\330\241\330\251 \331\201\331\202\330\267)\' : \'Financial Email / Notification Receipt Extractor\'}\n            </h2>\n          </div>\n          <p className=\"text-xs text-[#8E99A8]\">\n            {isAr\n              ? \'\330\247\331\204\330\265\331\202 \331\206\330\265 \330\245\330\264\330\271\330\247\330\261 \330\257\331\201\330\271 \330\243\331\210 \330\245\331\212\330\265\330\247\331\204 \330\264\330\261\330\247\330\241 \331\204\330\252\330\255\331\204\331\212\331\204\331\207 \331\203\330\250\331\212\330\247\331\206\330\247\330\252 \330\272\331\212\330\261 \331\205\331\210\330\253\331\210\331\202\330\251 \330\271\330\250\330\261 Gemini Flash-Lite\330\214 \330\253\331\205 \330\261\330\247\330\254\330\271\331\207 \331\202\330\250\331\204 \330\247\331\204\330\255\331\201\330\270.\'\n              : \'Paste a payment confirmation or receipt email. Parsed strictly as untrusted data and requires your confirmation.\'}\n          </p>\n          <form onSubmit={handleParseEmail} className=\"space-y-3\">\n            <textarea\n              rows={3}\n              value={emailSnippet}\n              onChange={(e) => setEmailSnippet(e.target.value)}\n              placeholder={\n                isAr\n                  ? \'\331\205\330\253\330\247\331\204: \330\252\331\205 \330\256\330\265\331\205 \331\205\330\250\331\204\330\272 420.00 EGP \331\205\331\206 \330\250\330\267\330\247\331\202\330\252\331\203 \331\204\330\257\331\211 Carrefour Egypt \330\250\330\252\330\247\330\261\331\212\330\256 2026-11-22 \330\261\331\202\331\205 \331\205\330\261\330\254\330\271\331\212 #88412\'\n                  : \'e.g., Payment confirmation: EGP 420.00 charged at Carrefour Egypt on 2026-11-22 Ref #88412\'\n              }\n              className=\"w-full p-3.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\"\n            />\n            <button\n              type=\"submit\"\n              disabled={parsingEmail || !emailSnippet.trim()}\n              className=\"min-h-[42px] px-5 rounded-xl bg-[#191F27] border border-[#2A3340] hover:border-emerald-500/60 text-xs font-semibold text-[#F4F6F8] inline-flex items-center gap-2\"\n            >\n              {parsingEmail ? <Loader2 className=\"w-3.5 h-3.5 animate-spin text-emerald-400\" /> : null}\n              {isAr ? \'\330\247\330\263\330\252\330\256\330\261\330\247\330\254 \330\250\331\212\330\247\331\206\330\247\330\252 \330\247\331\204\331\205\330\271\330\247\331\205\331\204\330\251 \331\204\331\204\331\205\330\261\330\247\330\254\330\271\330\251\' : \'Extract Transaction for Review\'}\n            </button>\n          </form>\n\n          {emailError ? <p className=\"text-xs text-red-400\">{emailError}</p> : null}\n          {emailSaved ? <p className=\"text-xs text-emerald-400\">{isAr ? \'\330\252\331\205 \330\255\331\201\330\270 \330\247\331\204\331\205\330\271\330\247\331\205\331\204\330\251 \331\201\331\212 \330\247\331\204\331\205\330\265\330\247\330\261\331\212\331\201.\' : \'Transaction saved to Expenses.\'}</p> : null}\n\n          {emailProposal ? (\n            <div className=\"pt-4 border-t border-[#232A33] flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n              <div className=\"text-xs space-y-1\">\n                <p className=\"font-semibold text-[#F4F6F8]\">\n                  {emailProposal.description} \342\200\224 <span className=\"font-mono-nums text-emerald-400\">{emailProposal.amountEgp} EGP</span>\n                </p>\n                <p className=\"text-[#8E99A8]\">\n                  {getCategoryLabel(emailProposal.category, lang)} \302\267 {emailProposal.date} \302\267 {emailProposal.notes || \'\'}\n                </p>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => void handleConfirmEmailExpense()}\n                className=\"min-h-[40px] px-4 rounded-xl bg-emerald-500 text-[#07110C] text-xs font-semibold hover:bg-emerald-400 inline-flex items-center gap-1.5 whitespace-nowrap\"\n              >\n                <Check className=\"w-3.5 h-3.5\" />\n                {isAr ? \'\330\252\330\243\331\203\331\212\330\257 \331\210\330\245\330\266\330\247\331\201\330\251 \331\204\331\204\331\205\330\265\330\247\330\261\331\212\331\201\' : \'Confirm & Add Expense\'}\n              </button>\n            </div>\n          ) : null}\n        </div>\n      </div>\n    );\n  }\n\n  // SETTINGS & PROFILE MODE\n  return (\n    <div className=\"space-y-6\">\n      <div>\n        <h1 className=\"text-2xl font-bold text-[#F4F6F8]\">{isAr ? \'\330\247\331\204\331\205\331\204\331\201 \330\247\331\204\330\264\330\256\330\265\331\212 \331\210\330\247\331\204\330\245\330\271\330\257\330\247\330\257\330\247\330\252\' : \'Profile & Settings\'}</h1>\n        <p className=\"text-xs text-[#8E99A8] mt-1\">\n          {isAr\n            ? \'\331\212\331\205\331\203\331\206\331\203 \330\252\330\271\330\257\331\212\331\204 \331\203\331\204 \330\252\331\201\330\266\331\212\331\204\330\247\330\252\331\203 \330\247\331\204\330\264\330\256\330\265\331\212\330\251 \331\210\330\247\331\204\330\271\331\205\331\204\331\212\330\251 \331\210\330\245\330\271\330\257\330\247\330\257\330\247\330\252 \330\247\331\204\330\260\331\203\330\247\330\241 \330\247\331\204\330\247\330\265\330\267\331\206\330\247\330\271\331\212 \331\210\330\247\331\204\331\206\330\263\330\256 \330\247\331\204\330\247\330\255\330\252\331\212\330\247\330\267\331\212 \331\201\331\212 \330\243\331\212 \331\210\331\202\330\252.\'\n            : \'Edit all personalization settings, schedule preferences, AI quotas, and data exports anytime.\'}\n        </p>\n      </div>\n\n      <form onSubmit={handleSaveSettings} className=\"bg-[#13171C] border border-[#232A33] rounded-2xl p-6 space-y-5\">\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n          <div>\n            <label htmlFor=\"set-name\" className=\"block text-xs text-[#8E99A8] mb-1\">{isAr ? \'\330\247\331\204\330\247\330\263\331\205\' : \'Display Name\'}</label>\n            <input id=\"set-name\" type=\"text\" value={displayName} onChange={(e) => setDisplayName(e.target.value)} className=\"w-full min-h-[44px] px-3.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\" />\n          </div>\n          <div>\n            <label htmlFor=\"set-goal\" className=\"block text-xs text-[#8E99A8] mb-1\">{isAr ? \'\330\247\331\204\331\207\330\257\331\201 \330\247\331\204\331\205\330\247\331\204\331\212 \330\247\331\204\330\261\330\246\331\212\330\263\331\212\' : \'Main Financial Goal\'}</label>\n            <input id=\"set-goal\" type=\"text\" value={financialGoal} onChange={(e) => setFinancialGoal(e.target.value)} className=\"w-full min-h-[44px] px-3.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\" />\n          </div>\n          <div>\n            <label htmlFor=\"set-peak\" className=\"block text-xs text-[#8E99A8] mb-1\">{isAr ? \'\331\201\330\252\330\261\330\251 \330\243\330\271\331\204\331\211 \330\252\330\261\331\203\331\212\330\262\' : \'Highest Concentration Period\'}</label>\n            <select id=\"set-peak\" value={peak} onChange={(e) => setPeak(e.target.value as PeakConcentration)} className=\"w-full min-h-[44px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\">\n              <option value=\"morning\">{isAr ? \'\330\247\331\204\330\265\330\250\330\247\330\255 (Morning)\' : \'Morning\'}</option>\n              <option value=\"afternoon\">{isAr ? \'\330\250\330\271\330\257 \330\247\331\204\330\270\331\207\330\261 (Afternoon)\' : \'Afternoon\'}</option>\n              <option value=\"evening\">{isAr ? \'\330\247\331\204\331\205\330\263\330\247\330\241 (Evening)\' : \'Evening\'}</option>\n            </select>\n          </div>\n          <div>\n            <label htmlFor=\"set-watch\" className=\"block text-xs text-[#8E99A8] mb-1\">{isAr ? \'\330\247\331\204\330\263\330\247\330\271\330\251 \330\247\331\204\330\260\331\203\331\212\330\251\' : \'Smartwatch\'}</label>\n            <input id=\"set-watch\" type=\"text\" value={smartwatch} onChange={(e) => setSmartwatch(e.target.value)} className=\"w-full min-h-[44px] px-3.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\" />\n          </div>\n          <div className=\"grid grid-cols-3 gap-2.5\">\n            <div>\n              <label htmlFor=\"set-wh\" className=\"block text-xs text-[#8E99A8] mb-1\">{isAr ? \'\330\263\330\247\330\271\330\247\330\252 \330\247\331\204\330\271\331\205\331\204\' : \'Work hrs\'}</label>\n              <input id=\"set-wh\" type=\"number\" value={dailyWorkHours} onChange={(e) => setDailyWorkHours(e.target.value)} className=\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\" />\n            </div>\n            <div>\n              <label htmlFor=\"set-ws\" className=\"block text-xs text-[#8E99A8] mb-1\">{isAr ? \'\330\250\330\257\330\247\331\212\330\251\' : \'Start hr\'}</label>\n              <input id=\"set-ws\" type=\"number\" value={workStart} onChange={(e) => setWorkStart(e.target.value)} className=\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\" />\n            </div>\n            <div>\n              <label htmlFor=\"set-we\" className=\"block text-xs text-[#8E99A8] mb-1\">{isAr ? \'\331\206\331\207\330\247\331\212\330\251\' : \'End hr\'}</label>\n              <input id=\"set-we\" type=\"number\" value={workEnd} onChange={(e) => setWorkEnd(e.target.value)} className=\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\" />\n            </div>\n          </div>\n          <div className=\"grid grid-cols-3 gap-2.5\">\n            <div>\n              <label htmlFor=\"set-sleep\" className=\"block text-xs text-[#8E99A8] mb-1\">{isAr ? \'\331\207\330\257\331\201 \330\247\331\204\331\206\331\210\331\205\' : \'Sleep (h)\'}</label>\n              <input id=\"set-sleep\" type=\"number\" step=\"0.5\" value={targetSleep} onChange={(e) => setTargetSleep(e.target.value)} className=\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\" />\n            </div>\n            <div>\n              <label htmlFor=\"set-steps\" className=\"block text-xs text-[#8E99A8] mb-1\">{isAr ? \'\331\207\330\257\331\201 \330\247\331\204\330\256\330\267\331\210\330\247\330\252\' : \'Steps\'}</label>\n              <input id=\"set-steps\" type=\"number\" value={stepTarget} onChange={(e) => setStepTarget(e.target.value)} className=\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\" />\n            </div>\n            <div>\n              <label htmlFor=\"set-liab\" className=\"block text-xs text-[#8E99A8] mb-1\">{isAr ? \'\330\247\331\204\330\252\330\262\330\247\331\205\330\247\330\252 (\330\254.\331\205)\' : \'Liabilities\'}</label>\n              <input id=\"set-liab\" type=\"number\" value={liabilitiesEgp} onChange={(e) => setLiabilitiesEgp(e.target.value)} className=\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\" />\n            </div>\n          </div>\n          <div>\n            <label htmlFor=\"set-ai-model\" className=\"block text-xs text-[#8E99A8] mb-1\">{isAr ? \'\331\206\331\205\331\210\330\260\330\254 LIFE AI \330\247\331\204\330\247\331\201\330\252\330\261\330\247\330\266\331\212\' : \'Default LIFE AI Model\'}</label>\n            <select id=\"set-ai-model\" value={aiModel} onChange={(e) => setAiModel(e.target.value as AiModelId)} className=\"w-full min-h-[44px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\">\n              <option value=\"gemini-3.1-flash-lite\">Gemini Flash-Lite</option>\n              <option value=\"gemini-4-hydrogen\">Gemini Flash</option>\n            </select>\n          </div>\n          <div>\n            <label htmlFor=\"set-ai-limit\" className=\"block text-xs text-[#8E99A8] mb-1\">{isAr ? \'\330\247\331\204\330\255\330\257 \330\247\331\204\331\212\331\210\331\205\331\212 \331\204\330\267\331\204\330\250\330\247\330\252 AI\' : \'Daily AI Request Limit\'}</label>\n            <input id=\"set-ai-limit\" type=\"number\" value={aiLimit} onChange={(e) => setAiLimit(e.target.value)} className=\"w-full min-h-[44px] px-3.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\" />\n          </div>\n        </div>\n\n        <div className=\"flex items-center justify-end gap-3 pt-2\">\n          <button type=\"submit\" className=\"min-h-[44px] px-6 rounded-xl bg-emerald-500 text-[#07110C] font-semibold text-sm hover:bg-emerald-400\">\n            {settingsSaved ? (isAr ? \'\330\252\331\205 \330\255\331\201\330\270 \330\247\331\204\330\245\330\271\330\257\330\247\330\257\330\247\330\252\' : \'Settings Saved\') : (isAr ? \'\330\255\331\201\330\270 \330\247\331\204\330\252\330\272\331\212\331\212\330\261\330\247\330\252\' : \'Save Changes\')}\n          </button>\n        </div>\n      </form>\n\n      {/* Data Ownership: Export, Restore & Reset */}\n      <div className=\"bg-[#13171C] border border-[#232A33] rounded-2xl p-6 space-y-4\">\n        <h2 className=\"text-sm font-semibold text-[#F4F6F8]\">{isAr ? \'\331\205\331\204\331\203\331\212\330\251 \330\247\331\204\330\250\331\212\330\247\331\206\330\247\330\252 \331\210\330\247\331\204\331\206\330\263\330\256 \330\247\331\204\330\247\330\255\330\252\331\212\330\247\330\267\331\212\' : \'Data Ownership, Backup & Account Reset\'}</h2>\n        <div className=\"flex flex-wrap items-center gap-3\">\n          <button\n            type=\"button\"\n            onClick={() => {\n              const blob = new Blob([exportJsonBackup()], { type: \'application/json\' });\n              const url = URL.createObjectURL(blob);\n              const a = document.createElement(\'a\');\n              a.href = url;\n              a.download = `life-os-backup-${TODAY_ISO}.json`;\n              a.click();\n              URL.revokeObjectURL(url);\n            }}\n            className=\"min-h-[42px] px-4 rounded-xl bg-[#191F27] border border-[#2A3340] text-xs font-semibold text-[#F4F6F8] hover:border-emerald-500/60\"\n          >\n            {isAr ? \'\330\252\330\265\330\257\331\212\330\261 \331\206\330\263\330\256\330\251 \330\247\330\255\330\252\331\212\330\247\330\267\331\212\330\251 JSON\' : \'Export JSON Backup\'}\n          </button>\n\n          <label className=\"min-h-[42px] px-4 rounded-xl bg-[#191F27] border border-[#2A3340] text-xs font-semibold text-[#F4F6F8] hover:border-emerald-500/60 inline-flex items-center gap-2 cursor-pointer\">\n            <Upload className=\"w-3.5 h-3.5\" />\n            {isAr ? \'\330\247\330\263\330\252\330\271\330\247\330\257\330\251 \331\206\330\263\330\256\330\251 JSON\' : \'Restore JSON Backup\'}\n            <input type=\"file\" accept=\"application/json\" onChange={handleImportFile} className=\"hidden\" />\n          </label>\n\n          <button\n            type=\"button\"\n            onClick={() => setConfirmReset(true)}\n            className=\"min-h-[42px] px-4 rounded-xl border border-red-500/40 text-xs font-semibold text-red-400 hover:bg-red-500/10\"\n          >\n            {isAr ? \'\330\245\330\271\330\247\330\257\330\251 \330\266\330\250\330\267 \330\247\331\204\330\250\331\212\330\247\331\206\330\247\330\252 \330\247\331\204\331\205\330\255\331\204\331\212\330\251\' : \'Reset Local Data\'}\n          </button>\n        </div>\n        {importStatus ? <p className=\"text-xs text-emerald-400\">{importStatus}</p> : null}\n      </div>\n\n      <ConfirmDialog\n        open={confirmReset}\n        title={isAr ? \'\330\252\330\243\331\203\331\212\330\257 \330\245\330\271\330\247\330\257\330\251 \330\266\330\250\330\267 \330\247\331\204\330\250\331\212\330\247\331\206\330\247\330\252\' : \'Confirm Data Reset\'}\n        description={\n          isAr\n            ? \'\330\263\331\212\330\252\331\205 \331\205\330\263\330\255 \330\247\331\204\330\252\330\271\330\257\331\212\331\204\330\247\330\252 \330\247\331\204\331\205\330\255\331\204\331\212\330\251 \331\210\330\245\330\271\330\247\330\257\330\251 \330\247\331\204\330\250\331\212\330\247\331\206\330\247\330\252 \331\204\331\204\331\210\330\266\330\271 \330\247\331\204\330\247\331\201\330\252\330\261\330\247\330\266\331\212 \330\247\331\204\330\243\331\210\331\204\331\212. \331\207\331\204 \330\243\331\206\330\252 \331\205\330\252\330\243\331\203\330\257\330\237\'\n            : \'This resets local workspace edits back to the initial starter dataset. Continue?\'\n        }\n        confirmLabel={isAr ? \'\331\206\330\271\331\205\330\214 \330\245\330\271\330\247\330\257\330\251 \330\247\331\204\330\266\330\250\330\267\' : \'Yes, Reset\'}\n        cancelLabel={isAr ? \'\330\245\331\204\330\272\330\247\330\241\' : \'Cancel\'}\n        tone=\"danger\"\n        onConfirm={async () => {\n          await resetAllData();\n          setConfirmReset(false);\n        }}\n        onCancel={() => setConfirmReset(false)}\n      />\n    </div>\n  );\n};\n"
