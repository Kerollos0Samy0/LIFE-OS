  planner_response {
    response: "\330\247\331\204\330\245\330\254\330\247\330\250\330\251 \330\247\331\204\331\205\330\256\330\252\330\265\330\261\330\251 \330\250\330\252\331\206\331\202\330\263\331\205 \331\204\330\254\330\262\330\243\331\212\331\206 \331\205\331\207\331\205\331\212\331\206:\n\n### 1. \330\252\330\271\330\257\331\212\331\204 \331\203\331\210\330\257 \330\247\331\204\330\252\330\267\330\250\331\212\331\202 \331\206\331\201\330\263\331\207 (\330\245\330\266\330\247\331\201\330\251 \330\264\330\247\330\264\330\247\330\252 \330\243\331\210 \330\250\330\261\331\205\330\254\330\251 \331\205\331\212\330\262\330\247\330\252 \330\254\330\257\331\212\330\257\330\251 \331\205\331\206 \330\247\331\204\330\265\331\201\330\261)\n**\331\204\330\247 \342\200\224 \330\247\331\204\331\205\330\263\330\247\330\271\330\257 (`LIFE AI`) \330\254\331\210\330\251 \330\247\331\204\330\252\330\267\330\250\331\212\331\202 \331\205\330\264 \330\250\331\212\330\271\330\257\331\221\331\204 \330\247\331\204\331\203\331\210\330\257 \330\247\331\204\331\205\330\265\330\257\330\261\331\212.**  \n\330\247\331\204\330\263\330\250\330\250 \330\243\331\205\331\206\331\212 \331\210\331\207\331\206\330\257\330\263\331\212: \330\247\331\204\330\252\330\267\330\250\331\212\331\202 \331\210\331\207\331\210 \330\264\330\272\330\247\331\204 \331\201\331\212 \330\247\331\204\331\205\330\252\330\265\331\201\330\255/\330\247\331\204\331\205\331\210\330\250\330\247\331\212\331\204 \330\250\331\212\331\203\331\210\331\206 \331\205\330\250\331\206\331\212 (Compiled) \330\250\330\247\331\204\331\201\330\271\331\204\330\214 \331\210\331\205\331\212\331\206\331\201\330\271\330\264 \331\212\330\271\330\257\331\221\331\204 \331\205\331\204\331\201\330\247\330\252 \330\247\331\204\331\203\331\210\330\257 \331\210\331\212\330\271\331\212\330\257 \330\250\331\206\330\247\330\241 \331\206\331\201\330\263\331\207. \330\243\331\212 \331\205\331\212\330\262\330\251 \330\250\330\261\331\205\330\254\331\212\330\251 \330\254\330\257\331\212\330\257\330\251 \330\243\331\210 \330\264\330\247\330\264\330\251 \330\254\330\257\331\212\330\257\330\251 \330\250\330\252\330\252\330\271\331\205\331\204 \331\207\331\206\330\247 \331\201\331\212 \331\205\330\263\330\247\330\255\330\251 \330\247\331\204\330\252\330\267\331\210\331\212\330\261 (\330\250\331\205\330\254\330\261\330\257 \331\205\330\247 \330\252\330\267\331\204\330\250\331\207\330\247 \331\205\331\206\331\212).\n\n---\n\n### 2. \330\252\330\271\330\257\331\212\331\204 \331\205\330\255\330\252\331\210\331\211 \330\247\331\204\330\252\330\267\330\250\331\212\331\202 \331\210\330\252\330\256\330\265\331\212\330\265\331\207 \331\205\331\206 \330\254\331\210\330\251 \330\247\331\204\331\205\330\255\330\247\330\257\330\253\330\251 (\331\210\330\257\331\207 \331\206\331\202\330\257\330\261 \331\206\330\271\331\205\331\204\331\207!)\n**\330\243\331\212\331\210\331\207\330\214 \331\210\330\250\330\264\331\203\331\204 \330\271\331\205\331\204\331\212 \330\254\330\257\330\247\331\213 \331\210\330\242\331\205\331\206.** \331\206\331\202\330\257\330\261 \331\206\330\262\331\210\331\221\330\257 `LIFE AI` \330\250\330\243\330\257\331\210\330\247\330\252 \331\205\331\206\330\270\331\221\331\205\330\251 (Function Calling) \330\252\330\256\331\204\331\212\331\207 \342\200\224 **\330\250\330\271\330\257 \331\205\330\247 \330\252\330\266\330\272\330\267 \330\252\330\243\331\203\331\212\330\257** \342\200\224 \331\212\331\202\330\257\330\261 \331\212\330\262\331\210\330\257 \331\210\331\212\330\264\331\212\331\204 \331\210\331\212\330\271\330\257\331\221\331\204 \330\255\330\247\330\254\330\247\330\252 \331\203\330\252\331\212\330\261 \330\257\330\247\330\256\331\204 \330\247\331\204\330\252\330\267\330\250\331\212\331\202 \331\210\330\252\330\252\330\255\331\201\330\270 \331\201\331\212 Firestore\330\214 \330\262\331\212:\n\n- **\330\247\331\204\330\252\330\255\331\203\331\205 \330\247\331\204\331\203\330\247\331\205\331\204 \331\201\331\212 \330\247\331\204\