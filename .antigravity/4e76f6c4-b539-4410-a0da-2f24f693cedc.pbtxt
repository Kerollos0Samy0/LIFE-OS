  user_input {
    user_response: "\330\247\330\271\331\205\331\204 \330\257\331\210\331\204"
    items {
      item {
        text_block {
          content: "---\ntype: \"feature\"\ntitle: \"Google Maps\"\nicon: \"maps_pin_colorful\"\n---\n\nI want to use Google Maps Platform. You **MUST** use the google-maps-platform (or google-maps-platform-ghp-integration) skill for this."
        }
      }
    }
    items {
      item {
        text_block {
          content: "---\ntype: \"feature\"\ntitle: \"Add voice conversations\"\nicon: \"audio_spark\"\n---\n\nAdd functionality to the app for users to use model gemini-3.8-live (Live API) in their app. This will allow users to have a conversation with the app and get responses from Live API in real-time."
        }
      }
    }
    items {
      item {
        text_block {
          content: "---\ntype: \"feature\"\ntitle: \"Add a Gemini chatbot\"\nicon: \"voice_chat\"\n---\n\nYou MUST add a multi-turn chat interface to the app using Gemini. The chat must maintain conversation history, display messages in a scrollable thread, and include a system instruction to give the chatbots specific roles. Use gemini-4-carbon for deep reasoning tasks, gemini-4-neon for particularly complex interactive tasks, gemini-4-hydrogen for general tasks, and gemini-3.1-flash-lite for tasks that should happen fast."
        }
      }
    }
    items {
      item {
        text_block {
          content: "---\ntype: \"feature\"\ntitle: \"Use Google Maps data\"\nicon: \"google_pin\"\n---\n\nYou MUST add Maps Grounding to the app where relevant to get up to date and accurate information. Use gemini-4-hydrogen (with googleMaps tool)"
        }
      }
    }
    items {
      text: "\330\247\330\271\331\205\331\204 \330\257\331\210\331\204"
    }
  }
}
