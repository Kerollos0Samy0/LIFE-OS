            }
            lines {
              text: "            <h2 className=\"text-sm font-semibold text-[#F4F6F8]\">{isAr ? \'\330\263\330\254\331\204 \330\254\331\204\330\263\330\247\330\252 \330\247\331\204\330\252\330\261\331\203\331\212\330\262\' : \'Focus Session History\'}</h2>"
