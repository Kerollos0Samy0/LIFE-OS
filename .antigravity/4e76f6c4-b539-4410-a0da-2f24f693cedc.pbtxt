            }
            lines {
              text: "            {data.incomeRecords.map((rec) => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              const paid = getPaidCashFromIncome(rec);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              const unpaid = getUnpaidAmountFromIncome(rec);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              return ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                <div key={rec.id} className=\"py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  <div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    <p className=\"text-sm font-semibold text-[#F4F6F8]\">{rec.title}</p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    <p className=\"text-xs text-[#8E99A8] mt-0.5\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                      {INCOME_SOURCE_LABELS[rec.source][lang]} \302\267{\' \'}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                      <span"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        className={"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                          rec.status === \'fully_paid\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            ? \'text-emerald-400\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            : rec.status === \'overdue\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                              ? \'text-red-400\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                              : \'text-amber-400\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                      >"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        {INCOME_STATUS_LABELS[rec.status][lang]}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                      </span>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                      {\' \302\267 \'}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                      <span className=\"font-mono-nums\">{rec.expectedPaymentDate}</span>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                      {rec.projectName ? ` \302\267 ${rec.projectName}` : \'\'}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    </p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
