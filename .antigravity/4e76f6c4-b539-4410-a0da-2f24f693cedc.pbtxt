1\331\201\330\271 \330\247\331\204\331\205\330\252\331\210\330\263\330\267 \330\245\331\204\331\211 6.5 \330\263\330\247\330\271\330\251\',\n        description: \'\330\252\331\202\331\204\331\212\331\204 \330\247\330\263\330\252\330\256\330\257\330\247\331\205 \330\247\331\204\331\205\331\210\330\250\330\247\331\212\331\204 \330\250\330\247\331\204\331\204\331\212\331\204 \331\202\330\250\331\204 \330\247\331\204\331\206\331\210\331\205 \330\250\330\263\330\247\330\271\330\251\',\n        category: \'health\',\n        targetLabel: \'6.5 \330\263\330\247\330\271\330\251 \331\206\331\210\331\205 \331\212\331\210\331\205\331\212\330\247\331\213\',\n        startDate: \'2026-11-01\',\n        deadline: \'2027-01-31\',\n        progress: 35,\n        milestones: [\n          { id: \'m5\', title: \'\330\252\330\263\330\254\331\212\331\204 \330\256\330\267 \330\247\331\204\330\243\330\263\330\247\330\263 \331\204\331\205\330\257\330\251 7 \330\243\331\212\330\247\331\205\', completed: true },\n          { id: \'m6\', title: \'\330\256\331\201\330\266 \331\210\331\202\330\252 \330\247\331\204\330\264\330\247\330\264\330\251 \330\247\331\204\331\204\331\212\331\204\331\212 \331\204\330\243\331\202\331\204 \331\205\331\206 30 \330\257\331\202\331\212\331\202\330\251\', completed: false },\n          { id: \'m7\', title: \'\330\247\331\204\331\206\331\210\331\205 \331\202\330\250\331\204 \330\247\331\204\330\263\330\247\330\271\330\251 12:30 \331\204\331\205\330\257\330\251 \330\243\330\263\330\250\331\210\330\271\331\212\331\206\', completed: false },\n        ],\n      },\n      {\n        id: \'goal-3\',\n        userId,\n        title: \'\330\252\331\210\330\263\331\212\330\271 \330\257\330\256\331\204 \330\247\331\204\331\201\330\261\331\212\331\204\330\247\331\206\330\263 \331\204\331\200 15 \330\243\331\204\331\201 \330\264\331\207\330\261\331\212\330\247\331\213\',\n        description: \'\330\245\330\272\331\204\330\247\331\202 \331\205\330\264\330\261\331\210\330\2