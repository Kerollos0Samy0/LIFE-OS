  view_file {
    absolute_path_uri: "file:///firestore.rules"
    end_line: 504
    content: "rules_version = \'2\';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    // Pillar 1 / Global Safety Net: Default deny all unmatched paths\n    match /{document=**} {\n      allow read, write: if false;\n    }\n\n    // --- Hardened Global Primitives ---\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function isVerifiedUser() {\n      return isSignedIn() && request.auth.token.email_verified == true;\n    }\n\n    function isOwner(userId) {\n      return isVerifiedUser() && request.auth.uid == userId;\n    }\n\n    function isValidId(id) {\n      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches(\'^[a-zA-Z0-9_\\\\-]+$\');\n    }\n\n    function incoming() {\n      return request.resource.data;\n    }\n\n    function existing() {\n      return resource.data;\n    }\n\n    function isValidOptionalString(data, field, maxLen) {\n      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);\n    }\n\n    function isValidNonNegNumber(val, maxVal) {\n      return (val is int || val is float) && val >= 0 && val <= maxVal;\n    }\n\n    function isValidMoney(val) {\n      return isValidNonNegNumber(val, 1000000000000);\n    }\n\n    // --- Validation Blueprints (Pillar 2: Called on BOTH create & update) ---\n    function isValidUserProfile(data, userId) {\n      return data.keys().hasAll([\'userId\', \'displayName\', \'language\', \'currency\', \'dailyWorkHours\', \'peakConcentration\', \'createdAt\', \'updatedAt\'])\n        && data.keys().hasOnly([\n          \'userId\', \'displayName\', \'email\', \'language\', \'currency\',\n          \'dailyWorkHours\', \'workStartHour\', \'workEndHour\', \'targetSleepHours\',\n          \'peakConcentration\', \'financialGoal\', \'smartphone\', \'smartwatch\',\n          \'dailyStepTarget\', \'aiDefaultModel\', \'aiDailyLimit\', \'liabilitiesPiasters\',\n          \'createdAt\', \'updatedAt\'\n        ])\n        && data.userId == userId\n        && isValidId(data.userId)\n        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120\n        && isValidOptionalString(data, \'email\', 200)\n        && data.language in [\'ar\', \'en\']\n        && data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 10\n        && isValidNonNegNumber(data.dailyWorkHours, 24)\n        && (!(\'workStartHour\' in data) || isValidNonNegNumber(data.workStartHour, 23))\n        && (!(\'workEndHour\' in data) || isValidNonNegNumber(data.workEndHour, 24))\n        && (!(\'targetSleepHours\' in data) || isValidNonNegNumber(data.targetSleepHours, 24))\n        && data.peakConcentration in [\'morning\', \'afternoon\', \'evening\']\n        && isValidOptionalString(data, \'financialGoal\', 200)\n        && isValidOptionalString(data, \'smartphone\', 60)\n        && isValidOptionalString(data, \'smartwatch\', 80)\n        && (!(\'dailyStepTarget\' in data) || isValidNonNegNumber(data.dailyStepTarget, 100000))\n        && (!(\'aiDefaultModel\' in data) || data.aiDefaultModel in [\'gemini-3.1-flash-lite\', \'gemini-4-hydrogen\'])\n        && (!(\'aiDailyLimit\' in data) || isValidNonNegNumber(data.aiDailyLimit, 500))\n        && (!(\'liabilitiesPiasters\' in data) || isValidMoney(data.liabilitiesPiasters))\n        && data.createdAt is timestamp\n        && data.updatedAt is timestamp;\n    }\n\n    function isValidIncomeRecord(data, userId) {\n      return data.keys().hasAll([\'userId\', \'title\', \'amountPiasters\', \'paidAmountPiasters\', \'currency\', \'source\', \'status\', \'expectedPaymentDate\', \'createdAt\', \'updatedAt\'])\n        && data.keys().hasOnly([\n          \'userId\', \'title\', \'amountPiasters\', \'paidAmountPiasters\', \'currency\',\n          \'source\', \'status\', \'dateReceived\', \'expectedPaymentDate\', \'projectName\',\n          \'notes\', \'createdAt\', \'updatedAt\'\n        ])\n        && data.userId == userId\n        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160\n        && isValidMoney(data.amountPiasters)\n        && isValidMoney(data.paidAmountPiasters)\n        && data.paidAmountPiasters <= data.amountPiasters\n        && data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 10\n        && data.source in [\'fixed_salary\', \'freelance\', \'additional\']\n        && data.status in [\'expected\', \'invoiced\', \'partially_paid\', \'fully_paid\', \'overdue\']\n        && isValidOptionalString(data, \'dateReceived\', 32)\n        && data.expectedPaymentDate is string && data.expectedPaymentDate.size() >= 1 && data.expectedPaymentDate.size() <= 32\n        && isValidOptionalString(data, \'projectName\', 120)\n        && isValidOptionalString(data, \'notes\', 500)\n        && data.createdAt is timestamp\n        && data.updatedAt is timestamp;\n    }\n\n    function isValidExpenseRecord(data, userId) {\n      return data.keys().hasAll([\'userId\', \'description\', \'amountPiasters\', \'currency\', \'category\', \'date\', \'paymentMethod\', \'entrySource\', \'recurring\', \'createdAt\', \'updatedAt\'])\n        && data.keys().hasOnly([\n          \'userId\', \'description\', \'amountPiasters\', \'currency\', \'category\',\n          \'date\', \'paymentMethod\', \'entrySource\', \'recurring\', \'notes\', \'createdAt\', \'updatedAt\'\n        ])\n        && data.userId == userId\n        && data.description is string && data.description.size() >= 1 && data.description.size() <= 200\n        && isValidMoney(data.amountPiasters)\n        && data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 10\n        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60\n        && data.date is string && data.date.size() >= 1 && data.date.size() <= 32\n        && data.paymentMethod in [\'cash\', \'card\', \'instapay\', \'wallet\', \'bank_transfer\']\n        && data.entrySource in [\'manual\', \'voice\', \'receipt\', \'notification\', \'email_import\']\n        && data.recurring is bool\n        && isValidOptionalString(data, \'notes\', 500)\n        && data.createdAt is timestamp\n        && data.updatedAt is timestamp;\n    }\n\n    function isValidBudget(data, userId) {\n      return data.keys().hasAll([\'userId\', \'category\', \'monthKey\', \'limitPiasters\', \'createdAt\', \'updatedAt\'])\n        && data.keys().hasOnly([\'userId\', \'category\', \'monthKey\', \'limitPiasters\', \'createdAt\', \'updatedAt\'])\n        && data.userId == userId\n        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60\n        && data.monthKey is string && data.monthKey.size() >= 4 && data.monthKey.size() <= 10\n        && isValidMoney(data.limitPiasters)\n        && data.createdAt is timestamp\n        && data.updatedAt is timestamp;\n    }\n\n    function isValidSavingsGoal(data, userId) {\n      return data.keys().hasAll([\'userId\', \'title\', \'category\', \'targetPiasters\', \'currentPiasters\', \'targetDate\', \'createdAt\', \'updatedAt\'])\n        && data.keys().hasOnly([\'userId\', \'title\', \'category\', \'targetPiasters\', \'currentPiasters\', \'targetDate\', \'createdAt\', \'updatedAt\'])\n        && data.userId == userId\n        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140\n        && data.category in [\'emergency\', \'purchases\', \'education\', \'travel\', \'investments\', \'custom\']\n        && isValidMoney(data.targetPiasters)\n        && isValidMoney(data.currentPiasters)\n        && data.targetDate is string && data.targetDate.size() >= 1 && data.targetDate.size() <= 32\n        && data.createdAt is timestamp\n        && data.updatedAt is timestamp;\n    }\n\n    function isValidInvestmentAsset(data, userId) {\n      return data.keys().hasAll([\'userId\', \'name\', \'category\', \'quantity\', \'purchasePricePiasters\', \'currentValuationPiasters\', \'feesPiasters\', \'realizedPnlPiasters\', \'purchaseDate\', \'valuationSource\', \'createdAt\', \'updatedAt\'])\n        && data.keys().hasOnly([\'userId\', \'name\', \'category\', \'quantity\', \'purchasePricePiasters\', \'currentValuationPiasters\', \'feesPiasters\', \'realizedPnlPiasters\', \'purchaseDate\', \'valuationSource\', \'createdAt\', \'updatedAt\'])\n        && data.userId == userId\n        && data.name is string && data.name.size() >= 1 && data.name.size() <= 140\n        && data.category in [\'gold\', \'stocks\', \'mutual_funds\', \'etfs\', \'other\']\n        && isValidNonNegNumber(data.quantity, 1000000000)\n        && isValidMoney(data.purchasePricePiasters)\n        && isValidMoney(data.currentValuationPiasters)\n        && isValidMoney(data.feesPiasters)\n        && (data.realizedPnlPiasters is int || data.realizedPnlPiasters is float)\n        && data.realizedPnlPiasters >= -1000000000000 && data.realizedPnlPiasters <= 1000000000000\n        && data.purchaseDate is string && data.purchaseDate.size() >= 1 && data.purchaseDate.size() <= 32\n        && data.valuationSource in [\'manual\', \'verified_market\']\n        && data.createdAt is timestamp\n        && data.updatedAt is timestamp;\n    }\n\n    function isValidTaskItem(data, userId) {\n      return data.keys().hasAll([\'userId\', \'title\', \'priority\', \'category\', \'status\', \'deadline\', \'estimatedMinutes\', \'actualMinutes\', \'createdAt\', \'updatedAt\'])\n        && data.keys().hasOnly([\'userId\', \'title\', \'description\', \'priority\', \'category\', \'status\', \'deadline\', \'scheduledStart\', \'estimatedMinutes\', \'actualMinutes\', \'project\', \'createdAt\', \'updatedAt\'])\n        && data.userId == userId\n        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200\n        && isValidOptionalString(data, \'description\', 600)\n        && data.priority in [\'critical\', \'high\', \'medium\', \'low\']\n        && data.category in [\'deep_work\', \'admin\', \'meetings\', \'personal\', \'rest\', \'commute\']\n        && data.status in [\'todo\', \'in_progress\', \'completed\']\n        && data.deadline is string && data.deadline.size() >= 1 && data.deadline.size() <= 32\n        && isValidOptionalString(data, \'scheduledStart\', 16)\n        && isValidNonNegNumber(data.estimatedMinutes, 1440)\n        && isValidNonNegNumber(data.actualMinutes, 1440)\n        && isValidOptionalString(data, \'project\', 120)\n        && data.createdAt is timestamp\n        && data.updatedAt is timestamp;\n    }\n\n    function isValidCalendarEvent(data, userId) {\n      return data.keys().hasAll([\'userId\', \'title\', \'calendarType\', \'date\', \'startTime\', \'endTime\', \'createdAt\', \'updatedAt\'])\n        && data.keys().hasOnly([\'userId\', \'title\', \'calendarType\', \'date\', \'startTime\', \'endTime\', \'notes\', \'createdAt\', \'updatedAt\'])\n        && data.userId == userId\n        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200\n        && data.calendarType in [\'work\', \'personal\']\n        && data.date is string && data.date.size() >= 1 && data.date.size() <= 32\n        && data.startTime is string && data.startTime.size() >= 1 && data.startTime.size() <= 16\n        && data.endTime is string && data.endTime.size() >= 1 && data.endTime.size() <= 16\n        && isValidOptionalString(data, \'notes\', 400)\n        && data.createdAt is timestamp\n        && data.updatedAt is timestamp;\n    }\n\n    function isValidFocusSession(data, userId) {\n      return data.keys().hasAll([\'userId\', \'label\', \'durationMinutes\', \'distractions\', \'date\', \'createdAt\'])\n        && data.keys().hasOnly([\'userId\', \'label\', \'durationMinutes\', \'distractions\', \'date\', \'createdAt\'])\n        && data.userId == userId\n        && data.label is string && data.label.size() >= 1 && data.label.size() <= 140\n        && isValidNonNegNumber(data.durationMinutes, 480)\n        && isValidNonNegNumber(data.distractions, 500)\n        && data.date is string && data.date.size() >= 1 && data.date.size() <= 32\n        && data.createdAt is timestamp;\n    }\n\n    function isValidHealthLog(data, userId) {\n      return data.keys().hasAll([\'userId\', \'date\', \'source\', \'createdAt\', \'updatedAt\'])\n        && data.keys().hasOnly([\'userId\', \'date\', \'sleepHours\', \'sleepBedtime\', \'steps\', \'activeCalories\', \'restingHeartRate\', \'source\', \'createdAt\', \'updatedAt\'])\n        && data.userId == userId\n        && data.date is string && data.date.size() >= 1 && data.date.size() <= 32\n        && (!(\'sleepHours\' in data) || isValidNonNegNumber(data.sleepHours, 24))\n        && isValidOptionalString(data, \'sleepBedtime\', 16)\n        && (!(\'steps\' in data) || isValidNonNegNumber(data.steps, 200000))\n        && (!(\'activeCalories\' in data) || isValidNonNegNumber(data.activeCalories, 20000))\n        && (!(\'restingHeartRate\' in data) || isValidNonNegNumber(data.restingHeartRate, 240))\n        && data.source in [\'manual\', \'health_connect\', \'xiaomi_band\']\n        && data.createdAt is timestamp\n        && data.updatedAt is timestamp;\n    }\n\n    function isValidAppUsageLog(data, userId) {\n      return data.keys().hasAll([\'userId\', \'date\', \'productivityMinutes\', \'socialMediaMinutes\', \'nighttimeMinutes\', \'source\', \'createdAt\', \'updatedAt\'])\n        && data.keys().hasOnly([\'userId\', \'date\', \'productivityMinutes\', \'communicationMinutes\', \'socialMediaMinutes\', \'entertainmentMinutes\', \'educationMinutes\', \'otherMinutes\', \'nighttimeMinutes\', \'interruptions\', \'source\', \'createdAt\', \'updatedAt\'])\n        && data.userId == userId\n        && data.date is string && data.date.size() >= 1 && data.date.size() <= 32\n        && isValidNonNegNumber(data.productivityMinutes, 1440)\n        && (!(\'communicationMinutes\' in data) || isValidNonNegNumber(data.communicationMinutes, 1440))\n        && isValidNonNegNumber(data.socialMediaMinutes, 1440)\n        && (!(\'entertainmentMinutes\' in data) || isValidNonNegNumber(data.entertainmentMinutes, 1440))\n        && (!(\'educationMinutes\' in data) || isValidNonNegNumber(data.educationMinutes, 1440))\n        && (!(\'otherMinutes\' in data) || isValidNonNegNumber(data.otherMinutes, 1440))\n        && isValidNonNegNumber(data.nighttimeMinutes, 720)\n        && (!(\'interruptions\' in data) || isValidNonNegNumber(data.interruptions, 2000))\n        && data.source in [\'manual\', \'usage_stats\']\n        && data.createdAt is timestamp\n        && data.updatedAt is timestamp;\n    }\n\n    function isValidEnergyLog(data, userId) {\n      return data.keys().hasAll([\'userId\', \'date\', \'energyLevel\', \'moodLevel\', \'focusLevel\', \'stressLevel\', \'createdAt\'])\n        && data.keys().hasOnly([\'userId\', \'date\', \'energyLevel\', \'moodLevel\', \'focusLevel\', \'stressLevel\', \'notes\', \'createdAt\'])\n        && data.userId == userId\n        && data.date is string && data.date.size() >= 1 && data.date.size() <= 32\n        && isValidNonNegNumber(data.energyLevel, 10)\n        && isValidNonNegNumber(data.moodLevel, 10)\n        && isValidNonNegNumber(data.focusLevel, 10)\n        && isValidNonNegNumber(data.stressLevel, 10)\n        && isValidOptionalString(data, \'notes\', 300)\n        && data.createdAt is timestamp;\n    }\n\n    function isValidPersonalGoal(data, userId) {\n      return data.keys().hasAll([\'userId\', \'title\', \'category\', \'targetLabel\', \'deadline\', \'progress\', \'createdAt\', \'updatedAt\'])\n        && data.keys().hasOnly([\'userId\', \'title\', \'description\', \'category\', \'targetLabel\', \'startDate\', \'deadline\', \'progress\', \'milestones\', \'createdAt\', \'updatedAt\'])\n        && data.userId == userId\n        && data.title is string && data.title.size() >= 1 && data.title.size() <= 180\n        && isValidOptionalString(data, \'description\', 500)\n        && data.category in [\'financial\', \'professional\', \'educational\', \'health\', \'personal\', \'social\']\n        && data.targetLabel is string && data.targetLabel.size() >= 1 && data.targetLabel.size() <= 120\n        && isValidOptionalString(data, \'startDate\', 32)\n        && data.deadline is string && data.deadline.size() >= 1 && data.deadline.size() <= 32\n        && isValidNonNegNumber(data.progress, 100)\n        && (!(\'milestones\' in data) || (data.milestones is list && data.milestones.size() <= 20 && (data.milestones.size() == 0 || data.milestones[0] is map)))\n        && data.createdAt is timestamp\n        && data.updatedAt is timestamp;\n    }\n\n    // --- User Root & PII-Isolated Profile ---\n    match /users/{userId} {\n      allow get: if isOwner(userId) && isValidId(userId);\n      allow list: if false;\n      allow create: if isOwner(userId)\n        && isValidId(userId)\n        && isValidUserProfile(incoming(), userId)\n        && incoming().createdAt == request.time\n        && incoming().updatedAt == request.time;\n      allow update: if isOwner(userId)\n        && isValidId(userId)\n        && isValidUserProfile(incoming(), userId)\n        && incoming().userId == existing().userId\n        && incoming().createdAt == existing().createdAt\n        && incoming().updatedAt == request.time\n        && incoming().diff(existing()).affectedKeys().hasOnly([\n          \'displayName\', \'email\', \'language\', \'currency\',\n          \'dailyWorkHours\', \'workStartHour\', \'workEndHour\', \'targetSleepHours\',\n          \'peakConcentration\', \'financialGoal\', \'smartphone\', \'smartwatch\',\n          \'dailyStepTarget\', \'aiDefaultModel\', \'aiDailyLimit\', \'liabilitiesPiasters\',\n          \'updatedAt\'\n        ]);\n      allow delete: if isOwner(userId) && isValidId(userId);\n\n      // --- Income Records ---\n      match /income_records/{recordId} {\n        allow get: if isOwner(userId) && isValidId(recordId);\n        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;\n        allow create: if isOwner(userId) && isValidId(recordId)\n          && isValidIncomeRecord(incoming(), userId)\n          && incoming().createdAt == request.time\n          && incoming().updatedAt == request.time;\n        allow update: if isOwner(userId) && isValidId(recordId)\n          && isValidIncomeRecord(incoming(), userId)\n          && incoming().userId == existing().userId\n          && incoming().createdAt == existing().createdAt\n          && incoming().updatedAt == request.time\n          && incoming().diff(existing()).affectedKeys().hasOnly([\n            \'title\', \'amountPiasters\', \'paidAmountPiasters\', \'source\', \'status\',\n            \'dateReceived\', \'expectedPaymentDate\', \'projectName\', \'notes\', \'updatedAt\'\n          ]);\n        allow delete: if isOwner(userId) && isValidId(recordId);\n      }\n\n      // --- Expense Records ---\n      match /expense_records/{recordId} {\n        allow get: if isOwner(userId) && isValidId(recordId);\n        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;\n        allow create: if isOwner(userId) && isValidId(recordId)\n          && isValidExpenseRecord(incoming(), userId)\n          && incoming().createdAt == request.time\n          && incoming().updatedAt == request.time;\n        allow update: if isOwner(userId) && isValidId(recordId)\n          && isValidExpenseRecord(incoming(), userId)\n          && incoming().userId == existing().userId\n          && incoming().createdAt == existing().createdAt\n          && incoming().updatedAt == request.time\n          && incoming().diff(existing()).affectedKeys().hasOnly([\n            \'description\', \'amountPiasters\', \'category\', \'date\', \'paymentMethod\', \'recurring\', \'notes\', \'updatedAt\'\n          ]);\n        allow delete: if isOwner(userId) && isValidId(recordId);\n      }\n\n      // --- Budgets ---\n      match /budgets/{budgetId} {\n        allow get: if isOwner(userId) && isValidId(budgetId);\n        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;\n        allow create: if isOwner(userId) && isValidId(budgetId)\n          && isValidBudget(incoming(), userId)\n          && incoming().createdAt == request.time\n          && incoming().updatedAt == request.time;\n        allow update: if isOwner(userId) && isValidId(budgetId)\n          && isValidBudget(incoming(), userId)\n          && incoming().userId == existing().userId\n          && incoming().createdAt == existing().createdAt\n          && incoming().updatedAt == request.time\n          && incoming().diff(existing()).affectedKeys().hasOnly([\'category\', \'monthKey\', \'limitPiasters\', \'updatedAt\']);\n        allow delete: if isOwner(userId) && isValidId(budgetId);\n      }\n\n      // --- Savings Goals ---\n      match /savings_goals/{goalId} {\n        allow get: if isOwner(userId) && isValidId(goalId);\n        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;\n        allow create: if isOwner(userId) && isValidId(goalId)\n          && isValidSavingsGoal(incoming(), userId)\n          && incoming().createdAt == request.time\n          && incoming().updatedAt == request.time;\n        allow update: if isOwner(userId) && isValidId(goalId)\n          && isValidSavingsGoal(incoming(), userId)\n          && incoming().userId == existing().userId\n          && incoming().createdAt == existing().createdAt\n          && incoming().updatedAt == request.time\n          && incoming().diff(existing()).affectedKeys().hasOnly([\'title\', \'category\', \'targetPiasters\', \'currentPiasters\', \'targetDate\', \'updatedAt\']);\n        allow delete: if isOwner(userId) && isValidId(goalId);\n      }\n\n      // --- Investments ---\n      match /investments/{investmentId} {\n        allow get: if isOwner(userId) && isValidId(investmentId);\n        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;\n        allow create: if isOwner(userId) && isValidId(investmentId)\n          && isValidInvestmentAsset(incoming(), userId)\n          && incoming().createdAt == request.time\n          && incoming().updatedAt == request.time;\n        allow update: if isOwner(userId) && isValidId(investmentId)\n          && isValidInvestmentAsset(incoming(), userId)\n          && incoming().userId == existing().userId\n          && incoming().createdAt == existing().createdAt\n          && incoming().updatedAt == request.time\n          && incoming().diff(existing()).affectedKeys().hasOnly([\n            \'name\', \'category\', \'quantity\', \'purchasePricePiasters\',\n            \'currentValuationPiasters\', \'feesPiasters\', \'realizedPnlPiasters\',\n            \'purchaseDate\', \'valuationSource\', \'updatedAt\'\n          ]);\n        allow delete: if isOwner(userId) && isValidId(investmentId);\n      }\n\n      // --- Tasks ---\n      match /tasks/{taskId} {\n        allow get: if isOwner(userId) && isValidId(taskId);\n        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;\n        allow create: if isOwner(userId) && isValidId(taskId)\n          && isValidTaskItem(incoming(), userId)\n          && incoming().createdAt == request.time\n          && incoming().updatedAt == request.time;\n        allow update: if isOwner(userId) && isValidId(taskId)\n          && isValidTaskItem(incoming(), userId)\n          && incoming().userId == existing().userId\n          && incoming().createdAt == existing().createdAt\n          && incoming().updatedAt == request.time\n          && incoming().diff(existing()).affectedKeys().hasOnly([\n            \'title\', \'description\', \'priority\', \'category\', \'status\',\n            \'deadline\', \'scheduledStart\', \'estimatedMinutes\', \'actualMinutes\', \'project\', \'updatedAt\'\n          ]);\n        allow delete: if isOwner(userId) && isValidId(taskId);\n      }\n\n      // --- Calendar Events ---\n      match /calendar_events/{eventId} {\n        allow get: if isOwner(userId) && isValidId(eventId);\n        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;\n        allow create: if isOwner(userId) && isValidId(eventId)\n          && isValidCalendarEvent(incoming(), userId)\n          && incoming().createdAt == request.time\n          && incoming().updatedAt == request.time;\n        allow update: if isOwner(userId) && isValidId(eventId)\n          && isValidCalendarEvent(incoming(), userId)\n          && incoming().userId == existing().userId\n          && incoming().createdAt == existing().createdAt\n          && incoming().updatedAt == request.time\n          && incoming().diff(existing()).affectedKeys().hasOnly([\'title\', \'calendarType\', \'date\', \'startTime\', \'endTime\', \'notes\', \'updatedAt\']);\n        allow delete: if isOwner(userId) && isValidId(eventId);\n      }\n\n      // --- Focus Sessions ---\n      match /focus_sessions/{sessionId} {\n        allow get: if isOwner(userId) && isValidId(sessionId);\n        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;\n        allow create: if isOwner(userId) && isValidId(sessionId)\n          && isValidFocusSession(incoming(), userId)\n          && incoming().createdAt == request.time;\n        allow update: if false;\n        allow delete: if isOwner(userId) && isValidId(sessionId);\n      }\n\n      // --- Health Logs ---\n      match /health_logs/{logId} {\n        allow get: if isOwner(userId) && isValidId(logId);\n        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;\n        allow create: if isOwner(userId) && isValidId(logId)\n          && isValidHealthLog(incoming(), userId)\n          && incoming().createdAt == request.time\n          && incoming().updatedAt == request.time;\n        allow update: if isOwner(userId) && isValidId(logId)\n          && isValidHealthLog(incoming(), userId)\n          && incoming().userId == existing().userId\n          && incoming().createdAt == existing().createdAt\n          && incoming().updatedAt == request.time\n          && incoming().diff(existing()).affectedKeys().hasOnly([\'sleepHours\', \'sleepBedtime\', \'steps\', \'activeCalories\', \'restingHeartRate\', \'source\', \'updatedAt\']);\n        allow delete: if isOwner(userId) && isValidId(logId);\n      }\n\n      // --- App Usage Logs ---\n      match /app_usage/{usageId} {\n        allow get: if isOwner(userId) && isValidId(usageId);\n        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;\n        allow create: if isOwner(userId) && isValidId(usageId)\n          && isValidAppUsageLog(incoming(), userId)\n          && incoming().createdAt == request.time\n          && incoming().updatedAt == request.time;\n        allow update: if isOwner(userId) && isValidId(usageId)\n          && isValidAppUsageLog(incoming(), userId)\n          && incoming().userId == existing().userId\n          && incoming().createdAt == existing().createdAt\n          && incoming().updatedAt == request.time\n          && incoming().diff(existing()).affectedKeys().hasOnly([\n            \'productivityMinutes\', \'communicationMinutes\', \'socialMediaMinutes\',\n            \'entertainmentMinutes\', \'educationMinutes\', \'otherMinutes\',\n            \'nighttimeMinutes\', \'interruptions\', \'source\', \'updatedAt\'\n          ]);\n        allow delete: if isOwner(userId) && isValidId(usageId);\n      }\n\n      // --- Energy Logs ---\n      match /energy_logs/{logId} {\n        allow get: if isOwner(userId) && isValidId(logId);\n        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;\n        allow create: if isOwner(userId) && isValidId(logId)\n          && isValidEnergyLog(incoming(), userId)\n          && incoming().createdAt == request.time;\n        allow update: if false;\n        allow delete: if isOwner(userId) && isValidId(logId);\n      }\n\n      // --- Personal Goals ---\n      match /goals/{goalId} {\n        allow get: if isOwner(userId) && isValidId(goalId);\n        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;\n        allow create: if isOwner(userId) && isValidId(goalId)\n          && isValidPersonalGoal(incoming(), userId)\n          && incoming().createdAt == request.time\n          && incoming().updatedAt == request.time;\n        allow update: if isOwner(userId) && isValidId(goalId)\n          && isValidPersonalGoal(incoming(), userId)\n          && incoming().userId == existing().userId\n          && incoming().createdAt == existing().createdAt\n          && incoming().updatedAt == request.time\n          && incoming().diff(existing()).affectedKeys().hasOnly([\n            \'title\', \'description\', \'category\', \'targetLabel\', \'startDate\',\n            \'deadline\', \'progress\', \'milestones\', \'updatedAt\'\n          ]);\n        allow delete: if isOwner(userId) && isValidId(goalId);\n      }\n    }\n  }\n}\n"
