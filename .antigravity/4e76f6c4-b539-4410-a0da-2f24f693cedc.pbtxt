              text: "          >"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            {briefingLoading ? <Loader2 className=\"w-3.5 h-3.5 animate-spin text-emerald-400\" /> : <RefreshCw className=\"w-3.5 h-3.5 text-emerald-400\" />}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            {briefing"
