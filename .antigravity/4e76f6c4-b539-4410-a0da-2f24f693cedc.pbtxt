  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useEffect, useState } from \'react\';\nimport { Check, Target, Trash2, X } from \'lucide-react\';\nimport { useLifeOs } from \'../context/LifeOsContext\';\nimport { TODAY_ISO } from \'../data/seedData\';\nimport type { DailyMicroGoal, MicroGoalCategory } from \'../types/lifeos\';\n\ninterface DailyMicroGoalModalProps {\n  open: boolean;\n  onClose: () => void;\n  existingGoal: DailyMicroGoal | null;\n}\n\nconst CATEGORY_OPTIONS: Array<{ id: MicroGoalCategory; ar: string; en: string }> = [\n  { id: \'focus\', ar: \'\330\247\331\204\330\252\330\261\331\203\331\212\330\262\', en: \'Focus\' },\n  { id: \'finance\', ar: \'\330\247\331\204\331\205\330\247\331\204\331\212\330\247\330\252\', en: \'Finance\' },\n  { id: \'health\', ar: \'\330\247\331\204\330\265\330\255\330\251\', en: \'Health\' },\n  { id: \'wellbeing\', ar: \'\330\247\331\204\330\252\331\210\330\247\330\262\331\206 \330\247\331\204\330\261\331\202\331\205\331\212\', en: \'Wellbeing\' },\n  { id: \'personal\', ar: \'\330\264\330\256\330\265\331\212\', en: \'Personal\' },\n];\n\ninterface MicroGoalTemplate {\n  category: MicroGoalCategory;\n  targetValue: number;\n  titleAr: string;\n  unitAr: string;\n  titleEn: string;\n  unitEn: string;\n}\n\nconst QUICK_TEMPLATES: MicroGoalTemplate[] = [\n  {\n    category: \'focus\',\n    targetValue: 90,\n    titleAr: \'\330\245\331\206\330\254\330\247\330\262 90 \330\257\331\202\331\212\331\202\330\251 \330\252\330\261\331\203\331\212\330\262 \330\271\331\205\331\212\331\202 \331\202\330\250\331\204 \330\247\331\204\330\270\331\207\330\261\',\n    unitAr: \'\330\257\331\202\331\212\331\202\330\251\',\n    titleEn: \'Complete 90 minutes of deep work before noon\',\n    unitEn: \'min\',\n  },\n  {\n    category: \'health\',\n    targetValue: 8000,\n    titleAr: \'\330\247\331\204\331\205\330\264\331\212 8,000 \330\256\330\267\331\210\330\251 \330\247\331\204\331\212\331\210\331\205\',\n    unitAr: \'\330\256\330\267\331\210\330\251\',\n    titleEn: \'Walk 8,000 steps today\',\n    unitEn: \'steps\',\n  },\n  {\n    category: \'finance\',\n    targetValue: 3,\n    titleAr: \'\331\205\330\261\330\247\330\254\330\271\330\251 \331\210\330\252\330\263\330\254\331\212\331\204 \331\203\331\204 \331\205\330\265\330\247\330\261\331\212\331\201 \330\247\331\204\331\212\331\210\331\205 \330\250\330\257\331\210\331\206 \330\247\330\263\330\252\330\253\331\206\330\247\330\241\',\n    unitAr: \'\331\205\330\261\330\247\330\254\330\271\330\251\',\n    titleEn: \'Log and review all daily expenses\',\n    unitEn: \'checks\',\n  },\n  {\n    category: \'wellbeing\',\n    targetValue: 30,\n    titleAr: \'\331\202\330\261\330\247\330\241\330\251 30 \330\265\331\201\330\255\330\251 \331\202\330\250\331\204 \330\247\331\204\331\206\331\210\331\205 \330\250\330\257\331\204 \330\247\331\204\330\263\331\210\330\264\331\212\330\247\331\204 \331\205\331\212\330\257\331\212\330\247\',\n    unitAr: \'\330\265\331\201\330\255\330\251\',\n    titleEn: \'Read 30 pages before bed instead of scrolling\',\n    unitEn: \'pages\',\n  },\n];\n\nexport const DailyMicroGoalModal: React.FC<DailyMicroGoalModalProps> = ({\n  open,\n  onClose,\n  existingGoal,\n}) => {\n  const { lang, upsertDailyMicroGoal, deleteDailyMicroGoal } = useLifeOs();\n  const isAr = lang === \'ar\';\n\n  const [title, setTitle] = useState(\'\');\n  const [category, setCategory] = useState<MicroGoalCategory>(\'focus\');\n  const [targetValue, setTargetValue] = useState<string>(\'90\');\n  const [currentValue, setCurrentValue] = useState<string>(\'0\');\n  const [unit, setUnit] = useState(\'\');\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\n  const [isSaving, setIsSaving] = useState(false);\n\n  useEffect(() => {\n    if (!open) return;\n    setErrorMsg(null);\n    if (existingGoal) {\n      setTitle(existingGoal.title);\n      setCategory(existingGoal.category);\n      setTargetValue(String(existingGoal.targetValue));\n      setCurrentValue(String(existingGoal.currentValue));\n      setUnit(existingGoal.unit);\n    } else {\n      setTitle(\'\');\n      setCategory(\'focus\');\n      setTargetValue(\'60\');\n      setCurrentValue(\'0\');\n      setUnit(isAr ? \'\330\257\331\202\331\212\331\202\330\251\' : \'min\');\n    }\n  }, [open, existingGoal, isAr]);\n\n  useEffect(() => {\n    if (!open) return;\n    const onKeyDown = (e: KeyboardEvent) => {\n      if (e.key === \'Escape\') onClose();\n    };\n    window.addEventListener(\'keydown\', onKeyDown);\n    return () => window.removeEventListener(\'keydown\', onKeyDown);\n  }, [open, onClose]);\n\n  if (!open) return null;\n\n  const applyTemplate = (tpl: MicroGoalTemplate) => {\n    setTitle(isAr ? tpl.titleAr : tpl.titleEn);\n    setCategory(tpl.category);\n    setTargetValue(String(tpl.targetValue));\n    setUnit(isAr ? tpl.unitAr : tpl.unitEn);\n    setCurrentValue(\'0\');\n    setErrorMsg(null);\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    const cleanTitle = title.trim();\n    const cleanUnit = unit.trim();\n    const parsedTarget = Number(targetValue);\n    const parsedCurrent = Number(currentValue);\n\n    if (!cleanTitle) {\n      setErrorMsg(isAr ? \'\331\212\330\261\330\254\331\211 \331\203\330\252\330\247\330\250\330\251 \330\271\331\206\331\210\330\247\331\206 \331\210\330\247\330\266\330\255 \331\204\331\207\330\257\331\201 \330\247\331\204\331\212\331\210\331\205 \330\247\331\204\331\205\330\265\330\272\331\221\330\261.\' : \'Please enter a clear title for your daily micro-goal.\');\n      return;\n    }\n    if (!Number.isFinite(parsedTarget) || parsedTarget < 1 || parsedTarget > 100000) {\n      setErrorMsg(isAr ? \'\331\212\330\254\330\250 \330\243\331\206 \331\212\331\203\331\210\331\206 \330\247\331\204\330\261\331\202\331\205 \330\247\331\204\331\205\330\263\330\252\331\207\330\257\331\201 \330\250\331\212\331\206 1 \331\210 100,000.\' : \'Target value must be between 1 and 100,000.\');\n      return;\n    }\n    if (!Number.isFinite(parsedCurrent) || parsedCurrent < 0 || parsedCurrent > 100000) {\n      setErrorMsg(isAr ? \'\331\212\330\254\330\250 \330\243\331\206 \331\212\331\203\331\210\331\206 \330\247\331\204\330\252\331\202\330\257\331\205 \330\247\331\204\330\255\330\247\331\204\331\212 \330\261\331\202\331\205\330\247\331\213 \330\265\330\255\331\212\330\255\330\247\331\213 \330\272\331\212\330\261 \330\263\330\247\331\204\330\250.\' : \'Current progress must be a valid non-negative number.\');\n      return;\n    }\n    if (!cleanUnit) {\n      setErrorMsg(isAr ? \'\331\212\330\261\330\254\331\211 \330\252\330\255\330\257\331\212\330\257 \331\210\330\255\330\257\330\251 \330\247\331\204\331\202\331\212\330\247\330\263 (\331\205\330\253\331\204: \330\257\331\202\331\212\331\202\330\251\330\214 \330\256\330\267\331\210\330\251\330\214 \330\265\331\201\330\255\330\251).\' : \'Please specify a unit (e.g. min, steps, pages).\');\n      return;\n    }\n\n    setIsSaving(true);\n    setErrorMsg(null);\n    try {\n      await upsertDailyMicroGoal({\n        date: TODAY_ISO,\n        title: cleanTitle.slice(0, 140),\n        category,\n        targetValue: Math.round(parsedTarget),\n        currentValue: Math.round(parsedCurrent),\n        unit: cleanUnit.slice(0, 32),\n        completed: Math.round(parsedCurrent) >= Math.round(parsedTarget),\n      });\n      onClose();\n    } catch (err) {\n      setErrorMsg(err instanceof Error ? err.message : isAr ? \'\330\252\330\271\330\260\331\221\330\261 \330\255\331\201\330\270 \330\247\331\204\331\207\330\257\331\201.\' : \'Could not save micro-goal.\');\n    } finally {\n      setIsSaving(false);\n    }\n  };\n\n  const handleDelete = async () => {\n    if (!existingGoal) return;\n    setIsSaving(true);\n    try {\n      await deleteDailyMicroGoal(existingGoal.id);\n      onClose();\n    } finally {\n      setIsSaving(false);\n    }\n  };\n\n  return (\n    <div\n      className=\"fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-black/75 backdrop-blur-sm p-4\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-labelledby=\"daily-micro-goal-title\"\n      onClick={(e) => {\n        if (e.target === e.currentTarget) onClose();\n      }}\n    >\n      <div className=\"w-full max-w-lg bg-[#13171C] border border-[#232A33] rounded-2xl p-6 space-y-5 max-h-[90vh] overflow-y-auto\">\n        <div className=\"flex items-start justify-between gap-4\">\n          <div>\n            <h2\n              id=\"daily-micro-goal-title\"\n              className=\"text-base font-semibold text-[#F4F6F8] flex items-center gap-2\"\n            >\n              <Target className=\"w-4 h-4 text-emerald-400 shrink-0\" />\n              {existingGoal\n                ? isAr\n                  ? \'\330\252\330\271\330\257\331\212\331\204 \331\207\330\257\331\201 \330\247\331\204\331\212\331\210\331\205 \330\247\331\204\331\205\330\265\330\272\331\221\330\261\'\n                  : \'Edit Daily Micro-Goal\'\n                : isAr\n                  ? \'\330\252\330\255\330\257\331\212\330\257 \331\207\330\257\331\201 \330\247\331\204\331\212\331\210\331\205 \330\247\331\204\331\205\330\265\330\272\331\221\330\261\'\n                  : \'Set Daily Micro-Goal\'}\n            </h2>\n            <p className=\"text-xs text-[#8E99A8] mt-1\">\n              {isAr\n                ? `\331\207\330\257\331\201 \331\210\330\247\330\255\330\257 \331\202\330\247\330\250\331\204 \331\204\331\204\331\202\331\212\330\247\330\263 \331\204\331\212\331\210\331\205 ${TODAY_ISO} \331\212\330\270\331\207\330\261 \330\243\330\271\331\204\331\211 \331\204\331\210\330\255\330\251 \330\247\331\204\330\252\330\255\331\203\331\205 \331\204\331\205\330\252\330\247\330\250\330\271\330\251 \330\252\331\202\330\257\331\205\331\203.`\n                : `One focused, measurable target for ${TODAY_ISO} pinned to the top of your dashboard.`}\n            </p>\n          </div>\n          <button\n            type=\"button\"\n            onClick={onClose}\n            aria-label={isAr ? \'\330\245\330\272\331\204\330\247\331\202\' : \'Close\'}\n            className=\"min-h-[40px] min-w-[40px] flex items-center justify-center rounded-xl text-[#8E99A8] hover:text-[#F4F6F8] hover:bg-[#1C222B] transition-colors shrink-0\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Quick Presets */}\n        <div className=\"space-y-2\">\n          <p className=\"text-xs text-[#8E99A8]\">\n            {isAr ? \'\330\247\331\202\330\252\330\261\330\247\330\255\330\247\330\252 \330\263\330\261\331\212\330\271\330\251 \331\204\331\204\331\212\331\210\331\205\' : \'Quick presets for today\'}\n          </p>\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2\">\n            {QUICK_TEMPLATES.map((tpl, idx) => (\n              <button\n                key={idx}\n                type=\"button\"\n                onClick={() => applyTemplate(tpl)}\n                className=\"min-h-[40px] px-3 py-2 rounded-xl bg-[#0B0D10] border border-[#232A33] hover:border-emerald-500/50 text-start transition-colors\"\n              >\n                <p className=\"text-xs font-medium text-[#E2E8F0] truncate\">\n                  {isAr ? tpl.titleAr : tpl.titleEn}\n                </p>\n                <p className=\"text-[11px] text-[#758091] tabular-nums mt-0.5\">\n                  {tpl.targetValue.toLocaleString(\'en-US\')} {isAr ? tpl.unitAr : tpl.unitEn}\n                </p>\n              </button>\n            ))}\n          </div>\n        </div>\n\n        <form onSubmit={handleSubmit} className=\"space-y-4\">\n          {/* Category Segmented Control */}\n          <div className=\"space-y-1.5\">\n            <span className=\"block text-xs font-medium text-[#A9B3C1]\">\n              {isAr ? \'\330\247\331\204\331\205\330\254\330\247\331\204\' : \'Area\'}\n            </span>\n            <div className=\"flex flex-wrap gap-1.5 p-1 rounded-xl bg-[#0B0D10] border border-[#232A33]\">\n              {CATEGORY_OPTIONS.map((opt) => {\n                const active = category === opt.id;\n                return (\n                  <button\n                    key={opt.id}\n                    type=\"button\"\n                    onClick={() => setCategory(opt.id)}\n                    aria-pressed={active}\n                    className={`flex-1 min-h-[38px] px-3 py-1.5 rounded-lg text-xs font-medium transition-colors whitespace-nowrap ${\n                      active\n                        ? \'bg-emerald-500/15 text-emerald-400\'\n                        : \'text-[#8E99A8] hover:text-[#F4F6F8]\'\n                    }`}\n                  >\n                    {isAr ? opt.ar : opt.en}\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Goal Title */}\n          <div>\n            <label htmlFor=\"micro-goal-title-input\" className=\"block text-xs font-medium text-[#A9B3C1] mb-1.5\">\n              {isAr ? \'\330\271\331\206\331\210\330\247\331\206 \330\247\331\204\331\207\330\257\331\201 \330\247\331\204\331\205\330\265\330\272\331\221\330\261\' : \'Micro-Goal Title\'}\n            </label>\n            <input\n              id=\"micro-goal-title-input\"\n              type=\"text\"\n              maxLength={140}\n              required\n              value={title}\n              onChange={(e) => setTitle(e.target.value)}\n              placeholder={\n                isAr\n                  ? \'\331\205\330\253\330\247\331\204: \330\245\331\206\331\207\330\247\330\241 90 \330\257\331\202\331\212\331\202\330\251 \330\252\330\261\331\203\331\212\330\262 \330\271\331\205\331\212\331\202 \330\250\330\257\331\210\331\206 \331\205\331\202\330\247\330\267\330\271\330\251\'\n                  : \'e.g., Complete 90 minutes of uninterrupted deep work\'\n              }\n              className=\"w-full min-h-[44px] px-3.5 py-2.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8] placeholder:text-[#5E6877] focus:outline-none focus:border-emerald-500\"\n            />\n          </div>\n\n          {/* Target, Current & Unit */}\n          <div className=\"grid grid-cols-3 gap-3\">\n            <div>\n              <label htmlFor=\"micro-goal-target\" className=\"block text-xs text-[#8E99A8] mb-1.5\">\n                {isAr ? \'\330\247\331\204\331\205\330\263\330\252\331\207\330\257\331\201\' : \'Target\'}\n              </label>\n              <input\n                id=\"micro-goal-target\"\n                type=\"number\"\n                min={1}\n                max={100000}\n                required\n                value={targetValue}\n                onChange={(e) => setTargetValue(e.target.value)}\n                className=\"w-full min-h-[44px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8] focus:outline-none focus:border-emerald-500\"\n              />\n            </div>\n\n            <div>\n              <label htmlFor=\"micro-goal-current\" className=\"block text-xs text-[#8E99A8] mb-1.5\">\n                {isAr ? \'\330\247\331\204\330\255\330\247\331\204\331\212\' : \'Current\'}\n              </label>\n              <input\n                id=\"micro-goal-current\"\n                type=\"number\"\n                min={0}\n                max={100000}\n                required\n                value={currentValue}\n                onChange={(e) => setCurrentValue(e.target.value)}\n                className=\"w-full min-h-[44px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8] focus:outline-none focus:border-emerald-500\"\n              />\n            </div>\n\n            <div>\n              <label htmlFor=\"micro-goal-unit\" className=\"block text-xs text-[#8E99A8] mb-1.5\">\n                {isAr ? \'\330\247\331\204\331\210\330\255\330\257\330\251\' : \'Unit\'}\n              </label>\n              <input\n                id=\"micro-goal-unit\"\n                type=\"text\"\n                maxLength={32}\n                required\n                value={unit}\n                onChange={(e) => setUnit(e.target.value)}\n                placeholder={isAr ? \'\330\257\331\202\331\212\331\202\330\251\' : \'min\'}\n                className=\"w-full min-h-[44px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8] placeholder:text-[#5E6877] focus:outline-none focus:border-emerald-500\"\n              />\n            </div>\n          </div>\n\n          {errorMsg ? (\n            <div className=\"p-3 rounded-xl bg-red-500/10 border border-red-500/30 text-xs text-red-300\">\n              {errorMsg}\n            </div>\n          ) : null}\n\n          <div className=\"flex items-center justify-between gap-3 pt-2 border-t border-[#232A33]\">\n            {existingGoal ? (\n              <button\n                type=\"button\"\n                onClick={() => void handleDelete()}\n                disabled={isSaving}\n                className=\"min-h-[44px] px-3.5 rounded-xl border border-red-500/30 text-red-300 hover:bg-red-500/10 text-xs font-medium flex items-center gap-1.5 transition-colors whitespace-nowrap\"\n              >\n                <Trash2 className=\"w-3.5 h-3.5\" />\n                {isAr ? \'\331\205\330\263\330\255 \330\247\331\204\331\207\330\257\331\201\' : \'Clear Goal\'}\n              </button>\n            ) : (\n              <span />\n            )}\n\n            <div className=\"flex items-center gap-2.5\">\n              <button\n                type=\"button\"\n                onClick={onClose}\n                className=\"min-h-[44px] px-4 rounded-xl border border-[#232A33] text-sm text-[#C8D0DC] hover:bg-[#1B212A] transition-colors whitespace-nowrap\"\n              >\n                {isAr ? \'\330\245\331\204\330\272\330\247\330\241\' : \'Cancel\'}\n              </button>\n              <button\n                type=\"submit\"\n                disabled={isSaving}\n                className=\"min-h-[44px] px-5 rounded-xl bg-emerald-500 text-[#07110C] font-semibold text-sm hover:bg-emerald-400 disabled:opacity-50 transition-colors flex items-center gap-2 whitespace-nowrap\"\n              >\n                <Check className=\"w-4 h-4\" />\n                {isAr ? \'\330\255\331\201\330\270 \331\207\330\257\331\201 \330\247\331\204\331\212\331\210\331\205\' : \'Save Micro-Goal\'}\n              </button>\n            </div>\n          </div>\n        </form>\n      </div>\n    </div>\n  );\n};\n"
