              text: "                        onClick={() => void updateIncomeStatus(rec.id, \'fully_paid\', rec.amountPiasters)}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        className=\"min-h-[36px] px-2.5 rounded-lg border border-emerald-500/40 text-xs text-emerald-300 hover:bg-emerald-500/10 whitespace-nowrap\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                      >"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        {isAr ? \'\330\252\330\243\331\203\331\212\330\257 \330\247\331\204\330\252\330\255\330\265\331\212\331\204\' : \'Mark Paid\'}"
