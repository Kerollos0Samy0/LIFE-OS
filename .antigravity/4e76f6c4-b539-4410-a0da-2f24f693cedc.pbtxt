              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <p className=\"text-xs font-semibold text-emerald-400\">{isAr ? \'\331\205\331\204\330\247\330\255\330\270\330\251 \330\247\331\204\330\265\330\255\330\251 \331\210\330\247\331\204\330\267\330\247\331\202\330\251\' : \'Health Observation\'}</p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <p className=\"text-[#D2DAE5] leading-relaxed\">{briefing.healthObservation}</p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            <div className=\"space-y-1\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <p className=\"text-xs font-semibold text-amber-400\">{isAr ? \'\330\252\330\260\331\203\331\212\330\261 \331\205\331\207\331\205\' : \'Important Reminder\'}</p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <p className=\"text-[#D2DAE5] leading-relaxed\">{briefing.importantReminder}</p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            {briefing.recommendations?.length > 0 ? ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <div className=\"md:col-span-2 pt-3 border-t border-[#232A33] space-y-2\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                <p className=\"text-xs font-semibold text-[#F4F6F8]\">{isAr ? \'\330\252\331\210\330\265\331\212\330\247\330\252 \330\271\331\205\331\204\331\212\330\251 \331\204\331\204\331\212\331\210\331\205\' : \'Practical Recommendations\'}</p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                <ul className=\"space-y-1.5\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
