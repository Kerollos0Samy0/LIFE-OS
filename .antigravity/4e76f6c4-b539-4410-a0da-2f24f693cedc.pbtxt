              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                {isRunning ? (isAr ? \'\330\245\331\212\331\202\330\247\331\201 \331\205\330\244\331\202\330\252\' : \'Pause\') : (isAr ? \'\330\247\330\250\330\257\330\243 \330\247\331\204\330\252\330\261\331\203\331\212\330\262\' : \'Start Focus\')}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              </button>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              <button"
