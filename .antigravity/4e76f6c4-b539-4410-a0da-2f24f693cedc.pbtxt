            lines {
              text: "                <CartesianGrid stroke=\"#232A33\" strokeDasharray=\"3 3\" vertical={false} />"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                <XAxis dataKey=\"name\" tick={{ fill: \'#8E99A8\', fontSize: 11 }} axisLine={false} tickLine={false} />"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                <YAxis tick={{ fill: \'#8E99A8\', fontSize: 11 }} axisLine={false} tickLine={false} />"
