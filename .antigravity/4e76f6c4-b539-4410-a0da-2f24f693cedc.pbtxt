            }
            lines {
              text: "                aria-label={isAr ? \'\330\245\330\271\330\247\330\257\330\251 \330\266\330\250\330\267 \330\247\331\204\331\205\330\244\331\202\330\252\' : \'Reset timer\'}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                className=\"min-h-[44px] min-w-[44px] rounded-xl bg-[#191F27] border border-[#232A33] text-[#C8D0DC] flex items-center justify-center\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              >"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                <RotateCcw className=\"w-4 h-4\" />"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              </button>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
