    tool_calls {
      id: "call_9845439595505391692"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useMemo, useState } from \'react\';\\nimport { Bar, BarChart, CartesianGrid, ResponsiveContainer, Tooltip, XAxis, YAxis } from \'recharts\';\\nimport { ShieldCheck, Smartphone } from \'lucide-react\';\\nimport { useLifeOs } from \'../context/LifeOsContext\';\\nimport { TODAY_ISO } from \'../data/seedData\';\\n\\nexport const WellbeingModule: React.FC = () => {\\n  const { data, lang, upsertAppUsageLog } = useLifeOs();\\n  const isAr = lang === \'ar\';\\n\\n  const latest = useMemo(\\n    () => [...data.appUsageLogs].sort((a, b) => b.date.localeCompare(a.date))[0] || null,\\n    [data.appUsageLogs],\\n  );\\n\\n  const [prod, setProd] = useState(String(latest?.productivityMinutes ?? 90));\\n  const [comm, setComm] = useState(String(latest?.communicationMinutes ?? 50));\\n  const [social, setSocial] = useState(String(latest?.socialMediaMinutes ?? 65));\\n  const [ent, setEnt] = useState(String(latest?.entertainmentMinutes ?? 35));\\n  const [edu, setEdu] = useState(String(latest?.educationMinutes ?? 30));\\n  const [other, setOther] = useState(String(latest?.otherMinutes ?? 15));\\n  const [night, setNight] = useState(String(latest?.nighttimeMinutes ?? 40));\\n  const [interrupts, setInterrupts] = useState(String(latest?.interruptions ?? 20));\\n  const [saved, setSaved] = useState(false);\\n\\n  const totalMinutes = latest\\n    ? latest.productivityMinutes +\\n      latest.communicationMinutes +\\n      latest.socialMediaMinutes +\\n      latest.entertainmentMinutes +\\n      latest.educationMinutes +\\n      latest.otherMinutes\\n    : 0;\\n\\n  const categoryBars = useMemo(() => {\\n    if (!latest) return [];\\n    return [\\n      { name: isAr ? \'\330\245\331\206\330\252\330\247\330\254\331\212\330\251\' : \'Productivity\', mins: latest.productivityMinutes },\\n      { name: isAr ? \'\330\252\331\210\330\247\330\265\331\204\' : \'Communication\', mins: latest.communicationMinutes },\\n      { name: isAr ? \'\330\263\331\210\330\264\331\212\330\247\331\204 \331\205\331\212\330\257\331\212\330\247\' : \'Social Media\', mins: latest.socialMediaMinutes },\\n      { name: isAr ? \'\330\252\330\261\331\201\331\212\331\207\' : \'Entertainment\', mins: latest.entertainmentMinutes },\\n      { name: isAr ? \'\330\252\330\271\331\204\331\212\331\205\' : \'Education\', mins: latest.educationMinutes },\\n      { name: isAr ? \'\330\243\330\256\330\261\331\211\' : \'Other\', mins: latest.otherMinutes },\\n    ];\\n  }, [latest, isAr]);\\n\\n  const handleSave = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    await upsertAppUsageLog({\\n      date: TODAY_ISO,\\n      productivityMinutes: Math.max(0, Number(prod) || 0),\\n      communicationMinutes: Math.max(0, Number(comm) || 0),\\n      socialMediaMinutes: Math.max(0, Number(social) || 0),\\n      entertainmentMinutes: Math.max(0, Number(ent) || 0),\\n      educationMinutes: Math.max(0, Number(edu) || 0),\\n      otherMinutes: Math.max(0, Number(other) || 0),\\n      nighttimeMinutes: Math.max(0, Number(night) || 0),\\n      interruptions: Math.max(0, Number(interrupts) || 0),\\n      source: \'manual\',\\n    });\\n    setSaved(true);\\n    setTimeout(() => setSaved(false), 1800);\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      <div>\\n        <h1 className=\\\"text-2xl font-bold text-[#F4F6F8]\\\">{isAr ? \'\330\247\331\204\330\261\331\201\330\247\331\207\331\212\330\251 \330\247\331\204\330\261\331\202\331\205\331\212\330\251\' : \'Digital Wellbeing\'}</h1>\\n        <p className=\\\"text-xs text-[#8E99A8] mt-1\\\">\\n          {isAr\\n            ? \'\330\252\330\255\331\204\331\212\331\204 \331\210\331\202\330\252 \330\247\331\204\330\264\330\247\330\264\330\251 \331\210\330\247\331\204\330\247\330\263\330\252\330\256\330\257\330\247\331\205 \330\247\331\204\331\204\331\212\331\204\331\212 \331\210\331\205\331\202\330\247\330\267\330\271\330\247\330\252 \330\247\331\204\330\252\330\261\331\203\331\212\330\262 \330\271\330\250\330\261 Android Usage Stats \330\243\331\210 \330\247\331\204\330\252\330\263\330\254\331\212\331\204 \330\247\331\204\331\212\330\257\331\210\331\212.\'\\n            : \'Screen time, nighttime usage, and focus interruption tracking via Android Usage Stats or manual entry.\'}\\n        </p>\\n      </div>\\n\\n      <div className=\\\"grid grid-cols-2 lg:grid-cols-4 gap-4\\\">\\n        <div className=\\\"bg-[#13171C] border border-[#232A33] rounded-2xl p-4\\\">\\n          <p className=\\\"text-xs text-[#8E99A8]\\\">{isAr ? \'\330\245\330\254\331\205\330\247\331\204\331\212 \331\210\331\202\330\252 \330\247\331\204\330\264\330\247\330\264\330\251\' : \'Total Screen Time\'}</p>\\n          <p className=\\\"text-xl font-bold font-mono-nums text-[#F4F6F8] mt-1\\\">\\n            {(totalMinutes / 60).toFixed(1)} {isAr ? \'\330\263\330\247\330\271\330\251\' : \'h\'}\\n          </p>\\n        </div>\\n        <div className=\\\"bg-[#13171C] border border-[#232A33] rounded-2xl p-4\\\">\\n          <p className=\\\"text-xs text-[#8E99A8]\\\">{isAr ? \'\330\252\330\267\330\250\331\212\331\202\330\247\330\252 \330\247\331\204\330\245\331\206\330\252\330\247\330\254\331\212\330\251\' : \'Productive Apps\'}</p>\\n          <p className=\\\"text-xl font-bold font-mono-nums text-emerald-400 mt-1\\\">\\n            {latest?.productivityMinutes ?? 0} {isAr ? \'\330\257\' : \'m\'}\\n          </p>\\n        </div>\\n        <div className=\\\"bg-[#13171C] border border-[#232A33] rounded-2xl p-4\\\">\\n          <p className=\\\"text-xs text-[#8E99A8]\\\">{isAr ? \'\330\247\331\204\330\263\331\210\330\264\331\212\330\247\331\204 \331\205\331\212\330\257\331\212\330\247\' : \'Social Media\'}</p>\\n          <p className=\\\"text-xl font-bold font-mono-nums text-amber-400 mt-1\\\">\\n            {latest?.socialMediaMinutes ?? 0} {isAr ? \'\330\257\' : \'m\'}\\n          </p>\\n        </div>\\n        <div className=\\\"bg-[#13171C] border border-[#232A33] rounded-2xl p-4\\\">\\n          <p className=\\\"text-xs text-[#8E99A8]\\\">{isAr ? \'\330\247\331\204\330\247\330\263\330\252\330\256\330\257\330\247\331\205 \330\247\331\204\331\204\331\212\331\204\331\212\' : \'Nighttime Usage\'}</p>\\n          <p className=\\\"text-xl font-bold font-mono-nums text-red-400 mt-1\\\">\\n            {latest?.nighttimeMinutes ?? 0} {isAr ? \'\330\257\' : \'m\'} \302\267 {latest?.interruptions ?? 0} {isAr ? \'\331\205\331\202\330\247\330\267\330\271\330\251\' : \'pickups\'}\\n          </p>\\n        </div>\\n      </div>\\n\\n      <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-5\\\">\\n        <div className=\\\"lg:col-span-7 bg-[#13171C] border border-[#232A33] rounded-2xl p-5 space-y-4\\\">\\n          <h2 className=\\\"text-sm font-semibold text-[#F4F6F8]\\\">{isAr ? \'\330\252\331\210\330\262\331\212\330\271 \330\247\331\204\330\247\330\263\330\252\330\256\330\257\330\247\331\205 \330\255\330\263\330\250 \330\247\331\204\331\201\330\246\330\251 (\330\257\331\202\330\247\330\246\331\202)\' : \'Usage by App Category (Minutes)\'}</h2>\\n          <div className=\\\"h-64 w-full\\\" dir=\\\"ltr\\\">\\n            <ResponsiveContainer width=\\\"100%\\\" height=\\\"100%\\\">\\n              <BarChart data={categoryBars} margin={{ top: 8, right: 8, left: -12, bottom: 8 }}>\\n                <CartesianGrid stroke=\\\"#232A33\\\" strokeDasharray=\\\"3 3\\\" vertical={false} />\\n                <XAxis dataKey=\\\"name\\\" tick={{ fill: \'#8E99A8\', fontSize: 11 }} axisLine={false} tickLine={false} />\\n                <YAxis tick={{ fill: \'#8E99A8\', fontSize: 11 }} axisLine={false} tickLine={false} />\\n                <Tooltip contentStyle={{ backgroundColor: \'#0B0D10\', border: \'1px solid #232A33\', borderRadius: 12, color: \'#F4F6F8\', fontSize: 12 }} />\\n                <Bar dataKey=\\\"mins\\\" fill=\\\"#34D399\\\" radius={[6, 6, 0, 0]} />\\n              </BarChart>\\n            </ResponsiveContainer>\\n          </div>\\n\\n          <div className=\\\"pt-4 border-t border-[#232A33] flex items-start gap-3 text-xs text-[#A9B3C1]\\\">\\n            <ShieldCheck className=\\\"w-4 h-4 text-emerald-400 shrink-0 mt-0.5\\\" />\\n            <p className=\\\"leading-relaxed\\\">\\n              {isAr\\n                ? \'\330\256\330\265\331\210\330\265\331\212\330\251 \330\265\330\247\330\261\331\205\330\251: \331\204\330\247 \331\212\330\254\331\205\330\271 LIFE OS \330\243\330\250\330\257\330\247\331\213 \331\205\330\255\330\252\331\210\331\211 \330\247\331\204\330\261\330\263\330\247\330\246\331\204 \330\243\331\210 \331\203\331\204\331\205\330\247\330\252 \330\247\331\204\331\205\330\261\331\210\330\261 \330\243\331\210 \331\206\331\202\330\261\330\247\330\252 \331\204\331\210\330\255\330\251 \330\247\331\204\331\205\331\201\330\247\330\252\331\212\330\255. \330\247\331\204\330\254\331\205\330\271 \330\247\331\204\330\252\331\204\331\202\330\247\330\246\331\212 \331\212\330\252\330\267\331\204\330\250 \330\245\330\260\331\206 Android Usage Stats \330\271\331\204\331\211 \331\207\330\247\330\252\331\201 Android.\'\\n                : \'Strict privacy: LIFE OS never collects message contents, passwords, or keystrokes. Automatic capture requires Android Usage Stats permission on Android.\'}\\n            </p>\\n          </div>\\n        </div>\\n\\n        <form onSubmit={handleSave} className=\\\"lg:col-span-5 bg-[#13171C] border border-[#232A33] rounded-2xl p-5 space-y-3.5 self-start\\\">\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <Smartphone className=\\\"w-4 h-4 text-emerald-400\\\" />\\n            <h2 className=\\\"text-sm font-semibold text-[#F4F6F8]\\\">{isAr ? \'\330\252\330\255\330\257\331\212\330\253 \330\263\330\254\331\204 \331\210\331\202\330\252 \330\247\331\204\330\264\330\247\330\264\330\251 \330\247\331\204\331\212\331\210\331\205\' : \'Update Today\342\200\231s Screen Time Log\'}</h2>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-2 gap-3 text-xs\\\">\\n            {[\\n              { id: \'wb-prod\', label: isAr ? \'\330\245\331\206\330\252\330\247\330\254\331\212\330\251 (\330\257)\' : \'Productivity (m)\', v: prod, s: setProd },\\n              { id: \'wb-comm\', label: isAr ? \'\330\252\331\210\330\247\330\265\331\204 (\330\257)\' : \'Communication (m)\', v: comm, s: setComm },\\n              { id: \'wb-soc\', label: isAr ? \'\330\263\331\210\330\264\331\212\330\247\331\204 \331\205\331\212\330\257\331\212\330\247 (\330\257)\' : \'Social Media (m)\', v: social, s: setSocial },\\n              { id: \'wb-ent\', label: isAr ? \'\330\252\330\261\331\201\331\212\331\207 (\330\257)\' : \'Entertainment (m)\', v: ent, s: setEnt },\\n              { id: \'wb-edu\', label: isAr ? \'\330\252\330\271\331\204\331\212\331\205 (\330\257)\' : \'Education (m)\', v: edu, s: setEdu },\\n              { id: \'wb-oth\', label: isAr ? \'\330\243\330\256\330\261\331\211 (\330\257)\' : \'Other (m)\', v: other, s: setOther },\\n              { id: \'wb-night\', label: isAr ? \'\330\247\330\263\330\252\330\256\330\257\330\247\331\205 \331\204\331\212\331\204\331\212 (\330\257)\' : \'Nighttime (m)\', v: night, s: setNight },\\n              { id: \'wb-int\', label: isAr ? \'\331\205\331\202\330\247\330\267\330\271\330\247\330\252 \330\247\331\204\330\252\330\261\331\203\331\212\330\262\' : \'Interruptions\', v: interrupts, s: setInterrupts },\\n            ].map((f) => (\\n              <div key={f.id}>\\n                <label htmlFor={f.id} className=\\\"block text-[#8E99A8] mb-1\\\">{f.label}</label>\\n                <input\\n                  id={f.id}\\n                  type=\\\"number\\\"\\n                  value={f.v}\\n                  onChange={(e) => f.s(e.target.value)}\\n                  className=\\\"w-full min-h-[40px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\\\"\\n                />\\n              </div>\\n            ))}\\n          </div>\\n\\n          <button type=\\\"submit\\\" className=\\\"w-full min-h-[44px] rounded-xl bg-emerald-500 text-[#07110C] font-semibold text-sm hover:bg-emerald-400\\\">\\n            {saved ? (isAr ? \'\330\252\331\205 \330\247\331\204\330\252\330\255\330\257\331\212\330\253\' : \'Updated\') : (isAr ? \'\330\255\331\201\330\270 \330\250\331\212\330\247\331\206\330\247\330\252 \330\247\331\204\330\264\330\247\330\264\330\251\' : \'Save Screen Time\')}\\n          </button>\\n        </form>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create Module 05 Digital Wellbeing component with 6-category usage analytics, manual logging, and strict Android privacy disclosure\", \"Overwrite\":true, \"TargetFile\":\"/src/components/WellbeingModule.tsx\", \"toolAction\":\"Creating WellbeingModule component\", \"toolSummary\":\"Create WellbeingModule\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_9845439595505391991"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useMemo, useState } from \'react\';\\nimport { Check, Loader2, Send, Sparkles } from \'lucide-react\';\\nimport { useLifeOs } from \'../context/LifeOsContext\';\\nimport { CURRENT_MONTH, TODAY_ISO } from \'../data/seedData\';\\nimport {\\n  calculateAvailableCashPiasters,\\n  calculatePendingReceivablesPiasters,\\n  calculateTotalExpensesPiasters,\\n  calculateTotalPaidIncomePiasters,\\n  egpToPiasters,\\n} from \'../utils/finance\';\\nimport { calculateEnergyEstimate } from \'../utils/energy\';\\nimport type { AiChatMessage, AiModelId, TaskCategory, TaskPriority } from \'../types/lifeos\';\\n\\ntype AiDomain = \'general\' | \'finance\' | \'productivity\' | \'health\';\\n\\nexport const LifeAiModule: React.FC = () => {\\n  const { data, lang, recordAiUsage, addExpense, addTask } = useLifeOs();\\n  const isAr = lang === \'ar\';\\n\\n  const [domain, setDomain] = useState<AiDomain>(\'general\');\\n  const [model, setModel] = useState<AiModelId>(data.profile.aiDefaultModel);\\n  const [input, setInput] = useState(\'\');\\n  const [loading, setLoading] = useState(false);\\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\\n  const [messages, setMessages] = useState<AiChatMessage[]>([\\n    {\\n      id: \'welcome-ai\',\\n      role: \'assistant\',\\n      content: isAr\\n        ? \'\330\243\331\207\331\204\330\247\331\213 \330\250\331\203 \331\201\331\212 LIFE AI. \330\250\331\202\330\261\330\243 \331\201\331\202\330\267 \330\247\331\204\330\250\331\212\330\247\331\206\330\247\330\252 \330\247\331\204\331\205\330\267\331\204\331\210\330\250\330\251 \331\204\330\263\330\244\330\247\331\204\331\203 (\330\247\331\204\331\205\330\247\331\204\331\212\330\251\330\214 \330\247\331\204\330\245\331\206\330\252\330\247\330\254\331\212\330\251\330\214 \330\247\331\204\330\265\330\255\330\251\330\214 \330\243\331\210 \330\247\331\204\331\205\330\261\330\247\330\254\330\271\330\251 \330\247\331\204\330\243\330\263\330\250\331\210\330\271\331\212\330\251) \331\210\330\250\330\263\330\252\330\243\330\260\331\206\331\203 \331\202\330\250\331\204 \330\252\331\206\331\201\331\212\330\260 \330\243\331\212 \330\252\330\271\330\257\331\212\331\204 \330\243\331\210 \330\245\330\266\330\247\331\201\330\251.\'\\n        : \'Welcome to LIFE AI. I query only the minimum scoped context for your question and always ask for confirmation before saving any changes.\',\\n      timestamp: TODAY_ISO,\\n    },\\n  ]);\\n\\n  // Scoped minimal context selector (never dumps the entire database!)\\n  const scopedContext = useMemo(() => {\\n    const availableCashEgp = calculateAvailableCashPiasters(data.incomeRecords, data.expenseRecords) / 100;\\n    const paidIncomeEgp = calculateTotalPaidIncomePiasters(data.incomeRecords, CURRENT_MONTH) / 100;\\n    const monthExpensesEgp = calculateTotalExpensesPiasters(data.expenseRecords, CURRENT_MONTH) / 100;\\n    const pendingFreelanceEgp = calculatePendingReceivablesPiasters(data.incomeRecords) / 100;\\n\\n    if (domain === \'finance\') {\\n      return {\\n        currency: \'EGP\',\\n        availableCashEgp,\\n        paidIncomeEgp,\\n        monthExpensesEgp,\\n        pendingFreelanceEgp,\\n        recentExpenses: data.expenseRecords.slice(0, 6).map((e) => ({\\n          desc: e.description,\\n          egp: e.amountPiasters / 100,\\n          cat: e.category,\\n          date: e.date,\\n        })),\\n        budgetsCount: data.budgets.length,\\n        savingsGoalsCount: data.savingsGoals.length,\\n      };\\n    }\\n    if (domain === \'productivity\') {\\n      return {\\n        peakConcentration: data.profile.peakConcentration,\\n        workHours: `${data.profile.workStartHour}:00-${data.profile.workEndHour}:00`,\\n        pendingTasks: data.tasks\\n          .filter((t) => t.status !== \'completed\')\\n          .slice(0, 6)\\n          .map((t) => ({ title: t.title, priority: t.priority, category: t.category, mins: t.estimatedMinutes })),\\n        focusSessionsToday: data.focusSessions.filter((f) => f.date === TODAY_ISO).length,\\n      };\\n    }\\n    if (domain === \'health\') {\\n      const latestHealth = [...data.healthLogs].sort((a, b) => b.date.localeCompare(a.date))[0];\\n      const energy = calculateEnergyEstimate({\\n        healthLogs: data.healthLogs,\\n        appUsageLogs: data.appUsageLogs,\\n        energyLogs: data.energyLogs,\\n        dailyStepTarget: data.profile.dailyStepTarget,\\n        targetSleepHours: data.profile.targetSleepHours,\\n        peakConcentration: data.profile.peakConcentration,\\n      });\\n      return {\\n        sleepHours: latestHealth?.sleepHours ?? \'unavailable\',\\n        steps: latestHealth?.steps ?? \'unavailable\',\\n        restingHr: latestHealth?.restingHeartRate ?? \'unavailable\',\\n        estimatedEnergyScore: energy.estimatedScore ?? \'unavailable\',\\n        nighttimeScreenMins: energy.measuredFactors.nighttimeScreenMinutes ?? \'unavailable\',\\n      };\\n    }\\n    return {\\n      availableCashEgp,\\n      monthExpensesEgp,\\n      pendingFreelanceEgp,\\n      openTasksCount: data.tasks.filter((t) => t.status !== \'completed\').length,\\n      activeGoalsCount: data.goals.length,\\n      peakConcentration: data.profile.peakConcentration,\\n    };\\n  }, [data, domain]);\\n\\n  const quotaReached = data.aiUsage.requestsToday >= data.profile.aiDailyLimit;\\n\\n  const sendMessage = async (textToSend?: string) => {\\n    const cleanText = (textToSend ?? input).trim();\\n    if (!cleanText || loading) return;\\n    if (quotaReached) {\\n      setErrorMsg(\\n        isAr\\n          ? `\331\210\330\265\331\204\330\252 \331\204\331\204\330\255\330\257 \330\247\331\204\331\212\331\210\331\205\331\212 \330\247\331\204\331\205\330\255\330\257\330\257 (${data.profile.aiDailyLimit} \330\267\331\204\330\250). \331\212\331\205\331\203\331\206\331\203 \330\252\330\271\330\257\331\212\331\204\331\207 \331\205\331\206 \330\247\331\204\330\245\330\271\330\257\330\247\330\257\330\247\330\252.`\\n          : `Daily AI request limit (${data.profile.aiDailyLimit}) reached. Adjust it in Settings.`,\\n      );\\n      return;\\n    }\\n\\n    setErrorMsg(null);\\n    const userMsg: AiChatMessage = {\\n      id: `u-${Date.now()}`,\\n      role: \'user\',\\n      content: cleanText,\\n      timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\\n    };\\n    setMessages((prev) => [...prev, userMsg]);\\n    setInput(\'\');\\n    setLoading(true);\\n\\n    try {\\n      const res = await fetch(\'/api/ai/chat\', {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({\\n          message: cleanText,\\n          language: lang,\\n          domain,\\n          model,\\n          context: scopedContext,\\n          history: messages.slice(-5).map((m) => ({ role: m.role, content: m.content })),\\n        }),\\n      });\\n      const json = await res.json();\\n      if (!res.ok) {\\n        throw new Error(json.error || \'LIFE AI error\');\\n      }\\n\\n      const tokensUsed = Number(json.tokensUsed || 0);\\n      recordAiUsage(model, tokensUsed);\\n\\n      const aiMsg: AiChatMessage = {\\n        id: `a-${Date.now()}`,\\n        role: \'assistant\',\\n        content: json.reply || \'\',\\n        model,\\n        tokensUsed,\\n        proposal: json.proposal,\\n        timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\\n      };\\n      setMessages((prev) => [...prev, aiMsg]);\\n    } catch (err) {\\n      setErrorMsg(err instanceof Error ? err.message : \'Request failed\');\\n    } finally {\\n      setLoading(false);\\n    }\\n  };\\n\\n  const handleConfirmProposal = async (msg: AiChatMessage) => {\\n    if (!msg.proposal || msg.proposalApplied) return;\\n    const p = msg.proposal;\\n    if (p.type === \'add_expense\') {\\n      await addExpense({\\n        description: String(p.payload.description || \'Expense\'),\\n        amountPiasters: egpToPiasters(Number(p.payload.amountEgp || 0)),\\n        currency: \'EGP\',\\n        category: String(p.payload.category || \'other\'),\\n        date: TODAY_ISO,\\n        paymentMethod: \'cash\',\\n        entrySource: \'manual\',\\n        recurring: false,\\n      });\\n    } else if (p.type === \'add_task\') {\\n      await addTask({\\n        title: String(p.payload.title || \'New Task\'),\\n        priority: (p.payload.priority as TaskPriority) || \'medium\',\\n        category: (p.payload.category as TaskCategory) || \'deep_work\',\\n        status: \'todo\',\\n        deadline: TODAY_ISO,\\n        estimatedMinutes: Number(p.payload.estimatedMinutes || 45),\\n        actualMinutes: 0,\\n      });\\n    }\\n    setMessages((prev) =>\\n      prev.map((m) => (m.id === msg.id ? { ...m, proposalApplied: true } : m)),\\n    );\\n  };\\n\\n  const quickPrompts = isAr\\n    ? [\\n        \'\331\204\330\256\331\221\330\265 \331\210\330\266\330\271\331\212 \330\247\331\204\331\205\330\247\331\204\331\212 \331\207\330\260\330\247 \330\247\331\204\330\264\331\207\330\261 \331\210\330\247\331\202\330\252\330\261\330\255 \330\252\330\255\330\263\331\212\331\206 \331\204\331\204\331\205\331\212\330\262\330\247\331\206\331\212\330\251\',\\n        \'\330\261\330\252\331\221\330\250 \331\205\331\207\330\247\331\205\331\212 \330\247\331\204\331\205\330\252\330\250\331\202\331\212\330\251 \330\255\330\263\330\250 \330\260\330\261\331\210\330\251 \330\252\330\261\331\203\331\212\330\262\331\212 \330\247\331\204\330\265\330\250\330\247\330\255\331\212\330\251\',\\n        \'\330\263\330\254\331\221\331\204 \331\205\330\265\330\261\331\210\331\201 120 \330\254\331\206\331\212\331\207 \331\202\331\207\331\210\330\251 \331\210\330\264\330\247\331\212 \330\247\331\204\331\206\331\207\330\247\330\261\330\257\331\207\',\\n      ]\\n    : [\\n        \'Summarize my monthly cash flow and budget improvements\',\\n        \'Prioritize my remaining tasks around my morning peak\',\\n        \'Add an expense of 120 EGP for coffee today\',\\n      ];\\n\\n  return (\\n    <div className=\\\"space-y-5\\\">\\n      <div className=\\\"flex flex-col md:flex-row md:items-center justify-between gap-4\\\">\\n        <div>\\n          <h1 className=\\\"text-2xl font-bold text-[#F4F6F8] flex items-center gap-2\\\">\\n            <Sparkles className=\\\"w-5 h-5 text-emerald-400\\\" />\\n            LIFE AI\\n          </h1>\\n          <p className=\\\"text-xs text-[#8E99A8] mt-1\\\">\\n            {isAr\\n              ? \'\331\205\330\263\330\247\330\271\330\257\331\203 \330\247\331\204\330\264\330\256\330\265\331\212 \330\271\330\250\330\261 Gemini API \331\205\331\206 \330\247\331\204\330\256\330\247\330\257\331\205 \342\200\224 \330\252\331\210\330\254\331\212\331\207 \330\260\331\203\331\212 \331\204\331\204\331\206\331\205\330\247\330\260\330\254 \331\210\331\205\331\210\330\247\331\201\331\202\330\251 \330\245\331\204\330\262\330\247\331\205\331\212\330\251 \331\202\330\250\331\204 \330\243\331\212 \330\252\330\271\330\257\331\212\331\204.\'\\n              : \'Server-side Gemini personal assistant with model routing, minimal scoped context, and action confirmation.\'}\\n          </p>\\n        </div>\\n\\n        {/* AI Usage & Cost Quota Stats */}\\n        <div className=\\\"text-xs text-[#8E99A8] font-mono-nums flex flex-wrap items-center gap-3\\\">\\n          <span>\\n            {isAr ? \'\330\247\331\204\330\267\331\204\330\250\330\247\330\252 \330\247\331\204\331\212\331\210\331\205:\' : \'Today:\'}{\' \'}\\n            <strong className=\\\"text-[#F4F6F8]\\\">\\n              {data.aiUsage.requestsToday}/{data.profile.aiDailyLimit}\\n            </strong>\\n          </span>\\n          <span>\302\267</span>\\n          <span>\\n            {isAr ? \'\330\247\331\204\330\252\331\210\331\203\331\206\330\262 \331\207\330\260\330\247 \330\247\331\204\330\264\331\207\330\261:\' : \'Tokens/mo:\'}{\' \'}\\n            <strong className=\\\"text-[#F4F6F8]\\\">{data.aiUsage.tokensThisMonth.toLocaleString(\'en-US\')}</strong>\\n          </span>\\n        </div>\\n      </div>\\n\\n      {/* Domain & Model Routing Controls */}\\n      <div className=\\\"bg-[#13171C] border border-[#232A33] rounded-2xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3\\\">\\n        <div className=\\\"flex items-center gap-1.5 overflow-x-auto\\\">\\n          {(\\n            [\\n              { id: \'general\', label: isAr ? \'\331\205\330\261\330\247\330\254\330\271\330\251 \330\271\330\247\331\205\330\251\' : \'General\' },\\n              { id: \'finance\', label: isAr ? \'\330\247\331\204\331\205\330\247\331\204\331\212\330\251\' : \'Finance\' },\\n              { id: \'productivity\', label: isAr ? \'\330\247\331\204\330\245\331\206\330\252\330\247\330\254\331\212\330\251\' : \'Productivity\' },\\n              { id: \'health\', label: isAr ? \'\330\247\331\204\330\265\330\255\330\251\' : \'Health\' },\\n            ] as const\\n          ).map((d) => (\\n            <button\\n              key={d.id}\\n              type=\\\"button\\\"\\n              onClick={() => setDomain(d.id)}\\n              className={`min-h-[36px] px-3 rounded-xl text-xs font-semibold transition-colors whitespace-nowrap ${\\n                domain === d.id ? \'bg-emerald-500 text-[#07110C]\' : \'text-[#A9B3C1] hover:bg-[#1B212A]\'\\n              }`}\\n            >\\n              {d.label}\\n            </button>\\n          ))}\\n        </div>\\n\\n        <div className=\\\"flex items-center gap-2 shrink-0\\\">\\n          <label htmlFor=\\\"ai-model-select\\\" className=\\\"text-xs text-[#8E99A8] whitespace-nowrap\\\">\\n            {isAr ? \'\330\247\331\204\331\206\331\205\331\210\330\260\330\254:\' : \'Model:\'}\\n          </label>\\n          <select\\n            id=\\\"ai-model-select\\\"\\n            value={model}\\n            onChange={(e) => setModel(e.target.value as AiModelId)}\\n            className=\\\"min-h-[36px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-xs font-mono-nums text-[#F4F6F8]\\\"\\n          >\\n            <option value=\\\"gemini-3.1-flash-lite\\\">Gemini Flash-Lite ({isAr ? \'\330\263\330\261\331\212\330\271 \331\210\330\247\331\202\330\252\330\265\330\247\330\257\331\212\' : \'Fast / Low Cost\'})</option>\\n            <option value=\\\"gemini-4-hydrogen\\\">Gemini Flash ({isAr ? \'\330\252\330\255\331\204\331\212\331\204 \330\243\330\271\331\205\331\202\' : \'Deep Analysis\'})</option>\\n          </select>\\n        </div>\\n      </div>\\n\\n      {/* Chat Thread */}\\n      <div className=\\\"bg-[#13171C] border border-[#232A33] rounded-2xl p-5 flex flex-col gap-4 min-h-[380px] max-h-[540px]\\\">\\n        <div className=\\\"flex-1 overflow-y-auto space-y-4 pe-1\\\">\\n          {messages.map((msg) => (\\n            <div\\n              key={msg.id}\\n              className={`flex flex-col ${msg.role === \'user\' ? \'items-end\' : \'items-start\'}`}\\n            >\\n              <div\\n                className={`max-w-[85%] rounded-2xl px-4 py-3 text-sm leading-relaxed whitespace-pre-wrap ${\\n                  msg.role === \'user\'\\n                    ? \'bg-emerald-500/15 border border-emerald-500/30 text-[#F4F6F8]\'\\n                    : \'bg-[#0B0D10] border border-[#232A33] text-[#DCE3EC]\'\\n                }`}\\n              >\\n                <p>{msg.content}</p>\\n                {msg.proposal ? (\\n                  <div className=\\\"mt-3 pt-3 border-t border-[#232A33] space-y-2.5\\\">\\n                    <p className=\\\"text-xs font-semibold text-amber-300\\\">\\n                      {isAr ? \'\330\245\330\254\330\261\330\247\330\241 \331\205\331\202\330\252\330\261\330\255 \331\212\330\255\330\252\330\247\330\254 \330\252\330\243\331\203\331\212\330\257\331\203:\' : \'Proposed action awaiting confirmation:\'}\\n                    </p>\\n                    <p className=\\\"text-xs text-[#F4F6F8]\\\">{msg.proposal.summary}</p>\\n                    <button\\n                      type=\\\"button\\\"\\n                      disabled={msg.proposalApplied}\\n                      onClick={() => void handleConfirmProposal(msg)}\\n                      className=\\\"min-h-[36px] px-3.5 rounded-xl bg-emerald-500 text-[#07110C] text-xs font-semibold hover:bg-emerald-400 disabled:opacity-60 inline-flex items-center gap-1.5\\\"\\n                    >\\n                      <Check className=\\\"w-3.5 h-3.5\\\" />\\n                      {msg.proposalApplied\\n                        ? isAr ? \'\330\252\331\205 \330\247\331\204\330\252\331\206\331\201\331\212\330\260 \331\210\330\247\331\204\330\255\331\201\330\270\' : \'Confirmed & Saved\'\\n                        : isAr ? \'\330\252\330\243\331\203\331\212\330\257 \331\210\330\252\331\206\331\201\331\212\330\260\' : \'Confirm & Apply\'}\\n                    </button>\\n                  </div>\\n                ) : null}\\n              </div>\\n              <span className=\\\"text-[11px] text-[#6C7787] font-mono-nums mt-1 px-1\\\">\\n                {msg.timestamp}\\n                {msg.model ? ` \302\267 ${msg.model}` : \'\'}\\n                {msg.tokensUsed ? ` \302\267 ${msg.tokensUsed} tok` : \'\'}\\n              </span>\\n            </div>\\n          ))}\\n          {loading ? (\\n            <div className=\\\"flex items-center gap-2 text-xs text-[#8E99A8]\\\">\\n              <Loader2 className=\\\"w-4 h-4 animate-spin text-emerald-400\\\" />\\n              {isAr ? \'LIFE AI \331\212\330\255\331\204\331\204 \330\250\331\212\330\247\331\206\330\247\330\252\331\203 \330\247\331\204\331\205\330\255\330\257\330\257\330\251...\' : \'LIFE AI is analyzing your scoped metrics...\'}\\n            </div>\\n          ) : null}\\n        </div>\\n\\n        {errorMsg ? (\\n          <div className=\\\"p-3 rounded-xl bg-red-500/10 border border-red-500/30 text-xs text-red-300\\\">\\n            {errorMsg}\\n          </div>\\n        ) : null}\\n\\n        <div className=\\\"flex flex-wrap gap-2 text-xs\\\">\\n          {quickPrompts.map((p, idx) => (\\n            <button\\n              key={idx}\\n              type=\\\"button\\\"\\n              onClick={() => void sendMessage(p)}\\n              className=\\\"px-3 py-1.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-[#A9B3C1] hover:text-emerald-400 hover:border-emerald-500/40 transition-colors\\\"\\n            >\\n              {p}\\n            </button>\\n          ))}\\n        </div>\\n\\n        <form\\n          onSubmit={(e) => {\\n            e.preventDefault();\\n            void sendMessage();\\n          }}\\n          className=\\\"flex gap-2 pt-2 border-t border-[#232A33]\\\"\\n        >\\n          <input\\n            type=\\\"text\\\"\\n            value={input}\\n            onChange={(e) => setInput(e.target.value)}\\n            placeholder={isAr ? \'\330\247\330\263\330\243\331\204 \330\271\331\206 \331\205\330\265\330\247\330\261\331\212\331\201\331\203\330\214 \331\205\331\207\330\247\331\205\331\203\330\214 \331\206\331\210\331\205\331\203\330\214 \330\243\331\210 \330\247\330\267\331\204\330\250 \331\205\330\261\330\247\330\254\330\271\330\251 \330\243\330\263\330\250\331\210\330\271\331\212\330\251...\' : \'Ask about spending, schedule, sleep, or weekly review...\'}\\n            aria-label={isAr ? \'\330\261\330\263\330\247\331\204\330\251 \330\245\331\204\331\211 LIFE AI\' : \'Message LIFE AI\'}\\n            className=\\\"flex-1 min-h-[44px] px-4 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8] focus:outline-none focus:border-emerald-500\\\"\\n          />\\n          <button\\n            type=\\\"submit\\\"\\n            disabled={loading || !input.trim()}\\n            aria-label={isAr ? \'\330\245\330\261\330\263\330\247\331\204\' : \'Send\'}\\n            className=\\\"min-h-[44px] px-5 rounded-xl bg-emerald-500 text-[#07110C] font-semibold text-sm hover:bg-emerald-400 disabled:opacity-50 flex items-center gap-2\\\"\\n          >\\n            <Send className=\\\"w-4 h-4\\\" />\\n            <span className=\\\"hidden sm:inline\\\">{isAr ? \'\330\245\330\261\330\263\330\247\331\204\' : \'Send\'}</span>\\n          </button>\\n        </form>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create Module 07 LIFE AI Assistant chat with scoped minimal context, Flash-Lite vs Flash routing, quota tracking, and confirmation cards for mutations\", \"Overwrite\":true, \"TargetFile\":\"/src/components/LifeAiModule.tsx\", \"toolAction\":\"Creating LifeAiModule component\", \"toolSummary\":\"Create LifeAiModule\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_9845439595505392290"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { Check, Loader2, Plus, Sparkles, Trash2 } from \'lucide-react\';\\nimport { useLifeOs } from \'../context/LifeOsContext\';\\nimport { TODAY_ISO } from \'../data/seedData\';\\nimport { GOAL_CATEGORY_LABELS } from \'../i18n/translations\';\\nimport type { GoalCategory, PersonalGoal } from \'../types/lifeos\';\\n\\nexport const GoalsModule: React.FC = () => {\\n  const { data, lang, addGoal, toggleGoalMilestone, appendGoalMilestones, deleteGoal, recordAiUsage } = useLifeOs();\\n  const isAr = lang === \'ar\';\\n\\n  const [title, setTitle] = useState(\'\');\\n  const [description, setDescription] = useState(\'\');\\n  const [category, setCategory] = useState<GoalCategory>(\'financial\');\\n  const [targetLabel, setTargetLabel] = useState(\'\');\\n  const [deadline, setDeadline] = useState(\'2027-06-01\');\\n  const [suggestingGoalId, setSuggestingGoalId] = useState<string | null>(null);\\n  const [aiError, setAiError] = useState<string | null>(null);\\n\\n  const handleAddGoal = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!title.trim() || !targetLabel.trim()) return;\\n    await addGoal({\\n      title: title.trim(),\\n      description: description.trim() || undefined,\\n      category,\\n      targetLabel: targetLabel.trim(),\\n      startDate: TODAY_ISO,\\n      deadline,\\n      progress: 0,\\n      milestones: [\\n        { id: `ms-init-${Date.now()}`, title: isAr ? \'\330\252\330\255\330\257\331\212\330\257 \330\256\330\267\330\251 \330\247\331\204\330\243\330\263\330\250\331\210\330\271 \330\247\331\204\330\243\331\210\331\204\' : \'Define week-1 action plan\', completed: false },\\n      ],\\n    });\\n    setTitle(\'\');\\n    setDescription(\'\');\\n    setTargetLabel(\'\');\\n  };\\n\\n  const handleAiMilestones = async (goal: PersonalGoal) => {\\n    setSuggestingGoalId(goal.id);\\n    setAiError(null);\\n    try {\\n      const res = await fetch(\'/api/ai/goal-milestones\', {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({\\n          title: goal.title,\\n          category: goal.category,\\n          targetLabel: goal.targetLabel,\\n          language: lang,\\n        }),\\n      });\\n      const json = await res.json();\\n      if (!res.ok) throw new Error(json.error || \'Failed to suggest milestones\');\\n      if (json.tokensUsed) recordAiUsage(\'gemini-3.1-flash-lite\', json.tokensUsed);\\n      if (Array.isArray(json.milestones) && json.milestones.length > 0) {\\n        await appendGoalMilestones(goal.id, json.milestones);\\n      }\\n    } catch (err) {\\n      setAiError(err instanceof Error ? err.message : \'Error suggesting milestones\');\\n    } finally {\\n      setSuggestingGoalId(null);\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      <div>\\n        <h1 className=\\\"text-2xl font-bold text-[#F4F6F8]\\\">{isAr ? \'\330\247\331\204\330\243\331\207\330\257\330\247\331\201 \330\247\331\204\330\264\330\256\330\265\331\212\330\251\' : \'Personal Goals\'}</h1>\\n        <p className=\\\"text-xs text-[#8E99A8] mt-1\\\">\\n          {isAr\\n            ? \'\330\245\330\257\330\247\330\261\330\251 \330\243\331\207\330\257\330\247\331\201\331\203 \330\247\331\204\331\205\330\247\331\204\331\212\330\251 \331\210\330\247\331\204\331\205\331\207\331\206\331\212\330\251 \331\210\330\247\331\204\330\252\330\271\331\204\331\212\331\205\331\212\330\251 \331\210\330\247\331\204\330\265\330\255\331\212\330\251 \331\210\330\247\331\204\330\264\330\256\330\265\331\212\330\251 \331\205\330\271 \330\247\331\202\330\252\330\261\330\247\330\255 \330\256\330\267\331\210\330\247\330\252 \330\271\331\205\331\204\331\212\330\251 \330\271\330\250\330\261 Gemini.\'\\n            : \'Track financial, professional, educational, health, personal, and social goals with Gemini milestone suggestions.\'}\\n        </p>\\n      </div>\\n\\n      {aiError ? (\\n        <div className=\\\"p-3.5 rounded-xl bg-red-500/10 border border-red-500/30 text-xs text-red-300\\\">{aiError}</div>\\n      ) : null}\\n\\n      <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-5\\\">\\n        <form onSubmit={handleAddGoal} className=\\\"lg:col-span-4 bg-[#13171C] border border-[#232A33] rounded-2xl p-5 space-y-4 self-start\\\">\\n          <h2 className=\\\"text-sm font-semibold text-[#F4F6F8]\\\">{isAr ? \'\330\245\330\266\330\247\331\201\330\251 \331\207\330\257\331\201 \330\254\330\257\331\212\330\257\' : \'Create Personal Goal\'}</h2>\\n          <div>\\n            <label htmlFor=\\\"goal-title\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\271\331\206\331\210\330\247\331\206 \330\247\331\204\331\207\330\257\331\201\' : \'Goal Title\'}</label>\\n            <input\\n              id=\\\"goal-title\\\"\\n              type=\\\"text\\\"\\n              value={title}\\n              onChange={(e) => setTitle(e.target.value)}\\n              placeholder={isAr ? \'\331\205\330\253\330\247\331\204: \330\245\330\252\331\202\330\247\331\206 \330\252\330\267\331\210\331\212\330\261 \330\252\330\267\330\250\331\212\331\202\330\247\330\252 \330\247\331\204\331\205\331\210\330\250\330\247\331\212\331\204\' : \'e.g., Ship side project MVP\'}\\n              className=\\\"w-full min-h-[44px] px-3.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\\\"\\n            />\\n          </div>\\n          <div className=\\\"grid grid-cols-2 gap-3\\\">\\n            <div>\\n              <label htmlFor=\\\"goal-cat\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\247\331\204\331\201\330\246\330\251\' : \'Category\'}</label>\\n              <select\\n                id=\\\"goal-cat\\\"\\n                value={category}\\n                onChange={(e) => setCategory(e.target.value as GoalCategory)}\\n                className=\\\"w-full min-h-[44px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\\\"\\n              >\\n                {(Object.keys(GOAL_CATEGORY_LABELS) as GoalCategory[]).map((c) => (\\n                  <option key={c} value={c}>{GOAL_CATEGORY_LABELS[c][lang]}</option>\\n                ))}\\n              </select>\\n            </div>\\n            <div>\\n              <label htmlFor=\\\"goal-dl\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\247\331\204\331\205\331\210\330\271\330\257 \330\247\331\204\331\205\330\263\330\252\331\207\330\257\331\201\' : \'Deadline\'}</label>\\n              <input\\n                id=\\\"goal-dl\\\"\\n                type=\\\"date\\\"\\n                value={deadline}\\n                onChange={(e) => setDeadline(e.target.value)}\\n                className=\\\"w-full min-h-[44px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-xs font-mono-nums text-[#F4F6F8]\\\"\\n              />\\n            </div>\\n          </div>\\n          <div>\\n            <label htmlFor=\\\"goal-target\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\247\331\204\331\205\330\271\331\212\330\247\330\261 \330\247\331\204\331\205\330\263\330\252\331\207\330\257\331\201\' : \'Measurable Target\'}</label>\\n            <input\\n              id=\\\"goal-target\\\"\\n              type=\\\"text\\\"\\n              value={targetLabel}\\n              onChange={(e) => setTargetLabel(e.target.value)}\\n              placeholder={isAr ? \'\331\205\330\253\330\247\331\204: 50,000 \330\254.\331\205 \330\243\331\210 3 \330\264\331\207\330\247\330\257\330\247\330\252\' : \'e.g., 50,000 EGP or 3 courses\'}\\n              className=\\\"w-full min-h-[44px] px-3.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\\\"\\n            />\\n          </div>\\n          <div>\\n            <label htmlFor=\\\"goal-desc\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\247\331\204\331\210\330\265\331\201 (\330\247\330\256\330\252\331\212\330\247\330\261\331\212)\' : \'Description (Optional)\'}</label>\\n            <textarea\\n              id=\\\"goal-desc\\\"\\n              rows={2}\\n              value={description}\\n              onChange={(e) => setDescription(e.target.value)}\\n              className=\\\"w-full p-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\\\"\\n            />\\n          </div>\\n          <button type=\\\"submit\\\" className=\\\"w-full min-h-[44px] rounded-xl bg-emerald-500 text-[#07110C] font-semibold text-sm hover:bg-emerald-400 flex items-center justify-center gap-2\\\">\\n            <Plus className=\\\"w-4 h-4\\\" />\\n            {isAr ? \'\330\255\331\201\330\270 \330\247\331\204\331\207\330\257\331\201\' : \'Save Goal\'}\\n          </button>\\n        </form>\\n\\n        <div className=\\\"lg:col-span-8 space-y-4\\\">\\n          {data.goals.map((goal) => (\\n            <div key={goal.id} className=\\\"bg-[#13171C] border border-[#232A33] rounded-2xl p-5 space-y-4\\\">\\n              <div className=\\\"flex items-start justify-between gap-3\\\">\\n                <div>\\n                  <p className=\\\"text-xs text-[#8E99A8]\\\">\\n                    {GOAL_CATEGORY_LABELS[goal.category][lang]} \302\267 {goal.targetLabel} \302\267{\' \'}\\n                    <span className=\\\"font-mono-nums\\\">{goal.deadline}</span>\\n                  </p>\\n                  <h3 className=\\\"text-base font-semibold text-[#F4F6F8] mt-1\\\">{goal.title}</h3>\\n                  {goal.description ? <p className=\\\"text-xs text-[#A9B3C1] mt-1\\\">{goal.description}</p> : null}\\n                </div>\\n                <div className=\\\"flex items-center gap-2 shrink-0\\\">\\n                  <button\\n                    type=\\\"button\\\"\\n                    disabled={suggestingGoalId === goal.id}\\n                    onClick={() => void handleAiMilestones(goal)}\\n                    className=\\\"min-h-[36px] px-3 rounded-xl border border-[#2A3340] text-xs font-medium text-emerald-400 hover:bg-[#1A212B] flex items-center gap-1.5 whitespace-nowrap\\\"\\n                  >\\n                    {suggestingGoalId === goal.id ? <Loader2 className=\\\"w-3.5 h-3.5 animate-spin\\\" /> : <Sparkles className=\\\"w-3.5 h-3.5\\\" />}\\n                    {isAr ? \'\330\247\331\202\330\252\330\261\330\247\330\255 \330\256\330\267\331\210\330\247\330\252 AI\' : \'AI Milestones\'}\\n                  </button>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => void deleteGoal(goal.id)}\\n                    aria-label={`${isAr ? \'\330\255\330\260\331\201 \331\207\330\257\331\201\' : \'Delete goal\'} ${goal.title}`}\\n                    className=\\\"min-h-[36px] min-w-[36px] flex items-center justify-center rounded-lg text-[#758091] hover:text-red-400\\\"\\n                  >\\n                    <Trash2 className=\\\"w-4 h-4\\\" />\\n                  </button>\\n                </div>\\n              </div>\\n\\n              <div className=\\\"space-y-1.5\\\">\\n                <div className=\\\"flex justify-between text-xs font-mono-nums\\\">\\n                  <span className=\\\"text-[#8E99A8]\\\">{isAr ? \'\331\206\330\263\330\250\330\251 \330\247\331\204\330\245\331\206\330\254\330\247\330\262\' : \'Progress\'}</span>\\n                  <span className=\\\"text-emerald-400 font-semibold\\\">{goal.progress}%</span>\\n                </div>\\n                <div className=\\\"h-2 rounded-full bg-[#0B0D10] overflow-hidden\\\">\\n                  <div className=\\\"h-full bg-emerald-500 rounded-full transition-all\\\" style={{ width: `${goal.progress}%` }} />\\n                </div>\\n              </div>\\n\\n              <div className=\\\"pt-3 border-t border-[#232A33] space-y-2\\\">\\n                {goal.milestones.map((m) => (\\n                  <button\\n                    key={m.id}\\n                    type=\\\"button\\\"\\n                    onClick={() => void toggleGoalMilestone(goal.id, m.id)}\\n                    className=\\\"w-full flex items-center gap-2.5 text-start text-xs py-1.5 hover:text-[#F4F6F8] transition-colors\\\"\\n                  >\\n                    <span\\n                      className={`w-5 h-5 rounded-md border flex items-center justify-center shrink-0 ${\\n                        m.completed ? \'bg-emerald-500 border-emerald-500 text-[#07110C]\' : \'border-[#33404F] text-transparent\'\\n                      }`}\\n                    >\\n                      <Check className=\\\"w-3.5 h-3.5\\\" />\\n                    </span>\\n                    <span className={m.completed ? \'line-through text-[#6C7787]\' : \'text-[#D2DAE5]\'}>{m.title}</span>\\n                  </button>\\n                ))}\\n              </div>\\n            </div>\\n          ))}\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create Module 09 Personal Goals management component with 6 categories, interactive milestones, and Gemini AI milestone suggestions\", \"Overwrite\":true, \"TargetFile\":\"/src/components/GoalsModule.tsx\", \"toolAction\":\"Creating GoalsModule component\", \"toolSummary\":\"Create GoalsModule\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_9845439595505392589"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useMemo, useState } from \'react\';\\nimport { Download, Printer } from \'lucide-react\';\\nimport { useLifeOs } from \'../context/LifeOsContext\';\\nimport { CURRENT_MONTH, TODAY_ISO } from \'../data/seedData\';\\nimport {\\n  calculateAvailableCashPiasters,\\n  calculateNetWorthPiasters,\\n  calculateSavingsRatePercent,\\n  calculateTotalExpensesPiasters,\\n  calculateTotalPaidIncomePiasters,\\n  formatEgp,\\n  piastersToEgp,\\n} from \'../utils/finance\';\\nimport { getCategoryLabel } from \'../i18n/translations\';\\n\\ntype ReportPeriod = \'daily\' | \'weekly\' | \'monthly\';\\n\\nexport const ReportsModule: React.FC = () => {\\n  const { data, lang, exportJsonBackup } = useLifeOs();\\n  const isAr = lang === \'ar\';\\n  const [period, setPeriod] = useState<ReportPeriod>(\'monthly\');\\n\\n  const summary = useMemo(() => {\\n    const todayExpenses = data.expenseRecords.filter((e) => e.date === TODAY_ISO).reduce((s, e) => s + e.amountPiasters, 0);\\n    const monthExpenses = calculateTotalExpensesPiasters(data.expenseRecords, CURRENT_MONTH);\\n    const monthPaidIncome = calculateTotalPaidIncomePiasters(data.incomeRecords, CURRENT_MONTH);\\n    const availableCash = calculateAvailableCashPiasters(data.incomeRecords, data.expenseRecords);\\n    const netWorth = calculateNetWorthPiasters({\\n      availableCashPiasters: availableCash,\\n      savingsGoals: data.savingsGoals,\\n      investments: data.investments,\\n      liabilitiesPiasters: data.profile.liabilitiesPiasters,\\n    });\\n    const savingsRate = calculateSavingsRatePercent(monthPaidIncome, monthExpenses);\\n    const completedTasks = data.tasks.filter((t) => t.status === \'completed\').length;\\n    const focusTotal = data.focusSessions.reduce((s, f) => s + f.durationMinutes, 0);\\n    const avgGoalProgress =\\n      data.goals.length > 0 ? Math.round(data.goals.reduce((s, g) => s + g.progress, 0) / data.goals.length) : 0;\\n    const sleepVals = data.healthLogs.map((h) => h.sleepHours).filter((v): v is number => typeof v === \'number\');\\n    const avgSleep = sleepVals.length > 0 ? (sleepVals.reduce((s, x) => s + x, 0) / sleepVals.length).toFixed(1) : \'\342\200\224\';\\n\\n    return {\\n      todayExpenses,\\n      monthExpenses,\\n      monthPaidIncome,\\n      availableCash,\\n      netWorth,\\n      savingsRate,\\n      completedTasks,\\n      totalTasks: data.tasks.length,\\n      focusTotal,\\n      avgGoalProgress,\\n      avgSleep,\\n    };\\n  }, [data]);\\n\\n  const downloadFile = (content: string, filename: string, mime: string) => {\\n    const blob = new Blob([content], { type: mime });\\n    const url = URL.createObjectURL(blob);\\n    const a = document.createElement(\'a\');\\n    a.href = url;\\n    a.download = filename;\\n    a.click();\\n    URL.revokeObjectURL(url);\\n  };\\n\\n  const handleExportCsv = () => {\\n    const headers = [\'Date\', \'Description\', \'Category\', \'Amount_EGP\', \'PaymentMethod\', \'Source\'];\\n    const rows = data.expenseRecords.map((e) => [\\n      e.date,\\n      `\\\"${e.description.replace(/\\\"/g, \'\\\"\\\"\')}\\\"`,\\n      getCategoryLabel(e.category, lang),\\n      piastersToEgp(e.amountPiasters).toFixed(2),\\n      e.paymentMethod,\\n      e.entrySource,\\n    ]);\\n    const csv = [headers.join(\',\'), ...rows.map((r) => r.join(\',\'))].join(\'\\\\n\');\\n    downloadFile(csv, `life-os-expenses-${CURRENT_MONTH}.csv`, \'text/csv;charset=utf-8\');\\n  };\\n\\n  const handleExportJson = () => {\\n    downloadFile(exportJsonBackup(), `life-os-backup-${TODAY_ISO}.json`, \'application/json\');\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 no-print\\\">\\n        <div>\\n          <h1 className=\\\"text-2xl font-bold text-[#F4F6F8]\\\">{isAr ? \'\330\247\331\204\330\252\331\202\330\247\330\261\331\212\330\261 \331\210\330\247\331\204\330\261\330\244\331\211\' : \'Reports & Insights\'}</h1>\\n          <p className=\\\"text-xs text-[#8E99A8] mt-1\\\">\\n            {isAr\\n              ? \'\330\252\331\202\330\247\330\261\331\212\330\261 \331\212\331\210\331\205\331\212\330\251 \331\210\330\243\330\263\330\250\331\210\330\271\331\212\330\251 \331\210\330\264\331\207\330\261\331\212\330\251 \331\202\330\247\330\250\331\204\330\251 \331\204\331\204\330\267\330\250\330\247\330\271\330\251 \331\203\331\200 PDF \330\243\331\210 \330\247\331\204\330\252\330\265\330\257\331\212\330\261 \331\203\331\200 CSV \331\210\331\206\330\263\330\256\330\251 \330\247\330\255\330\252\331\212\330\247\330\267\331\212\330\251 JSON.\'\\n              : \'Daily, weekly, and monthly reports with PDF print, CSV financial export, and JSON backup.\'}\\n          </p>\\n        </div>\\n\\n        <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => window.print()}\\n            className=\\\"min-h-[40px] px-3.5 rounded-xl bg-emerald-500 text-[#07110C] text-xs font-semibold hover:bg-emerald-400 flex items-center gap-1.5\\\"\\n          >\\n            <Printer className=\\\"w-3.5 h-3.5\\\" />\\n            {isAr ? \'\330\267\330\250\330\247\330\271\330\251 / PDF\' : \'Print / PDF\'}\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={handleExportCsv}\\n            className=\\\"min-h-[40px] px-3.5 rounded-xl bg-[#13171C] border border-[#232A33] text-xs font-medium text-[#E2E8F0] hover:border-emerald-500/50 flex items-center gap-1.5\\\"\\n          >\\n            <Download className=\\\"w-3.5 h-3.5\\\" />\\n            CSV\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={handleExportJson}\\n            className=\\\"min-h-[40px] px-3.5 rounded-xl bg-[#13171C] border border-[#232A33] text-xs font-medium text-[#E2E8F0] hover:border-emerald-500/50 flex items-center gap-1.5\\\"\\n          >\\n            <Download className=\\\"w-3.5 h-3.5\\\" />\\n            JSON Backup\\n          </button>\\n        </div>\\n      </div>\\n\\n      <div className=\\\"flex items-center gap-1.5 no-print\\\">\\n        {(\\n          [\\n            { id: \'daily\', label: isAr ? \'\330\247\331\204\330\252\331\202\330\261\331\212\330\261 \330\247\331\204\331\212\331\210\331\205\331\212\' : \'Daily Report\' },\\n            { id: \'weekly\', label: isAr ? \'\330\247\331\204\330\252\331\202\330\261\331\212\330\261 \330\247\331\204\330\243\330\263\330\250\331\210\330\271\331\212\' : \'Weekly Report\' },\\n            { id: \'monthly\', label: isAr ? \'\330\247\331\204\330\252\331\202\330\261\331\212\330\261 \330\247\331\204\330\264\331\207\330\261\331\212\' : \'Monthly Report\' },\\n          ] as const\\n        ).map((p) => (\\n          <button\\n            key={p.id}\\n            type=\\\"button\\\"\\n            onClick={() => setPeriod(p.id)}\\n            className={`min-h-[40px] px-3.5 rounded-xl text-xs font-semibold transition-colors ${\\n              period === p.id\\n                ? \'bg-emerald-500 text-[#07110C]\'\\n                : \'bg-[#13171C] border border-[#232A33] text-[#A9B3C1]\'\\n            }`}\\n          >\\n            {p.label}\\n          </button>\\n        ))}\\n      </div>\\n\\n      <div className=\\\"bg-[#13171C] border border-[#232A33] rounded-2xl p-6 space-y-6\\\">\\n        <div className=\\\"flex items-center justify-between border-b border-[#232A33] pb-4\\\">\\n          <div>\\n            <h2 className=\\\"text-lg font-bold text-[#F4F6F8]\\\">\\n              {period === \'daily\'\\n                ? isAr ? `\330\252\331\202\330\261\331\212\330\261 LIFE OS \330\247\331\204\331\212\331\210\331\205\331\212 \342\200\224 ${TODAY_ISO}` : `LIFE OS Daily Report \342\200\224 ${TODAY_ISO}`\\n                : period === \'weekly\'\\n                  ? isAr ? \'\330\252\331\202\330\261\331\212\330\261 LIFE OS \330\247\331\204\330\243\330\263\330\250\331\210\330\271\331\212\' : \'LIFE OS Weekly Report\'\\n                  : isAr ? `\330\252\331\202\330\261\331\212\330\261 LIFE OS \330\247\331\204\330\264\331\207\330\261\331\212 \342\200\224 ${CURRENT_MONTH}` : `LIFE OS Monthly Report \342\200\224 ${CURRENT_MONTH}`}\\n            </h2>\\n            <p className=\\\"text-xs text-[#8E99A8] mt-0.5\\\">{data.profile.displayName} \302\267 {data.profile.currency}</p>\\n          </div>\\n        </div>\\n\\n        <div className=\\\"grid grid-cols-2 md:grid-cols-4 gap-5\\\">\\n          <div>\\n            <p className=\\\"text-xs text-[#8E99A8]\\\">{period === \'daily\' ? (isAr ? \'\331\205\330\265\330\247\330\261\331\212\331\201 \330\247\331\204\331\212\331\210\331\205\' : \'Today Expenses\') : (isAr ? \'\331\205\330\265\330\247\330\261\331\212\331\201 \330\247\331\204\330\264\331\207\330\261\' : \'Monthly Expenses\')}</p>\\n            <p className=\\\"text-xl font-bold font-mono-nums text-[#F4F6F8] mt-1\\\">\\n              {formatEgp(period === \'daily\' ? summary.todayExpenses : summary.monthExpenses, lang)}\\n            </p>\\n          </div>\\n          <div>\\n            <p className=\\\"text-xs text-[#8E99A8]\\\">{isAr ? \'\330\247\331\204\330\257\330\256\331\204 \330\247\331\204\331\205\330\255\330\265\331\221\331\204\' : \'Paid Income\'}</p>\\n            <p className=\\\"text-xl font-bold font-mono-nums text-emerald-400 mt-1\\\">{formatEgp(summary.monthPaidIncome, lang)}</p>\\n          </div>\\n          <div>\\n            <p className=\\\"text-xs text-[#8E99A8]\\\">{isAr ? \'\330\265\330\247\331\201\331\212 \330\247\331\204\330\253\330\261\331\210\330\251\' : \'Net Worth\'}</p>\\n            <p className=\\\"text-xl font-bold font-mono-nums text-[#F4F6F8] mt-1\\\">{formatEgp(summary.netWorth.netWorthPiasters, lang)}</p>\\n          </div>\\n          <div>\\n            <p className=\\\"text-xs text-[#8E99A8]\\\">{isAr ? \'\331\205\330\271\330\257\331\204 \330\247\331\204\330\247\330\257\330\256\330\247\330\261\' : \'Savings Rate\'}</p>\\n            <p className=\\\"text-xl font-bold font-mono-nums text-emerald-400 mt-1\\\">{summary.savingsRate}%</p>\\n          </div>\\n        </div>\\n\\n        <div className=\\\"grid grid-cols-1 md:grid-cols-3 gap-5 pt-5 border-t border-[#232A33] text-sm\\\">\\n          <div className=\\\"space-y-1\\\">\\n            <p className=\\\"text-xs font-semibold text-emerald-400\\\">{isAr ? \'\330\247\331\204\330\245\331\206\330\252\330\247\330\254\331\212\330\251 \331\210\330\247\331\204\330\252\330\261\331\203\331\212\330\262\' : \'Productivity & Focus\'}</p>\\n            <p className=\\\"text-[#D2DAE5]\\\">\\n              {isAr\\n                ? `\330\245\331\206\330\254\330\247\330\262 ${summary.completedTasks} \331\205\331\206 ${summary.totalTasks} \331\205\331\207\330\247\331\205 \302\267 \330\245\330\254\331\205\330\247\331\204\331\212 \330\254\331\204\330\263\330\247\330\252 \330\247\331\204\330\252\330\261\331\203\331\212\330\262 ${summary.focusTotal} \330\257\331\202\331\212\331\202\330\251.`\\n                : `Completed ${summary.completedTasks}/${summary.totalTasks} tasks \302\267 Total focus logged: ${summary.focusTotal} minutes.`}\\n            </p>\\n          </div>\\n          <div className=\\\"space-y-1\\\">\\n            <p className=\\\"text-xs font-semibold text-emerald-400\\\">{isAr ? \'\330\247\330\252\330\254\330\247\331\207 \330\247\331\204\331\206\331\210\331\205 \331\210\330\247\331\204\330\265\330\255\330\251\' : \'Sleep & Health Trend\'}</p>\\n            <p className=\\\"text-[#D2DAE5]\\\">\\n              {isAr\\n                ? `\331\205\330\252\331\210\330\263\330\267 \330\247\331\204\331\206\331\210\331\205 \330\247\331\204\331\205\330\263\330\254\331\204 ${summary.avgSleep} \330\263\330\247\330\271\330\251 \331\205\331\202\330\247\330\250\331\204 \330\247\331\204\331\207\330\257\331\201 (${data.profile.targetSleepHours} \330\263\330\247\330\271\330\247\330\252).`\\n                : `Average logged sleep is ${summary.avgSleep}h against your ${data.profile.targetSleepHours}h target.`}\\n            </p>\\n          </div>\\n          <div className=\\\"space-y-1\\\">\\n            <p className=\\\"text-xs font-semibold text-emerald-400\\\">{isAr ? \'\330\252\331\202\330\257\331\205 \330\247\331\204\330\243\331\207\330\257\330\247\331\201 \330\247\331\204\330\264\330\256\330\265\331\212\330\251\' : \'Personal Goals Progress\'}</p>\\n            <p className=\\\"text-[#D2DAE5]\\\">\\n              {isAr\\n                ? `\331\205\330\252\331\210\330\263\330\267 \330\247\331\204\330\252\331\202\330\257\331\205 \330\271\330\250\330\261 ${data.goals.length} \330\243\331\207\330\257\330\247\331\201 \331\206\330\264\330\267\330\251: ${summary.avgGoalProgress}%.`\\n                : `Average progress across ${data.goals.length} active goals: ${summary.avgGoalProgress}%.`}\\n            </p>\\n          </div>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create Module 10 Reports & Insights component with Daily/Weekly/Monthly views, Print/PDF, CSV, and JSON Backup export\", \"Overwrite\":true, \"TargetFile\":\"/src/components/ReportsModule.tsx\", \"toolAction\":\"Creating ReportsModule component\", \"toolSummary\":\"Create ReportsModule\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_9845439595505392888"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { Check, Loader2, Mail, Shield, Upload } from \'lucide-react\';\\nimport { useLifeOs } from \'../context/LifeOsContext\';\\nimport { TODAY_ISO } from \'../data/seedData\';\\nimport { egpToPiasters, piastersToEgp } from \'../utils/finance\';\\nimport { getCategoryLabel } from \'../i18n/translations\';\\nimport { ConfirmDialog } from \'./ConfirmDialog\';\\nimport type { AiModelId, ParsedExpenseProposal, PeakConcentration } from \'../types/lifeos\';\\n\\ninterface ConnectionsSettingsProps {\\n  mode: \'connections\' | \'settings\';\\n}\\n\\nexport const ConnectionsSettingsModule: React.FC<ConnectionsSettingsProps> = ({ mode }) => {\\n  const {\\n    data,\\n    lang,\\n    user,\\n    isCloudMode,\\n    signInWithGoogle,\\n    signOut,\\n    updateProfile,\\n    addExpense,\\n    recordAiUsage,\\n    exportJsonBackup,\\n    importJsonBackup,\\n    resetAllData,\\n  } = useLifeOs();\\n\\n  const isAr = lang === \'ar\';\\n\\n  // Untrusted financial email parser (Gmail read-only extraction pattern)\\n  const [emailSnippet, setEmailSnippet] = useState(\'\');\\n  const [parsingEmail, setParsingEmail] = useState(false);\\n  const [emailProposal, setEmailProposal] = useState<ParsedExpenseProposal | null>(null);\\n  const [emailError, setEmailError] = useState<string | null>(null);\\n  const [emailSaved, setEmailSaved] = useState(false);\\n\\n  // Settings form state\\n  const [displayName, setDisplayName] = useState(data.profile.displayName);\\n  const [dailyWorkHours, setDailyWorkHours] = useState(String(data.profile.dailyWorkHours));\\n  const [workStart, setWorkStart] = useState(String(data.profile.workStartHour));\\n  const [workEnd, setWorkEnd] = useState(String(data.profile.workEndHour));\\n  const [targetSleep, setTargetSleep] = useState(String(data.profile.targetSleepHours));\\n  const [peak, setPeak] = useState<PeakConcentration>(data.profile.peakConcentration);\\n  const [financialGoal, setFinancialGoal] = useState(data.profile.financialGoal);\\n  const [smartwatch, setSmartwatch] = useState(data.profile.smartwatch);\\n  const [stepTarget, setStepTarget] = useState(String(data.profile.dailyStepTarget));\\n  const [liabilitiesEgp, setLiabilitiesEgp] = useState(String(piastersToEgp(data.profile.liabilitiesPiasters)));\\n  const [aiModel, setAiModel] = useState<AiModelId>(data.profile.aiDefaultModel);\\n  const [aiLimit, setAiLimit] = useState(String(data.profile.aiDailyLimit));\\n  const [settingsSaved, setSettingsSaved] = useState(false);\\n  const [importStatus, setImportStatus] = useState<string | null>(null);\\n  const [confirmReset, setConfirmReset] = useState(false);\\n\\n  const handleParseEmail = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!emailSnippet.trim()) return;\\n    setParsingEmail(true);\\n    setEmailError(null);\\n    setEmailProposal(null);\\n    setEmailSaved(false);\\n    try {\\n      const res = await fetch(\'/api/ai/parse-expense\', {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({ text: emailSnippet.trim(), sourceType: \'email\', todayIso: TODAY_ISO }),\\n      });\\n      const json = await res.json();\\n      if (!res.ok) throw new Error(json.error || \'Could not parse email receipt\');\\n      if (json.tokensUsed) recordAiUsage(\'gemini-3.1-flash-lite\', json.tokensUsed);\\n      setEmailProposal(json.proposal as ParsedExpenseProposal);\\n    } catch (err) {\\n      setEmailError(err instanceof Error ? err.message : \'Email parse error\');\\n    } finally {\\n      setParsingEmail(false);\\n    }\\n  };\\n\\n  const handleConfirmEmailExpense = async () => {\\n    if (!emailProposal || emailProposal.amountEgp <= 0) return;\\n    await addExpense({\\n      description: emailProposal.description,\\n      amountPiasters: egpToPiasters(emailProposal.amountEgp),\\n      currency: \'EGP\',\\n      category: emailProposal.category || \'other\',\\n      date: emailProposal.date || TODAY_ISO,\\n      paymentMethod: emailProposal.paymentMethod || \'card\',\\n      entrySource: \'email_import\',\\n      recurring: false,\\n      notes: emailProposal.notes,\\n    });\\n    setEmailSaved(true);\\n    setEmailProposal(null);\\n    setEmailSnippet(\'\');\\n  };\\n\\n  const handleSaveSettings = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    await updateProfile({\\n      displayName: displayName.trim() || data.profile.displayName,\\n      dailyWorkHours: Math.max(1, Math.min(18, Number(dailyWorkHours) || 8)),\\n      workStartHour: Math.max(0, Math.min(23, Number(workStart) || 9)),\\n      workEndHour: Math.max(1, Math.min(24, Number(workEnd) || 17)),\\n      targetSleepHours: Math.max(3, Math.min(12, Number(targetSleep) || 6)),\\n      peakConcentration: peak,\\n      financialGoal: financialGoal.trim(),\\n      smartwatch: smartwatch.trim(),\\n      dailyStepTarget: Math.max(1000, Number(stepTarget) || 8000),\\n      liabilitiesPiasters: egpToPiasters(Math.max(0, Number(liabilitiesEgp) || 0)),\\n      aiDefaultModel: aiModel,\\n      aiDailyLimit: Math.max(5, Math.min(500, Number(aiLimit) || 40)),\\n    });\\n    setSettingsSaved(true);\\n    setTimeout(() => setSettingsSaved(false), 1800);\\n  };\\n\\n  const handleImportFile = (ev: React.ChangeEvent<HTMLInputElement>) => {\\n    const file = ev.target.files?.[0];\\n    if (!file) return;\\n    const reader = new FileReader();\\n    reader.onload = () => {\\n      const ok = importJsonBackup(String(reader.result || \'\'));\\n      setImportStatus(\\n        ok\\n          ? isAr ? \'\330\252\331\205 \330\247\330\263\330\252\330\271\330\247\330\257\330\251 \330\247\331\204\331\206\330\263\330\256\330\251 \330\247\331\204\330\247\330\255\330\252\331\212\330\247\330\267\331\212\330\251 \330\250\331\206\330\254\330\247\330\255.\' : \'Backup restored successfully.\'\\n          : isAr ? \'\331\205\331\204\331\201 \330\247\331\204\331\206\330\263\330\256\330\251 \330\247\331\204\330\247\330\255\330\252\331\212\330\247\330\267\331\212\330\251 \330\272\331\212\330\261 \330\265\330\247\331\204\330\255.\' : \'Invalid backup file format.\',\\n      );\\n    };\\n    reader.readAsText(file);\\n  };\\n\\n  if (mode === \'connections\') {\\n    const integrations = [\\n      {\\n        name: isAr ? \'\330\255\330\263\330\247\330\250 Google \331\210 Cloud Firestore\' : \'Google Account & Cloud Firestore\',\\n        status: isCloudMode\\n          ? isAr ? `\331\205\330\252\330\265\331\204 (${user?.email})` : `Connected (${user?.email})`\\n          : isAr ? \'\330\272\331\212\330\261 \331\205\330\252\330\265\331\204 (\331\210\330\266\330\271 \331\205\330\255\331\204\331\212)\' : \'Not connected (Local Mode)\',\\n        live: isCloudMode,\\n        privacy: isAr\\n          ? \'\330\252\330\256\330\262\331\212\331\206 \331\205\330\264\331\201\331\221\330\261 \331\210\331\202\331\210\330\247\330\271\330\257 \330\243\331\205\330\247\331\206 \330\252\330\271\330\262\331\204 \330\250\331\212\330\247\331\206\330\247\330\252\331\203 \330\250\330\247\331\204\331\203\330\247\331\205\331\204 \330\250\330\247\330\263\331\205 \330\247\331\204\331\205\330\263\330\252\330\256\330\257\331\205 \330\247\331\204\330\256\330\247\330\265 \330\250\331\203 \331\201\331\202\330\267.\'\\n          : \'Owner-isolated Firestore security rules keep all personal records strictly private to your UID.\',\\n        action: isCloudMode\\n          ? { label: isAr ? \'\330\252\330\263\330\254\331\212\331\204 \330\247\331\204\330\256\330\261\331\210\330\254\' : \'Sign out\', fn: () => void signOut() }\\n          : { label: isAr ? \'\330\252\330\263\330\254\331\212\331\204 \330\247\331\204\330\257\330\256\331\210\331\204 \330\250\331\200 Google\' : \'Sign in with Google\', fn: () => void signInWithGoogle() },\\n      },\\n      {\\n        name: \'Google Calendar\',\\n        status: isAr ? \'\331\212\330\252\330\267\331\204\330\250 \330\252\331\201\330\271\331\212\331\204 OAuth (\330\252\331\202\331\210\331\212\331\205 \331\205\330\255\331\204\331\212 \331\206\330\264\330\267)\' : \'OAuth Not Enabled (Local Calendar Active)\',\\n        live: false,\\n        privacy: isAr\\n          ? \'\331\212\330\267\331\204\330\250 \330\243\331\202\331\204 \330\265\331\204\330\247\330\255\331\212\330\251 \331\205\331\205\331\203\331\206\330\251 \331\204\331\202\330\261\330\247\330\241\330\251 \331\210\330\245\331\206\330\264\330\247\330\241 \330\247\331\204\330\243\330\255\330\257\330\247\330\253 \331\210\331\212\330\244\331\203\330\257 \330\257\330\247\330\246\331\205\330\247\331\213 \331\202\330\250\331\204 \330\247\331\204\330\255\330\260\331\201.\'\\n          : \'Uses least-privilege event scopes and always confirms before deleting events.\',\\n      },\\n      {\\n        name: \'Google Drive (LIFE OS Folder)\',\\n        status: isAr ? \'\331\212\330\252\330\267\331\204\330\250 \330\252\331\201\330\271\331\212\331\204 OAuth (\330\252\330\265\330\257\331\212\330\261 JSON \331\205\330\255\331\204\331\212 \331\205\330\252\330\247\330\255)\' : \'OAuth Not Enabled (Local JSON Export Ready)\',\\n        live: false,\\n        privacy: isAr\\n          ? \'\331\212\330\265\331\204 \331\201\331\202\330\267 \331\204\331\205\330\254\331\204\330\257 LIFE OS \330\247\331\204\331\205\330\256\330\265\330\265 \331\204\331\204\331\206\330\263\330\256 \330\247\331\204\330\247\330\255\330\252\331\212\330\247\330\267\331\212 \331\210\330\247\331\204\330\252\331\202\330\247\330\261\331\212\330\261.\'\\n          : \'Uses narrowest drive.file permissions strictly for LIFE OS exports and backups.\',\\n      },\\n      {\\n        name: \'Gmail (Read-Only Financial Emails)\',\\n        status: isAr ? \'\331\212\330\252\330\267\331\204\330\250 \330\252\331\201\330\271\331\212\331\204 OAuth (\330\247\331\204\331\205\330\263\330\252\330\256\330\261\330\254 \330\247\331\204\331\212\330\257\331\210\331\212 \331\205\330\252\330\247\330\255 \330\243\330\257\331\206\330\247\331\207)\' : \'OAuth Not Enabled (Manual Parser Below)\',\\n        live: false,\\n        privacy: isAr\\n          ? \'\331\202\330\261\330\247\330\241\330\251 \331\201\331\202\330\267 (\331\204\330\247 \331\212\330\261\330\263\331\204 \331\210\331\204\330\247 \331\212\330\255\330\260\331\201 \331\210\331\204\330\247 \331\212\330\271\330\257\331\204 \330\247\331\204\330\261\330\263\330\247\330\246\331\204 \330\243\330\250\330\257\330\247\331\213) \331\210\331\212\330\271\330\247\331\205\331\204 \331\205\330\255\330\252\331\210\331\211 \330\247\331\204\330\245\331\212\331\205\331\212\331\204 \331\203\330\250\331\212\330\247\331\206\330\247\330\252 \330\272\331\212\330\261 \331\205\331\210\330\253\331\210\331\202\330\251.\'\\n          : \'Read-only in V1 \342\200\224 never sends, deletes, or modifies email; treats email text as untrusted data.\',\\n      },\\n      {\\n        name: \'Android Health Connect & Xiaomi Smart Band\',\\n        status: isAr ? \'\331\212\330\252\330\267\331\204\330\250 \330\252\330\267\330\250\331\212\331\202 Android \330\243\330\265\331\204\331\212 (\330\247\331\204\330\252\330\263\330\254\331\212\331\204 \330\247\331\204\331\212\330\257\331\210\331\212 \331\205\330\252\330\247\330\255)\' : \'Requires Native Android (Manual Logging Active)\',\\n        live: false,\\n        privacy: isAr\\n          ? \'\331\212\331\202\330\261\330\243 \331\201\331\202\330\267 \330\247\331\204\331\205\331\202\330\247\331\212\331\212\330\263 \330\247\331\204\330\265\330\255\331\212\330\251 \330\247\331\204\330\252\331\212 \330\252\331\210\330\247\331\201\331\202 \330\271\331\204\331\212\331\207\330\247 \330\265\330\261\330\247\330\255\330\251\331\213 \330\271\330\250\330\261 Health Connect.\'\\n          : \'Reads only explicitly authorized metrics through Android Health Connect.\',\\n      },\\n      {\\n        name: \'Android Usage Stats (Digital Wellbeing)\',\\n        status: isAr ? \'\331\212\330\252\330\267\331\204\330\250 \330\245\330\260\331\206 Android (\330\247\331\204\330\252\330\263\330\254\331\212\331\204 \330\247\331\204\331\212\330\257\331\210\331\212 \331\205\330\252\330\247\330\255)\' : \'Requires Android Permission (Manual Logging Active)\',\\n        live: false,\\n        privacy: isAr\\n          ? \'\331\205\330\257\330\251 \330\247\330\263\330\252\330\256\330\257\330\247\331\205 \330\247\331\204\330\252\330\267\330\250\331\212\331\202\330\247\330\252 \331\201\331\202\330\267 \342\200\224 \331\204\330\247 \331\212\331\202\330\261\330\243 \330\247\331\204\330\261\330\263\330\247\330\246\331\204 \330\243\331\210 \331\203\331\204\331\205\330\247\330\252 \330\247\331\204\331\205\330\261\331\210\330\261 \330\243\331\210 \331\204\331\210\330\255\330\251 \330\247\331\204\331\205\331\201\330\247\330\252\331\212\330\255.\'\\n          : \'App duration metadata only \342\200\224 never reads messages, passwords, or keystrokes.\',\\n      },\\n    ];\\n\\n    return (\\n      <div className=\\\"space-y-6\\\">\\n        <div>\\n          <h1 className=\\\"text-2xl font-bold text-[#F4F6F8]\\\">{isAr ? \'\330\247\331\204\330\255\330\263\330\247\330\250\330\247\330\252 \330\247\331\204\331\205\330\252\330\265\331\204\330\251 \331\210\330\247\331\204\330\256\330\265\331\210\330\265\331\212\330\251\' : \'Connected Accounts & Privacy\'}</h1>\\n          <p className=\\\"text-xs text-[#8E99A8] mt-1\\\">\\n            {isAr\\n              ? \'\330\264\331\201\330\247\331\201\331\212\330\251 \331\203\330\247\331\205\331\204\330\251 \330\255\331\210\331\204 \330\247\331\204\330\252\331\203\330\247\331\205\331\204\330\247\330\252 \330\247\331\204\331\201\330\271\330\247\331\204\330\251 \330\255\330\247\331\204\331\212\330\247\331\213 \331\210\330\247\331\204\330\252\331\203\330\247\331\205\331\204\330\247\330\252 \330\247\331\204\330\252\331\212 \330\252\330\252\330\267\331\204\330\250 \330\243\330\260\331\210\331\206\330\247\330\252 Android \330\243\331\210 OAuth.\'\\n              : \'Honest availability status and privacy disclosures for every ecosystem integration.\'}\\n          </p>\\n        </div>\\n\\n        <div className=\\\"bg-[#13171C] border border-[#232A33] rounded-2xl divide-y divide-[#1D232C]\\\">\\n          {integrations.map((item) => (\\n            <div key={item.name} className=\\\"p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4\\\">\\n              <div className=\\\"space-y-1\\\">\\n                <p className=\\\"text-sm font-semibold text-[#F4F6F8]\\\">{item.name}</p>\\n                <p className={`text-xs font-medium ${item.live ? \'text-emerald-400\' : \'text-[#8E99A8]\'}`}>{item.status}</p>\\n                <p className=\\\"text-xs text-[#758091] flex items-center gap-1.5 pt-0.5\\\">\\n                  <Shield className=\\\"w-3.5 h-3.5 shrink-0 text-emerald-400/70\\\" />\\n                  {item.privacy}\\n                </p>\\n              </div>\\n              {item.action ? (\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={item.action.fn}\\n                  className=\\\"min-h-[40px] px-4 rounded-xl bg-emerald-500 text-[#07110C] text-xs font-semibold hover:bg-emerald-400 whitespace-nowrap shrink-0 self-start sm:self-center\\\"\\n                >\\n                  {item.action.label}\\n                </button>\\n              ) : null}\\n            </div>\\n          ))}\\n        </div>\\n\\n        {/* Financial Email Receipt Extractor (Treats email as untrusted data + requires confirmation) */}\\n        <div className=\\\"bg-[#13171C] border border-[#232A33] rounded-2xl p-5 space-y-4\\\">\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <Mail className=\\\"w-4 h-4 text-emerald-400\\\" />\\n            <h2 className=\\\"text-sm font-semibold text-[#F4F6F8]\\\">\\n              {isAr ? \'\330\247\330\263\330\252\330\256\330\261\330\247\330\254 \331\205\330\271\330\247\331\205\331\204\330\251 \331\205\331\206 \330\261\330\263\330\247\331\204\330\251 \330\245\331\212\330\265\330\247\331\204 / \330\245\330\264\330\271\330\247\330\261 \330\250\331\206\331\203\331\212 (\331\202\330\261\330\247\330\241\330\251 \331\201\331\202\330\267)\' : \'Financial Email / Notification Receipt Extractor\'}\\n            </h2>\\n          </div>\\n          <p className=\\\"text-xs text-[#8E99A8]\\\">\\n            {isAr\\n              ? \'\330\247\331\204\330\265\331\202 \331\206\330\265 \330\245\330\264\330\271\330\247\330\261 \330\257\331\201\330\271 \330\243\331\210 \330\245\331\212\330\265\330\247\331\204 \330\264\330\261\330\247\330\241 \331\204\330\252\330\255\331\204\331\212\331\204\331\207 \331\203\330\250\331\212\330\247\331\206\330\247\330\252 \330\272\331\212\330\261 \331\205\331\210\330\253\331\210\331\202\330\251 \330\271\330\250\330\261 Gemini Flash-Lite\330\214 \330\253\331\205 \330\261\330\247\330\254\330\271\331\207 \331\202\330\250\331\204 \330\247\331\204\330\255\331\201\330\270.\'\\n              : \'Paste a payment confirmation or receipt email. Parsed strictly as untrusted data and requires your confirmation.\'}\\n          </p>\\n          <form onSubmit={handleParseEmail} className=\\\"space-y-3\\\">\\n            <textarea\\n              rows={3}\\n              value={emailSnippet}\\n              onChange={(e) => setEmailSnippet(e.target.value)}\\n              placeholder={\\n                isAr\\n                  ? \'\331\205\330\253\330\247\331\204: \330\252\331\205 \330\256\330\265\331\205 \331\205\330\250\331\204\330\272 420.00 EGP \331\205\331\206 \330\250\330\267\330\247\331\202\330\252\331\203 \331\204\330\257\331\211 Carrefour Egypt \330\250\330\252\330\247\330\261\331\212\330\256 2026-11-22 \330\261\331\202\331\205 \331\205\330\261\330\254\330\271\331\212 #88412\'\\n                  : \'e.g., Payment confirmation: EGP 420.00 charged at Carrefour Egypt on 2026-11-22 Ref #88412\'\\n              }\\n              className=\\\"w-full p-3.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\\\"\\n            />\\n            <button\\n              type=\\\"submit\\\"\\n              disabled={parsingEmail || !emailSnippet.trim()}\\n              className=\\\"min-h-[42px] px-5 rounded-xl bg-[#191F27] border border-[#2A3340] hover:border-emerald-500/60 text-xs font-semibold text-[#F4F6F8] inline-flex items-center gap-2\\\"\\n            >\\n              {parsingEmail ? <Loader2 className=\\\"w-3.5 h-3.5 animate-spin text-emerald-400\\\" /> : null}\\n              {isAr ? \'\330\247\330\263\330\252\330\256\330\261\330\247\330\254 \330\250\331\212\330\247\331\206\330\247\330\252 \330\247\331\204\331\205\330\271\330\247\331\205\331\204\330\251 \331\204\331\204\331\205\330\261\330\247\330\254\330\271\330\251\' : \'Extract Transaction for Review\'}\\n            </button>\\n          </form>\\n\\n          {emailError ? <p className=\\\"text-xs text-red-400\\\">{emailError}</p> : null}\\n          {emailSaved ? <p className=\\\"text-xs text-emerald-400\\\">{isAr ? \'\330\252\331\205 \330\255\331\201\330\270 \330\247\331\204\331\205\330\271\330\247\331\205\331\204\330\251 \331\201\331\212 \330\247\331\204\331\205\330\265\330\247\330\261\331\212\331\201.\' : \'Transaction saved to Expenses.\'}</p> : null}\\n\\n          {emailProposal ? (\\n            <div className=\\\"pt-4 border-t border-[#232A33] flex flex-col sm:flex-row sm:items-center justify-between gap-3\\\">\\n              <div className=\\\"text-xs space-y-1\\\">\\n                <p className=\\\"font-semibold text-[#F4F6F8]\\\">\\n                  {emailProposal.description} \342\200\224 <span className=\\\"font-mono-nums text-emerald-400\\\">{emailProposal.amountEgp} EGP</span>\\n                </p>\\n                <p className=\\\"text-[#8E99A8]\\\">\\n                  {getCategoryLabel(emailProposal.category, lang)} \302\267 {emailProposal.date} \302\267 {emailProposal.notes || \'\'}\\n                </p>\\n              </div>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => void handleConfirmEmailExpense()}\\n                className=\\\"min-h-[40px] px-4 rounded-xl bg-emerald-500 text-[#07110C] text-xs font-semibold hover:bg-emerald-400 inline-flex items-center gap-1.5 whitespace-nowrap\\\"\\n              >\\n                <Check className=\\\"w-3.5 h-3.5\\\" />\\n                {isAr ? \'\330\252\330\243\331\203\331\212\330\257 \331\210\330\245\330\266\330\247\331\201\330\251 \331\204\331\204\331\205\330\265\330\247\330\261\331\212\331\201\' : \'Confirm & Add Expense\'}\\n              </button>\\n            </div>\\n          ) : null}\\n        </div>\\n      </div>\\n    );\\n  }\\n\\n  // SETTINGS & PROFILE MODE\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      <div>\\n        <h1 className=\\\"text-2xl font-bold text-[#F4F6F8]\\\">{isAr ? \'\330\247\331\204\331\205\331\204\331\201 \330\247\331\204\330\264\330\256\330\265\331\212 \331\210\330\247\331\204\330\245\330\271\330\257\330\247\330\257\330\247\330\252\' : \'Profile & Settings\'}</h1>\\n        <p className=\\\"text-xs text-[#8E99A8] mt-1\\\">\\n          {isAr\\n            ? \'\331\212\331\205\331\203\331\206\331\203 \330\252\330\271\330\257\331\212\331\204 \331\203\331\204 \330\252\331\201\330\266\331\212\331\204\330\247\330\252\331\203 \330\247\331\204\330\264\330\256\330\265\331\212\330\251 \331\210\330\247\331\204\330\271\331\205\331\204\331\212\330\251 \331\210\330\245\330\271\330\257\330\247\330\257\330\247\330\252 \330\247\331\204\330\260\331\203\330\247\330\241 \330\247\331\204\330\247\330\265\330\267\331\206\330\247\330\271\331\212 \331\210\330\247\331\204\331\206\330\263\330\256 \330\247\331\204\330\247\330\255\330\252\331\212\330\247\330\267\331\212 \331\201\331\212 \330\243\331\212 \331\210\331\202\330\252.\'\\n            : \'Edit all personalization settings, schedule preferences, AI quotas, and data exports anytime.\'}\\n        </p>\\n      </div>\\n\\n      <form onSubmit={handleSaveSettings} className=\\\"bg-[#13171C] border border-[#232A33] rounded-2xl p-6 space-y-5\\\">\\n        <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\">\\n          <div>\\n            <label htmlFor=\\\"set-name\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\247\331\204\330\247\330\263\331\205\' : \'Display Name\'}</label>\\n            <input id=\\\"set-name\\\" type=\\\"text\\\" value={displayName} onChange={(e) => setDisplayName(e.target.value)} className=\\\"w-full min-h-[44px] px-3.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\\\" />\\n          </div>\\n          <div>\\n            <label htmlFor=\\\"set-goal\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\247\331\204\331\207\330\257\331\201 \330\247\331\204\331\205\330\247\331\204\331\212 \330\247\331\204\330\261\330\246\331\212\330\263\331\212\' : \'Main Financial Goal\'}</label>\\n            <input id=\\\"set-goal\\\" type=\\\"text\\\" value={financialGoal} onChange={(e) => setFinancialGoal(e.target.value)} className=\\\"w-full min-h-[44px] px-3.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\\\" />\\n          </div>\\n          <div>\\n            <label htmlFor=\\\"set-peak\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\331\201\330\252\330\261\330\251 \330\243\330\271\331\204\331\211 \330\252\330\261\331\203\331\212\330\262\' : \'Highest Concentration Period\'}</label>\\n            <select id=\\\"set-peak\\\" value={peak} onChange={(e) => setPeak(e.target.value as PeakConcentration)} className=\\\"w-full min-h-[44px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\\\">\\n              <option value=\\\"morning\\\">{isAr ? \'\330\247\331\204\330\265\330\250\330\247\330\255 (Morning)\' : \'Morning\'}</option>\\n              <option value=\\\"afternoon\\\">{isAr ? \'\330\250\330\271\330\257 \330\247\331\204\330\270\331\207\330\261 (Afternoon)\' : \'Afternoon\'}</option>\\n              <option value=\\\"evening\\\">{isAr ? \'\330\247\331\204\331\205\330\263\330\247\330\241 (Evening)\' : \'Evening\'}</option>\\n            </select>\\n          </div>\\n          <div>\\n            <label htmlFor=\\\"set-watch\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\247\331\204\330\263\330\247\330\271\330\251 \330\247\331\204\330\260\331\203\331\212\330\251\' : \'Smartwatch\'}</label>\\n            <input id=\\\"set-watch\\\" type=\\\"text\\\" value={smartwatch} onChange={(e) => setSmartwatch(e.target.value)} className=\\\"w-full min-h-[44px] px-3.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\\\" />\\n          </div>\\n          <div className=\\\"grid grid-cols-3 gap-2.5\\\">\\n            <div>\\n              <label htmlFor=\\\"set-wh\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\263\330\247\330\271\330\247\330\252 \330\247\331\204\330\271\331\205\331\204\' : \'Work hrs\'}</label>\\n              <input id=\\\"set-wh\\\" type=\\\"number\\\" value={dailyWorkHours} onChange={(e) => setDailyWorkHours(e.target.value)} className=\\\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\\\" />\\n            </div>\\n            <div>\\n              <label htmlFor=\\\"set-ws\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\250\330\257\330\247\331\212\330\251\' : \'Start hr\'}</label>\\n              <input id=\\\"set-ws\\\" type=\\\"number\\\" value={workStart} onChange={(e) => setWorkStart(e.target.value)} className=\\\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\\\" />\\n            </div>\\n            <div>\\n              <label htmlFor=\\\"set-we\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\331\206\331\207\330\247\331\212\330\251\' : \'End hr\'}</label>\\n              <input id=\\\"set-we\\\" type=\\\"number\\\" value={workEnd} onChange={(e) => setWorkEnd(e.target.value)} className=\\\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\\\" />\\n            </div>\\n          </div>\\n          <div className=\\\"grid grid-cols-3 gap-2.5\\\">\\n            <div>\\n              <label htmlFor=\\\"set-sleep\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\331\207\330\257\331\201 \330\247\331\204\331\206\331\210\331\205\' : \'Sleep (h)\'}</label>\\n              <input id=\\\"set-sleep\\\" type=\\\"number\\\" step=\\\"0.5\\\" value={targetSleep} onChange={(e) => setTargetSleep(e.target.value)} className=\\\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\\\" />\\n            </div>\\n            <div>\\n              <label htmlFor=\\\"set-steps\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\331\207\330\257\331\201 \330\247\331\204\330\256\330\267\331\210\330\247\330\252\' : \'Steps\'}</label>\\n              <input id=\\\"set-steps\\\" type=\\\"number\\\" value={stepTarget} onChange={(e) => setStepTarget(e.target.value)} className=\\\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\\\" />\\n            </div>\\n            <div>\\n              <label htmlFor=\\\"set-liab\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\247\331\204\330\252\330\262\330\247\331\205\330\247\330\252 (\330\254.\331\205)\' : \'Liabilities\'}</label>\\n              <input id=\\\"set-liab\\\" type=\\\"number\\\" value={liabilitiesEgp} onChange={(e) => setLiabilitiesEgp(e.target.value)} className=\\\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\\\" />\\n            </div>\\n          </div>\\n          <div>\\n            <label htmlFor=\\\"set-ai-model\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\331\206\331\205\331\210\330\260\330\254 LIFE AI \330\247\331\204\330\247\331\201\330\252\330\261\330\247\330\266\331\212\' : \'Default LIFE AI Model\'}</label>\\n            <select id=\\\"set-ai-model\\\" value={aiModel} onChange={(e) => setAiModel(e.target.value as AiModelId)} className=\\\"w-full min-h-[44px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\\\">\\n              <option value=\\\"gemini-3.1-flash-lite\\\">Gemini Flash-Lite</option>\\n              <option value=\\\"gemini-4-hydrogen\\\">Gemini Flash</option>\\n            </select>\\n          </div>\\n          <div>\\n            <label htmlFor=\\\"set-ai-limit\\\" className=\\\"block text-xs text-[#8E99A8] mb-1\\\">{isAr ? \'\330\247\331\204\330\255\330\257 \330\247\331\204\331\212\331\210\331\205\331\212 \331\204\330\267\331\204\330\250\330\247\330\252 AI\' : \'Daily AI Request Limit\'}</label>\\n            <input id=\\\"set-ai-limit\\\" type=\\\"number\\\" value={aiLimit} onChange={(e) => setAiLimit(e.target.value)} className=\\\"w-full min-h-[44px] px-3.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\\\" />\\n          </div>\\n        </div>\\n\\n        <div className=\\\"flex items-center justify-end gap-3 pt-2\\\">\\n          <button type=\\\"submit\\\" className=\\\"min-h-[44px] px-6 rounded-xl bg-emerald-500 text-[#07110C] font-semibold text-sm hover:bg-emerald-400\\\">\\n            {settingsSaved ? (isAr ? \'\330\252\331\205 \330\255\331\201\330\270 \330\247\331\204\330\245\330\271\330\257\330\247\330\257\330\247\330\252\' : \'Settings Saved\') : (isAr ? \'\330\255\331\201\330\270 \330\247\331\204\330\252\330\272\331\212\331\212\330\261\330\247\330\252\' : \'Save Changes\')}\\n          </button>\\n        </div>\\n      </form>\\n\\n      {/* Data Ownership: Export, Restore & Reset */}\\n      <div className=\\\"bg-[#13171C] border border-[#232A33] rounded-2xl p-6 space-y-4\\\">\\n        <h2 className=\\\"text-sm font-semibold text-[#F4F6F8]\\\">{isAr ? \'\331\205\331\204\331\203\331\212\330\251 \330\247\331\204\330\250\331\212\330\247\331\206\330\247\330\252 \331\210\330\247\331\204\331\206\330\263\330\256 \330\247\331\204\330\247\330\255\330\252\331\212\330\247\330\267\331\212\' : \'Data Ownership, Backup & Account Reset\'}</h2>\\n        <div className=\\\"flex flex-wrap items-center gap-3\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => {\\n              const blob = new Blob([exportJsonBackup()], { type: \'application/json\' });\\n              const url = URL.createObjectURL(blob);\\n              const a = document.createElement(\'a\');\\n              a.href = url;\\n              a.download = `life-os-backup-${TODAY_ISO}.json`;\\n              a.click();\\n              URL.revokeObjectURL(url);\\n            }}\\n            className=\\\"min-h-[42px] px-4 rounded-xl bg-[#191F27] border border-[#2A3340] text-xs font-semibold text-[#F4F6F8] hover:border-emerald-500/60\\\"\\n          >\\n            {isAr ? \'\330\252\330\265\330\257\331\212\330\261 \331\206\330\263\330\256\330\251 \330\247\330\255\330\252\331\212\330\247\330\267\331\212\330\251 JSON\' : \'Export JSON Backup\'}\\n          </button>\\n\\n          <label className=\\\"min-h-[42px] px-4 rounded-xl bg-[#191F27] border border-[#2A3340] text-xs font-semibold text-[#F4F6F8] hover:border-emerald-500/60 inline-flex items-center gap-2 cursor-pointer\\\">\\n            <Upload className=\\\"w-3.5 h-3.5\\\" />\\n            {isAr ? \'\330\247\330\263\330\252\330\271\330\247\330\257\330\251 \331\206\330\263\330\256\330\251 JSON\' : \'Restore JSON Backup\'}\\n            <input type=\\\"file\\\" accept=\\\"application/json\\\" onChange={handleImportFile} className=\\\"hidden\\\" />\\n          </label>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setConfirmReset(true)}\\n            className=\\\"min-h-[42px] px-4 rounded-xl border border-red-500/40 text-xs font-semibold text-red-400 hover:bg-red-500/10\\\"\\n          >\\n            {isAr ? \'\330\245\330\271\330\247\330\257\330\251 \330\266\330\250\330\267 \330\247\331\204\330\250\331\212\330\247\331\206\330\247\330\252 \330\247\331\204\331\205\330\255\331\204\331\212\330\251\' : \'Reset Local Data\'}\\n          </button>\\n        </div>\\n        {importStatus ? <p className=\\\"text-xs text-emerald-400\\\">{importStatus}</p> : null}\\n      </div>\\n\\n      <ConfirmDialog\\n        open={confirmReset}\\n        title={isAr ? \'\330\252\330\243\331\203\331\212\330\257 \330\245\330\271\330\247\330\257\330\251 \330\266\330\250\330\267 \330\247\331\204\330\250\331\212\330\247\331\206\330\247\330\252\' : \'Confirm Data Reset\'}\\n        description={\\n          isAr\\n            ? \'\330\263\331\212\330\252\331\205 \331\205\330\263\330\255 \330\247\331\204\330\252\330\271\330\257\331\212\331\204\330\247\330\252 \330\247\331\204\331\205\330\255\331\204\331\212\330\251 \331\210\330\245\330\271\330\247\330\257\330\251 \330\247\331\204\330\250\331\212\330\247\331\206\330\247\330\252 \331\204\331\204\331\210\330\266\330\271 \330\247\331\204\330\247\331\201\330\252\330\261\330\247\330\266\331\212 \330\247\331\204\330\243\331\210\331\204\331\212. \331\207\331\204 \330\243\331\206\330\252 \331\205\330\252\330\243\331\203\330\257\330\237\'\\n            : \'This resets local workspace edits back to the initial starter dataset. Continue?\'\\n        }\\n        confirmLabel={isAr ? \'\331\206\330\271\331\205\330\214 \330\245\330\271\330\247\330\257\330\251 \330\247\331\204\330\266\330\250\330\267\' : \'Yes, Reset\'}\\n        cancelLabel={isAr ? \'\330\245\331\204\330\272\330\247\330\241\' : \'Cancel\'}\\n        tone=\\\"danger\\\"\\n        onConfirm={async () => {\\n          await resetAllData();\\n          setConfirmReset(false);\\n        }}\\n        onCancel={() => setConfirmReset(false)}\\n      />\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create Modules 08 and 12 Connected Accounts, untrusted email financial extractor, and editable Profile & Settings module\", \"Overwrite\":true, \"TargetFile\":\"/src/components/ConnectionsSettingsModule.tsx\", \"toolAction\":\"Creating ConnectionsSettingsModule component\", \"toolSummary\":\"Create ConnectionsSettingsModule\"}"
