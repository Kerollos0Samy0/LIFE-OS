    content: "import React, { useMemo, useState } from \'react\';\nimport {\n  Activity,\n  ArrowUpLeft,\n  ArrowUpRight,\n  CalendarClock,\n  CheckCircle2,\n  Loader2,\n  Mic,\n  RefreshCw,\n  Sparkles,\n  Wallet,\n  Zap,\n} from \'lucide-react\';\nimport { useLifeOs } from \'../context/LifeOsContext\';\nimport { CURRENT_MONTH, TODAY_ISO } from \'../data/seedData\';\nimport {\n  calculateAvailableCashPiasters,\n  calculatePendingReceivablesPiasters,\n  calculateSavingsRatePercent,\n  calculateTotalExpensesPiasters,\n  calculateTotalPaidIncomePiasters,\n  formatEgp,\n} from \'../utils/finance\';\nimport { calculateEnergyEstimate } from \'../utils/energy\';\nimport { UI_TEXT } from \'../i18n/translations\';\nimport type { NavDestination } from \'../types/lifeos\';\n\ninterface DailyBriefingResponse {\n  financialObservation: string;\n  productivityObservation: string;\n  healthObservation: string;\n  importantReminder: string;\n  recommendations: string[];\n}\n\ninterface HomeDashboardProps {\n  onNavigate: (dest: NavDestination) => void;\n  onOpenVoiceExpense: () => void;\n}\n\nexport const HomeDashboard: React.FC<HomeDashboardProps> = ({ onNavigate, onOpenVoiceExpense }) => {\n  const { data, lang, recordAiUsage, isCloudMode, signInWithGoogle, seedCloudFromSample } = useLifeOs();\n  const isAr = lang === \'ar\';\n\n  const [briefing, setBriefing] = useState<DailyBriefingResponse | null>(null);\n  const [briefingLoading, setBriefingLoading] = useState(false);\n  const [briefingError, setBriefingError] = useState<string | null>(null);\n\n  const metrics = useMemo(() => {\n    const availableCash = calculateAvailableCashPiasters(data.incomeRecords, data.expenseRecords);\n    const monthlyPaidIncome = calculateTotalPaidIncomePiasters(data.incomeRecords, CURRENT_MONTH);\n    const monthlyExpenses = calculateTotalExpensesPiasters(data.expenseRecords, CURRENT_MONTH);\n    const pendingReceivables = calculatePendingReceivablesPiasters(data.incomeRecords);\n    const savingsRate = calculateSavingsRatePercent(monthlyPaidIncome, monthlyExpenses);\n\n    const totalSavingsCurrent = data.savingsGoals.reduce((s, g) => s + g.currentPiasters, 0);\n    const totalSavingsTarget = data.savingsGoals.reduce((s, g) => s + g.targetPiasters, 0);\n    const savingsProgressPct = totalSavingsTarget > 0 ? Math.round((totalSavingsCurrent / totalSavingsTarget) * 100) : 0;\n\n    const todayTasks = data.tasks.filter((t) => t.deadline === TODAY_ISO);\n    const completedToday = todayTasks.filter((t) => t.status === \'completed\').length;\n    const remainingToday = todayTasks.length - completedToday;\n    const todayEvents = data.calendarEvents.filter((e) => e.date === TODAY_ISO);\n    const focusMinutesToday = data.focusSessions\n      .filter((f) => f.date === TODAY_ISO)\n      .reduce((s, f) => s + f.durationMinutes, 0);\n\n    const latestHealth = [...data.healthLogs].sort((a, b) => b.date.localeCompare(a.date))[0] || null;\n    const latestUsage = [...data.appUsageLogs].sort((a, b) => b.date.localeCompare(a.date))[0] || null;\n\n    const energy = calculateEnergyEstimate({\n      healthLogs: data.healthLogs,\n      appUsageLogs: data.appUsageLogs,\n      energyLogs: data.energyLogs,\n      dailyStepTarget: data.profile.dailyStepTarget,\n      targetSleepHours: data.profile.targetSleepHours,\n      peakConcentration: data.profile.peakConcentration,\n    });\n\n    const overdueInvoices = data.incomeRecords.filter((i) => i.status === \'overdue\');\n\n    return {\n      availableCash,\n      monthlyPaidIncome,\n      monthlyExpenses,\n      pendingReceivables,\n      savingsRate,\n      savingsProgressPct,\n      totalSavingsCurrent,\n      todayTasks,\n      completedToday,\n      remainingToday,\n      todayEvents,\n      focusMinutesToday,\n      latestHealth,\n      latestUsage,\n      energy,\n      overdueInvoices,\n    };\n  }, [data]);\n\n  const handleGenerateBriefing = async () => {\n    setBriefingLoading(true);\n    setBriefingError(null);\n    try {\n      const payload = {\n        date: TODAY_ISO,\n        availableCashEgp: metrics.availableCash / 100,\n        monthlyPaidIncomeEgp: metrics.monthlyPaidIncome / 100,\n        monthlyExpensesEgp: metrics.monthlyExpenses / 100,\n        pendingFreelanceReceivablesEgp: metrics.pendingReceivables / 100,\n        overdueInvoicesCount: metrics.overdueInvoices.length,\n        savingsProgressPercent: metrics.savingsProgressPct,\n        tasksCompletedToday: metrics.completedToday,\n        tasksRemainingToday: metrics.remainingToday,\n        focusMinutesToday: metrics.focusMinutesToday,\n        sleepHours: metrics.latestHealth?.sleepHours ?? \'unavailable\',\n        steps: metrics.latestHealth?.steps ?? \'unavailable\',\n        restingHeartRate: metrics.latestHealth?.restingHeartRate ?? \'unavailable\',\n        nighttimeScreenMinutes: metrics.latestUsage?.nighttimeMinutes ?? \'unavailable\',\n        estimatedEnergyScore: metrics.energy.estimatedScore ?? \'unavailable\',\n        peakConcentration: data.profile.peakConcentration,\n      };\n\n      const res = await fetch(\'/api/ai/briefing\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ language: lang, summary: payload }),\n      });\n      const json = await res.json();\n      if (!res.ok) {\n        throw new Error(json.error || \'Could not generate daily briefing\');\n      }\n      if (json.tokensUsed) {\n        recordAiUsage(\'gemini-3.1-flash-lite\', json.tokensUsed);\n      }\n      setBriefing(json.briefing as DailyBriefingResponse);\n    } catch (err) {\n      setBriefingError(err instanceof Error ? err.message : \'Failed to load AI briefing\');\n    } finally {\n      setBriefingLoading(false);\n    }\n  };\n\n  const ArrowIcon = isAr ? ArrowUpLeft : ArrowUpRight;\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Greeting & Quick Actions Row */}\n      <section className=\"flex flex-col md:flex-row md:items-end justify-between gap-4\">\n        <div>\n          <p className=\"text-xs text-[#8E99A8] tabular-nums\">\n            {TODAY_ISO} \302\267 {isCloudMode ? UI_TEXT[lang].auth.cloudSynced : UI_TEXT[lang].auth.localSampleMode}\n          </p>\n          <h1 className=\"text-2xl sm:text-3xl font-bold text-[#F4F6F8] mt-1\">\n            {isAr ? `\330\243\331\207\331\204\330\247\331\213 \331\212\330\247 ${data.profile.displayName}` : `Welcome back, ${data.profile.displayName}`}\n          </h1>\n          <p className=\"text-sm text-[#8E99A8] mt-1\">\n            {isAr\n              ? \'\331\205\331\204\330\256\330\265 \330\255\331\212 \331\204\330\255\330\247\331\204\330\252\331\203 \330\247\331\204\331\205\330\247\331\204\331\212\330\251\330\214 \331\210\331\202\330\252\331\203\330\214 \330\265\330\255\330\252\331\203\330\214 \331\210\331\205\330\244\330\264\330\261 \330\267\330\247\331\202\330\252\331\203 \330\247\331\204\331\212\331\210\331\205.\'\n              : \'Live snapshot of your finances, time, health, and daily energy.\'}\n          </p>\n        </div>\n\n        <div className=\"flex flex-wrap items-center gap-2.5\">\n          <button\n            type=\"button\"\n            onClick={onOpenVoiceExpense}\n            className=\"min-h-[44px] px-4 py-2 rounded-xl bg-emerald-500 text-[#07110C] font-semibold text-sm hover:bg-emerald-400 transition-colors flex items-center gap-2 whitespace-nowrap\"\n          >\n            <Mic className=\"w-4 h-4\" />\n            {isAr ? \'\330\263\330\254\331\221\331\204 \331\205\330\265\330\261\331\210\331\201 \330\250\330\247\331\204\330\265\331\210\330\252\' : \'Voice Expense\'}\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => onNavigate(\'ai\')}\n            className=\"min-h-[44px] px-4 py-2 rounded-xl bg-[#13171C] border border-[#232A33] text-sm font-medium text-[#E2E8F0] hover:border-emerald-500/50 transition-colors flex items-center gap-2 whitespace-nowrap\"\n          >\n            <Sparkles className=\"w-4 h-4 text-emerald-400\" />\n            {isAr ? \'\330\247\330\263\330\243\331\204 LIFE AI\' : \'Ask LIFE AI\'}\n          </button>\n        </div>\n      </section>\n\n      {/* Honest Cloud Sync / Empty Cloud Notice */}\n      {!isCloudMode ? (\n        <div className=\"bg-[#13171C] border border-[#232A33] rounded-2xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <p className=\"text-xs sm:text-sm text-[#A9B3C1] leading-relaxed\">\n            {UI_TEXT[lang].auth.syncNotice}\n          </p>\n          <button\n            type=\"button\"\n            onClick={() => void signInWithGoogle()}\n            className=\"min-h-[40px] px-4 py-2 rounded-xl border border-emerald-500/40 text-emerald-300 hover:bg-emerald-500/10 text-xs font-semibold transition-colors whitespace-nowrap shrink-0\"\n          >\n            {UI_TEXT[lang].auth.signInGoogle}\n          </button>\n        </div>\n      ) : data.expenseRecords.length === 0 && data.incomeRecords.length === 0 ? (\n        <div className=\"bg-[#13171C] border border-[#232A33] rounded-2xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <p className=\"text-xs sm:text-sm text-[#A9B3C1]\">\n            {isAr\n              ? \'\330\255\330\263\330\247\330\250\331\203 \330\247\331\204\330\263\330\255\330\247\330\250\331\212 \330\254\330\247\331\207\330\262 \331\210\331\201\330\247\330\261\330\272 \330\255\330\247\331\204\331\212\330\247\331\213. \331\212\331\205\331\203\331\206\331\203 \330\247\331\204\330\250\330\257\330\241 \330\250\330\245\330\266\330\247\331\201\330\251 \330\263\330\254\331\204\330\247\330\252\331\203 \330\243\331\210 \330\247\330\263\330\252\331\212\330\261\330\247\330\257 \330\250\331\212\330\247\331\206\330\247\330\252 \330\250\330\257\330\247\331\212\330\251 \331\206\331\205\331\210\330\260\330\254\331\212\330\251 \331\204\330\252\330\254\330\261\330\250\330\251 \330\247\331\204\331\205\331\206\330\265\330\251.\'\n              : \'Your cloud workspace is empty. Start adding records or load starter sample data to explore.\'}\n          </p>\n          <button\n            type=\"button\"\n            onClick={() => void seedCloudFromSample()}\n            className=\"min-h-[40px] px-4 py-2 rounded-xl bg-emerald-500 text-[#07110C] text-xs font-semibold hover:bg-emerald-400 transition-colors whitespace-nowrap shrink-0\"\n          >\n            {isAr ? \'\330\247\330\263\330\252\331\212\330\261\330\247\330\257 \330\250\331\212\330\247\331\206\330\247\330\252 \330\247\331\204\330\250\330\257\330\247\331\212\330\251\' : \'Load Starter Data\'}\n          </button>\n        </div>\n      ) : null}\n\n      {/* Focal Anchor: Financial Summary Hero Grid */}\n      <section className=\"grid grid-cols-1 lg:grid-cols-12 gap-5\">\n        <div className=\"lg:col-span-7 bg-[#13171C] border border-[#232A33] rounded-2xl p-6 flex flex-col justify-between gap-6\">\n          <div className=\"flex items-start justify-between gap-4\">\n            <div>\n              <p className=\"text-xs text-[#8E99A8] flex items-center gap-1.5\">\n                <Wallet className=\"w-3.5 h-3.5 text-emerald-400\" />\n                {isAr ? \'\330\247\331\204\330\261\330\265\331\212\330\257 \330\247\331\204\331\206\331\202\330\257\331\212 \330\247\331\204\331\205\330\252\330\247\330\255 \331\201\330\271\331\204\331\212\330\247\331\213\' : \'Available Cash Balance\'}\n              </p>\n              <p className=\"text-3xl sm:text-4xl font-bold font-mono-nums text-[#F4F6F8] mt-2\" data-testid=\"home-available-cash\">\n                {formatEgp(metrics.availableCash, lang)}\n              </p>\n              <p className=\"text-xs text-[#8E99A8] mt-1.5\">\n                {isAr\n                  ? \'\331\204\330\247 \331\212\330\264\331\205\331\204 \331\201\331\210\330\247\330\252\331\212\330\261 \330\247\331\204\331\201\330\261\331\212\331\204\330\247\331\206\330\263 \330\272\331\212\330\261 \330\247\331\204\331\205\330\255\330\265\331\221\331\204\330\251\'\n                  : \'Strictly excludes unpaid freelance invoices\'}\n                {\' \302\267 \'}\n                <span className=\"text-amber-400 font-mono-nums\">\n                  {isAr ? \'\331\205\330\263\330\252\330\255\331\202\330\247\330\252 \331\205\330\271\331\204\331\202\330\251:\' : \'Pending:\'} {formatEgp(metrics.pendingReceivables, lang)}\n                </span>\n              </p>\n            </div>\n            <button\n              type=\"button\"\n              onClick={() => onNavigate(\'finance\')}\n              className=\"min-h-[38px] px-3 rounded-xl text-xs font-medium text-emerald-400 hover:bg-[#1B222A] transition-colors flex items-center gap-1 whitespace-nowrap shrink-0\"\n            >\n              {isAr ? \'\330\247\331\204\330\252\331\201\330\247\330\265\331\212\331\204\' : \'Details\'}\n              <ArrowIcon className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n\n          <div className=\"grid grid-cols-3 gap-3 sm:gap-4 pt-5 border-t border-[#232A33]\">\n            <div>\n              <p className=\"text-[11px] sm:text-xs text-[#8E99A8]\">{isAr ? \'\330\257\330\256\331\204 \330\247\331\204\330\264\331\207\330\261 \330\247\331\204\331\205\330\255\330\265\331\221\331\204\' : \'Monthly Paid Income\'}</p>\n              <p className=\"text-sm sm:text-lg font-semibold font-mono-nums text-emerald-400 mt-1 whitespace-nowrap\">\n                {formatEgp(metrics.monthlyPaidIncome, lang)}\n              </p>\n            </div>\n            <div>\n              <p className=\"text-[11px] sm:text-xs text-[#8E99A8]\">{isAr ? \'\331\205\330\265\330\247\330\261\331\212\331\201 \330\247\331\204\330\264\331\207\330\261\' : \'Monthly Expenses\'}</p>\n              <p className=\"text-sm sm:text-lg font-semibold font-mono-nums text-[#F4F6F8] mt-1 whitespace-nowrap\" data-testid=\"home-monthly-expenses\">\n                {formatEgp(metrics.monthlyExpenses, lang)}\n              </p>\n            </div>\n            <div>\n              <p className=\"text-[11px] sm:text-xs text-[#8E99A8]\">{isAr ? \'\330\252\331\202\330\257\331\205 \330\247\331\204\330\247\330\257\330\256\330\247\330\261\' : \'Savings Progress\'}</p>\n              <p className=\"text-sm sm:text-lg font-semibold font-mono-nums text-[#F4F6F8] mt-1 whitespace-nowrap\">\n                {metrics.savingsProgressPct}%\n              </p>\n            </div>\n          </div>\n        </div>\n\n        {/* Energy & AI Daily Briefing Card */}\n        <div className=\"lg:col-span-5 bg-[#13171C] border border-[#232A33] rounded-2xl p-6 flex flex-col justify-between gap-4\">\n          <div className=\"flex items-start justify-between gap-3\">\n            <div>\n              <p className=\"text-xs text-[#8E99A8] flex items-center gap-1.5\">\n                <Zap className=\"w-3.5 h-3.5 text-emerald-400\" />\n                {isAr ? \'\331\205\330\244\330\264\330\261 \330\247\331\204\330\267\330\247\331\202\330\251 \330\247\331\204\330\252\331\202\330\257\331\212\330\261\331\212\' : \'Estimated Energy Indicator\'}\n              </p>\n              <div className=\"flex items-baseline gap-2.5 mt-2\">\n                <span className=\"text-3xl font-bold font-mono-nums text-[#F4F6F8]\">\n                  {metrics.energy.estimatedScore !== null ? `${metrics.energy.estimatedScore}%` : UI_TEXT[lang].common.unavailable}\n                </span>\n                <span className=\"text-xs text-[#8E99A8]\">\n                  {metrics.energy.level === \'high\'\n                    ? isAr ? \'\330\267\330\247\331\202\330\251 \331\205\330\261\330\252\331\201\330\271\330\251\' : \'High readiness\'\n                    : metrics.energy.level === \'moderate\'\n                      ? isAr ? \'\330\267\330\247\331\202\330\251 \331\205\330\252\331\210\330\263\330\267\330\251\' : \'Moderate\'\n                      : metrics.energy.level === \'low\'\n                        ? isAr ? \'\331\212\331\217\331\206\330\265\330\255 \330\250\330\247\331\204\330\261\330\247\330\255\330\251\' : \'Prioritize recovery\'\n                        : \'\'}\n                </span>\n              </div>\n            </div>\n            <span className=\"text-xs text-[#8E99A8] tabular-nums whitespace-nowrap shrink-0\">\n              {metrics.energy.baselineDaysLogged}/{metrics.energy.baselineTargetDays} {isAr ? \'\331\212\331\210\331\205 \330\243\330\263\330\247\330\263\' : \'baseline d\'}\n            </span>\n          </div>\n\n          <div className=\"space-y-2 text-xs text-[#A9B3C1] pt-3 border-t border-[#232A33]\">\n            <p className=\"text-[#F4F6F8] font-medium\">\n              {isAr ? \'\330\252\331\210\330\265\331\212\330\251 \330\247\331\204\330\252\330\261\331\203\331\212\330\262:\' : \'Focus recommendation:\'}\n            </p>\n            <p className=\"leading-relaxed\">\n              {isAr ? metrics.energy.recommendationsAr[0] : metrics.energy.recommendationsEn[0]}\n            </p>\n            <p className=\"text-[11px] text-[#758091]\">{UI_TEXT[lang].common.nonMedicalNotice}</p>\n          </div>\n        </div>\n      </section>\n\n      {/* Productivity & Health Summaries */}\n      <section className=\"grid grid-cols-1 md:grid-cols-2 gap-5\">\n        {/* Productivity Summary */}\n        <div className=\"bg-[#13171C] border border-[#232A33] rounded-2xl p-6 space-y-4\">\n          <div className=\"flex items-center justify-between\">\n            <h2 className=\"text-base font-semibold text-[#F4F6F8] flex items-center gap-2\">\n              <CalendarClock className=\"w-4 h-4 text-emerald-400\" />\n              {isAr ? \'\331\205\331\204\330\256\330\265 \330\247\331\204\330\245\331\206\330\252\330\247\330\254\331\212\330\251 \331\210\330\247\331\204\331\210\331\202\330\252\' : \'Productivity & Time\'}\n            </h2>\n            <button\n              type=\"button\"\n              onClick={() => onNavigate(\'time\')}\n              className=\"text-xs text-emerald-400 hover:underline flex items-center gap-1\"\n            >\n              {isAr ? \'\330\245\330\257\330\247\330\261\330\251 \330\247\331\204\331\212\331\210\331\205\' : \'Open Time\'}\n              <ArrowIcon className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n\n          <div className=\"grid grid-cols-3 gap-3 text-sm\">\n            <div>\n              <p className=\"text-xs text-[#8E99A8]\">{isAr ? \'\330\247\331\204\331\205\331\203\330\252\331\205\331\204\330\251 \330\247\331\204\331\212\331\210\331\205\' : \'Completed\'}</p>\n              <p className=\"text-xl font-bold font-mono-nums text-emerald-400 mt-1\">\n                {metrics.completedToday}/{metrics.todayTasks.length}\n              </p>\n            </div>\n            <div>\n              <p className=\"text-xs text-[#8E99A8]\">{isAr ? \'\330\247\331\204\331\205\331\210\330\247\330\271\331\212\330\257 \330\247\331\204\331\212\331\210\331\205\' : \'Events\'}</p>\n              <p className=\"text-xl font-bold font-mono-nums text-[#F4F6F8] mt-1\">{metrics.todayEvents.length}</p>\n            </div>\n            <div>\n              <p className=\"text-xs text-[#8E99A8]\">{isAr ? \'\331\210\331\202\330\252 \330\247\331\204\330\252\330\261\331\203\331\212\330\262\' : \'Focus Time\'}</p>\n              <p className=\"text-xl font-bold font-mono-nums text-[#F4F6F8] mt-1\">\n                {metrics.focusMinutesToday} {isAr ? \'\330\257\' : \'m\'}\n              </p>\n            </div>\n          </div>\n\n          <div className=\"pt-3 border-t border-[#232A33] space-y-2\">\n            {metrics.todayTasks.slice(0, 3).map((t) => (\n              <div key={t.id} className=\"flex items-center justify-between text-xs py-1\">\n                <span className={t.status === \'completed\' ? \'line-through text-[#6C7787]\' : \'text-[#E2E8F0]\'}>\n                  {t.title}\n                </span>\n                <span className=\"font-mono-nums text-[#8E99A8] shrink-0 ms-3\">\n                  {t.scheduledStart || \'\342\200\224\'} \302\267 {t.estimatedMinutes}{isAr ? \'\330\257\' : \'m\'}\n                </span>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* Health Summary */}\n        <div className=\"bg-[#13171C] border border-[#232A33] rounded-2xl p-6 space-y-4\">\n          <div className=\"flex items-center justify-between\">\n            <h2 className=\"text-base font-semibold text-[#F4F6F8] flex items-center gap-2\">\n              <Activity className=\"w-4 h-4 text-emerald-400\" />\n              {isAr ? \'\331\205\331\204\330\256\330\265 \330\247\331\204\330\265\330\255\330\251 \331\210\330\247\331\204\331\206\330\264\330\247\330\267\' : \'Health & Activity\'}\n            </h2>\n            <button\n              type=\"button\"\n              onClick={() => onNavigate(\'health\')}\n              className=\"text-xs text-emerald-400 hover:underline flex items-center gap-1\"\n            >\n              {isAr ? \'\330\263\330\254\331\204 \330\247\331\204\330\265\330\255\330\251\' : \'Open Health\'}\n              <ArrowIcon className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n\n          <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3\">\n            <div>\n              <p className=\"text-xs text-[#8E99A8]\">{isAr ? \'\330\247\331\204\331\206\331\210\331\205\' : \'Sleep\'}</p>\n              <p className=\"text-lg font-bold font-mono-nums text-[#F4F6F8] mt-1\">\n                {metrics.latestHealth?.sleepHours != null\n                  ? `${metrics.latestHealth.sleepHours} ${isAr ? \'\330\263\' : \'h\'}`\n                  : UI_TEXT[lang].common.unavailable}\n              </p>\n            </div>\n            <div>\n              <p className=\"text-xs text-[#8E99A8]\">{isAr ? \'\330\247\331\204\330\256\330\267\331\210\330\247\330\252\' : \'Steps\'}</p>\n              <p className=\"text-lg font-bold font-mono-nums text-[#F4F6F8] mt-1\">\n                {metrics.latestHealth?.steps != null\n                  ? metrics.latestHealth.steps.toLocaleString(\'en-US\')\n                  : UI_TEXT[lang].common.unavailable}\n              </p>\n            </div>\n            <div>\n              <p className=\"text-xs text-[#8E99A8]\">{isAr ? \'\330\263\330\271\330\261\330\247\330\252 \331\206\330\264\330\267\330\251\' : \'Active kcal\'}</p>\n              <p className=\"text-lg font-bold font-mono-nums text-[#F4F6F8] mt-1\">\n                {metrics.latestHealth?.activeCalories != null\n                  ? `${metrics.latestHealth.activeCalories}`\n                  : UI_TEXT[lang].common.unavailable}\n              </p>\n            </div>\n            <div>\n              <p className=\"text-xs text-[#8E99A8]\">{isAr ? \'\331\206\330\250\330\266 \330\247\331\204\330\261\330\247\330\255\330\251\' : \'Resting HR\'}</p>\n              <p className=\"text-lg font-bold font-mono-nums text-[#F4F6F8] mt-1\">\n                {metrics.latestHealth?.restingHeartRate != null\n                  ? `${metrics.latestHealth.restingHeartRate} bpm`\n                  : UI_TEXT[lang].common.unavailable}\n              </p>\n            </div>\n          </div>\n\n          <div className=\"pt-3 border-t border-[#232A33] flex items-center justify-between text-xs text-[#8E99A8]\">\n            <span>\n              {isAr ? \'\330\247\331\204\331\205\330\265\330\257\330\261:\' : \'Source:\'}{\' \'}\n              {metrics.latestHealth?.source === \'manual\'\n                ? isAr ? \'\330\245\330\257\330\256\330\247\331\204 \331\212\330\257\331\210\331\212\' : \'Manual log\'\n                : metrics.latestHealth?.source || UI_TEXT[lang].common.unavailable}\n            </span>\n            <span className=\"font-mono-nums\">\n              {isAr ? \'\331\207\330\257\331\201 \330\247\331\204\330\256\330\267\331\210\330\247\330\252:\' : \'Goal:\'}{\' \'}\n              {metrics.latestHealth?.steps\n                ? `${Math.min(100, Math.round((metrics.latestHealth.steps / data.profile.dailyStepTarget) * 100))}%`\n                : \'0%\'}\n            </span>\n          </div>\n        </div>\n      </section>\n\n      {/* AI Daily Briefing Section */}\n      <section className=\"bg-[#13171C] border border-[#232A33] rounded-2xl p-6 space-y-4\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div>\n            <h2 className=\"text-base font-semibold text-[#F4F6F8] flex items-center gap-2\">\n              <Sparkles className=\"w-4 h-4 text-emerald-400\" />\n              {isAr ? \'\330\247\331\204\331\205\331\204\330\256\330\265 \330\247\331\204\331\212\331\210\331\205\331\212 \330\247\331\204\330\260\331\203\331\212 (AI Daily Briefing)\' : \'AI Daily Briefing\'}\n            </h2>\n            <p className=\"text-xs text-[#8E99A8] mt-0.5\">\n              {isAr\n                ? \'\330\252\330\255\331\204\331\212\331\204 \331\205\330\256\330\252\330\265\330\261 \331\205\330\250\331\206\331\212 \331\201\331\202\330\267 \330\271\331\204\331\211 \330\243\330\261\331\202\330\247\331\205\331\203 \330\247\331\204\331\201\330\271\331\204\331\212\330\251 \330\271\330\250\330\261 Gemini Flash-Lite \342\200\224 \330\250\330\257\331\210\331\206 \330\250\331\212\330\247\331\206\330\247\330\252 \331\205\330\256\330\252\331\204\331\202\330\251.\'\n                : \'Concise briefing grounded strictly in your recorded metrics via Gemini Flash-Lite.\'}\n            </p>\n          </div>\n          <button\n            type=\"button\"\n            onClick={handleGenerateBriefing}\n            disabled={briefingLoading}\n            className=\"min-h-[40px] px-4 py-2 rounded-xl bg-[#191F27] border border-[#2A3340] hover:border-emerald-500/60 text-xs font-semibold text-[#F4F6F8] transition-colors flex items-center gap-2 whitespace-nowrap self-start sm:self-auto\"\n          >\n            {briefingLoading ? <Loader2 className=\"w-3.5 h-3.5 animate-spin text-emerald-400\" /> : <RefreshCw className=\"w-3.5 h-3.5 text-emerald-400\" />}\n            {briefing\n              ? isAr ? \'\330\252\330\255\330\257\331\212\330\253 \330\247\331\204\331\205\331\204\330\256\330\265\' : \'Refresh Briefing\'\n              : isAr ? \'\330\252\331\210\331\204\331\212\330\257 \331\205\331\204\330\256\330\265 \330\247\331\204\331\212\331\210\331\205\' : \'Generate Today\342\200\231s Briefing\'}\n          </button>\n        </div>\n\n        {briefingError ? (\n          <div className=\"p-3.5 rounded-xl bg-red-500/10 border border-red-500/30 text-xs text-red-300\">\n            {briefingError}\n          </div>\n        ) : null}\n\n        {briefing ? (\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4 pt-2 border-t border-[#232A33] text-sm\">\n            <div className=\"space-y-1\">\n              <p className=\"text-xs font-semibold text-emerald-400\">{isAr ? \'\331\205\331\204\330\247\330\255\330\270\330\251 \331\205\330\247\331\204\331\212\330\251\' : \'Financial Observation\'}</p>\n              <p className=\"text-[#D2DAE5] leading-relaxed\">{briefing.financialObservation}</p>\n            </div>\n            <div className=\"space-y-1\">\n              <p className=\"text-xs font-semibold text-emerald-400\">{isAr ? \'\331\205\331\204\330\247\330\255\330\270\330\251 \330\247\331\204\330\245\331\206\330\252\330\247\330\254\331\212\330\251\' : \'Productivity Observation\'}</p>\n              <p className=\"text-[#D2DAE5] leading-relaxed\">{briefing.productivityObservation}</p>\n            </div>\n            <div className=\"space-y-1\">\n              <p className=\"text-xs font-semibold text-emerald-400\">{isAr ? \'\331\205\331\204\330\247\330\255\330\270\330\251 \330\247\331\204\330\265\330\255\330\251 \331\210\330\247\331\204\330\267\330\247\331\202\330\251\' : \'Health Observation\'}</p>\n              <p className=\"text-[#D2DAE5] leading-relaxed\">{briefing.healthObservation}</p>\n            </div>\n            <div className=\"space-y-1\">\n              <p className=\"text-xs font-semibold text-amber-400\">{isAr ? \'\330\252\330\260\331\203\331\212\330\261 \331\205\331\207\331\205\' : \'Important Reminder\'}</p>\n              <p className=\"text-[#D2DAE5] leading-relaxed\">{briefing.importantReminder}</p>\n            </div>\n            {briefing.recommendations?.length > 0 ? (\n              <div className=\"md:col-span-2 pt-3 border-t border-[#232A33] space-y-2\">\n                <p className=\"text-xs font-semibold text-[#F4F6F8]\">{isAr ? \'\330\252\331\210\330\265\331\212\330\247\330\252 \330\271\331\205\331\204\331\212\330\251 \331\204\331\204\331\212\331\210\331\205\' : \'Practical Recommendations\'}</p>\n                <ul className=\"space-y-1.5\">\n                  {briefing.recommendations.map((rec, idx) => (\n                    <li key={idx} className=\"flex items-start gap-2 text-xs sm:text-sm text-[#C8D0DC]\">\n                      <CheckCircle2 className=\"w-4 h-4 text-emerald-400 shrink-0 mt-0.5\" />\n                      <span>{rec}</span>\n                    </li>\n                  ))}\n                </ul>\n              </div>\n            ) : null}\n          </div>\n        ) : (\n          <div className=\"pt-3 border-t border-[#232A33] grid grid-cols-1 md:grid-cols-3 gap-4 text-xs text-[#A9B3C1]\">\n            <div>\n              <p className=\"font-semibold text-[#F4F6F8] mb-1\">{isAr ? \'\330\247\331\204\331\205\330\247\331\204\331\212\330\247\330\252\' : \'Finance\'}</p>\n              <p>\n                {isAr\n                  ? `\331\205\330\271\330\257\331\204 \330\247\331\204\330\247\330\257\330\256\330\247\330\261 \330\247\331\204\330\264\331\207\330\261\331\212 \330\247\331\204\330\255\330\247\331\204\331\212 ${metrics.savingsRate}% \331\205\330\271 ${metrics.overdueInvoices.length} \331\201\330\247\330\252\331\210\330\261\330\251 \331\201\330\261\331\212\331\204\330\247\331\206\330\263 \331\205\330\252\330\243\330\256\330\261\330\251 \330\252\330\255\330\252\330\247\330\254 \331\205\330\252\330\247\330\250\330\271\330\251.`\n                  : `Current monthly savings rate is ${metrics.savingsRate}% with ${metrics.overdueInvoices.length} overdue freelance invoice(s).`}\n              </p>\n            </div>\n            <div>\n              <p className=\"font-semibold text-[#F4F6F8] mb-1\">{isAr ? \'\330\247\331\204\330\245\331\206\330\252\330\247\330\254\331\212\330\251\' : \'Productivity\'}</p>\n              <p>\n                {isAr\n                  ? `\331\205\330\252\330\250\331\202\331\212 ${metrics.remainingToday} \331\205\331\207\330\247\331\205 \330\247\331\204\331\212\331\210\331\205 \342\200\224 \330\247\330\263\330\252\330\272\331\204 \330\247\331\204\331\201\330\252\330\261\330\251 \330\247\331\204\330\265\330\250\330\247\330\255\331\212\330\251 \331\204\331\204\331\205\331\207\330\247\331\205 \330\247\331\204\330\271\331\205\331\212\331\202\330\251.`\n                  : `${metrics.remainingToday} tasks remaining today \342\200\224 prioritize deep work during your morning peak.`}\n              </p>\n            </div>\n            <div>\n              <p className=\"font-semibold text-[#F4F6F8] mb-1\">{isAr ? \'\330\247\331\204\330\265\330\255\330\251\' : \'Health\'}</p>\n              <p>\n                {isAr\n                  ? `\330\247\330\266\330\272\330\267 \"\330\252\331\210\331\204\331\212\330\257 \331\205\331\204\330\256\330\265 \330\247\331\204\331\212\331\210\331\205\" \331\204\331\204\330\255\330\265\331\210\331\204 \330\271\331\204\331\211 \331\202\330\261\330\247\330\241\330\251 \331\205\330\256\330\265\330\265\330\251 \331\205\331\206 Gemini \330\250\331\206\330\247\330\241\331\213 \330\271\331\204\331\211 \331\203\331\204 \330\250\331\212\330\247\331\206\330\247\330\252\331\203.`\n                  : `Click \"Generate Today\'s Briefing\" for a live Gemini analysis grounded in your data.`}\n              </p>\n            </div>\n          </div>\n        )}\n      </section>\n    </div>\n  );\n};\n"
    num_lines: 529
    num_bytes: 25927
    line_range_bytes: 25927
  }
}
