            lines {
              text: "                {isAr"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  ? `\330\247\330\266\330\272\330\267 \"\330\252\331\210\331\204\331\212\330\257 \331\205\331\204\330\256\330\265 \330\247\331\204\331\212\331\210\331\205\" \331\204\331\204\330\255\330\265\331\210\331\204 \330\271\331\204\331\211 \331\202\330\261\330\247\330\241\330\251 \331\205\330\256\330\265\330\265\330\251 \331\205\331\206 Gemini \330\250\331\206\330\247\330\241\331\213 \330\271\331\204\331\211 \331\203\331\204 \330\250\331\212\330\247\331\206\330\247\330\252\331\203.`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
