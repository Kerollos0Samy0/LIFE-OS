        instruction: "{\n  \"entities\": {\n    \"UserProfile\": {\n      \"title\": \"UserProfile\",\n      \"description\": \"User profile, work schedule, personalization settings, and currency preferences.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"userId\": { \"type\": \"string\", \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"displayName\": { \"type\": \"string\", \"maxLength\": 120 },\n        \"email\": { \"type\": \"string\", \"format\": \"email\", \"maxLength\": 200 },\n        \"language\": { \"type\": \"string\", \"enum\": [\"ar\", \"en\"] },\n        \"currency\": { \"type\": \"string\", \"maxLength\": 10 },\n        \"dailyWorkHours\": { \"type\": \"number\" },\n        \"workStartHour\": { \"type\": \"number\" },\n        \"workEndHour\": { \"type\": \"number\" },\n        \"targetSleepHours\": { \"type\": \"number\" },\n        \"peakConcentration\": { \"type\": \"string\", \"enum\": [\"morning\", \"afternoon\", \"evening\"] },\n        \"financialGoal\": { \"type\": \"string\", \"maxLength\": 200 },\n        \"smartphone\": { \"type\": \"string\", \"maxLength\": 60 },\n        \"smartwatch\": { \"type\": \"string\", \"maxLength\": 80 },\n        \"dailyStepTarget\": { \"type\": \"number\" },\n        \"aiDefaultModel\": { \"type\": \"string\", \"enum\": [\"gemini-3.1-flash-lite\", \"gemini-4-hydrogen\"] },\n        \"aiDailyLimit\": { \"type\": \"number\" },\n        \"liabilitiesPiasters\": { \"type\": \"number\" },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"userId\", \"displayName\", \"language\", \"currency\", \"dailyWorkHours\", \"peakConcentration\", \"createdAt\", \"updatedAt\"]\n    },\n    \"IncomeRecord\": {\n      \"title\": \"IncomeRecord\",\n      \"description\": \"Salary, freelance project, or additional income record stored in integer piasters.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"userId\": { \"type\": \"string\", \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"title\": { \"type\": \"string\", \"maxLength\": 160 },\n        \"amountPiasters\": { \"type\": \"number\" },\n        \"paidAmountPiasters\": { \"type\": \"number\" },\n        \"currency\": { \"type\": \"string\", \"maxLength\": 10 },\n        \"source\": { \"type\": \"string\", \"enum\": [\"fixed_salary\", \"freelance\", \"additional\"] },\n        \"status\": { \"type\": \"string\", \"enum\": [\"expected\", \"invoiced\", \"partially_paid\", \"fully_paid\", \"overdue\"] },\n        \"dateReceived\": { \"type\": \"string\", \"maxLength\": 32 },\n        \"expectedPaymentDate\": { \"type\": \"string\", \"maxLength\": 32 },\n        \"projectName\": { \"type\": \"string\", \"maxLength\": 120 },\n        \"notes\": { \"type\": \"string\", \"maxLength\": 500 },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"userId\", \"title\", \"amountPiasters\", \"paidAmountPiasters\", \"currency\", \"source\", \"status\", \"expectedPaymentDate\", \"createdAt\", \"updatedAt\"]\n    },\n    \"ExpenseRecord\": {\n      \"title\": \"ExpenseRecord\",\n      \"description\": \"Personal expense transaction stored in integer piasters.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"userId\": { \"type\": \"string\", \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"description\": { \"type\": \"string\", \"maxLength\": 200 },\n        \"amountPiasters\": { \"type\": \"number\" },\n        \"currency\": { \"type\": \"string\", \"maxLength\": 10 },\n        \"category\": { \"type\": \"string\", \"maxLength\": 60 },\n        \"date\": { \"type\": \"string\", \"maxLength\": 32 },\n        \"paymentMethod\": { \"type\": \"string\", \"enum\": [\"cash\", \"card\", \"instapay\", \"wallet\", \"bank_transfer\"] },\n        \"entrySource\": { \"type\": \"string\", \"enum\": [\"manual\", \"voice\", \"receipt\", \"notification\", \"email_import\"] },\n        \"recurring\": { \"type\": \"boolean\" },\n        \"notes\": { \"type\": \"string\", \"maxLength\": 500 },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"userId\", \"description\", \"amountPiasters\", \"currency\", \"category\", \"date\", \"paymentMethod\", \"entrySource\", \"recurring\", \"createdAt\", \"updatedAt\"]\n    },\n    \"Budget\": {\n      \"title\": \"Budget\",\n      \"description\": \"Monthly overall or category-specific spending budget in piasters.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"userId\": { \"type\": \"string\", \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"category\": { \"type\": \"string\", \"maxLength\": 60 },\n        \"monthKey\": { \"type\": \"string\", \"maxLength\": 10 },\n        \"limitPiasters\": { \"type\": \"number\" },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"userId\", \"category\", \"monthKey\", \"limitPiasters\", \"createdAt\", \"updatedAt\"]\n    },\n    \"SavingsGoal\": {\n      \"title\": \"SavingsGoal\",\n      \"description\": \"Targeted savings bucket stored in integer piasters.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"userId\": { \"type\": \"string\", \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"title\": { \"type\": \"string\", \"maxLength\": 140 },\n        \"category\": { \"type\": \"string\", \"enum\": [\"emergency\", \"purchases\", \"education\", \"travel\", \"investments\", \"custom\"] },\n        \"targetPiasters\": { \"type\": \"number\" },\n        \"currentPiasters\": { \"type\": \"number\" },\n        \"targetDate\": { \"type\": \"string\", \"maxLength\": 32 },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"userId\", \"title\", \"category\", \"targetPiasters\", \"currentPiasters\", \"targetDate\", \"createdAt\", \"updatedAt\"]\n    },\n    \"InvestmentAsset\": {\n      \"title\": \"InvestmentAsset\",\n      \"description\": \"Manual investment portfolio holding with explicit manual valuation tracking.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"userId\": { \"type\": \"string\", \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"name\": { \"type\": \"string\", \"maxLength\": 140 },\n        \"category\": { \"type\": \"string\", \"enum\": [\"gold\", \"stocks\", \"mutual_funds\", \"etfs\", \"other\"] },\n        \"quantity\": { \"type\": \"number\" },\n        \"purchasePricePiasters\": { \"type\": \"number\" },\n        \"currentValuationPiasters\": { \"type\": \"number\" },\n        \"feesPiasters\": { \"type\": \"number\" },\n        \"realizedPnlPiasters\": { \"type\": \"number\" },\n        \"purchaseDate\": { \"type\": \"string\", \"maxLength\": 32 },\n        \"valuationSource\": { \"type\": \"string\", \"enum\": [\"manual\", \"verified_market\"] },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"userId\", \"name\", \"category\", \"quantity\", \"purchasePricePiasters\", \"currentValuationPiasters\", \"feesPiasters\", \"realizedPnlPiasters\", \"purchaseDate\", \"valuationSource\", \"createdAt\", \"updatedAt\"]\n    },\n    \"TaskItem\": {\n      \"title\": \"TaskItem\",\n      \"description\": \"Scheduled or backlog personal/work task.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"userId\": { \"type\": \"string\", \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"title\": { \"type\": \"string\", \"maxLength\": 200 },\n        \"description\": { \"type\": \"string\", \"maxLength\": 600 },\n        \"priority\": { \"type\": \"string\", \"enum\": [\"critical\", \"high\", \"medium\", \"low\"] },\n        \"category\": { \"type\": \"string\", \"enum\": [\"deep_work\", \"admin\", \"meetings\", \"personal\", \"rest\", \"commute\"] },\n        \"status\": { \"type\": \"string\", \"enum\": [\"todo\", \"in_progress\", \"completed\"] },\n        \"deadline\": { \"type\": \"string\", \"maxLength\": 32 },\n        \"scheduledStart\": { \"type\": \"string\", \"maxLength\": 16 },\n        \"estimatedMinutes\": { \"type\": \"number\" },\n        \"actualMinutes\": { \"type\": \"number\" },\n        \"project\": { \"type\": \"string\", \"maxLength\": 120 },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"userId\", \"title\", \"priority\", \"category\", \"status\", \"deadline\", \"estimatedMinutes\", \"actualMinutes\", \"createdAt\", \"updatedAt\"]\n    },\n    \"CalendarEvent\": {\n      \"title\": \"CalendarEvent\",\n      \"description\": \"Personal or work scheduled calendar event.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"userId\": { \"type\": \"string\", \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"title\": { \"type\": \"string\", \"maxLength\": 200 },\n        \"calendarType\": { \"type\": \"string\", \"enum\": [\"work\", \"personal\"] },\n        \"date\": { \"type\": \"string\", \"maxLength\": 32 },\n        \"startTime\": { \"type\": \"string\", \"maxLength\": 16 },\n        \"endTime\": { \"type\": \"string\", \"maxLength\": 16 },\n        \"notes\": { \"type\": \"string\", \"maxLength\": 400 },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"userId\", \"title\", \"calendarType\", \"date\", \"startTime\", \"endTime\", \"createdAt\", \"updatedAt\"]\n    },\n    \"FocusSession\": {\n      \"title\": \"FocusSession\",\n      \"description\": \"Completed Pomodoro or custom focus session.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"userId\": { \"type\": \"string\", \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"label\": { \"type\": \"string\", \"maxLength\": 140 },\n        \"durationMinutes\": { \"type\": \"number\" },\n        \"distractions\": { \"type\": \"number\" },\n        \"date\": { \"type\": \"string\", \"maxLength\": 32 },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"userId\", \"label\", \"durationMinutes\", \"distractions\", \"date\", \"createdAt\"]\n    },\n    \"HealthLog\": {\n      \"title\": \"HealthLog\",\n      \"description\": \"Daily health metrics with explicit source and availability metadata.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"userId\": { \"type\": \"string\", \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"date\": { \"type\": \"string\", \"maxLength\": 32 },\n        \"sleepHours\": { \"type\": \"number\" },\n        \"sleepBedtime\": { \"type\": \"string\", \"maxLength\": 16 },\n        \"steps\": { \"type\": \"number\" },\n        \"activeCalories\": { \"type\": \"number\" },\n        \"restingHeartRate\": { \"type\": \"number\" },\n        \"source\": { \"type\": \"string\", \"enum\": [\"manual\", \"health_connect\", \"xiaomi_band\"] },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"userId\", \"date\", \"source\", \"createdAt\", \"updatedAt\"]\n    },\n    \"AppUsageLog\": {\n      \"title\": \"AppUsageLog\",\n      \"description\": \"Daily digital wellbeing app usage duration in minutes by category.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"userId\": { \"type\": \"string\", \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"date\": { \"type\": \"string\", \"maxLength\": 32 },\n        \"productivityMinutes\": { \"type\": \"number\" },\n        \"communicationMinutes\": { \"type\": \"number\" },\n        \"socialMediaMinutes\": { \"type\": \"number\" },\n        \"entertainmentMinutes\": { \"type\": \"number\" },\n        \"educationMinutes\": { \"type\": \"number\" },\n        \"otherMinutes\": { \"type\": \"number\" },\n        \"nighttimeMinutes\": { \"type\": \"number\" },\n        \"interruptions\": { \"type\": \"number\" },\n        \"source\": { \"type\": \"string\", \"enum\": [\"manual\", \"usage_stats\"] },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"userId\", \"date\", \"productivityMinutes\", \"socialMediaMinutes\", \"nighttimeMinutes\", \"source\", \"createdAt\", \"updatedAt\"]\n    },\n    \"EnergyLog\": {\n      \"title\": \"EnergyLog\",\n      \"description\": \"Self-reported energy, mood, focus, and stress check-in.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"userId\": { \"type\": \"string\", \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"date\": { \"type\": \"string\", \"maxLength\": 32 },\n        \"energyLevel\": { \"type\": \"number\" },\n        \"moodLevel\": { \"type\": \"number\" },\n        \"focusLevel\": { \"type\": \"number\" },\n        \"stressLevel\": { \"type\": \"number\" },\n        \"notes\": { \"type\": \"string\", \"maxLength\": 300 },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"userId\", \"date\", \"energyLevel\", \"moodLevel\", \"focusLevel\", \"stressLevel\", \"createdAt\"]\n    },\n    \"PersonalGoal\": {\n      \"title\": \"PersonalGoal\",\n      \"description\": \"Personal goal with category, progress, deadline, and bounded milestone titles.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"userId\": { \"type\": \"string\", \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"title\": { \"type\": \"string\", \"maxLength\": 180 },\n        \"description\": { \"type\": \"string\", \"maxLength\": 500 },\n        \"category\": { \"type\": \"string\", \"enum\": [\"financial\", \"professional\", \"educational\", \"health\", \"personal\", \"social\"] },\n        \"targetLabel\": { \"type\": \"string\", \"maxLength\": 120 },\n        \"startDate\": { \"type\": \"string\", \"maxLength\": 32 },\n        \"deadline\": { \"type\": \"string\", \"maxLength\": 32 },\n        \"progress\": { \"type\": \"number\" },\n        \"milestones\": { \"type\": \"array\" },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"userId\", \"title\", \"category\", \"targetLabel\", \"deadline\", \"progress\", \"createdAt\", \"updatedAt\"]\n    }\n  },\n  \"firestore\": {\n    \"/users/{userId}\": {\n      \"schema\": { \"$ref\": \"#/entities/UserProfile\" },\n      \"description\": \"Private user profile and personalization settings, readable and writable only by the owner.\"\n    },\n    \"/users/{userId}/income_records/{recordId}\": {\n      \"schema\": { \"$ref\": \"#/entities/IncomeRecord\" },\n      \"description\": \"Owner-scoped income records.\"\n    },\n    \"/users/{userId}/expense_records/{recordId}\": {\n      \"schema\": { \"$ref\": \"#/entities/ExpenseRecord\" },\n      \"description\": \"Owner-scoped expense records.\"\n    },\n    \"/users/{userId}/budgets/{budgetId}\": {\n      \"schema\": { \"$ref\": \"#/entities/Budget\" },\n      \"description\": \"Owner-scoped monthly and category budgets.\"\n    },\n    \"/users/{userId}/savings_goals/{goalId}\": {\n      \"schema\": { \"$ref\": \"#/entities/SavingsGoal\" },\n      \"description\": \"Owner-scoped savings goals.\"\n    },\n    \"/users/{userId}/investments/{investmentId}\": {\n      \"schema\": { \"$ref\": \"#/entities/InvestmentAsset\" },\n      \"description\": \"Owner-scoped manual investment portfolio holdings.\"\n    },\n    \"/users/{userId}/tasks/{taskId}\": {\n      \"schema\": { \"$ref\": \"#/entities/TaskItem\" },\n      \"description\": \"Owner-scoped tasks.\"\n    },\n    \"/users/{userId}/calendar_events/{eventId}\": {\n      \"schema\": { \"$ref\": \"#/entities/CalendarEvent\" },\n      \"description\": \"Owner-scoped calendar events.\"\n    },\n    \"/users/{userId}/focus_sessions/{sessionId}\": {\n      \"schema\": { \"$ref\": \"#/entities/FocusSession\" },\n      \"description\": \"Owner-scoped focus timer sessions.\"\n    },\n    \"/users/{userId}/health_logs/{logId}\": {\n      \"schema\": { \"$ref\": \"#/entities/HealthLog\" },\n      \"description\": \"Owner-scoped health and sleep logs.\"\n    },\n    \"/users/{userId}/app_usage/{usageId}\": {\n      \"schema\": { \"$ref\": \"#/entities/AppUsageLog\" },\n      \"description\": \"Owner-scoped digital wellbeing app usage logs.\"\n    },\n    \"/users/{userId}/energy_logs/{logId}\": {\n      \"schema\": { \"$ref\": \"#/entities/EnergyLog\" },\n      \"description\": \"Owner-scoped self-reported energy check-in logs.\"\n    },\n    \"/users/{userId}/goals/{goalId}\": {\n      \"schema\": { \"$ref\": \"#/entities/PersonalGoal\" },\n      \"description\": \"Owner-scoped personal goals.\"\n    }\n  }\n}\n"
        path {
          absolute_uri: "file:///firebase-blueprint.json"
        }
        overwrite: true
      }
    }
