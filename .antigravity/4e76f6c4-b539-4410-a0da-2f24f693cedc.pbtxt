              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    <div className=\"text-end\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                      <p className=\"text-sm font-bold font-mono-nums text-[#F4F6F8]\">{formatEgp(rec.amountPiasters, lang)}</p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                      {unpaid > 0 ? ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        <p className=\"text-[11px] font-mono-nums text-amber-400\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                          {isAr ? `\331\205\330\255\330\265\331\221\331\204 ${formatEgp(paid, lang)} \302\267 \331\205\330\271\331\204\331\202 ${formatEgp(unpaid, lang)}` : `Paid ${formatEgp(paid, lang)} \302\267 Due ${formatEgp(unpaid, lang)}`}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        </p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                      ) : ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        <p className=\"text-[11px] text-emerald-400\">{isAr ? \'\331\205\330\266\330\247\331\201 \331\204\331\204\330\261\330\265\331\212\330\257 \330\247\331\204\331\205\330\252\330\247\330\255\' : \'In available cash\'}</p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                      )}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    {rec.status !== \'fully_paid\' ? ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
