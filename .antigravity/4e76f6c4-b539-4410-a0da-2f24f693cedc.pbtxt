              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            className=\"min-h-[40px] px-4 py-2 rounded-xl bg-[#191F27] border border-[#2A3340] hover:border-emerald-500/60 text-xs font-semibold text-[#F4F6F8] transition-colors flex items-center gap-2 whitespace-nowrap self-start sm:self-auto\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
