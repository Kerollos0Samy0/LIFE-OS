ped monthly and category budgets.\"\n    },\n    \"/users/{userId}/savings_goals/{goalId}\": {\n      \"schema\": { \"$ref\": \"#/entities/SavingsGoal\" },\n      \"description\": \"Owner-scoped savings goals.\"\n    },\n    \"/users/{userId}/investments/{investmentId}\": {\n      \"schema\": { \"$ref\": \"#/entities/InvestmentAsset\" },\n      \"description\": \"Owner-scoped manual investment portfolio holdings.\"\n    },\n    \"/users/{userId}/tasks/{taskId}\": {\n      \"schema\": { \"$ref\": \"#/entities/TaskItem\" },\n      \"description\": \"Owner-scoped tasks.\"\n    },\n    \"/users/{userId}/calendar_events/{eventId}\": {\n      \"schema\": { \"$ref\": \"#/entities/CalendarEvent\" },\n      \"description\": \"Owner-scoped calendar events.\"\n    },\n    \"/users/{userId}/focus_sessions/{sessionId}\": {\n      \"schema\": { \"$ref\": \"#/entities/FocusSession\" },\n      \"description\": \"Owner-scoped focus timer sessions.\"\n    },\n    \"/users/{userId}/health_logs/{logId}\": {\n      \"schema\": { \"$ref\": \"#/entities/HealthLog\" },\n      \"description\": \"Owner-scoped health and sleep logs.\"\n    },\n    \"/users/{userId}/app_usage/{usageId}\": {\n      \"schema\": { \"$ref\": \"#/entities/AppUsageLog\" },\n      \"description\": \"Owner-scoped digital wellbeing app usage logs.\"\n    },\n    \"/users/{userId}/energy_logs/{logId}\": {\n      \"schema\": { \"$ref\": \"#/entities/EnergyLog\" },\n      \"description\": \"Owner-scoped self-reported energy check-in logs.\"\n    },\n    \"/users/{userId}/goals/{goalId}\": {\n      \"schema\": { \"$ref\": \"#/entities/PersonalGoal\" },\n      \"description\": \"Owner-scoped personal goals.\"\n    }\n  }\n}"
