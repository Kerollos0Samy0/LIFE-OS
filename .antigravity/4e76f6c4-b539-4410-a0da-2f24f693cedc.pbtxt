      thinking_signature: "\022\276\017\n\273\017\001i\024}\023\252\021#\226ZX\206\367\fP\030\rT&\352\345\031s\257nT\376\005F\216\347\257M\264\006\357\332\265\0066K>\221T\320V2,\274\234\375\031\257\212\342|\346?\225\205\335\257\035\224\363\004p{\373\331\336\202m\350)\375\354\3329\267\272\300\030\367 \351\256\311\346\274L\3377 \201\327\254\006\376L\001<wj\310\251M\001\345\311G\261\361}\334\260\211\261\335\272\254}u\260a\320\367\327\217\250\361H\2763\316\362\026N\265\260Y\002c!\254\026\325D\377PX\026q*\214*U\267\301>V^\252y\242D\250\265i\314\376\021\302fA\207W\277_wl\222\223\003\326\262\301\204[\036\214J\211\2661\225\260G\275\t\352k\005\337YV\204]bd@;y\347\225i\250\304\213\367\223cU\177\306\355tm!T\'2E\267\334\002\275\033\212`\306\024a\\>\364B\263MEYRG\221\361V\000\027\273\216\264.\330\313\025\243\220\371\272\213\215J\377\003\207\005\337;?\317\305LR\177\212&\2026R\335\226\230b\027>\272\347\232DPN\265\341\230\325Q|L\2157\203K\241\245\023\357aqfQ\276\323\225%\305A1,\235=!}\332\177\243\226\017#\374\351\350JI\327\234(\254\363Q\252\344g.\310JZY\250\327jh\0259z=\2074i\a\366\376\263\343\novR\276\002\'\3562\207\312\f\027\244Pt\330\026p\247\305\n\372\261bh\321RW\252\305\252m\343\240\177\306\005\373\352\001+`\327\237\221\330\037vA\265\300\250\320\346@\374\a#\277\373\255\375\252\201\272\021\310B\272s\3237T\000Y\026\317\355e\347\016y\337\337i\022\372\335|[\033l\021\024\016\030k2h\336\220\365\266uKPj\326\246\257\032\302\2639o\260\370\026Q\016\252]m\273<\347b7*\030)7q\321\325\3654F\345\3206\024N\247\345\256\266\030p\3310/\002\206{\256\3461|\357\226\340\316\026}\006\253\310\367\304\037\255[\350df\307\271Z\232\003\344V\276\324\333\253i+\234\323+CT\317!l\357\006Tyu\352\312nQ)\377\316\313\374raf\\t\234\255\216#\036\347\222\332\252\\tU\034/\316)\223\177t\217)\304\210\020\027\262\203\030z\020q\304\274\006\233x\213\vU\225\376#\271\376\261S\a\333E\254\'y\227o\037\256\315t\342\330\253\267\324\344j\373\216\360\031\237\260\264Q\0341\207\352v(\360\347w\205\343\235\276kK\333\260,\202*\331\355sq\276Z\315\251\023\265/\316C\257)\300RKg!\034\357\354\253\177\333/P$\323\350K\3208\213\311Y\370\346\334\241)\332\206\233\236\325\247\367\320\277\345\aR\r\021\311\232\033b\272\245A}\321d\203\243\336\267sn*4\273\275(%3\273$\306\233\261\234\353D\005j\031JIJ\226\362\"/\2641f~\223m\302\264wdas\335\346\347\251\021|\372\372\366\021\255I^\202\375\273\320\213\301l\345N\243\215\333k\341(tRkf\242\247\260\023\331\371\311\320\332\003.\320La(\001\356\247\265n\261\207\2720s\317\322Xu#\205>\227NC\327\366<\364\201\247I\373\323\376W\261\335\271\002\f\360\270p^d\330=7,\266SW[F\224\300\002kQ<\264\a\2177\254/\373L<\332z\224\263o\003\242\002\315oP\241\240*7\255{\244\203^\337,\201!r\005y\373\265\234\211\276\331\351\271\326DY}\037&\nom\341\323\241\350*\255\304{\221~\3577\215\024\274\324\367u5m\240a\256\234Zj\270\304\004\3146\351V\377\234]t\231\236&{\254\366\345\244\211\360\375\001L\'\003\341:_q<\025\203\315}\204\343\371\216\n\206\202\2308\277\325\224M\364\372\240\304 \317\036\272a\'4i\344\221U\343\220\035\256\305\030b\'i\3270\371ZI\2474\205*\213\310\356H\"\3635\217%\264\2104\300\022\236\231@\325Q\272\027[\020=\357\251\356\231\034Y\330\023^\266\220r\217\033.V\317\370L\251\241\221\227:\320dI\340\225u\332\322u\3120\2400b\002\021\370\037\273\315\243+-\222\265\222\346\235\275\212\203i\357\"\215\267\224\263\257WP\231\353\023\227\302hUad\337\213I\204_\324\372 \255\v\2056z6+\270\351\210HT=WpY5J\263\314\372\225\t&\330<\214;+5\322?K`4_$\310\374\2359\333#k+\037?s\244\227\336\031\\\005\273\212\316\035\324\357?\350QH\216O\261\033\323\2516\205A\017\bI\306\207\036t\330\315\003\003\211\360e-\216\254\r\221\341\324\344\201\024\236\\\300QN\345\205\276\022\371v\214O+>t\357\213\177\206]\303\211\334\3569\306A\026\001\326k\366\215\334\201\347\240\224\312j\210\205\222\237Bl\246\343/\366HG\3120\004g\371\362\340>\036\025\2606\000\324\b\250\f\274\b\371\210%4s\347\205/C\361\211\200\270\267\240y\237XY\251\321\351\207e\260\250B\363\035\331\276\256t#\'\357\346QW\264\025xG\370\276\023\262\252=\362\231?W\034\343\232r\304\277\250\200=\246D\316\273\2019\002\374\274$w\373\376tt\244\355\245\202\261\231#W\322g\275\246\204\362\352\3741\245G\022\236\217L(\001\312\267\245\017c\234Z\226k\361\231WNl\367-!\v\327\3670C\2150\016/\221 6\v\356\230\\\373\346\251\345\260\032a\325\270\252+@5\305Ne&d\310\325\314>\277\006\372\030i]=H|\270\266P\335\371\2326\025:\205\203\270v\0370\221\310\267\344\352\2509\264\017A\211\231l\366k\201\333\346=M\202\203&\254_\211{\351\2131O\246%3\2315\235(\276\000\371F\260\275\270\"m\222g|?\321\257\354J\262\311\210\360X\016\200D\250\202\2612[\360\303L\222\277\334\320\0232\343\224\206\316<\241\023\0302h\270\372\237\033n\bz\030\317\205#\336y<e,*\274\366>\001>\003\247\347\326\242[& =\334\350\337j\322\177\303(-\217!\361Z\001%\tW\335\261\266g}\322\260&\252\346\347Eb\330\244[3\322\347\227\2359\316\031pKGk-d\262N\210\327\a\356S\300\022\370U\360A\202\030\264\000D\364\230<p~A\217kA\216\237Y\301\207)\322\232\017c\361\354\313B\214\371A\271\000\215\343\232y\240\246o;\316\024\226\345Bc\021\004\334\260u\347\302\357\36326\231\361`\327%\373r\vm\275\017\366\025\255\327@\361Mbr\364\370#mU\204:\300\000\222Bw\353NU\306\210\244E\000\366\2000D\031<xh\217\023t\376\022\3354\000\344\260\177\265\272@<\240\201LOHV\340\304N\305eN\\\032\351.\f\\\320\a\355)r\342`\005$-n\311f\335\237Ma\325_\203\031\313\300\024\373\337\317\031rd\360YO\305Vo\310/\273\n\263\202xew\335\362$\343p\372\230\022\312\336%\251\322\231q\242\032\3432s\347\023\f\360~fV\214/\314\233\266\30439\221\217ppr\371o\247F\251\223MO\234\203V#S\3540iR\347\025\005Z\021v\243\bD\220\200O\245\247\333\357\305\033\350I\202\363\261\023\2461\306n\204IG\3140\3539\325s\362\272\t\321H\307EJ\301\234\226\213"
