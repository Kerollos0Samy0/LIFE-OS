              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      {/* TAB 4: TIME ANALYTICS */}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      {tab === \'analytics\' ? ("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        <div className=\"bg-[#13171C] border border-[#232A33] rounded-2xl p-5 space-y-4\">"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          <h2 className=\"text-sm font-semibold text-[#F4F6F8]\">"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            {isAr ? \'\330\247\331\204\331\210\331\202\330\252 \330\247\331\204\331\205\330\256\330\267\330\267 \331\205\331\202\330\247\330\250\331\204 \330\247\331\204\331\210\331\202\330\252 \330\247\331\204\331\201\330\271\331\204\331\212 \330\255\330\263\330\250 \330\247\331\204\331\206\331\210\330\271 (\330\250\330\247\331\204\330\257\331\202\330\247\330\246\331\202)\' : \'Planned vs Actual Time by Category (Minutes)\'}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          </h2>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
