              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            <ResponsiveContainer width=\"100%\" height=\"100%\">"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              <BarChart data={timeAnalytics} margin={{ top: 8, right: 12, left: 0, bottom: 8 }}>"
