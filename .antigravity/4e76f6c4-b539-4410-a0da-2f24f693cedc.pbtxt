            }
            lines {
              text: "      ) : null}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      <ConfirmDialog"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        open={pendingOutOfHoursTask}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        title={isAr ? \'\330\252\330\243\331\203\331\212\330\257 \330\254\330\257\331\210\331\204\330\251 \330\256\330\247\330\261\330\254 \330\263\330\247\330\271\330\247\330\252 \330\247\331\204\330\271\331\205\331\204\' : \'Schedule Outside Working Hours?\'}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        description={"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          isAr"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            ? `\330\247\331\204\331\205\331\210\330\271\330\257 \330\247\331\204\331\205\330\256\330\252\330\247\330\261 (${scheduledStart}) \331\212\331\202\330\271 \330\256\330\247\330\261\330\254 \330\263\330\247\330\271\330\247\330\252 \330\271\331\205\331\204\331\203 \330\247\331\204\331\205\330\255\330\257\330\257\330\251 (${data.profile.workStartHour}:00 \342\200\223 ${data.profile.workEndHour}:00). \331\207\331\204 \330\252\330\261\331\212\330\257 \330\252\330\243\331\203\331\212\330\257 \330\254\330\257\331\210\331\204\330\251 \330\247\331\204\331\205\331\207\331\205\330\251 \331\201\331\212 \331\207\330\260\330\247 \330\247\331\204\331\210\331\202\330\252\330\237`"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            : `The selected time (${scheduledStart}) is outside your working hours (${data.profile.workStartHour}:00\342\200\223${data.profile.workEndHour}:00). Confirm scheduling anyway?`"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        confirmLabel={isAr ? \'\330\252\330\243\331\203\331\212\330\257 \330\247\331\204\330\254\330\257\331\210\331\204\330\251\' : \'Confirm Schedule\'}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        cancelLabel={isAr ? \'\330\252\330\271\330\257\331\212\331\204 \330\247\331\204\331\210\331\202\330\252\' : \'Adjust Time\'}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        onConfirm={() => void commitNewTask()}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        onCancel={() => setPendingOutOfHoursTask(false)}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      />"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      <ConfirmDialog"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        open={Boolean(confirmDeleteEvent)}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        title={isAr ? \'\330\255\330\260\331\201 \331\205\331\210\330\271\330\257 \331\205\331\206 \330\247\331\204\330\252\331\202\331\210\331\212\331\205\' : \'Delete Calendar Event\'}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
