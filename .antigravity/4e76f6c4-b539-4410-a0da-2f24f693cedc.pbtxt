  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useMemo, useState } from \'react\';\nimport {\n  Area,\n  AreaChart,\n  Bar,\n  BarChart,\n  CartesianGrid,\n  ResponsiveContainer,\n  Tooltip,\n  XAxis,\n  YAxis,\n} from \'recharts\';\nimport { Activity, Moon, Watch, Zap } from \'lucide-react\';\nimport { useLifeOs } from \'../context/LifeOsContext\';\nimport { TODAY_ISO } from \'../data/seedData\';\nimport { calculateEnergyEstimate } from \'../utils/energy\';\nimport { UI_TEXT } from \'../i18n/translations\';\n\ntype HealthSubTab = \'overview\' | \'energy\' | \'band\';\n\nexport const HealthEnergyModule: React.FC = () => {\n  const { data, lang, upsertHealthLog, addEnergyLog } = useLifeOs();\n  const isAr = lang === \'ar\';\n  const [subTab, setSubTab] = useState<HealthSubTab>(\'overview\');\n\n  // Health manual log form\n  const [logDate, setLogDate] = useState(TODAY_ISO);\n  const [sleepHours, setSleepHours] = useState(\'6.0\');\n  const [sleepBedtime, setSleepBedtime] = useState(\'01:00\');\n  const [steps, setSteps] = useState(\'7500\');\n  const [activeCalories, setActiveCalories] = useState(\'350\');\n  const [restingHr, setRestingHr] = useState(\'64\');\n  const [healthSaved, setHealthSaved] = useState(false);\n\n  // Energy check-in form\n  const [energyLevel, setEnergyLevel] = useState(7);\n  const [moodLevel, setMoodLevel] = useState(7);\n  const [focusLevel, setFocusLevel] = useState(8);\n  const [stressLevel, setStressLevel] = useState(4);\n  const [energyNotes, setEnergyNotes] = useState(\'\');\n  const [energySaved, setEnergySaved] = useState(false);\n\n  const sortedHealth = useMemo(\n    () => [...data.healthLogs].sort((a, b) => a.date.localeCompare(b.date)),\n    [data.healthLogs],\n  );\n  const latestHealth = sortedHealth[sortedHealth.length - 1] || null;\n\n  const avgSleep = useMemo(() => {\n    const vals = sortedHealth.map((h) => h.sleepHours).filter((v): v is number => typeof v === \'number\');\n    if (vals.length === 0) return null;\n    return Number((vals.reduce((s, x) => s + x, 0) / vals.length).toFixed(1));\n  }, [sortedHealth]);\n\n  const energyEstimate = useMemo(\n    () =>\n      calculateEnergyEstimate({\n        healthLogs: data.healthLogs,\n        appUsageLogs: data.appUsageLogs,\n        energyLogs: data.energyLogs,\n        dailyStepTarget: data.profile.dailyStepTarget,\n        targetSleepHours: data.profile.targetSleepHours,\n        peakConcentration: data.profile.peakConcentration,\n      }),\n    [data],\n  );\n\n  const handleSaveHealth = async (e: React.FormEvent) => {\n    e.preventDefault();\n    await upsertHealthLog({\n      date: logDate,\n      sleepHours: sleepHours !== \'\' ? Number(sleepHours) : undefined,\n      sleepBedtime: sleepBedtime || undefined,\n      steps: steps !== \'\' ? Number(steps) : undefined,\n      activeCalories: activeCalories !== \'\' ? Number(activeCalories) : undefined,\n      restingHeartRate: restingHr !== \'\' ? Number(restingHr) : undefined,\n      source: \'manual\',\n    });\n    setHealthSaved(true);\n    setTimeout(() => setHealthSaved(false), 1800);\n  };\n\n  const handleSaveEnergy = async (e: React.FormEvent) => {\n    e.preventDefault();\n    await addEnergyLog({\n      date: TODAY_ISO,\n      energyLevel,\n      moodLevel,\n      focusLevel,\n      stressLevel,\n      notes: energyNotes.trim() || undefined,\n    });\n    setEnergyNotes(\'\');\n    setEnergySaved(true);\n    setTimeout(() => setEnergySaved(false), 1800);\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      <div>\n        <h1 className=\"text-2xl font-bold text-[#F4F6F8]\">\n          {isAr ? \'\330\247\331\204\330\265\330\255\330\251 \331\210\330\247\331\204\331\204\331\212\330\247\331\202\330\251 \331\210\330\260\331\203\330\247\330\241 \330\247\331\204\330\267\330\247\331\202\330\251\' : \'Health, Fitness & Energy Intelligence\'}\n        </h1>\n        <p className=\"text-xs text-[#8E99A8] mt-1\">{UI_TEXT[lang].common.nonMedicalNotice}</p>\n      </div>\n\n      <div className=\"flex items-center gap-1.5 overflow-x-auto pb-1\">\n        {(\n          [\n            { id: \'overview\', label: isAr ? \'\330\247\331\204\331\206\331\210\331\205 \331\210\330\247\331\204\331\206\330\264\330\247\330\267\' : \'Sleep & Activity\' },\n            { id: \'energy\', label: isAr ? \'\330\260\331\203\330\247\330\241 \330\247\331\204\330\267\330\247\331\202\330\251 \331\210\330\247\331\204\330\252\330\263\330\254\331\212\331\204 \330\247\331\204\331\212\331\210\331\205\331\212\' : \'Energy Intelligence\' },\n            { id: \'band\', label: isAr ? \'Xiaomi Band \331\210 Health Connect\' : \'Xiaomi Band & Health Connect\' },\n          ] as const\n        ).map((t) => (\n          <button\n            key={t.id}\n            type=\"button\"\n            onClick={() => setSubTab(t.id)}\n            className={`min-h-[40px] px-3.5 py-2 rounded-xl text-xs font-semibold transition-colors whitespace-nowrap shrink-0 ${\n              subTab === t.id\n                ? \'bg-emerald-500 text-[#07110C]\'\n                : \'bg-[#13171C] border border-[#232A33] text-[#A9B3C1] hover:text-[#F4F6F8]\'\n            }`}\n          >\n            {t.label}\n          </button>\n        ))}\n      </div>\n\n      {/* SUBTAB 1: SLEEP & ACTIVITY */}\n      {subTab === \'overview\' ? (\n        <div className=\"space-y-5\">\n          <div className=\"grid grid-cols-2 lg:grid-cols-4 gap-4\">\n            <div className=\"bg-[#13171C] border border-[#232A33] rounded-2xl p-4\">\n              <p className=\"text-xs text-[#8E99A8] flex items-center gap-1.5\">\n                <Moon className=\"w-3.5 h-3.5 text-emerald-400\" />\n                {isAr ? \'\331\205\330\252\331\210\330\263\330\267 \330\247\331\204\331\206\331\210\331\205 (7 \330\243\331\212\330\247\331\205)\' : \'Avg Sleep (7d)\'}\n              </p>\n              <p className=\"text-xl font-bold font-mono-nums text-[#F4F6F8] mt-1\">\n                {avgSleep !== null ? `${avgSleep} ${isAr ? \'\330\263\330\247\330\271\330\251\' : \'h\'}` : UI_TEXT[lang].common.unavailable}\n              </p>\n              <p className=\"text-[11px] text-[#758091] mt-1\">\n                {isAr ? \'\330\247\331\206\330\252\330\270\330\247\331\205 \330\247\331\204\331\206\331\210\331\205:\' : \'Consistency:\'}{\' \'}\n                {energyEstimate.measuredFactors.sleepConsistencyPercent !== null\n                  ? `${energyEstimate.measuredFactors.sleepConsistencyPercent}%`\n                  : UI_TEXT[lang].common.unavailable}\n              </p>\n            </div>\n            <div className=\"bg-[#13171C] border border-[#232A33] rounded-2xl p-4\">\n              <p className=\"text-xs text-[#8E99A8] flex items-center gap-1.5\">\n                <Activity className=\"w-3.5 h-3.5 text-emerald-400\" />\n                {isAr ? \'\330\256\330\267\331\210\330\247\330\252 \330\242\330\256\330\261 \331\212\331\210\331\205\' : \'Latest Steps\'}\n              </p>\n              <p className=\"text-xl font-bold font-mono-nums text-[#F4F6F8] mt-1\">\n                {latestHealth?.steps != null ? latestHealth.steps.toLocaleString(\'en-US\') : UI_TEXT[lang].common.unavailable}\n              </p>\n              <p className=\"text-[11px] text-[#758091] font-mono-nums mt-1\">\n                {isAr ? \'\330\247\331\204\331\207\330\257\331\201 \330\247\331\204\331\212\331\210\331\205\331\212:\' : \'Target:\'} {data.profile.dailyStepTarget.toLocaleString(\'en-US\')}\n              </p>\n            </div>\n            <div className=\"bg-[#13171C] border border-[#232A33] rounded-2xl p-4\">\n              <p className=\"text-xs text-[#8E99A8]\">{isAr ? \'\330\263\330\271\330\261\330\247\330\252 \331\206\330\264\330\267\330\251 (\331\205\331\206\331\201\330\265\331\204\330\251 \330\271\331\206 \330\247\331\204\330\245\330\254\331\205\330\247\331\204\331\212)\' : \'Active Calories Only\'}</p>\n              <p className=\"text-xl font-bold font-mono-nums text-[#F4F6F8] mt-1\">\n                {latestHealth?.activeCalories != null ? `${latestHealth.activeCalories} kcal` : UI_TEXT[lang].common.unavailable}\n              </p>\n              <p className=\"text-[11px] text-[#758091] mt-1\">\n                {isAr ? \'\330\247\331\204\331\205\330\265\330\257\330\261: \330\245\330\257\330\256\330\247\331\204 \331\212\330\257\331\210\331\212\' : \'Source: Manual log\'}\n              </p>\n            </div>\n            <div className=\"bg-[#13171C] border border-[#232A33] rounded-2xl p-4\">\n              <p className=\"text-xs text-[#8E99A8]\">{isAr ? \'\331\206\330\250\330\266 \330\247\331\204\330\261\330\247\330\255\330\251\' : \'Resting Heart Rate\'}</p>\n              <p className=\"text-xl font-bold font-mono-nums text-[#F4F6F8] mt-1\">\n                {latestHealth?.restingHeartRate != null ? `${latestHealth.restingHeartRate} bpm` : UI_TEXT[lang].common.unavailable}\n              </p>\n              <p className=\"text-[11px] text-[#758091] font-mono-nums mt-1\">\n                {latestHealth?.date || \'\342\200\224\'}\n              </p>\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-5\">\n            <div className=\"lg:col-span-7 space-y-5\">\n              <div className=\"bg-[#13171C] border border-[#232A33] rounded-2xl p-5 space-y-3\">\n                <h2 className=\"text-sm font-semibold text-[#F4F6F8]\">{isAr ? \'\331\205\331\206\330\255\331\206\331\211 \330\263\330\247\330\271\330\247\330\252 \330\247\331\204\331\206\331\210\331\205 \330\247\331\204\330\243\330\263\330\250\331\210\330\271\331\212\' : \'Weekly Sleep Duration (Hours)\'}</h2>\n                <div className=\"h-52 w-full\" dir=\"ltr\">\n                  <ResponsiveContainer width=\"100%\" height=\"100%\">\n                    <AreaChart data={sortedHealth} margin={{ top: 8, right: 8, left: -16, bottom: 0 }}>\n                      <CartesianGrid stroke=\"#232A33\" strokeDasharray=\"3 3\" vertical={false} />\n                      <XAxis dataKey=\"date\" tickFormatter={(d: string) => d.slice(5)} tick={{ fill: \'#8E99A8\', fontSize: 11 }} axisLine={false} tickLine={false} />\n                      <YAxis domain={[0, 10]} tick={{ fill: \'#8E99A8\', fontSize: 11 }} axisLine={false} tickLine={false} />\n                      <Tooltip contentStyle={{ backgroundColor: \'#0B0D10\', border: \'1px solid #232A33\', borderRadius: 12, color: \'#F4F6F8\', fontSize: 12 }} />\n                      <Area type=\"monotone\" dataKey=\"sleepHours\" stroke=\"#34D399\" fill=\"#34D399\" fillOpacity={0.18} strokeWidth={2} />\n                    </AreaChart>\n                  </ResponsiveContainer>\n                </div>\n              </div>\n\n              <div className=\"bg-[#13171C] border border-[#232A33] rounded-2xl p-5 space-y-3\">\n                <h2 className=\"text-sm font-semibold text-[#F4F6F8]\">{isAr ? \'\330\247\331\204\330\256\330\267\331\210\330\247\330\252 \330\247\331\204\331\212\331\210\331\205\331\212\330\251\' : \'Daily Steps Pattern\'}</h2>\n                <div className=\"h-52 w-full\" dir=\"ltr\">\n                  <ResponsiveContainer width=\"100%\" height=\"100%\">\n                    <BarChart data={sortedHealth} margin={{ top: 8, right: 8, left: -12, bottom: 0 }}>\n                      <CartesianGrid stroke=\"#232A33\" strokeDasharray=\"3 3\" vertical={false} />\n                      <XAxis dataKey=\"date\" tickFormatter={(d: string) => d.slice(5)} tick={{ fill: \'#8E99A8\', fontSize: 11 }} axisLine={false} tickLine={false} />\n                      <YAxis tick={{ fill: \'#8E99A8\', fontSize: 11 }} axisLine={false} tickLine={false} />\n                      <Tooltip contentStyle={{ backgroundColor: \'#0B0D10\', border: \'1px solid #232A33\', borderRadius: 12, color: \'#F4F6F8\', fontSize: 12 }} />\n                      <Bar dataKey=\"steps\" fill=\"#34D399\" radius={[6, 6, 0, 0]} />\n                    </BarChart>\n                  </ResponsiveContainer>\n                </div>\n              </div>\n            </div>\n\n            <form onSubmit={handleSaveHealth} className=\"lg:col-span-5 bg-[#13171C] border border-[#232A33] rounded-2xl p-5 space-y-4 self-start\">\n              <div>\n                <h2 className=\"text-sm font-semibold text-[#F4F6F8]\">{isAr ? \'\330\252\330\263\330\254\331\212\331\204 \331\202\331\212\330\247\330\263\330\247\330\252 \330\247\331\204\331\212\331\210\331\205 \331\212\330\257\331\210\331\212\330\247\331\213\' : \'Log Daily Health Metrics\'}</h2>\n                <p className=\"text-xs text-[#8E99A8] mt-0.5\">\n                  {isAr ? \'\331\212\331\217\330\255\331\201\330\270 \330\250\331\205\330\265\330\257\330\261 \"\330\245\330\257\330\256\330\247\331\204 \331\212\330\257\331\210\331\212\" \331\210\330\252\331\210\331\202\331\212\330\252 \331\210\330\247\330\266\330\255 \331\204\331\203\331\204 \331\202\331\212\330\247\330\263.\' : \'Saved with explicit manual source & date timestamp.\'}\n                </p>\n              </div>\n              <div>\n                <label htmlFor=\"hl-date\" className=\"block text-xs text-[#8E99A8] mb-1\">{isAr ? \'\330\247\331\204\330\252\330\247\330\261\331\212\330\256\' : \'Date\'}</label>\n                <input id=\"hl-date\" type=\"date\" value={logDate} onChange={(e) => setLogDate(e.target.value)} className=\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\" />\n              </div>\n              <div className=\"grid grid-cols-2 gap-3\">\n                <div>\n                  <label htmlFor=\"hl-sleep\" className=\"block text-xs text-[#8E99A8] mb-1\">{isAr ? \'\330\263\330\247\330\271\330\247\330\252 \330\247\331\204\331\206\331\210\331\205\' : \'Sleep Hours\'}</label>\n                  <input id=\"hl-sleep\" type=\"number\" step=\"0.1\" value={sleepHours} onChange={(e) => setSleepHours(e.target.value)} className=\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\" />\n                </div>\n                <div>\n                  <label htmlFor=\"hl-bed\" className=\"block text-xs text-[#8E99A8] mb-1\">{isAr ? \'\331\210\331\202\330\252 \330\247\331\204\331\206\331\210\331\205\' : \'Bedtime\'}</label>\n                  <input id=\"hl-bed\" type=\"time\" value={sleepBedtime} onChange={(e) => setSleepBedtime(e.target.value)} className=\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\" />\n                </div>\n              </div>\n              <div className=\"grid grid-cols-3 gap-2.5\">\n                <div>\n                  <label htmlFor=\"hl-steps\" className=\"block text-xs text-[#8E99A8] mb-1\">{isAr ? \'\330\247\331\204\330\256\330\267\331\210\330\247\330\252\' : \'Steps\'}</label>\n                  <input id=\"hl-steps\" type=\"number\" value={steps} onChange={(e) => setSteps(e.target.value)} className=\"w-full min-h-[42px] px-2.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\" />\n                </div>\n                <div>\n                  <label htmlFor=\"hl-cal\" className=\"block text-xs text-[#8E99A8] mb-1\">{isAr ? \'\330\263\330\271\330\261\330\247\330\252 \331\206\330\264\330\267\330\251\' : \'Active kcal\'}</label>\n                  <input id=\"hl-cal\" type=\"number\" value={activeCalories} onChange={(e) => setActiveCalories(e.target.value)} className=\"w-full min-h-[42px] px-2.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\" />\n                </div>\n                <div>\n                  <label htmlFor=\"hl-hr\" className=\"block text-xs text-[#8E99A8] mb-1\">{isAr ? \'\331\206\330\250\330\266 \330\247\331\204\330\261\330\247\330\255\330\251\' : \'Resting HR\'}</label>\n                  <input id=\"hl-hr\" type=\"number\" value={restingHr} onChange={(e) => setRestingHr(e.target.value)} className=\"w-full min-h-[42px] px-2.5 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm font-mono-nums text-[#F4F6F8]\" />\n                </div>\n              </div>\n              <button type=\"submit\" className=\"w-full min-h-[44px] rounded-xl bg-emerald-500 text-[#07110C] font-semibold text-sm hover:bg-emerald-400\">\n                {healthSaved ? (isAr ? \'\330\252\331\205 \330\255\331\201\330\270 \330\247\331\204\330\263\330\254\331\204 \330\247\331\204\330\265\330\255\331\212\' : \'Health Log Saved\') : (isAr ? \'\330\255\331\201\330\270 \330\247\331\204\330\263\330\254\331\204 \330\247\331\204\330\265\330\255\331\212\' : \'Save Health Log\')}\n              </button>\n            </form>\n          </div>\n        </div>\n      ) : null}\n\n      {/* SUBTAB 2: ENERGY INTELLIGENCE */}\n      {subTab === \'energy\' ? (\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-5\">\n          <div className=\"lg:col-span-7 bg-[#13171C] border border-[#232A33] rounded-2xl p-6 space-y-5\">\n            <div className=\"flex items-start justify-between gap-4\">\n              <div>\n                <p className=\"text-xs text-[#8E99A8] flex items-center gap-1.5\">\n                  <Zap className=\"w-3.5 h-3.5 text-emerald-400\" />\n                  {isAr ? \'\331\206\331\205\331\210\330\260\330\254 \330\252\331\202\330\257\331\212\330\261 \330\247\331\204\330\267\330\247\331\202\330\251 \330\247\331\204\330\264\331\201\330\247\331\201 (\331\205\331\202\330\247\330\261\331\206\330\251 \330\250\330\256\330\267 \330\243\330\263\330\247\330\263\331\203 \330\247\331\204\330\264\330\256\330\265\331\212)\' : \'Transparent Personal Energy Model\'}\n                </p>\n                <p className=\"text-4xl font-bold font-mono-nums text-emerald-400 mt-2\" data-testid=\"energy-score-value\">\n                  {energyEstimate.estimatedScore !== null ? `${energyEstimate.estimatedScore}%` : UI_TEXT[lang].common.unavailable}\n                </p>\n              </div>\n              <div className=\"text-end text-xs\">\n                <p className=\"text-[#8E99A8]\">{isAr ? \'\330\252\331\202\330\257\331\205 \330\256\330\267 \330\247\331\204\330\243\330\263\330\247\330\263 (30 \331\212\331\210\331\205\330\247\331\213)\' : \'30-Day Baseline\'}</p>\n                <p className=\"font-mono-nums text-sm font-semibold text-[#F4F6F8] mt-0.5\">\n                  {energyEstimate.baselineDaysLogged} / {energyEstimate.baselineTargetDays}\n                </p>\n              </div>\n            </div>\n\n            <div className=\"pt-4 border-t border-[#232A33] space-y-3 text-xs\">\n              <p className=\"font-semibold text-[#F4F6F8]\">{isAr ? \'\330\250\331\212\330\247\331\206\330\247\330\252 \331\205\331\202\330\247\330\263\330\251 / \331\205\330\263\330\254\331\204\330\251 (Measured Data)\' : \'Measured / Logged Inputs\'}</p>\n              <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3\">\n                <div>\n                  <span className=\"text-[#8E99A8]\">{isAr ? \'\330\247\331\204\331\206\331\210\331\205\' : \'Sleep\'}</span>\n                  <p className=\"font-mono-nums text-sm text-[#F4F6F8] mt-0.5\">\n                    {energyEstimate.measuredFactors.sleepHours !== null ? `${energyEstimate.measuredFactors.sleepHours}h` : UI_TEXT[lang].common.unavailable}\n                  </p>\n                </div>\n                <div>\n                  <span className=\"text-[#8E99A8]\">{isAr ? \'\330\247\331\204\330\256\330\267\331\210\330\247\330\252\' : \'Steps\'}</span>\n                  <p className=\"font-mono-nums text-sm text-[#F4F6F8] mt-0.5\">\n                    {energyEstimate.measuredFactors.steps !== null ? energyEstimate.measuredFactors.steps.toLocaleString(\'en-US\') : UI_TEXT[lang].common.unavailable}\n                  </p>\n                </div>\n                <div>\n                  <span className=\"text-[#8E99A8]\">{isAr ? \'\330\264\330\247\330\264\330\251 \330\247\331\204\331\204\331\212\331\204\' : \'Night Screen\'}</span>\n                  <p className=\"font-mono-nums text-sm text-[#F4F6F8] mt-0.5\">\n                    {energyEstimate.measuredFactors.nighttimeScreenMinutes !== null\n                      ? `${energyEstimate.measuredFactors.nighttimeScreenMinutes}m`\n                      : UI_TEXT[lang].common.unavailable}\n                  </p>\n                </div>\n                <div>\n                  <span className=\"text-[#8E99A8]\">{isAr ? \'\330\252\331\202\331\212\331\212\331\205\331\203 \330\247\331\204\330\260\330\247\330\252\331\212\' : \'Self-Report\'}</span>\n                  <p className=\"font-mono-nums text-sm text-[#F4F6F8] mt-0.5\">\n                    {energyEstimate.selfReportedEnergy !== null ? `${energyEstimate.selfReportedEnergy}/10` : UI_TEXT[lang].common.unavailable}\n                  </p>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"pt-4 border-t border-[#232A33] space-y-2 text-xs\">\n              <p className=\"font-semibold text-emerald-400\">{isAr ? \'\330\247\330\263\330\252\331\206\330\252\330\247\330\254\330\247\330\252 \331\210\330\252\331\210\330\265\331\212\330\247\330\252 \330\271\331\205\331\204\331\212\330\251 (Inferred Insights)\' : \'Inferred Practical Suggestions\'}</p>\n              {(isAr ? energyEstimate.recommendationsAr : energyEstimate.recommendationsEn).map((r, i) => (\n                <p key={i} className=\"text-[#D2DAE5] leading-relaxed\">\342\200\242 {r}</p>\n              ))}\n            </div>\n          </div>\n\n          <form onSubmit={handleSaveEnergy} className=\"lg:col-span-5 bg-[#13171C] border border-[#232A33] rounded-2xl p-5 space-y-4 self-start\">\n            <h2 className=\"text-sm font-semibold text-[#F4F6F8]\">{isAr ? \'\330\252\330\263\330\254\331\212\331\204 \330\255\330\247\331\204\330\252\331\203 \330\247\331\204\331\212\331\210\331\205\331\212\330\251 (Self Check-in)\' : \'Daily Energy & Mood Check-in\'}</h2>\n            {(\n              [\n                { label: isAr ? \'\331\205\330\263\330\252\331\210\331\211 \330\247\331\204\330\267\330\247\331\202\330\251\' : \'Energy Level\', val: energyLevel, set: setEnergyLevel, id: \'en-lvl\' },\n                { label: isAr ? \'\330\247\331\204\331\205\330\262\330\247\330\254 \330\247\331\204\330\271\330\247\331\205\' : \'Mood\', val: moodLevel, set: setMoodLevel, id: \'mood-lvl\' },\n                { label: isAr ? \'\330\247\331\204\330\252\330\261\331\203\331\212\330\262\' : \'Focus\', val: focusLevel, set: setFocusLevel, id: \'focus-lvl\' },\n                { label: isAr ? \'\330\247\331\204\330\245\330\254\331\207\330\247\330\257 / \330\247\331\204\330\252\331\210\330\252\330\261\' : \'Perceived Stress\', val: stressLevel, set: setStressLevel, id: \'stress-lvl\' },\n              ] as const\n            ).map((slider) => (\n              <div key={slider.id} className=\"space-y-1\">\n                <div className=\"flex justify-between text-xs\">\n                  <label htmlFor={slider.id} className=\"text-[#A9B3C1]\">{slider.label}</label>\n                  <span className=\"font-mono-nums text-[#F4F6F8] font-semibold\">{slider.val} / 10</span>\n                </div>\n                <input\n                  id={slider.id}\n                  type=\"range\"\n                  min={1}\n                  max={10}\n                  value={slider.val}\n                  onChange={(e) => slider.set(Number(e.target.value))}\n                  className=\"w-full accent-emerald-500\"\n                />\n              </div>\n            ))}\n\n            <div>\n              <label htmlFor=\"en-notes\" className=\"block text-xs text-[#8E99A8] mb-1\">{isAr ? \'\331\205\331\204\330\247\330\255\330\270\330\251 \330\263\330\261\331\212\330\271\330\251\' : \'Quick Note\'}</label>\n              <input\n                id=\"en-notes\"\n                type=\"text\"\n                value={energyNotes}\n                onChange={(e) => setEnergyNotes(e.target.value)}\n                placeholder={isAr ? \'\331\205\330\253\330\247\331\204: \330\252\330\261\331\203\331\212\330\262 \330\247\331\204\330\265\330\250\330\255 \330\271\330\247\331\204\331\212 \330\250\330\271\330\257 \331\202\331\207\331\210\330\251 \330\256\331\201\331\212\331\201\330\251\' : \'e.g., Sharp morning focus\'}\n                className=\"w-full min-h-[42px] px-3 rounded-xl bg-[#0B0D10] border border-[#232A33] text-sm text-[#F4F6F8]\"\n              />\n            </div>\n\n            <button type=\"submit\" className=\"w-full min-h-[44px] rounded-xl bg-emerald-500 text-[#07110C] font-semibold text-sm hover:bg-emerald-400\">\n              {energySaved ? (isAr ? \'\330\252\331\205 \330\252\330\263\330\254\331\212\331\204 \330\247\331\204\330\252\331\202\331\212\331\212\331\205\' : \'Check-in Saved\') : (isAr ? \'\330\255\331\201\330\270 \330\247\331\204\330\252\331\202\331\212\331\212\331\205 \330\247\331\204\331\212\331\210\331\205\331\212\' : \'Save Daily Check-in\')}\n            </button>\n          </form>\n        </div>\n      ) : null}\n\n      {/* SUBTAB 3: XIAOMI SMART BAND & HEALTH CONNECT */}\n      {subTab === \'band\' ? (\n        <div className=\"bg-[#13171C] border border-[#232A33] rounded-2xl p-6 space-y-5\">\n          <div className=\"flex items-start justify-between gap-4\">\n            <div className=\"flex items-start gap-3\">\n              <Watch className=\"w-5 h-5 text-emerald-400 shrink-0 mt-0.5\" />\n              <div>\n                <h2 className=\"text-base font-semibold text-[#F4F6F8]\">\n                  {isAr ? \'Xiaomi Smart Band \330\271\330\250\330\261 Android Health Connect\' : \'Xiaomi Smart Band via Android Health Connect\'}\n                </h2>\n                <p className=\"text-xs text-[#8E99A8] mt-1 leading-relaxed\">\n                  {isAr\n                    ? \'\330\247\331\204\330\255\330\247\331\204\330\251 \330\247\331\204\330\255\330\247\331\204\331\212\330\251 \330\271\331\204\331\211 \331\205\330\252\330\265\331\201\330\255 \330\247\331\204\331\210\331\212\330\250: \330\272\331\212\330\261 \331\205\330\252\330\265\331\204 \330\252\331\204\331\202\330\247\330\246\331\212\330\247\331\213 (\331\212\330\252\330\267\331\204\330\250 \330\252\330\267\330\250\331\212\331\202 Android \330\243\330\265\331\204\331\212 \331\205\330\271 Android Health Connect + Mi Fitness).\'\n                    : \'Current Web Runtime Status: Not auto-connected (requires native Android app with Android Health Connect + Mi Fitness companion).\'}\n                </p>\n              </div>\n            </div>\n            <span className=\"text-xs font-medium text-amber-400 whitespace-nowrap\">\n              {isAr ? \'\331\212\330\252\330\267\331\204\330\250 Android\' : \'Android Required\'}\n            </span>\n          </div>\n\n          <div className=\"pt-4 border-t border-[#232A33] grid grid-cols-1 md:grid-cols-2 gap-5 text-xs text-[#A9B3C1]\">\n            <div className=\"space-y-2\">\n              <p className=\"font-semibold text-[#F4F6F8]\">{isAr ? \'\331\205\330\263\330\247\330\261 \330\247\331\204\330\261\330\250\330\267 \330\247\331\204\330\265\330\255\331\212\330\255 \331\210\330\247\331\204\331\205\331\210\330\253\331\210\331\202\' : \'Supported Standardized Integration Path\'}</p>\n              <p className=\"leading-relaxed\">\n                {isAr\n                  ? \'\331\204\330\247 \330\252\330\271\330\252\331\205\330\257 \330\243\330\254\331\207\330\262\330\251 Xiaomi Smart Band \330\271\331\204\331\211 API \330\271\330\247\331\205 \331\205\330\250\330\247\330\264\330\261 \331\204\331\203\331\204 \330\247\331\204\331\202\331\212\330\247\330\263\330\247\330\252\330\233 \331\204\330\260\331\204\331\203 \331\212\330\271\330\252\331\205\330\257 LIFE OS \330\271\331\204\331\211 Android Health Connect \331\203\330\267\330\250\331\202\330\251 \331\202\331\212\330\247\330\263\331\212\330\251 \330\250\330\271\330\257 \330\252\331\201\330\271\331\212\331\204 \330\247\331\204\331\205\330\262\330\247\331\205\331\206\330\251 \330\257\330\247\330\256\331\204 Mi Fitness.\'\n                  : \'Xiaomi wearables do not expose every metric through a public cloud API; LIFE OS uses Android Health Connect as the standardized layer synced from Mi Fitness.\'}\n              </p>\n            </div>\n            <div className=\"space-y-2\">\n              <p className=\"font-semibold text-[#F4F6F8]\">{isAr ? \'\330\247\331\204\331\205\331\202\330\247\331\212\331\212\330\263 \330\247\331\204\331\205\330\257\330\271\331\210\331\205\330\251 \330\271\331\206\330\257 \330\252\331\201\330\271\331\212\331\204 \330\247\331\204\330\245\330\260\331\206\' : \'Permissions & Metric Transparency\'}</p>\n              <p className=\"leading-relaxed\">\n                {isAr\n                  ? \'\330\247\331\204\331\206\331\210\331\205 \331\210\330\254\331\204\330\263\330\247\330\252\331\207 \302\267 \330\247\331\204\330\256\330\267\331\210\330\247\330\252 \331\210\330\247\331\204\331\205\330\263\330\247\331\201\330\251 \302\267 \330\247\331\204\330\263\330\271\330\261\330\247\330\252 \330\247\331\204\331\206\330\264\330\267\330\251 (\331\205\331\206\331\201\330\265\331\204\330\251 \330\271\331\206 \330\247\331\204\330\245\330\254\331\205\330\247\331\204\331\212) \302\267 \331\206\330\250\330\266 \330\247\331\204\331\202\331\204\330\250 \331\210\331\206\330\250\330\266 \330\247\331\204\330\261\330\247\330\255\330\251 \302\267 \330\247\331\204\330\252\331\205\330\247\330\261\331\212\331\206. \331\201\331\212 \331\206\330\263\330\256\330\251 \330\247\331\204\331\205\330\252\330\265\331\201\330\255 \330\247\331\204\330\255\330\247\331\204\331\212\330\251 \331\212\331\205\331\203\331\206\331\203 \330\252\330\263\330\254\331\212\331\204 \331\203\331\204 \331\207\330\260\331\207 \330\247\331\204\331\205\331\202\330\247\331\212\331\212\330\263 \331\212\330\257\331\210\3