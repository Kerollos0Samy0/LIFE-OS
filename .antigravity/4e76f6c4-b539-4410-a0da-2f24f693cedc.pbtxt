      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import type {\\n  DefaultExpenseCategory,\\n  GoalCategory,\\n  IncomeSource,\\n  IncomeStatus,\\n  InvestmentCategory,\\n  Language,\\n  PaymentMethod,\\n  SavingsCategory,\\n  TaskCategory,\\n  TaskPriority,\\n} from \'../types/lifeos\';\\n\\nexport const DEFAULT_EXPENSE_CATEGORIES: DefaultExpenseCategory[] = [\\n  \'food\',\\n  \'transportation\',\\n  \'housing\',\\n  \'utilities\',\\n  \'internet_mobile\',\\n  \'shopping\',\\n  \'health\',\\n  \'entertainment\',\\n  \'education\',\\n  \'family\',\\n  \'church_activities\',\\n  \'work_expenses\',\\n  \'subscriptions\',\\n  \'other\',\\n];\\n\\nexport const CATEGORY_LABELS: Record<string, { ar: string; en: string }> = {\\n  overall: { ar: \'\330\247\331\204\331\205\331\212\330\262\330\247\331\206\331\212\330\251 \330\247\331\204\330\264\331\207\330\261\331\212\330\251 \330\247\331\204\331\203\331\204\331\212\330\251\', en: \'Monthly Overall Budget\' },\\n  food: { ar: \'\330\243\331\203\331\204 \331\210\330\264\330\261\330\250\', en: \'Food & Dining\' },\\n  transportation: { ar: \'\331\205\331\210\330\247\330\265\331\204\330\247\330\252\', en: \'Transportation\' },\\n  housing: { ar: \'\330\263\331\203\331\206 \331\210\330\245\331\212\330\254\330\247\330\261\', en: \'Housing\' },\\n  utilities: { ar: \'\331\201\331\210\330\247\330\252\331\212\330\261 \331\210\331\205\330\261\330\247\331\201\331\202\', en: \'Utilities\' },\\n  internet_mobile: { ar: \'\330\245\331\206\330\252\330\261\331\206\330\252 \331\210\331\205\331\210\330\250\330\247\331\212\331\204\', en: \'Internet & Mobile\' },\\n  shopping: { ar: \'\331\205\330\264\330\252\330\261\331\212\330\247\330\252 \331\210\330\252\330\263\331\210\331\202\', en: \'Shopping\' },\\n  health: { ar: \'\330\265\330\255\330\251 \331\210\330\271\331\204\330\247\330\254\', en: \'Health\' },\\n  entertainment: { ar: \'\330\252\330\261\331\201\331\212\331\207 \331\210\330\256\330\261\331\210\330\254\330\247\330\252\', en: \'Entertainment\' },\\n  education: { ar: \'\330\252\330\271\331\204\331\212\331\205 \331\210\331\203\331\210\330\261\330\263\330\247\330\252\', en: \'Education\' },\\n  family: { ar: \'\330\247\331\204\330\243\330\263\330\261\330\251 \331\210\330\247\331\204\330\250\331\212\330\252\', en: \'Family\' },\\n  church_activities: { ar: \'\330\247\331\204\331\203\331\206\331\212\330\263\330\251 \331\210\330\247\331\204\330\243\331\206\330\264\330\267\330\251\', en: \'Church & Activities\' },\\n  work_expenses: { ar: \'\331\205\330\265\330\247\330\261\331\212\331\201 \330\247\331\204\330\264\330\272\331\204\', en: \'Work Expenses\' },\\n  subscriptions: { ar: \'\330\247\330\264\330\252\330\261\330\247\331\203\330\247\330\252 \330\264\331\207\330\261\331\212\330\251\', en: \'Subscriptions\' },\\n  other: { ar: \'\330\243\330\256\330\261\331\211\', en: \'Other\' },\\n};\\n\\nexport function getCategoryLabel(cat: string, lang: Language): string {\\n  return CATEGORY_LABELS[cat]?.[lang] ?? cat;\\n}\\n\\nexport const INCOME_SOURCE_LABELS: Record<IncomeSource, { ar: string; en: string }> = {\\n  fixed_salary: { ar: \'\331\205\330\261\330\252\330\250 \330\253\330\247\330\250\330\252\', en: \'Fixed Salary\' },\\n  freelance: { ar: \'\330\264\330\272\331\204 \330\255\330\261 (\331\201\330\261\331\212\331\204\330\247\331\206\330\263)\', en: \'Freelance Project\' },\\n  additional: { ar: \'\330\257\330\256\331\204 \330\245\330\266\330\247\331\201\331\212\', en: \'Additional Income\' },\\n};\\n\\nexport const INCOME_STATUS_LABELS: Record<IncomeStatus, { ar: string; en: string }> = {\\n  expected: { ar: \'\331\205\330\252\331\210\331\202\330\271\', en: \'Expected\' },\\n  invoiced: { ar: \'\330\252\331\205 \330\245\330\261\330\263\330\247\331\204 \330\247\331\204\331\201\330\247\330\252\331\210\330\261\330\251\', en: \'Invoiced\' },\\n  partially_paid: { ar: \'\331\205\330\257\331\201\331\210\330\271 \330\254\330\262\330\246\331\212\330\247\331\213\', en: \'Partially Paid\' },\\n  fully_paid: { 