rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1 / Global Safety Net: Default deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Global Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidOptionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isValidNonNegNumber(val, maxVal) {
      return (val is int || val is float) && val >= 0 && val <= maxVal;
    }

    function isValidMoney(val) {
      return isValidNonNegNumber(val, 1000000000000);
    }

    // --- Validation Blueprints (Pillar 2: Called on BOTH create & update) ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['userId', 'displayName', 'language', 'currency', 'dailyWorkHours', 'peakConcentration', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'userId', 'displayName', 'email', 'language', 'currency',
          'dailyWorkHours', 'workStartHour', 'workEndHour', 'targetSleepHours',
          'peakConcentration', 'financialGoal', 'smartphone', 'smartwatch',
          'dailyStepTarget', 'aiDefaultModel', 'aiDailyLimit', 'liabilitiesPiasters',
          'createdAt', 'updatedAt'
        ])
        && data.userId == userId
        && isValidId(data.userId)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && isValidOptionalString(data, 'email', 200)
        && data.language in ['ar', 'en']
        && data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 10
        && isValidNonNegNumber(data.dailyWorkHours, 24)
        && (!('workStartHour' in data) || isValidNonNegNumber(data.workStartHour, 23))
        && (!('workEndHour' in data) || isValidNonNegNumber(data.workEndHour, 24))
        && (!('targetSleepHours' in data) || isValidNonNegNumber(data.targetSleepHours, 24))
        && data.peakConcentration in ['morning', 'afternoon', 'evening']
        && isValidOptionalString(data, 'financialGoal', 200)
        && isValidOptionalString(data, 'smartphone', 60)
        && isValidOptionalString(data, 'smartwatch', 80)
        && (!('dailyStepTarget' in data) || isValidNonNegNumber(data.dailyStepTarget, 100000))
        && (!('aiDefaultModel' in data) || data.aiDefaultModel in ['gemini-3.1-flash-lite', 'gemini-4-hydrogen'])
        && (!('aiDailyLimit' in data) || isValidNonNegNumber(data.aiDailyLimit, 500))
        && (!('liabilitiesPiasters' in data) || isValidMoney(data.liabilitiesPiasters))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidIncomeRecord(data, userId) {
      return data.keys().hasAll(['userId', 'title', 'amountPiasters', 'paidAmountPiasters', 'currency', 'source', 'status', 'expectedPaymentDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'userId', 'title', 'amountPiasters', 'paidAmountPiasters', 'currency',
          'source', 'status', 'dateReceived', 'expectedPaymentDate', 'projectName',
          'notes', 'createdAt', 'updatedAt'
        ])
        && data.userId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && isValidMoney(data.amountPiasters)
        && isValidMoney(data.paidAmountPiasters)
        && data.paidAmountPiasters <= data.amountPiasters
        && data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 10
        && data.source in ['fixed_salary', 'freelance', 'additional']
        && data.status in ['expected', 'invoiced', 'partially_paid', 'fully_paid', 'overdue']
        && isValidOptionalString(data, 'dateReceived', 32)
        && data.expectedPaymentDate is string && data.expectedPaymentDate.size() >= 1 && data.expectedPaymentDate.size() <= 32
        && isValidOptionalString(data, 'projectName', 120)
        && isValidOptionalString(data, 'notes', 500)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExpenseRecord(data, userId) {
      return data.keys().hasAll(['userId', 'description', 'amountPiasters', 'currency', 'category', 'date', 'paymentMethod', 'entrySource', 'recurring', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'userId', 'description', 'amountPiasters', 'currency', 'category',
          'date', 'paymentMethod', 'entrySource', 'recurring', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.userId == userId
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 200
        && isValidMoney(data.amountPiasters)
        && data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 10
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && data.date is string && data.date.size() >= 1 && data.date.size() <= 32
        && data.paymentMethod in ['cash', 'card', 'instapay', 'wallet', 'bank_transfer']
        && data.entrySource in ['manual', 'voice', 'receipt', 'notification', 'email_import']
        && data.recurring is bool
        && isValidOptionalString(data, 'notes', 500)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBudget(data, userId) {
      return data.keys().hasAll(['userId', 'category', 'monthKey', 'limitPiasters', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'category', 'monthKey', 'limitPiasters', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && data.monthKey is string && data.monthKey.size() >= 4 && data.monthKey.size() <= 10
        && isValidMoney(data.limitPiasters)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavingsGoal(data, userId) {
      return data.keys().hasAll(['userId', 'title', 'category', 'targetPiasters', 'currentPiasters', 'targetDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'title', 'category', 'targetPiasters', 'currentPiasters', 'targetDate', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.category in ['emergency', 'purchases', 'education', 'travel', 'investments', 'custom']
        && isValidMoney(data.targetPiasters)
        && isValidMoney(data.currentPiasters)
        && data.targetDate is string && data.targetDate.size() >= 1 && data.targetDate.size() <= 32
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInvestmentAsset(data, userId) {
      return data.keys().hasAll(['userId', 'name', 'category', 'quantity', 'purchasePricePiasters', 'currentValuationPiasters', 'feesPiasters', 'realizedPnlPiasters', 'purchaseDate', 'valuationSource', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'name', 'category', 'quantity', 'purchasePricePiasters', 'currentValuationPiasters', 'feesPiasters', 'realizedPnlPiasters', 'purchaseDate', 'valuationSource', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 140
        && data.category in ['gold', 'stocks', 'mutual_funds', 'etfs', 'other']
        && isValidNonNegNumber(data.quantity, 1000000000)
        && isValidMoney(data.purchasePricePiasters)
        && isValidMoney(data.currentValuationPiasters)
        && isValidMoney(data.feesPiasters)
        && (data.realizedPnlPiasters is int || data.realizedPnlPiasters is float)
        && data.realizedPnlPiasters >= -1000000000000 && data.realizedPnlPiasters <= 1000000000000
        && data.purchaseDate is string && data.purchaseDate.size() >= 1 && data.purchaseDate.size() <= 32
        && data.valuationSource in ['manual', 'verified_market']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTaskItem(data, userId) {
      return data.keys().hasAll(['userId', 'title', 'priority', 'category', 'status', 'deadline', 'estimatedMinutes', 'actualMinutes', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'title', 'description', 'priority', 'category', 'status', 'deadline', 'scheduledStart', 'estimatedMinutes', 'actualMinutes', 'project', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && isValidOptionalString(data, 'description', 600)
        && data.priority in ['critical', 'high', 'medium', 'low']
        && data.category in ['deep_work', 'admin', 'meetings', 'personal', 'rest', 'commute']
        && data.status in ['todo', 'in_progress', 'completed']
        && data.deadline is string && data.deadline.size() >= 1 && data.deadline.size() <= 32
        && isValidOptionalString(data, 'scheduledStart', 16)
        && isValidNonNegNumber(data.estimatedMinutes, 1440)
        && isValidNonNegNumber(data.actualMinutes, 1440)
        && isValidOptionalString(data, 'project', 120)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCalendarEvent(data, userId) {
      return data.keys().hasAll(['userId', 'title', 'calendarType', 'date', 'startTime', 'endTime', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'title', 'calendarType', 'date', 'startTime', 'endTime', 'notes', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.calendarType in ['work', 'personal']
        && data.date is string && data.date.size() >= 1 && data.date.size() <= 32
        && data.startTime is string && data.startTime.size() >= 1 && data.startTime.size() <= 16
        && data.endTime is string && data.endTime.size() >= 1 && data.endTime.size() <= 16
        && isValidOptionalString(data, 'notes', 400)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFocusSession(data, userId) {
      return data.keys().hasAll(['userId', 'label', 'durationMinutes', 'distractions', 'date', 'createdAt'])
        && data.keys().hasOnly(['userId', 'label', 'durationMinutes', 'distractions', 'date', 'createdAt'])
        && data.userId == userId
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 140
        && isValidNonNegNumber(data.durationMinutes, 480)
        && isValidNonNegNumber(data.distractions, 500)
        && data.date is string && data.date.size() >= 1 && data.date.size() <= 32
        && data.createdAt is timestamp;
    }

    function isValidHealthLog(data, userId) {
      return data.keys().hasAll(['userId', 'date', 'source', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'date', 'sleepHours', 'sleepBedtime', 'steps', 'activeCalories', 'restingHeartRate', 'source', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && data.date is string && data.date.size() >= 1 && data.date.size() <= 32
        && (!('sleepHours' in data) || isValidNonNegNumber(data.sleepHours, 24))
        && isValidOptionalString(data, 'sleepBedtime', 16)
        && (!('steps' in data) || isValidNonNegNumber(data.steps, 200000))
        && (!('activeCalories' in data) || isValidNonNegNumber(data.activeCalories, 20000))
        && (!('restingHeartRate' in data) || isValidNonNegNumber(data.restingHeartRate, 240))
        && data.source in ['manual', 'health_connect', 'xiaomi_band']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAppUsageLog(data, userId) {
      return data.keys().hasAll(['userId', 'date', 'productivityMinutes', 'socialMediaMinutes', 'nighttimeMinutes', 'source', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'date', 'productivityMinutes', 'communicationMinutes', 'socialMediaMinutes', 'entertainmentMinutes', 'educationMinutes', 'otherMinutes', 'nighttimeMinutes', 'interruptions', 'source', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && data.date is string && data.date.size() >= 1 && data.date.size() <= 32
        && isValidNonNegNumber(data.productivityMinutes, 1440)
        && (!('communicationMinutes' in data) || isValidNonNegNumber(data.communicationMinutes, 1440))
        && isValidNonNegNumber(data.socialMediaMinutes, 1440)
        && (!('entertainmentMinutes' in data) || isValidNonNegNumber(data.entertainmentMinutes, 1440))
        && (!('educationMinutes' in data) || isValidNonNegNumber(data.educationMinutes, 1440))
        && (!('otherMinutes' in data) || isValidNonNegNumber(data.otherMinutes, 1440))
        && isValidNonNegNumber(data.nighttimeMinutes, 720)
        && (!('interruptions' in data) || isValidNonNegNumber(data.interruptions, 2000))
        && data.source in ['manual', 'usage_stats']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEnergyLog(data, userId) {
      return data.keys().hasAll(['userId', 'date', 'energyLevel', 'moodLevel', 'focusLevel', 'stressLevel', 'createdAt'])
        && data.keys().hasOnly(['userId', 'date', 'energyLevel', 'moodLevel', 'focusLevel', 'stressLevel', 'notes', 'createdAt'])
        && data.userId == userId
        && data.date is string && data.date.size() >= 1 && data.date.size() <= 32
        && isValidNonNegNumber(data.energyLevel, 10)
        && isValidNonNegNumber(data.moodLevel, 10)
        && isValidNonNegNumber(data.focusLevel, 10)
        && isValidNonNegNumber(data.stressLevel, 10)
        && isValidOptionalString(data, 'notes', 300)
        && data.createdAt is timestamp;
    }

    function isValidPersonalGoal(data, userId) {
      return data.keys().hasAll(['userId', 'title', 'category', 'targetLabel', 'deadline', 'progress', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'title', 'description', 'category', 'targetLabel', 'startDate', 'deadline', 'progress', 'milestones', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 180
        && isValidOptionalString(data, 'description', 500)
        && data.category in ['financial', 'professional', 'educational', 'health', 'personal', 'social']
        && data.targetLabel is string && data.targetLabel.size() >= 1 && data.targetLabel.size() <= 120
        && isValidOptionalString(data, 'startDate', 32)
        && data.deadline is string && data.deadline.size() >= 1 && data.deadline.size() <= 32
        && isValidNonNegNumber(data.progress, 100)
        && (!('milestones' in data) || (data.milestones is list && data.milestones.size() <= 20 && (data.milestones.size() == 0 || data.milestones[0] is map)))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDailyMicroGoal(data, userId) {
      return data.keys().hasAll(['userId', 'date', 'title', 'category', 'targetValue', 'currentValue', 'unit', 'completed', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'date', 'title', 'category', 'targetValue', 'currentValue', 'unit', 'completed', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && isValidId(data.userId)
        && data.date is string && data.date.size() >= 1 && data.date.size() <= 32
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.category in ['focus', 'finance', 'health', 'wellbeing', 'personal']
        && (data.targetValue is int || data.targetValue is float) && data.targetValue >= 1 && data.targetValue <= 100000
        && isValidNonNegNumber(data.currentValue, 100000)
        && data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 32
        && data.completed is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- User Root & PII-Isolated Profile ---
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'email', 'language', 'currency',
          'dailyWorkHours', 'workStartHour', 'workEndHour', 'targetSleepHours',
          'peakConcentration', 'financialGoal', 'smartphone', 'smartwatch',
          'dailyStepTarget', 'aiDefaultModel', 'aiDailyLimit', 'liabilitiesPiasters',
          'updatedAt'
        ]);
      allow delete: if isOwner(userId) && isValidId(userId);

      // --- Income Records ---
      match /income_records/{recordId} {
        allow get: if isOwner(userId) && isValidId(recordId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(recordId)
          && isValidIncomeRecord(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidId(recordId)
          && isValidIncomeRecord(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'amountPiasters', 'paidAmountPiasters', 'source', 'status',
            'dateReceived', 'expectedPaymentDate', 'projectName', 'notes', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(recordId);
      }

      // --- Expense Records ---
      match /expense_records/{recordId} {
        allow get: if isOwner(userId) && isValidId(recordId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(recordId)
          && isValidExpenseRecord(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidId(recordId)
          && isValidExpenseRecord(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'description', 'amountPiasters', 'category', 'date', 'paymentMethod', 'recurring', 'notes', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(recordId);
      }

      // --- Budgets ---
      match /budgets/{budgetId} {
        allow get: if isOwner(userId) && isValidId(budgetId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(budgetId)
          && isValidBudget(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidId(budgetId)
          && isValidBudget(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['category', 'monthKey', 'limitPiasters', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(budgetId);
      }

      // --- Savings Goals ---
      match /savings_goals/{goalId} {
        allow get: if isOwner(userId) && isValidId(goalId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(goalId)
          && isValidSavingsGoal(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidId(goalId)
          && isValidSavingsGoal(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'targetPiasters', 'currentPiasters', 'targetDate', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(goalId);
      }

      // --- Investments ---
      match /investments/{investmentId} {
        allow get: if isOwner(userId) && isValidId(investmentId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(investmentId)
          && isValidInvestmentAsset(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidId(investmentId)
          && isValidInvestmentAsset(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'category', 'quantity', 'purchasePricePiasters',
            'currentValuationPiasters', 'feesPiasters', 'realizedPnlPiasters',
            'purchaseDate', 'valuationSource', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(investmentId);
      }

      // --- Tasks ---
      match /tasks/{taskId} {
        allow get: if isOwner(userId) && isValidId(taskId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(taskId)
          && isValidTaskItem(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidId(taskId)
          && isValidTaskItem(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'description', 'priority', 'category', 'status',
            'deadline', 'scheduledStart', 'estimatedMinutes', 'actualMinutes', 'project', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      // --- Calendar Events ---
      match /calendar_events/{eventId} {
        allow get: if isOwner(userId) && isValidId(eventId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(eventId)
          && isValidCalendarEvent(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidId(eventId)
          && isValidCalendarEvent(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'calendarType', 'date', 'startTime', 'endTime', 'notes', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(eventId);
      }

      // --- Focus Sessions ---
      match /focus_sessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(sessionId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(sessionId)
          && isValidFocusSession(incoming(), userId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(sessionId);
      }

      // --- Health Logs ---
      match /health_logs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(logId)
          && isValidHealthLog(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidId(logId)
          && isValidHealthLog(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['sleepHours', 'sleepBedtime', 'steps', 'activeCalories', 'restingHeartRate', 'source', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(logId);
      }

      // --- App Usage Logs ---
      match /app_usage/{usageId} {
        allow get: if isOwner(userId) && isValidId(usageId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(usageId)
          && isValidAppUsageLog(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidId(usageId)
          && isValidAppUsageLog(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'productivityMinutes', 'communicationMinutes', 'socialMediaMinutes',
            'entertainmentMinutes', 'educationMinutes', 'otherMinutes',
            'nighttimeMinutes', 'interruptions', 'source', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(usageId);
      }

      // --- Energy Logs ---
      match /energy_logs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(logId)
          && isValidEnergyLog(incoming(), userId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(logId);
      }

      // --- Personal Goals ---
      match /goals/{goalId} {
        allow get: if isOwner(userId) && isValidId(goalId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(goalId)
          && isValidPersonalGoal(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidId(goalId)
          && isValidPersonalGoal(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'description', 'category', 'targetLabel', 'startDate',
            'deadline', 'progress', 'milestones', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(goalId);
      }

      // --- Daily Micro-Goals ---
      match /daily_micro_goals/{goalId} {
        allow get: if isOwner(userId) && isValidId(goalId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(goalId)
          && isValidDailyMicroGoal(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidId(goalId)
          && isValidDailyMicroGoal(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'date', 'title', 'category', 'targetValue', 'currentValue', 'unit', 'completed', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(goalId);
      }
    }
  }
}
